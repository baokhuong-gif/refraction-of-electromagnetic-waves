        target_content: "function hexToRgba(hex: string, alpha: number): string {\n  const clean = hex.replace(\'#\', \'\');\n  const full =\n    clean.length === 3\n      ? clean\n          .split(\'\')\n          .map((c) => c + c)\n          .join(\'\')\n      : clean;\n  const num = parseInt(full, 16);\n  const r = (num >> 16) & 255;\n  const g = (num >> 8) & 255;\n  const b = num & 255;\n  return `rgba(${r}, ${g}, ${b}, ${clamp(alpha, 0, 1).toFixed(3)})`;\n}"
        replacement_content: "function drawHaloText(\n  ctx: CanvasRenderingContext2D,\n  text: string,\n  x: number,\n  y: number,\n  fillColor: string,\n  font: string,\n  align: CanvasTextAlign = \'left\'\n) {\n  ctx.save();\n  ctx.font = font;\n  ctx.textAlign = align;\n  ctx.lineJoin = \'round\';\n  ctx.lineWidth = 3.5;\n  ctx.strokeStyle = \'rgba(255, 255, 255, 0.92)\';\n  ctx.strokeText(text, x, y);\n  ctx.fillStyle = fillColor;\n  ctx.fillText(text, x, y);\n  ctx.restore();\n}\n\nfunction hexToRgba(hex: string, alpha: number): string {\n  const clean = hex.replace(\'#\', \'\');\n  const full =\n    clean.length === 3\n      ? clean\n          .split(\'\')\n          .map((c) => c + c)\n          .join(\'\')\n      : clean;\n  const num = parseInt(full, 16);\n  const r = (num >> 16) & 255;\n  const g = (num >> 8) & 255;\n  const b = num & 255;\n  return `rgba(${r}, ${g}, ${b}, ${clamp(alpha, 0, 1).toFixed(3)})`;\n}"
