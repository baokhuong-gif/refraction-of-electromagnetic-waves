  code_action {
    action_spec {
      command {
        instruction: "Improve evanescent wave visibility and add clean white text halos and non-overlapping label positions for \316\270c, \316\270i, \316\270r, \316\270t, and \316\264e"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/WaveCanvas.tsx"
