      arguments_json: "{\"CodeContent\":\"import { clamp, computeEMRefraction, WavePhysicsResult } from \'../physics/emPhysics.ts\';\\nimport { PolarizationMode } from \'../physics/materials.ts\';\\n\\nexport type WaveDirectionCategory =\\n  | \'TOWARD_NORMAL\'\\n  | \'AWAY_FROM_NORMAL\'\\n  | \'STRAIGHT_THROUGH\'\\n  | \'TOTAL_INTERNAL_REFLECTION\'\\n  | \'GRAZING_REFRACTION\';\\n\\nexport type ConfidenceLevel = \'HIGH\' | \'MEDIUM\' | \'LOW\';\\n\\nexport interface AiWavePrediction {\\n  scenarioSummary: string;\\n  inferredN1: number;\\n  inferredN2: number;\\n  inferredIncidentAngleDeg: number;\\n  inferredWavelengthNm: number;\\n  inferredPolarization: PolarizationMode;\\n  directionCategory: WaveDirectionCategory;\\n  directionLabel: string;\\n  predictedRefractedAngleDeg: number | null;\\n  predictedReflectedAngleDeg: number;\\n  predictedDeviationDeg: number;\\n  confidenceLevel: ConfidenceLevel;\\n  physicalReasoning: string;\\n  engineeringRecommendations: string[];\\n}\\n\\nexport interface PhysicsCrossCheck {\\n  exactPhysics: WavePhysicsResult;\\n  expectedCategory: WaveDirectionCategory;\\n  isDirectionAligned: boolean;\\n  angleDiscrepancyDeg: number | null;\\n}\\n\\nexport interface TrajectorySvgGeometry {\\n  cx: number;\\n  cy: number;\\n  incStart: { x: number; y: number };\\n  refEnd: { x: number; y: number };\\n  transEnd: { x: number; y: number } | null;\\n  isTir: boolean;\\n}\\n\\nconst VALID_CATEGORIES = new Set<WaveDirectionCategory>([\\n  \'TOWARD_NORMAL\',\\n  \'AWAY_FROM_NORMAL\',\\n  \'STRAIGHT_THROUGH\',\\n  \'TOTAL_INTERNAL_REFLECTION\',\\n  \'GRAZING_REFRACTION\',\\n]);\\n\\nconst VALID_CONFIDENCE = new Set<ConfidenceLevel>([\'HIGH\', \'MEDIUM\', \'LOW\']);\\nconst VALID_POLARIZATIONS = new Set<PolarizationMode>([\'TE\', \'TM\', \'UNPOLARIZED\']);\\n\\nexport function normalizeAiWavePrediction(raw: unknown): AiWavePrediction {\\n  if (!raw || typeof raw !== \'object\') {\\n    throw new Error(\'Ph\341\272\243n h\341\273\223i d\341\273\261 \304\221o\303\241n AI kh\303\264ng \304\221\303\272ng \304\221\341\273\213nh d\341\272\241ng d\341\273\257 li\341\273\207u.\');\\n  }\\n\\n  const obj = raw as Record<string, unknown>;\\n\\n  const scenarioSummary =\\n    typeof obj.scenarioSummary === \'string\' && obj.scenarioSummary.trim().length > 0\\n      ? obj.scenarioSummary.trim()\\n      : \'K\341\273\213ch b\341\272\243n truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\';\\n\\n  const inferredN1 =\\n    typeof obj.inferredN1 === \'number\' && Number.isFinite(obj.inferredN1)\\n      ? clamp(obj.inferredN1, 1.0, 4.0)\\n      : NaN;\\n  const inferredN2 =\\n    typeof obj.inferredN2 === \'number\' && Number.isFinite(obj.inferredN2)\\n      ? clamp(obj.inferredN2, 1.0, 4.0)\\n      : NaN;\\n  const inferredIncidentAngleDeg =\\n    typeof obj.inferredIncidentAngleDeg === \'number\' && Number.isFinite(obj.inferredIncidentAngleDeg)\\n      ? clamp(obj.inferredIncidentAngleDeg, 0, 89.5)\\n      : NaN;\\n\\n  if (!Number.isFinite(inferredN1) || !Number.isFinite(inferredN2) || !Number.isFinite(inferredIncidentAngleDeg)) {\\n    throw new Error(\'M\303\264 h\303\254nh AI kh\303\264ng tr\303\255ch xu\341\272\245t \304\221\341\273\247 tham s\341\273\221 v\341\272\255t l\303\275 (n\342\202\201, n\342\202\202, \316\270i).\');\\n  }\\n\\n  const inferredWavelengthNm =\\n    typeof obj.inferredWavelengthNm === \'number\' && Number.isFinite(obj.inferredWavelengthNm)\\n      ? clamp(obj.inferredWavelengthNm, 100, 300_000_000)\\n      : 532;\\n\\n  const inferredPolarization: PolarizationMode =\\n    typeof obj.inferredPolarization === \'string\' &&\\n    VALID_POLARIZATIONS.has(obj.inferredPolarization as PolarizationMode)\\n      ? (obj.inferredPolarization as PolarizationMode)\\n      : \'UNPOLARIZED\';\\n\\n  const directionCategory: WaveDirectionCategory =\\n    typeof obj.directionCategory === \'string\' &&\\n    VALID_CATEGORIES.has(obj.directionCategory as WaveDirectionCategory)\\n      ? (obj.directionCategory as WaveDirectionCategory)\\n      : \'TOWARD_NORMAL\';\\n\\n  const directionLabel =\\n    typeof obj.directionLabel === \'string\' && obj.directionLabel.trim().length > 0\\n      ? obj.directionLabel.trim()\\n      : getDefaultDirectionLabel(directionCategory);\\n\\n  const predictedRefractedAngleDeg =\\n    directionCategory === \'TOTAL_INTERNAL_REFLECTION\' ||\\n    obj.predictedRefractedAngleDeg === null ||\\n    obj.predictedRefractedAngleDeg === undefined\\n      ? null\\n      : typeof obj.predictedRefractedAngleDeg === \'number\' &&\\n          Number.isFinite(obj.predictedRefractedAngleDeg)\\n        ? clamp(obj.predictedRefractedAngleDeg, 0, 90)\\n        : null;\\n\\n  const predictedReflectedAngleDeg =\\n    typeof obj.predictedReflectedAngleDeg === \'number\' &&\\n    Number.isFinite(obj.predictedReflectedAngleDeg)\\n      ? clamp(obj.predictedReflectedAngleDeg, 0, 89.5)\\n      : inferredIncidentAngleDeg;\\n\\n  const predictedDeviationDeg =\\n    typeof obj.predictedDeviationDeg === \'number\' && Number.isFinite(obj.predictedDeviationDeg)\\n      ? clamp(obj.predictedDeviationDeg, 0, 180)\\n      : predictedRefractedAngleDeg !== null\\n        ? Math.abs(inferredIncidentAngleDeg - predictedRefractedAngleDeg)\\n        : 180 - 2 * inferredIncidentAngleDeg;\\n\\n  const confidenceLevel: ConfidenceLevel =\\n    typeof obj.confidenceLevel === \'string\' &&\\n    VALID_CONFIDENCE.has(obj.confidenceLevel as ConfidenceLevel)\\n      ? (obj.confidenceLevel as ConfidenceLevel)\\n      : \'HIGH\';\\n\\n  const physicalReasoning =\\n    typeof obj.physicalReasoning === \'string\' && obj.physicalReasoning.trim().length > 0\\n      ? obj.physicalReasoning.trim()\\n      : \'H\306\260\341\273\233ng truy\341\273\201n s\303\263ng tu\303\242n theo \304\221\341\273\213nh lu\341\272\255t Snell v\303\240 s\341\273\261 thay \304\221\341\273\225i v\341\272\255n t\341\273\221c pha t\341\272\241i m\341\272\267t ph\303\242n c\303\241ch.\';\\n\\n  const engineeringRecommendations = Array.isArray(obj.engineeringRecommendations)\\n    ? obj.engineeringRecommendations\\n        .filter((item): item is string => typeof item === \'string\' && item.trim().length > 0)\\n        .map((item) => item.trim())\\n        .slice(0, 4)\\n    : [];\\n\\n  return {\\n    scenarioSummary,\\n    inferredN1,\\n    inferredN2,\\n    inferredIncidentAngleDeg,\\n    inferredWavelengthNm,\\n    inferredPolarization,\\n    directionCategory,\\n    directionLabel,\\n    predictedRefractedAngleDeg,\\n    predictedReflectedAngleDeg,\\n    predictedDeviationDeg,\\n    confidenceLevel,\\n    physicalReasoning,\\n    engineeringRecommendations,\\n  };\\n}\\n\\nexport function getDefaultDirectionLabel(category: WaveDirectionCategory): string {\\n  switch (category) {\\n    case \'TOWARD_NORMAL\':\\n      return \'Kh\303\272c x\341\272\241 l\341\273\207ch l\341\272\241i g\341\272\247n ph\303\241p tuy\341\272\277n\';\\n    case \'AWAY_FROM_NORMAL\':\\n      return \'Kh\303\272c x\341\272\241 l\341\273\207ch ra xa ph\303\241p tuy\341\272\277n\';\\n    case \'STRAIGHT_THROUGH\':\\n      return \'Truy\341\273\201n th\341\272\263ng kh\303\264ng \304\221\341\273\225i h\306\260\341\273\233ng\';\\n    case \'TOTAL_INTERNAL_REFLECTION\':\\n      return \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n v\341\273\201 m\303\264i tr\306\260\341\273\235ng 1\';\\n    case \'GRAZING_REFRACTION\':\\n      return \'Kh\303\272c x\341\272\241 s\303\241t m\341\272\267t ph\303\242n c\303\241ch (c\341\272\255n g\303\263c t\341\273\233i h\341\272\241n)\';\\n  }\\n}\\n\\nexport function deriveExpectedDirectionCategory(physics: WavePhysicsResult): WaveDirectionCategory {\\n  if (physics.isTotalInternalReflection) {\\n    return \'TOTAL_INTERNAL_REFLECTION\';\\n  }\\n  if (physics.incidentAngleDeg < 0.25 || Math.abs(physics.n1 - physics.n2) < 0.002) {\\n    return \'STRAIGHT_THROUGH\';\\n  }\\n  if (physics.refractedAngleDeg !== null && physics.refractedAngleDeg >= 82) {\\n    return \'GRAZING_REFRACTION\';\\n  }\\n  return physics.n2 > physics.n1 ? \'TOWARD_NORMAL\' : \'AWAY_FROM_NORMAL\';\\n}\\n\\nexport function crossCheckAiPredictionWithSnell(prediction: AiWavePrediction): PhysicsCrossCheck {\\n  const exactPhysics = computeEMRefraction({\\n    n1: prediction.inferredN1,\\n    n2: prediction.inferredN2,\\n    incidentAngleDeg: prediction.inferredIncidentAngleDeg,\\n    wavelengthVacuumNm: prediction.inferredWavelengthNm,\\n    polarization: prediction.inferredPolarization,\\n  });\\n\\n  const expectedCategory = deriveExpectedDirectionCategory(exactPhysics);\\n  const isDirectionAligned =\\n    prediction.directionCategory === expectedCategory ||\\n    (prediction.directionCategory === \'GRAZING_REFRACTION\' &&\\n      expectedCategory === \'AWAY_FROM_NORMAL\') ||\\n    (prediction.directionCategory === \'AWAY_FROM_NORMAL\' &&\\n      expectedCategory === \'GRAZING_REFRACTION\');\\n\\n  const angleDiscrepancyDeg =\\n    exactPhysics.refractedAngleDeg !== null && prediction.predictedRefractedAngleDeg !== null\\n      ? Math.abs(exactPhysics.refractedAngleDeg - prediction.predictedRefractedAngleDeg)\\n      : exactPhysics.isTotalInternalReflection && prediction.predictedRefractedAngleDeg === null\\n        ? 0\\n        : null;\\n\\n  return {\\n    exactPhysics,\\n    expectedCategory,\\n    isDirectionAligned,\\n    angleDiscrepancyDeg,\\n  };\\n}\\n\\nexport function computeTrajectorySvgGeometry(\\n  incidentAngleDeg: number,\\n  refractedAngleDeg: number | null,\\n  width = 360,\\n  height = 220\\n): TrajectorySvgGeometry {\\n  const cx = width / 2;\\n  const cy = height / 2;\\n  const rayLen = Math.min(width, height) * 0.42;\\n\\n  const thetaI = (clamp(incidentAngleDeg, 0, 89.5) * Math.PI) / 180;\\n  const incStart = {\\n    x: cx - Math.sin(thetaI) * rayLen,\\n    y: cy - Math.cos(thetaI) * rayLen,\\n  };\\n  const refEnd = {\\n    x: cx + Math.sin(thetaI) * rayLen,\\n    y: cy - Math.cos(thetaI) * rayLen,\\n  };\\n\\n  if (refractedAngleDeg === null) {\\n    return { cx, cy, incStart, refEnd, transEnd: null, isTir: true };\\n  }\\n\\n  const thetaT = (clamp(refractedAngleDeg, 0, 89.5) * Math.PI) / 180;\\n  const transEnd = {\\n    x: cx + Math.sin(thetaT) * rayLen,\\n    y: cy + Math.cos(thetaT) * rayLen,\\n  };\\n\\n  return { cx, cy, incStart, refEnd, transEnd, isTir: false };\\n}\\n\",\"Description\":\"Create pure utility module for AI wave direction prediction validation, Snell physics cross-checking, and SVG trajectory vector math\",\"Overwrite\":true,\"TargetFile\":\"/src/utils/aiWavePrediction.ts\",\"toolAction\":\"Creating AI wave prediction utilities\",\"toolSummary\":\"Create aiWavePrediction utility\"}"
      thinking_signature: "\022\367P\n\364P\001i\024}\023\252P\373\035,\221Kd\374Il\016\020\205\032\227\334O#\233>,\262\a\206\177{z\317\205\323\227\005\335\323\034\353\361\316\344u\033\207\377\253n\252\302\360\213\342@\234\314J\\x\322\305\231\317\004\246\023\374\247\265\310\214\327\321e\306\216\t\2649\300\364\253*\311\227\357{o\373l\342\207\002\330Sd9\0210\220\260\244\357D\217\021\254\363R\260A\350\231\270\\\000S\330\"\216\nu\270\270\034\340\356\247\275\023z\233\t\206\037\253\355\vN\226\006G\230#vIB\247B\336\337)\263)\312\201~=\334\374\335\374.\323yU^*\332A\202~\300\217\024`\250\207{\344\030+\207\016\220\246\254\251\314\3741f\224\263\032\323\246i\321\037\231\000\030\257\215\027TR\213\322\301\022\276\377\026\255\b\016\3109?\216\262\230\222\341\037\245wO\006\367\313\344#\020\257\"\234\017\024[\353z\321\217W\371Ru1\016\026He!4 P\307\003:\325\352[:3\313*\264\r\227{\241uB_\317[\t\305\276\300\3461\346F+\220\n\270\250\035N\354\335[\347?\231\352k\250$#f\005\207b)Fm:\335\303T\216|\362\033\237I\017\323nx\256>\374\241\347\017\204\271\360S\306\270x\227_\347\r\327n\240\017u/hZ\2534Ms\020iNP\2035\001\211\251\003\270C\030|\367z\fBvW3p\'\217\200N\345\323\266\f\3250*\300s\213\244g\3041\262\225\324r\022!Cxz\'\262\220\330\273\207\235\242\363\320\200\255\\O\301\357\301\322M\321]\001\240\374KP\373\244\353w\351\204\311\025U\273t}\301^\tv^\267L/]\256\372K\213G*\026P\263y\311NI\307\233\030g\032\002l\303\241\3679\034\035X\213#\341[\020W6\373\363\367\002h\214\tj\023\256/\206\271\242P\336Xd^[\207?\371R\333\2269e\276\270\270U\325-\213]\365`r\254@\365+~g\241\226<\350n\026d\366x^f\277\371\355{\231\022O\262\201\340R\373\207\2358\310\215\367\0004\345\234Wg\347\361\bC\367+\v\300{s\377\240\211\217\302V\325a\232\352\311\200f\274a.\350\220\n\367\201-\263\243\352\031\254\346!k\351\252N\315\315\3464\325g\306[\004(V&\a\256F\227nQX\272\227\270\246\n\r\260\340W\214\274\213Z\245\023\261\'\254\302Q\226\374\225\335I\305s\350C\no\0333\356k\335\303@\260\0336\204\203r\317V\241z\f\345\005\202-\237%\302\032\320%\316\"\271\236\bk\372%\351\005\233\037;_\274\333\254\211\333:\252\314\225\360\245\2079>Mu4\353K\306QGm](\255;\3152\\;\033\213\214\205\277|\274BiK\324\216\362\376\001L]\314\212qM\f\245\343\204\211\330U\026\303m\t\004\302\373\327\321g\2002\200\341\257\201\016\351\016\342>\211\241\a\036\006\002}\"\003)\221g\177L\252P\033:+\004c\277\264\361xT*\201\277=\333sa\264\031\314\004\030w\374f\\\002G\004\202\332c\352\366\375oME2\245*+D\226\352/\366\374O\231\242\006\034\255\274\257t\320B?\002I\031p\030|\274B\246Kg\335\f$\032\003M\"u\023\272p\364/C\371\271\202c\206\221mN\214\350\220\217\366\202\350\031\267\357\033y:|Nz\332\233\224c*-\275JQ\205`\022ZMD\307\220[\024\026\003\f\221\302\226\366Y\001\315_\347\021\271<\261\356/\177\256.\2724\232\304;0,\217U\000422>\000\271\301\024\254\234?\224\265\362\221\004\263vK\212\204b\2458)\3361\335l2Q\244\230\3567\000\214\322.]F\357\373\322\336y\364\3248\003\356\346\330\254x./\370rlF\272d&\320\030t\314\336\304\331\350\256\363a\302\321\247\'E\223\263_\214c%\260\037\035\265oN:\353\335MmD\266\025pi\221\240\260\006\301=\243\207\n\247\311\221\331CO\376\272\254+\263\302\b\031\252\313X\260\366\206\254I.V\204n?\310\326z\244\255\357\362\257\025N\217\375\276\263\331\317\37696\350o\n\001+\375\366\314\255\334\316\265\215o\251|\353\016\016{\022\217\346\372iA\344\004\235\306\243\016F\a\204Z\270J\200\343\245:M\'R\315\311\345\253\024\207\225\233\377\255\347]\037\004\333\206:\277\252\324\233D\b\324!`]\274\200\242O\276\346\250\214;\204\214\270\372\343\247\373Fj\227\356G\241\341Cu,3.bOa\303\213\346$\"\001I\016\373\353\b(\244\274\257eP\304\230E-`yK\360\300\364Y\t\346\254\334T\343S\035\361\255\275\032\362\245\355R\311\236i\034\377\017\t\2617\3407Q\262~)>\230\017\267$\210\321\355\302\025dn\316&[q>#\345\025\353\3466\252\206\334c\253\254\313\363\354?\214\352H\34656\032<CX+\362O\362U\333\b\240\350o\243;M6\274\354\345T\220\036\241J|B\216\227\356\366\267\002\310O\254\307\313\203&\215\345\212\275^\267\317\3672\357\225U\232~y\364\341\372\237\201\336e\347\342\263\330\315\177rn.\3