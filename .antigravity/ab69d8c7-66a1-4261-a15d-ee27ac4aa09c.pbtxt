        replacement_chunks {
          target_content: "          <input\n            aria-label=\"Thanh tr\306\260\341\273\243t chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng 2\"\n            type=\"range\"\n            min={1.0}\n            max={3.8}\n            step={0.005}\n            value={n2}\n            onChange={(e) => onChangeMaterial2(\'custom\', Number(e.target.value))}\n            className=\"lab-slider w-full\"\n          />"
