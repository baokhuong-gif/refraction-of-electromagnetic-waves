            }
            lines {
              text: "  const wavelength2Nm = wavelengthVacuumNm / n2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const wavelengthRatio = n1 / n2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const waveNumber1 = (2 * Math.PI) / (wavelength1Nm * 1e-9);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const waveNumber2 = (2 * Math.PI) / (wavelength2Nm * 1e-9);"
