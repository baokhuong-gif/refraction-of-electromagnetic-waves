      thinking_signature: "\022\254\t\n\251\t\001i\024}\023\203\323F\267\305\266\f>\026\202\272l\324\371\241NB\244\'\030^g\344\244\"~ev\323\310mk\177\231\000\246t\322\371\211gr\363B\2722\001\t\315\220S\f\311\375\340\303\340\016t\352\315-\211n;K\3011\201\321\342-\002\363\321\262-\'\232\320H\224\003\316\317\303\264\035I\254\025\252h\032\372\367\340\334\235q\313\205Sn 68d\271\262QK\034\3709\351\213\331\b\305\374\v\27008\315\266\tB\264\207\301\266\254\214\360\233J\314\270\245\366FJ\031\204\246\300\372\255X\261}f\222u\356\233\a\372.\361^\340!\315\021\370j\326\315\003\006\265\036\327Vg1\320\'\r\243\242\2247\021$d\0021f\211\324\216=\"C\314\300\276\037\253y\215\261O\232\330\3261l>\n\312\350\277\323\237\225\313\022\033+.\273\205/\t\3306\236\311\350[\340\375 \200p\241f\366\302$\233q\315o\344\324\266z\001\271\277Xt;\350\btGzF\021\rO\353\000\271A\'\177%L\307\247|ru\225\nQkN\230e!\2329\037\275>f0\274\341\313G\260\251\305\213\353\265\317\325\337\220\360]2Q\224\301\316\341\262CXt7\246V%g\262\322\201\027P\267\234\003\255\341\225\300c+\217\006\225\032\313\254\3325)\005o\277\271\a\2354Kq\342-\213\344\335\265o\322v\v\327\370\265\373`-\027\026B\337\253\340h[\224\323$\241\2314\374\025\354\215i{m)g\330h\305`\300w\262\027-34C\n\037:\271\032\361Y$\321Ky$\205\200G\261\'\255\315\341I3>\001\217\256\223glFG\224\340\220},\325\264~\r#\223\234\v\342\321V\023\363;srwZ8\250\273\300\227\2406F\304\f\314\276\325W\352+\245N\265\333\230\375\204)\314\362\321\250\360?cJ\213\037J@]{\361\326\023\3762\226\006\334\356\277\242\322\222\225\343iQ\177T\331\366\025v\305\246\271\250\035\206\226\207u\260~\243G\210T\2267\367v\327\220\325\aR_\t\354\276\231\f\377#\215\376<4\016\376Ve\3522\016\250\031\271\035\265\255B\312@#\345\374\210\225\362\237\261\037}FV\305\353\310\253\034\020\005\213y\016\332\357\205\r1=S\\{\222?#\367z\256\371z\255;\320\327\217\225X\253\351\271\340\334X\311p\300\270\261\371S\"W\271\343\001\005\306\3508\244{\314\354\340\031{\357\"]\375\034\261<\264\026\255,\262S\234\367\242\021\017\233B,\223LO7\355