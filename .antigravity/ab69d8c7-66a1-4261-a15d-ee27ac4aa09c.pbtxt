      thinking_signature: "\022\223\r\n\220\r\001i\024}\0238\225\371\354\224\255\033P\b\340.qH!\354\v\237\206M\355lh\200\004\347D\342\227\243\275\241E\205\205\'@/\221\330\307f\336^\253]\023\265\332f\336(\237\022\325\231\321\366\356\355_\221\025Mq\223A\325\350\a\354k\362S,\273P\205\201^\230-4\002+\353\026\205A5c+\021\322\035\351~\206\377\351\354h\032\036\311\332\320\224?\200\377\272\232\002\374\232\226\305\302\332\366\024H\310w\376 \326\341e\243\341n\372\355\341\232sX\353\252`7\214\027\316G\267\034\017\\U\372\350\261P\034\341\024`j\251\a\353kr\025~\344IV\263\177\262|\357\304JOQ\032\002\350\351\204\n\ba$\300\243\317\030\246\265x\356\021\226B\3258,j\337?\320\313\206\302\310\347\360\367r^y\224\223\230ZS%e\033\\)uM\272nJ\000W\244\301\363J\036I1\274\241\225\354N\356L\vn4\310\217e\004\325@_Z\234\031\275\212\340\330\313K\312\210Oy\262M\324\207\304\237\353\234\233\343\264\240\303<\0239\037OVX\210\316\000\277\230\232\023z\270\"\301N\245\030\252;\0312;\t\362P\026\364\245\020-,Q}\v\354\324\234\fi\'Y7du\347\350\030\210\n\004\"\"\253\207U\330\244R\267\005\255\366i\211\324aC\221\227\227;r\210t\365\2223cz\200\017\265\265\356\271\245\324\314\240m\273\276\231}\253\360\002pl\340\313\214\345\345\365\366\f\336\306v\v\177\271S\367\371\005m\367o\374\261?\017\036\237\325\322\340\247\334q\354\347\263\231\0221e.6\312i\303\265./T\a\337fz\027\336\256\271\333\354?\225\323\233NA\254\022\216\232\377S}8z\037\205}\227\345f\367\264\212U\234\264-\366\315+\350\023R\v%\257\337iG\357\256\350\2174\2017[OT\224\337\234\311\337\371\357\022\301A\357~\335\316\vfJ\270\026t\251\372\305K\234p\266\003\347%\301\231\307\265zN/\331\211\357\346\267\257\374\264\337`\377\343\350\273\f\377\310\256\372`*y\343!!P7\252\001\201A7\346\300\236\217\362\0004\236\005\240c9\325\217\227\242\3124>\361*\227\301Q\0355U\363\210\323\v\313}\f\320D\277ox\206U\265\033\253\r\235A\031N\360\364a\006\353cH>\305I\234\201\225\311f\256\243\211V\243r\357P\300\321\204P2\364\003\031\214\375(\303*\030\241\034I\364V\254\264lC1\363;\006\356b1\214%g\37