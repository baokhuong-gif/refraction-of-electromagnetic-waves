              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      : exactPhysics.isTotalInternalReflection && prediction.predictedRefractedAngleDeg === null"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
