              text: "      length: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      lambdaPx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      phaseOffsetRad: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      amplitudeWeight: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
