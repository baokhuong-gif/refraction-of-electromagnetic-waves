              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const normZ = (y - cy) / (rect.height * 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
