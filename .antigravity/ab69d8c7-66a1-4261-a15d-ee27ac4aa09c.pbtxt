      create_file {
        instruction: "import React, { useEffect } from \'react\';\nimport { BookOpen, X } from \'lucide-react\';\nimport { AnimatePresence, motion, useReducedMotion } from \'motion/react\';\nimport { formatWavelength, WavePhysicsResult } from \'../physics/emPhysics\';\n\ninterface PhysicsFormulasModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  n1: number;\n  n2: number;\n  incidentAngleDeg: number;\n  wavelengthVacuumNm: number;\n  physics: WavePhysicsResult;\n}\n\ninterface FractionProps {\n  numerator: React.ReactNode;\n  denominator: React.ReactNode;\n}\n\nconst MathFraction: React.FC<FractionProps> = ({ numerator, denominator }) => (\n  <span className=\"inline-flex flex-col items-center align-middle mx-1 leading-tight\">\n    <span className=\"px-1.5 pb-0.5 border-b border-slate-500 text-center\">{numerator}</span>\n    <span className=\"px-1.5 pt-0.5 text-center\">{denominator}</span>\n  </span>\n);\n\nconst SYMBOL_GLOSSARY: Array<{ symbol: string; meaning: string }> = [\n  {\n    symbol: \'n\342\202\201, n\342\202\202\',\n    meaning: \'Chi\341\272\277t su\341\272\245t tuy\341\273\207t \304\221\341\273\221i c\341\273\247a m\303\264i tr\306\260\341\273\235ng t\341\273\233i (1) v\303\240 m\303\264i tr\306\260\341\273\235ng kh\303\272c x\341\272\241 (2), x\303\241c \304\221\341\273\213nh m\341\273\251c \304\221\341\273\231 l\303\240m ch\341\272\255m s\303\263ng (n = c / v).\',\n  },\n  {\n    symbol: \'\316\270i, \316\270r, \316\270t\',\n    meaning: \'G\303\263c t\341\273\233i, g\303\263c ph\341\272\243n x\341\272\241 (\316\270r = \316\270i) v\303\240 g\303\263c kh\303\272c x\341\272\241, \304\221\341\273\201u \304\221o gi\341\273\257a tia s\303\263ng v\303\240 \304\221\306\260\341\273\235ng ph\303\241p tuy\341\272\277n c\341\273\247a m\341\272\267t ph\303\242n c\303\241ch.\',\n  },\n  {\n    symbol: \'\316\224\316\270\',\n    meaning: \'\304\220\341\273\231 l\341\273\207ch h\306\260\341\273\233ng c\341\273\247a tia kh\303\272c x\341\272\241 so v\341\273\233i ph\306\260\306\241ng truy\341\273\201n ban \304\221\341\272\247u (\316\224\316\270 = |\316\270i \342\210\222 \316\270t|).\',\n  },\n  {\n    symbol: \'s (TE)\',\n    meaning: \'Ph\303\242n c\341\273\261c \304\221i\341\273\207n ngang (Transverse Electric): vect\306\241 c\306\260\341\273\235ng \304\221\341\273\231 \304\221i\341\273\207n tr\306\260\341\273\235ng E vu\303\264ng g\303\263c v\341\273\233i m\341\272\267t ph\341\272\263ng t\341\273\233i.\',\n  },\n  {\n    symbol: \'p (TM)\',\n    meaning: \'Ph\303\242n c\341\273\261c t\341\273\253 ngang (Transverse Magnetic): vect\306\241 \304\221i\341\273\207n tr\306\260\341\273\235ng E n\341\272\261m song song trong m\341\272\267t ph\341\272\263ng t\341\273\233i.\',\n  },\n  {\n    symbol: \'rs, rp\',\n    meaning: \'H\341\273\207 s\341\273\221 bi\303\252n \304\221\341\273\231 ph\341\272\243n x\341\272\241 Fresnel cho ph\303\242n c\341\273\261c s v\303\240 p (t\341\273\267 s\341\273\221 bi\303\252n \304\221\341\273\231 \304\221i\341\273\207n tr\306\260\341\273\235ng ph\341\272\243n x\341\272\241 tr\303\252n \304\221i\341\273\207n tr\306\260\341\273\235ng t\341\273\233i).\',\n  },\n  {\n    symbol: \'Rs, Rp\',\n    meaning: \'H\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 c\303\264ng su\341\272\245t (t\341\273\267 l\341\273\207 ph\341\272\247n tr\304\203m n\304\203ng l\306\260\341\273\243ng b\341\272\255t l\341\272\241i), t\303\255nh b\341\272\261ng b\303\254nh ph\306\260\306\241ng m\303\264-\304\221un |rs|\302\262 v\303\240 |rp|\302\262.\',\n  },\n  {\n    symbol: \'Ts, Tp\',\n    meaning: \'H\341\273\207 s\341\273\221 truy\341\273\201n qua c\303\264ng su\341\272\245t sang m\303\264i tr\306\260\341\273\235ng 2; theo b\341\272\243o to\303\240n n\304\203ng l\306\260\341\273\243ng lu\303\264n c\303\263 Rs + Ts = 1 v\303\240 Rp + Tp = 1.\',\n  },\n  {\n    symbol: \'\316\270c\',\n    meaning: \'G\303\263c t\341\273\233i h\341\272\241n ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (ch\341\273\211 c\303\263 khi n\342\202\201 > n\342\202\202). Khi \316\270i > \316\270c, to\303\240n b\341\273\231 n\304\203ng l\306\260\341\273\243ng ph\341\272\243n x\341\272\241 (R = 100%).\',\n  },\n  {\n    symbol: \'\316\270B\',\n    meaning: \'G\303\263c Brewster (g\303\263c ph\303\242n c\341\273\261c): t\341\272\241i \316\270i = \316\270B, s\303\263ng ph\341\272\243n x\341\272\241 th\303\240nh ph\341\272\247n TM b\341\273\213 tri\341\273\207t ti\303\252u ho\303\240n to\303\240n (Rp = 0%).\',\n  },\n  {\n    symbol: \'\316\273\342\202\200, \316\273\342\202\201, \316\273\342\202\202\',\n    meaning: \'B\306\260\341\273\233c s\303\263ng trong ch\303\242n kh\303\264ng (\316\273\342\202\200) v\303\240 b\306\260\341\273\233c s\303\263ng n\341\273\231i m\303\264i trong m\303\264i tr\306\260\341\273\235ng 1, 2 (\316\273 = \316\273\342\202\200 / n).\',\n  },\n  {\n    symbol: \'v, c\',\n    meaning: \'V\341\272\255n t\341\273\221c pha trong m\303\264i tr\306\260\341\273\235ng (v = c / n) v\303\240 v\341\272\255n t\341\273\221c \303\241nh s\303\241ng trong ch\303\242n kh\303\264ng (c \342\211\210 2.998\303\22710\342\201\270 m/s).\',\n  },\n  {\n    symbol: \'\316\265r, \316\274r\',\n    meaning: \'H\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i t\306\260\306\241ng \304\221\341\273\221i (\316\265r = n\302\262 khi \316\274r = 1) v\303\240 \304\221\341\273\231 t\341\273\253 th\341\272\251m t\306\260\306\241ng \304\221\341\273\221i c\341\273\247a m\303\264i tr\306\260\341\273\235ng.\',\n  },\n  {\n    symbol: \'Z, Z\342\202\200\',\n    meaning: \'Tr\341\273\237 kh\303\241ng s\303\263ng n\341\273\231i t\341\272\241i c\341\273\247a m\303\264i tr\306\260\341\273\235ng (Z = Z\342\202\200 / n) v\303\240 tr\341\273\237 kh\303\241ng ch\303\242n kh\303\264ng (Z\342\202\200 \342\211\210 376.73 \316\251).\',\n  },\n  {\n    symbol: \'d\',\n    meaning: \'\304\220\341\273\231 s\303\242u xuy\303\252n th\341\272\245u c\341\273\247a s\303\263ng suy gi\341\272\243m b\341\273\201 m\341\272\267t (evanescent wave) v\303\240o m\303\264i tr\306\260\341\273\235ng 2 khi x\341\272\243y ra ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n.\',\n  },\n  {\n    symbol: \'\316\224\317\206\',\n    meaning: \'\304\220\341\273\231 d\341\273\213ch pha c\341\273\247a s\303\263ng ph\341\272\243n x\341\272\241 so v\341\273\233i s\303\263ng t\341\273\233i (v\303\255 d\341\273\245 180\302\260 khi s\303\263ng \304\221\341\272\243o pha t\341\272\241i bi\303\252n chi\341\272\277t quang t\304\203ng).\',\n  },\n];\n\nexport const PhysicsFormulasModal: React.FC<PhysicsFormulasModalProps> = ({\n  isOpen,\n  onClose,\n  n1,\n  n2,\n  incidentAngleDeg,\n  wavelengthVacuumNm,\n  physics,\n}) => {\n  const prefersReducedMotion = useReducedMotion();\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    const handleKeyDown = (event: KeyboardEvent) => {\n      if (event.key === \'Escape\') {\n        onClose();\n      }\n    };\n\n    const previousOverflow = document.body.style.overflow;\n    document.body.style.overflow = \'hidden\';\n    window.addEventListener(\'keydown\', handleKeyDown);\n\n    return () => {\n      document.body.style.overflow = previousOverflow;\n      window.removeEventListener(\'keydown\', handleKeyDown);\n    };\n  }, [isOpen, onClose]);\n\n  return (\n    <AnimatePresence>\n      {isOpen && (\n        <motion.div\n          key=\"formulas-backdrop\"\n          data-testid=\"formulas-modal-backdrop\"\n          initial={prefersReducedMotion ? { opacity: 1 } : { opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0 }}\n          transition={{ duration: 0.16 }}\n          onClick={onClose}\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-950/55 backdrop-blur-xs\"\n        >\n          <motion.div\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby=\"formulas-modal-title\"\n            data-testid=\"formulas-modal\"\n            initial={prefersReducedMotion ? { opacity: 1 } : { opacity: 0, y: 12, scale: 0.985 }}\n            animate={{ opacity: 1, y: 0, scale: 1 }}\n            exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0, y: 8, scale: 0.99 }}\n            transition={{ duration: 0.18, ease: [0.16, 1, 0.3, 1] }}\n            onClick={(e) => e.stopPropagation()}\n            className=\"w-full max-w-3xl max-h-[88vh] bg-white border border-slate-200 rounded-2xl shadow-2xl flex flex-col overflow-hidden\"\n          >\n            {/* Modal Header */}\n            <div className=\"px-5 sm:px-6 py-4 border-b border-slate-200 flex items-start justify-between gap-4 shrink-0 bg-white\">\n              <div className=\"flex items-start gap-3 min-w-0\">\n                <div className=\"mt-0.5 p-2 rounded-lg bg-sky-50 border border-sky-200 text-sky-700 shrink-0\">\n                  <BookOpen className=\"w-4 h-4\" aria-hidden=\"true\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <h2\n                    id=\"formulas-modal-title\"\n                    className=\"font-display text-lg sm:text-xl font-bold text-slate-950 tracking-[-0.015em]\"\n                  >\n                    H\341\273\207 c\303\264ng th\341\273\251c v\341\272\255t l\303\275 m\303\264 ph\341\273\217ng kh\303\272c x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253\n                  </h2>\n                  <p className=\"text-[13px] text-slate-600 mt-0.5 leading-relaxed\">\n                    \304\220\341\273\213nh lu\341\272\255t Snell, ph\306\260\306\241ng tr\303\254nh ph\341\272\243n x\341\272\241 Fresnel cho ph\303\242n c\341\273\261c s (TE) v\303\240 p (TM) c\303\271ng ch\303\272 gi\341\272\243i t\341\273\253ng k\303\275 hi\341\273\207u.\n                  </p>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={onClose}\n                aria-label=\"\304\220\303\263ng b\341\272\243ng c\303\264ng th\341\273\251c\"\n                data-testid=\"close-formulas-modal-btn\"\n                className=\"p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors shrink-0 cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Scrollable Body */}\n            <div className=\"overflow-y-auto px-5 sm:px-6 py-5 space-y-6\">\n              {/* Active Lab Live Context Strip */}\n              <div className=\"bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 text-xs\">\n                <span className=\"font-medium text-slate-700\">Tr\341\272\241ng th\303\241i m\303\264 ph\341\273\217ng hi\341\273\207n t\341\272\241i:</span>\n                <span className=\"font-mono text-slate-800 tabular-nums\">\n                  n\342\202\201 = {n1.toFixed(3)} \302\267 n\342\202\202 = {n2.toFixed(3)} \302\267 \316\270i = {incidentAngleDeg.toFixed(1)}\302\260 \342\206\222{\' \'}\n                  {physics.isTotalInternalReflection\n                    ? \'TIR (R = 100%)\'\n                    : `\316\270t = ${physics.refractedAngleDeg!.toFixed(2)}\302\260`}\n                </span>\n              </div>\n\n              {/* Section 1: Snell\'s Law */}\n              <section className=\"space-y-3\">\n                <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                  1. \304\220\341\273\213nh lu\341\272\255t kh\303\272c x\341\272\241 Snell & \304\220\341\273\231 l\341\273\207ch tia\n                </h3>\n                <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3\">\n                  <div className=\"flex flex-wrap items-center justify-between gap-3\">\n                    <div className=\"font-mono text-base sm:text-lg font-semibold text-slate-950 tracking-tight\">\n                      n\342\202\201 \302\267 sin(\316\270i) = n\342\202\202 \302\267 sin(\316\270t)\n                    </div>\n                    <div className=\"font-mono text-xs text-sky-800 tabular-nums\">\n                      {physics.isTotalInternalReflection\n                        ? `n\342\202\201 sin(\316\270i) = ${(n1 * Math.sin((incidentAngleDeg * Math.PI) / 180)).toFixed(3)} > n\342\202\202 \342\206\222 Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n`\n                        : `\316\270t = ${physics.refractedAngleDeg!.toFixed(2)}\302\260 \302\267 \316\224\316\270 = ${physics.deviationAngleDeg!.toFixed(2)}\302\260`}\n                    </div>\n                  </div>\n                  <div className=\"pt-2.5 border-t border-slate-200/80 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[13px] text-slate-800\">\n                    <div className=\"flex items-center\">\n                      <span>\316\270t = arcsin</span>\n                      <span className=\"mx-0.5\">(</span>\n                      <MathFraction numerator=\"n\342\202\201\" denominator=\"n\342\202\202\" />\n                      <span>\302\267 sin \316\270i )</span>\n                    </div>\n                    <div>\316\224\316\270 = |\316\270i \342\210\222 \316\270t|</div>\n                    <div>\316\270r = \316\270i</div>\n                  </div>\n                </div>\n              </section>\n\n              {/* Section 2: Fresnel Equations (s & p polarization) */}\n              <section className=\"space-y-3\">\n                <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                  2. Ph\306\260\306\241ng tr\303\254nh ph\341\272\243n x\341\272\241 & truy\341\273\201n qua Fresnel (ph\303\242n c\341\273\261c s v\303\240 p)\n                </h3>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {/* s-polarization (TE) */}\n                  <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3\">\n                    <div className=\"flex items-baseline justify-between gap-2\">\n                      <span className=\"font-display text-sm font-semibold text-slate-900\">\n                        Ph\303\242n c\341\273\261c s \342\200\224 TE (vu\303\264ng g\303\263c)\n                      </span>\n                      <span className=\"font-mono text-xs font-semibold text-sky-700 tabular-nums\">\n                        Rs = {(physics.reflectanceS * 100).toFixed(2)}%\n                      </span>\n                    </div>\n\n                    <div className=\"py-1 font-mono text-[13px] text-slate-950 overflow-x-auto\">\n                      <div className=\"inline-flex items-center whitespace-nowrap\">\n                        <span className=\"font-semibold\">rs =</span>\n                        <MathFraction\n                          numerator=\"n\342\202\201 cos \316\270i \342\210\222 n\342\202\202 cos \316\270t\"\n                          denominator=\"n\342\202\201 cos \316\270i + n\342\202\202 cos \316\270t\"\n                        />\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-slate-200/80 flex items-center justify-between text-xs font-mono text-slate-700 tabular-nums\">\n                      <span>Rs = |rs|\302\262</span>\n                      <span>Ts = 1 \342\210\222 Rs = {(physics.transmittanceS * 100).toFixed(2)}%</span>\n                    </div>\n                  </div>\n\n                  {/* p-polarization (TM) */}\n                  <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3\">\n                    <div className=\"flex items-baseline justify-between gap-2\">\n                      <span className=\"font-display text-sm font-semibold text-slate-900\">\n                        Ph\303\242n c\341\273\261c p \342\200\224 TM (song song)\n                      </span>\n                      <span className=\"font-mono text-xs font-semibold text-indigo-700 tabular-nums\">\n                        Rp = {(physics.reflectanceP * 100).toFixed(2)}%\n                      </span>\n                    </div>\n\n                    <div className=\"py-1 font-mono text-[13px] text-slate-950 overflow-x-auto\">\n                      <div className=\"inline-flex items-center whitespace-nowrap\">\n                        <span className=\"font-semibold\">rp =</span>\n                        <MathFraction\n                          numerator=\"n\342\202\202 cos \316\270i \342\210\222 n\342\202\201 cos \316\270t\"\n                          denominator=\"n\342\202\202 cos \316\270i + n\342\202\201 cos \316\270t\"\n                        />\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-slate-200/80 flex items-center justify-between text-xs font-mono text-slate-700 tabular-nums\">\n                      <span>Rp = |rp|\302\262</span>\n                      <span>Tp = 1 \342\210\222 Rp = {(physics.transmittanceP * 100).toFixed(2)}%</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Unpolarized & Normal Incidence Summary */}\n                <div className=\"bg-white border border-slate-200 rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[13px] font-mono text-slate-800\">\n                  <div className=\"inline-flex items-center\">\n                    <span>R_t\341\273\261 nhi\303\252n =</span>\n                    <MathFraction numerator=\"Rs + Rp\" denominator=\"2\" />\n                  </div>\n                  <div>R + T = 100%</div>\n                  <div className=\"inline-flex items-center\">\n                    <span>R\342\202\200 (\316\270i = 0\302\260) =</span>\n                    <span className=\"mx-0.5\">(</span>\n                    <MathFraction numerator=\"n\342\202\201 \342\210\222 n\342\202\202\" denominator=\"n\342\202\201 + n\342\202\202\" />\n                    <span>)\302\262</span>\n                  </div>\n                </div>\n              </section>\n\n              {/* Section 3: Critical Angle, Brewster Angle & Evanescent Wave */}\n              <section className=\"space-y-3\">\n                <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                  3. G\303\263c \304\221\341\272\267c bi\341\273\207t & Th\303\264ng s\341\273\221 truy\341\273\201n s\303\263ng \304\221i\341\273\207n m\303\264i (\316\274r = 1)\n                </h3>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2.5 text-[13px]\">\n                    <div className=\"font-mono text-slate-900 flex items-center flex-wrap gap-y-1\">\n                      <span className=\"font-semibold\">G\303\263c t\341\273\233i h\341\272\241n (n\342\202\201 &gt; n\342\202\202):</span>\n                      <span className=\"ml-2 inline-flex items-center\">\n                        sin \316\270c = <MathFraction numerator=\"n\342\202\202\" denominator=\"n\342\202\201\" />\n                      </span>\n                    </div>\n                    <div className=\"font-mono text-slate-900 flex items-center flex-wrap gap-y-1\">\n                      <span className=\"font-semibold\">G\303\263c Brewster (Rp = 0):</span>\n                      <span className=\"ml-2 inline-flex items-center\">\n                        tan \316\270B = <MathFraction numerator=\"n\342\202\202\" denominator=\"n\342\202\201\" />\n                      </span>\n                    </div>\n                    <div className=\"pt-1.5 border-t border-slate-200/80 font-mono text-xs text-slate-600 tabular-nums\">\n                      Hi\341\273\207n t\341\272\241i: \316\270B = {physics.brewsterAngleDeg.toFixed(2)}\302\260 \302\267{\' \'}\n                      {physics.criticalAngleDeg !== null\n                        ? `\316\270c = ${physics.criticalAngleDeg.toFixed(2)}\302\260`\n                        : \'Kh\303\264ng c\303\263 \316\270c (n\342\202\202 \342\211\245 n\342\202\201)\'}\n                    </div>\n                  </div>\n\n                  <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2.5 text-[13px]\">\n                    <div className=\"font-mono text-slate-900 flex flex-wrap gap-x-4 gap-y-1\">\n                      <span>v = c / n</span>\n                      <span>\316\273 = \316\273\342\202\200 / n</span>\n                      <span>\316\265r = n\302\262</span>\n                      <span>Z = Z\342\202\200 / n</span>\n                    </div>\n                    <div className=\"font-mono text-slate-900 flex items-center flex-wrap gap-y-1\">\n                      <span className=\"font-semibold\">S\303\263ng suy gi\341\272\243m (TIR):</span>\n                      <span className=\"ml-1.5 inline-flex items-center text-xs\">\n                        d = <MathFraction numerator=\"\316\273\342\202\200\" denominator=\"2\317\200 \342\210\232(n\342\202\201\302\262 sin\302\262\316\270i \342\210\222 n\342\202\202\302\262)\" />\n                      </span>\n                    </div>\n                    <div className=\"pt-1.5 border-t border-slate-200/80 font-mono text-xs text-slate-600 tabular-nums\">\n                      \316\273\342\202\200 = {formatWavelength(wavelengthVacuumNm)} \342\206\222 \316\273\342\202\202 ={\' \'}\n                      {formatWavelength(physics.wavelength2Nm)}\n                    </div>\n                  </div>\n                </div>\n              </section>\n\n              {/* Section 4: Detailed Symbol Glossary */}\n              <section className=\"space-y-3\">\n                <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                  4. Gi\341\272\243i th\303\255ch chi ti\341\272\277t c\303\241c k\303\275 hi\341\273\207u\n                </h3>\n                <dl className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 border-t border-slate-200 pt-3\">\n                  {SYMBOL_GLOSSARY.map((item) => (\n                    <div\n                      key={item.symbol}\n                      className=\"grid grid-cols-[74px_minmax(0,1fr)] gap-2.5 items-baseline py-1 border-b border-slate-100\"\n                    >\n                      <dt className=\"font-mono text-xs font-semibold text-sky-800 whitespace-nowrap\">\n                        {item.symbol}\n                      </dt>\n                      <dd className=\"text-xs text-slate-600 leading-relaxed\">{item.meaning}</dd>\n                    </div>\n                  ))}\n                </dl>\n              </section>\n            </div>\n\n            {/* Footer */}\n            <div className=\"px-5 sm:px-6 py-3.5 border-t border-slate-200 bg-slate-50 flex flex-wrap items-center justify-between gap-3 shrink-0\">\n              <span className=\"text-xs text-slate-500\">\n                \303\201p d\341\273\245ng cho m\341\272\267t ph\303\242n c\303\241ch ph\341\272\263ng gi\341\273\257a hai m\303\264i tr\306\260\341\273\235ng \304\221i\341\273\207n m\303\264i \304\221\341\272\263ng h\306\260\341\273\233ng, kh\303\264ng t\341\273\225n hao (\316\274r = 1).\n              </span>\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"px-4 py-2 text-[13px] font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors cursor-pointer\"\n              >\n                \304\220\303\263ng\n              </button>\n            </div>\n          </motion.div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n};\n"
