            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const xOfAngle = (deg: number) => padL + (clamp(deg, 0, 90) / 90) * plotW;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const yOfRatio = (r: number) => padT + (1 - clamp(r, 0, 1)) * plotH;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const yOfPhase = (deg: number) => padT + (1 - clamp(deg, 0, 180) / 180) * plotH;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const buildPath = (accessor: (pt: (typeof curve)[number]) => number, isPhase = false) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return curve"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .map((pt, i) => {"
