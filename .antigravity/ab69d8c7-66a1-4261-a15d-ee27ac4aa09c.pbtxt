}\\n          </nav>\\n\\n          {/* Zone 3: Auth action + Primary CTA */}\\n          <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n            {user ? (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void signOutUser()}\\n                title={user.email ?? \'\304\220\304\203ng xu\341\272\245t\'}\\n                className=\\\"hidden sm:inline-flex items-center gap-1.5 px-2.5 py-2 text-xs font-medium text-slate-700 hover:text-slate-900 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n              >\\n                <LogOut className=\\\"w-3.5 h-3.5\\\" />\\n                <span className=\\\"max-w-[100px] truncate\\\">\\n                  {user.displayName?.split(\' \')[0] || \'T\303\240i kho\341\272\243n\'}\\n                </span>\\n              </button>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void signInWithGoogle()}\\n                className=\\\"hidden sm:inline-flex items-center gap-1.5 px-2.5 py-2 text-xs font-medium text-slate-700 hover:text-slate-900 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n              >\\n                <LogIn className=\\\"w-3.5 h-3.5\\\" />\\n                \304\220\304\203ng nh\341\272\255p\\n              </button>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void handleRecordMeasurement()}\\n              className=\\\"px-3.5 py-2 text-xs font-semibold text-white bg-sky-700 hover:bg-sky-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n            >\\n              Ghi nh\341\272\255n ph\303\251p \304\221o\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Subtle inline feedback strip when recording a measurement, applying search N2, or exporting PDF */}\\n      {statusBanner && (\\n        <div\\n          role=\\\"status\\\"\\n          aria-live=\\\"polite\\\"\\n          data-testid=\\\"status-banner\\\"\\n          className=\\\"bg-emerald-50 border-b border-emerald-200 text-emerald-900 text-xs px-6 py-2\\\"\\n        >\\n          <div className=\\\"max-w-[1440px] mx-auto flex items-center justify-between gap-4\\\">\\n            <span>\342\227\217 {statusBanner.text}</span>\\n            {statusBanner.showLogLink && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(\'LOG\')}\\n                className=\\\"font-semibold underline hover:text-emerald-700 cursor-pointer whitespace-nowrap\\\"\\n              >\\n                Xem b\341\272\243ng ph\303\251p \304\221o\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Non-sticky mobile navigation tabs */}\\n      <div className=\\\"md:hidden px-4 pt-3 bg-slate-50\\\">\\n        <nav\\n          aria-label=\\\"\304\220i\341\273\201u h\306\260\341\273\233ng di \304\221\341\273\231ng\\\"\\n          className=\\\"grid grid-cols-5 gap-1 p-1 bg-slate-200/70 rounded-lg\\\"\\n        >\\n          {navItems.map((item) => (\\n            <button\\n              key={item.id}\\n              type=\\\"button\\\"\\n              aria-current={activeTab === item.id ? \'page\' : undefined}\\n              onClick={() => setActiveTab(item.id)}\\n              className={`py-2 px-1 text-[11px] font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                activeTab === item.id ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-600\'\\n              }`}\\n            >\\n              {item.mobileLabel}\\n            </button>\\n          ))}\\n        </nav>\\n      </div>\\n\\n      {/* Full-bleed 3D Optical Lab Viewport */}\\n      {activeTab === \'LAB_3D\' ?