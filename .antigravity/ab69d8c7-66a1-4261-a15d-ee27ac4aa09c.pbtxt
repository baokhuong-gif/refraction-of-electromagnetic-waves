            }
            lines {
              text: "    abbeNumber: 25.8,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    notes: \'Chi\341\272\277t su\341\272\245t v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c cao, d\303\271ng cho quang h\341\273\215c t\303\241ch ph\341\273\225.\',"
