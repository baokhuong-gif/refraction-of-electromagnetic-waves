lX = box.x + box.width - 30;    const n2StartY = box.y + box.height * 0.78;    const n2EndY = box.y + box.height * 0.62;    await page.mouse.move(railX, n2StartY);    await page.mouse.down();    await page.mouse.move(railX, n2EndY, { steps: 6 });    await page.mouse.up();    await page.waitForTimeout(200);    const n2AfterDrag = await page.getByLabel(\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng 2\").inputValue();    // Drag incident ray in Medium 1 to change incident angle    const incX = box.x + box.width * 0.34;    const incY = box.y + box.height * 0.22;    await page.mouse.move(incX, incY);    await page.mouse.down();    await page.mouse.move(box.x + box.width * 0.25, box.y + box.height * 0.32, { steps: 6 });    await page.mouse.up();    await page.waitForTimeout(200);    const angleAfterDrag = await page.getByLabel(\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p g\303\263c t\341\273\233i theo \304\221\341\273\231\").inputValue();    console.log(\"CANVAS_DRAG_CHECK:\", { n2AfterDrag, angleAfterDrag });    // 4. Test real PDF report download    const downloadPromise = page.waitForEvent(\"download\");    await page.getByRole(\"button\", { name: \"Xu\341\272\245t b\303\241o c\303\241o PDF\" }).click();    const download = await downloadPromise;    const suggestedName = download.suggestedFilename();    const savedPath = await download.path();    console.log(\"PDF_DOWNLOAD_CHECK:\", { suggestedName, hasFile: Boolean(savedPath) });    // 5. Capture refined TIR screenshot + verify Fresnel chart below    await page.getByRole(\"button\", { name: \"Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\" }).click();    await page.waitForTimeout(400);    await page.screenshot({ path: \".playwright-cli/r2-tir.png\" });    // 6. Verify mobile viewport reflow (390x844)    await page.setViewportSize({ width: 390, height: 844 });    await page.waitForTimeout(400);    const mobileOverflowX = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);    console.log(\"MOBILE_OVERFLOW_X:\", mobileOverflowX);    await page.screenshot({ path: \".playwright-cli/r2-mobile.png\" });  })(page);```### Events- Downloading file EMRefract-Bao-cao-Khuc-xa-20261125-1216.pdf ...- Downloaded file EMRefract-Bao-cao-Khuc-xa-20261125-1216.pdf to \".playwright-cli/EMRefract-Bao-cao-Khuc-xa-20261125-1216.pdf\"### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 1 messages for level \"info\"[INFO] %cDownload the React DevTools for a better development experience: https://react.dev/link/react-devtools font-weight:bold @ http://localhost:3000/node_modules/.vite/deps/react-dom_client.js?v=2529af69:15802Browser \'default\' closed"
