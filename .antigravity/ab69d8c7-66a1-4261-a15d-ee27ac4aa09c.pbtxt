          target_content: "      drawHaloText(\n        ctx,\n        \'Ph\303\241p tuy\341\272\277n (N)\',\n        cx + 8,\n        24,\n        \'#64748b\',\n        \'500 11px \"Plus Jakarta Sans\", sans-serif\',\n        \'left\'\n      );"
          replacement_content: "      if (width >= 520) {\n        drawHaloText(\n          ctx,\n          \'Ph\303\241p tuy\341\272\277n (N)\',\n          cx + 8,\n          24,\n          \'#64748b\',\n          \'500 11px \"Plus Jakarta Sans\", sans-serif\',\n          \'left\'\n        );\n      }"
