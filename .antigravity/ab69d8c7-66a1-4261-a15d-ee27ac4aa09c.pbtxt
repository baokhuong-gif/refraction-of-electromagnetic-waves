              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return { line, attr, mat, geo };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const incWaveTE = createWaveLine(0x16a34a);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const incWaveTM = createWaveLine(0x0284c7);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const refWave = createWaveLine(0xe11d48);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const transWave = createWaveLine(0x059669);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const evanescentWave = createWaveLine(0xd97706);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Instanced Photonic Wavefront Nodes along all 3 rays (InstancedMesh, frustumCulled = false)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const photonGeo = new THREE.SphereGeometry(0.055, 10, 10);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const photonMat = new THREE.MeshStandardMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      color: 0xffffff,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      emissive: 0xffffff,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      emissiveIntensity: 0.7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      roughness: 0.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      metalness: 0.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const photonMesh = new THREE.InstancedMesh(photonGeo, photonMat, TOTAL_PHOTONS);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    photonMesh.frustumCulled = false;"
