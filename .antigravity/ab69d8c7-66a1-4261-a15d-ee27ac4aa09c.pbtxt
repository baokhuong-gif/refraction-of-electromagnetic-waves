            }
            lines {
              text: "      // Update Instanced Photonic Wavefront Nodes along incident, reflected, refracted rays"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const v1Speed = 1 / p.n1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const v2Speed = 1 / p.n2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _quat.identity();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let idx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 1. Incident wavefront nodes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _color.set(waveHex);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < PHOTON_COUNT_PER_BEAM; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const frac = (i / PHOTON_COUNT_PER_BEAM + (phase * 0.055 * v1Speed)) % 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const dist = frac * BEAM_RADIUS_LEN;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _pos.set(startX + vecs.incDirX * dist, beamY, startZ + vecs.incDirZ * dist);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
