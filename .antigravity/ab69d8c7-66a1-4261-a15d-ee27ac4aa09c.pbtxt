  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useMemo, useRef, useState } from \'react\';\nimport {\n  clamp,\n  formatWavelength,\n  generateFresnelCurve,\n  WavePhysicsResult,\n} from \'../physics/emPhysics\';\nimport { PolarizationMode } from \'../physics/materials\';\n\ninterface FresnelChartProps {\n  physics: WavePhysicsResult;\n  polarization: PolarizationMode;\n  wavelengthVacuumNm: number;\n  material1Label: string;\n  material2Label: string;\n  onSelectAngle: (angleDeg: number) => void;\n}\n\ntype ChartMode = \'POWER\' | \'PHASE\';\n\nexport const FresnelChart: React.FC<FresnelChartProps> = ({\n  physics,\n  polarization,\n  wavelengthVacuumNm,\n  material1Label,\n  material2Label,\n  onSelectAngle,\n}) => {\n  const [chartMode, setChartMode] = useState<ChartMode>(\'POWER\');\n  const svgRef = useRef<SVGSVGElement | null>(null);\n  const [isScrubbing, setIsScrubbing] = useState(false);\n\n  const curve = useMemo(\n    () =>\n      generateFresnelCurve(\n        physics.n1,\n        physics.n2,\n        polarization,\n        wavelengthVacuumNm,\n        1\n      ),\n    [physics.n1, physics.n2, polarization, wavelengthVacuumNm]\n  );\n\n  // SVG layout coordinates\n  const W = 560;\n  const H = 230;\n  const padL = 44;\n  const padR = 16;\n  const padT = 16;\n  const padB = 34;\n  const plotW = W - padL - padR;\n  const plotH = H - padT - padB;\n\n  const xOfAngle = (deg: number) => padL + (clamp(deg, 0, 90) / 90) * plotW;\n  const yOfRatio = (r: number) => padT + (1 - clamp(r, 0, 1)) * plotH;\n  const yOfPhase = (deg: number) => padT + (1 - clamp(deg, 0, 180) / 180) * plotH;\n\n  const buildPath = (accessor: (pt: (typeof curve)[number]) => number, isPhase = false) => {\n    return curve\n      .map((pt, i) => {\n        const x = xOfAngle(pt.angleDeg);\n        const y = isPhase ? yOfPhase(accessor(pt)) : yOfRatio(accessor(pt));\n        return `${i === 0 ? \'M\' : \'L\'}${x.toFixed(1)},${y.toFixed(1)}`;\n      })\n      .join(\' \');\n  };\n\n  const pathRs = useMemo(() => buildPath((pt) => pt.Rs, false), [curve]);\n  const pathRp = useMemo(() => buildPath((pt) => pt.Rp, false), [curve]);\n  const pathTeff = useMemo(() => buildPath((pt) => pt.Teff, false), [curve]);\n  const pathPhaseS = useMemo(() => buildPath((pt) => pt.phaseS, true), [curve]);\n  const pathPhaseP = useMemo(() => buildPath((pt) => pt.phaseP, true), [curve]);\n\n  const updateAngleFromSvgPointer = (clientX: number) => {\n    const svg = svgRef.current;\n    if (!svg) return;\n    const rect = svg.getBoundingClientRect();\n    const relX = ((clientX - rect.left) / rect.width) * W;\n    const angle = ((relX - padL) / plotW) * 90;\n    onSelectAngle(Math.round(clamp(angle, 0, 89.5) * 10) / 10);\n  };\n\n  const cursorX = xOfAngle(physics.incidentAngleDeg);\n  const brewsterX = xOfAngle(physics.brewsterAngleDeg);\n  const criticalX =\n    physics.criticalAngleDeg !== null ? xOfAngle(physics.criticalAngleDeg) : null;\n\n  return (\n    <section\n      aria-label=\"\304\220\341\273\223 th\341\273\213 \304\221\341\272\267c tr\306\260ng Fresnel v\303\240 b\341\272\243ng th\303\264ng s\341\273\221 \304\221i\341\273\207n t\341\273\253\"\n      className=\"grid grid-cols-1 xl:grid-cols-12 gap-5\"\n    >\n      {/* Interactive Fresnel Chart */}\n      <div className=\"xl:col-span-7 bg-white border border-slate-200 rounded-xl p-5 flex flex-col justify-between\">\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mb-3\">\n          <div>\n            <h3 className=\"text-sm font-semibold text-slate-900\">\n              \304\220\306\260\341\273\235ng cong \304\221\341\272\267c t\303\255nh Fresnel theo g\303\263c t\341\273\233i \316\270i\n            </h3>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Nh\341\272\245p ho\341\272\267c k\303\251o tr\303\252n \304\221\341\273\223 th\341\273\213 \304\221\341\273\203 qu\303\251t nhanh g\303\263c t\341\273\233i \316\270i\n            </p>\n          </div>\n\n          <div\n            role=\"group\"\n            aria-label=\"Ch\341\272\277 \304\221\341\273\231 \304\221\341\273\223 th\341\273\213 Fresnel\"\n            className=\"flex items-center gap-1 bg-slate-100 p-1 rounded-lg\"\n          >\n            <button\n              type=\"button\"\n              aria-pressed={chartMode === \'POWER\'}\n              onClick={() => setChartMode(\'POWER\')}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\n                chartMode === \'POWER\'\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              C\303\264ng su\341\272\245t (R, T)\n            </button>\n            <button\n              type=\"button\"\n              aria-pressed={chartMode === \'PHASE\'}\n              onClick={() => setChartMode(\'PHASE\')}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\n                chartMode === \'PHASE\'\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              D\341\273\213ch pha (\316\224\317\206)\n            </button>\n          </div>\n        </div>\n\n        {/* SVG Plot */}\n        <svg\n          ref={svgRef}\n          viewBox={`0 0 ${W} ${H}`}\n          className=\"w-full h-auto select-none cursor-crosshair\"\n          role=\"img\"\n          aria-label=\"\304\220\341\273\223 th\341\273\213 ph\306\260\306\241ng tr\303\254nh Fresnel theo g\303\263c t\341\273\233i t\341\273\253 0 \304\221\341\272\277n 90 \304\221\341\273\231\"\n          onPointerDown={(e) => {\n            setIsScrubbing(true);\n            e.currentTarget.setPointerCapture(e.pointerId);\n            updateAngleFromSvgPointer(e.clientX);\n          }}\n          onPointerMove={(e) => {\n            if (isScrubbing) updateAngleFromSvgPointer(e.clientX);\n          }}\n          onPointerUp={(e) => {\n            setIsScrubbing(false);\n            if (e.currentTarget.hasPointerCapture(e.pointerId)) {\n              e.currentTarget.releasePointerCapture(e.pointerId);\n            }\n          }}\n        >\n          {/* Grid lines Y */}\n          {(chartMode === \'POWER\' ? [0, 0.25, 0.5, 0.75, 1] : [0, 45, 90, 135, 180]).map(\n            (tick) => {\n              const y = chartMode === \'POWER\' ? yOfRatio(tick) : yOfPhase(tick);\n              return (\n                <g key={tick}>\n                  <line\n                    x1={padL}\n                    y1={y}\n                    x2={W - padR}\n                    y2={y}\n                    stroke=\"#e2e8f0\"\n                    strokeWidth={1}\n                  />\n                  <text\n                    x={padL - 8}\n                    y={y + 3.5}\n                    textAnchor=\"end\"\n                    className=\"fill-slate-400 text-[10px] font-mono\"\n                  >\n                    {chartMode === \'POWER\' ? `${Math.round(tick * 100)}%` : `${tick}\302\260`}\n                  </text>\n                </g>\n              );\n            }\n          )}\n\n          {/* Grid lines X */}\n          {[0, 15, 30, 45, 60, 75, 90].map((deg) => {\n            const x = xOfAngle(deg);\n            return (\n              <g key={deg}>\n                <line\n                  x1={x}\n                  y1={padT}\n                  x2={x}\n                  y2={H - padB}\n                  stroke=\"#f1f5f9\"\n                  strokeWidth={1}\n                />\n                <text\n                  x={x}\n                  y={H - padB + 15}\n                  textAnchor=\"middle\"\n                  className=\"fill-slate-500 text-[10px] font-mono\"\n                >\n                  {deg}\302\260\n                </text>\n              </g>\n            );\n          })}\n\n          {/* Axes border */}\n          <line x1={padL} y1={padT} x2={padL} y2={H - padB} stroke=\"#94a3b8\" strokeWidth={1.2} />\n          <line\n            x1={padL}\n            y1={H - padB}\n            x2={W - padR}\n            y2={H - padB}\n            stroke=\"#94a3b8\"\n            strokeWidth={1.2}\n          />\n\n          {/* Brewster angle reference line */}\n          {Math.abs(physics.n1 - physics.n2) > 0.005 && (\n            <g>\n              <line\n                x1={brewsterX}\n                y1={padT}\n                x2={brewsterX}\n                y2={H - padB}\n                stroke=\"#d97706\"\n                strokeWidth={1.1}\n                strokeDasharray=\"3 3\"\n              />\n              <text\n                x={Math.min(W - 42, brewsterX + 4)}\n                y={padT + 11}\n                className=\"fill-amber-700 text-[10px] font-mono font-medium\"\n              >\n                \316\270B\n              </text>\n            </g>\n          )}\n\n          {/* Critical angle reference line */}\n          {criticalX !== null && (\n            <g>\n              <line\n                x1={criticalX}\n                y1={padT}\n                x2={criticalX}\n                y2={H - padB}\n                stroke=\"#dc2626\"\n                strokeWidth={1.1}\n                strokeDasharray=\"4 3\"\n              />\n              <text\n                x={Math.max(padL + 4, criticalX - 18)}\n                y={padT + 11}\n                className=\"fill-rose-700 text-[10px] font-mono font-medium\"\n              >\n                \316\270c\n              </text>\n            </g>\n          )}\n\n          {/* Curves */}\n          {chartMode === \'POWER\' ? (\n            <>\n              <path\n                d={pathTeff}\n                fill=\"none\"\n                stroke=\"#059669\"\n                strokeWidth={1.8}\n                strokeDasharray=\"5 3\"\n              />\n              <path d={pathRs} fill=\"none\" stroke=\"#dc2626\" strokeWidth={2} />\n              <path d={pathRp} fill=\"none\" stroke=\"#0284c7\" strokeWidth={2} />\n            </>\n          ) : (\n            <>\n              <path d={pathPhaseS} fill=\"none\" stroke=\"#dc2626\" strokeWidth={2} />\n              <path d={pathPhaseP} fill=\"none\" stroke=\"#0284c7\" strokeWidth={2} />\n            </>\n          )}\n\n          {/* Current Angle Vertical Cursor & Highlight Dots */}\n          <line\n            x1={cursorX}\n            y1={padT}\n            x2={cursorX}\n            y2={H - padB}\n            stroke=\"#0f172a\"\n            strokeWidth={1.4}\n          />\n\n          {chartMode === \'POWER\' ? (\n            <>\n              <circle\n                cx={cursorX}\n                cy={yOfRatio(physics.reflectanceS)}\n                r={4}\n                fill=\"#dc2626\"\n                stroke=\"#ffffff\"\n                strokeWidth={1.5}\n              />\n              <circle\n                cx={cursorX}\n                cy={yOfRatio(physics.reflectanceP)}\n                r={4}\n                fill=\"#0284c7\"\n                stroke=\"#ffffff\"\n                strokeWidth={1.5}\n              />\n              <circle\n                cx={cursorX}\n                cy={yOfRatio(physics.transmittanceEffective)}\n                r={3.5}\n                fill=\"#059669\"\n                stroke=\"#ffffff\"\n                strokeWidth={1.5}\n              />\n            </>\n          ) : (\n            <>\n              <circle\n                cx={cursorX}\n                cy={yOfPhase(physics.phaseShiftSDeg)}\n                r={4}\n                fill=\"#dc2626\"\n                stroke=\"#ffffff\"\n                strokeWidth={1.5}\n              />\n              <circle\n                cx={cursorX}\n                cy={yOfPhase(physics.phaseShiftPDeg)}\n                r={4}\n                fill=\"#0284c7\"\n                stroke=\"#ffffff\"\n                strokeWidth={1.5}\n              />\n            </>\n          )}\n\n          {/* X-Axis Title */}\n          <text\n            x={padL + plotW / 2}\n            y={H - 4}\n            textAnchor=\"middle\"\n            className=\"fill-slate-500 text-[10.5px]\"\n          >\n            G\303\263c t\341\273\233i \316\270i (\304\221\341\273\231)\n          </text>\n        </svg>\n\n        {/* Clean Unboxed Legend */}\n        <div className=\"mt-2 pt-2.5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600\">\n          {chartMode === \'POWER\' ? (\n            <div className=\"flex flex-wrap items-center gap-4 font-mono\">\n              <span className=\"inline-flex items-center gap-1.5\">\n                <span className=\"w-3 h-0.5 bg-rose-600 inline-block\" /> Rs (TE)\n              </span>\n              <span className=\"inline-flex items-center gap-1.5\">\n                <span className=\"w-3 h-0.5 bg-sky-600 inline-block\" /> Rp (TM)\n              </span>\n              <span className=\"inline-flex items-center gap-1.5\">\n                <span className=\"w-3 h-0.5 border-t-2 border-dashed border-emerald-600 inline-block\" />{\' \'}\n                Truy\341\273\201n qua T\n              </span>\n            </div>\n          ) : (\n            <div className=\"flex flex-wrap items-center gap-4 font-mono\">\n              <span className=\"inline-flex items-center gap-1.5\">\n                <span className=\"w-3 h-0.5 bg-rose-600 inline-block\" /> \316\224\317\206s (TE)\n              </span>\n              <span className=\"inline-flex items-center gap-1.5\">\n                <span className=\"w-3 h-0.5 bg-sky-600 inline-block\" /> \316\224\317\206p (TM)\n              </span>\n            </div>\n          )}\n          <span className=\"font-mono text-slate-700 tabular-nums\">\n            Hi\341\273\207n t\341\272\241i: \316\270i = {physics.incidentAngleDeg.toFixed(1)}\302\260\n          </span>\n        </div>\n      </div>\n\n      {/* Electromagnetic Medium Parameter Comparison Table */}\n      <div className=\"xl:col-span-5 bg-white border border-slate-200 rounded-xl p-5 flex flex-col justify-between\">\n        <div>\n          <h3 className=\"text-sm font-semibold text-slate-900 mb-1\">\n            Th\303\264ng s\341\273\221 truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253 hai m\303\264i tr\306\260\341\273\235ng\n          </h3>\n          <p className=\"text-xs text-slate-500 mb-4\">\n            So s\303\241nh tr\341\273\261c ti\341\272\277p \304\221\341\272\267c t\303\255nh \304\221i\341\273\207n m\303\264i, v\341\272\255n t\341\273\221c pha v\303\240 tr\341\273\237 kh\303\241ng s\303\263ng\n          </p>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse text-xs\">\n              <thead>\n                <tr className=\"border-b border-slate-200 text-slate-500\">\n                  <th className=\"py-2 pr-2 font-medium\">\304\220\341\272\241i l\306\260\341\273\243ng</th>\n                  <th className=\"py-2 px-2 font-medium text-right\">M\303\264i tr\306\260\341\273\235ng 1</th>\n                  <th className=\"py-2 pl-2 font-medium text-right\">M\303\264i tr\306\260\341\273\235ng 2</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 font-mono tabular-nums text-slate-800\">\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">Chi\341\272\277t su\341\272\245t (n)</td>\n                  <td className=\"py-2 px-2 text-right font-medium\">{physics.n1.toFixed(4)}</td>\n                  <td className=\"py-2 pl-2 text-right font-medium\">{physics.n2.toFixed(4)}</td>\n                </tr>\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">H\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i (\316\265r)</td>\n                  <td className=\"py-2 px-2 text-right\">{physics.permittivity1.toFixed(3)}</td>\n                  <td className=\"py-2 pl-2 text-right\">{physics.permittivity2.toFixed(3)}</td>\n                </tr>\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">Tr\341\273\237 kh\303\241ng s\303\263ng (Z)</td>\n                  <td className=\"py-2 px-2 text-right\">{physics.impedance1Ohm.toFixed(1)} \316\251</td>\n                  <td className=\"py-2 pl-2 text-right\">{physics.impedance2Ohm.toFixed(1)} \316\251</td>\n                </tr>\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">V\341\272\255n t\341\273\221c pha (v = c/n)</td>\n                  <td className=\"py-2 px-2 text-right\">\n                    {(physics.phaseVelocity1 / 1e8).toFixed(3)}\303\22710\342\201\270\n                  </td>\n                  <td className=\"py-2 pl-2 text-right\">\n                    {(physics.phaseVelocity2 / 1e8).toFixed(3)}\303\22710\342\201\270\n                  </td>\n                </tr>\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">B\306\260\341\273\233c s\303\263ng n\341\273\231i m\303\264i (\316\273)</td>\n                  <td className=\"py-2 px-2 text-right\">{formatWavelength(physics.wavelength1Nm)}</td>\n                  <td className=\"py-2 pl-2 text-right\">{formatWavelength(physics.wavelength2Nm)}</td>\n                </tr>\n                <tr>\n                  <td className=\"py-2 pr-2 font-sans text-slate-600\">H\341\273\207 s\341\273\221 bi\303\252n \304\221\341\273\231 |r|</td>\n                  <td className=\"py-2 px-2 text-right text-slate-500\">\n                    |rs| = {physics.rsMag.toFixed(3)}\n                  </td>\n                  <td className=\"py-2 pl-2 text-right text-slate-500\">\n                    |rp| = {physics.rpMag.toFixed(3)}\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 leading-relaxed\">\n          <span className=\"font-medium text-slate-700\">M\303\264i tr\306\260\341\273\235ng:</span> {material1Label} \342\206\222{\' \'}\n          {material2Label}. \304\220\341\273\213nh lu\341\272\255t b\341\272\243o to\303\240n n\304\203ng l\306\260\341\273\243ng:{\' \'}\n          <span className=\"font-mono text-slate-800\">\n            R + T = {((physics.reflectanceEffective + physics.transmittanceEffective) * 100).toFixed(1)}%\n          </span>\n          .\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/FresnelChart.tsx"
        }
        overwrite: true
      }
