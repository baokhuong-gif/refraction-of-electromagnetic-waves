            }
            lines {
              text: "        ctx.arc(cx, cy, arcR - 12, -Math.PI / 2, -Math.PI / 2 + thetaI);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const midR = -Math.PI / 2 + thetaI * 0.45;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const labelR = arcR + 18;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
