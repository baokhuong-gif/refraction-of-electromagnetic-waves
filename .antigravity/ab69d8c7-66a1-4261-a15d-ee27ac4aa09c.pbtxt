      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add unit test verifying PDF report metadata formatting for both standard refraction and TIR regimes\",\"EndLine\":176,\"Instruction\":\"Import buildPdfReportMetadata and add test asserting refracted angle, deviation angle, TIR formatting, and PDF filename\",\"ReplacementContent\":\"  assert.equal(errRes.ok, false);\\n  if (!errRes.ok) {\\n    assert.ok(Boolean(errRes.fieldErrors.incidentAngleDeg));\\n  }\\n});\\n\\ntest(\'PDF report metadata formats refracted angle, ray deviation, and TIR state accurately\', async () => {\\n  const { buildPdfReportMetadata } = await import(\'../utils/pdfReport\');\\n  const normalRes = computeEMRefraction({\\n    n1: 1.0,\\n    n2: 1.5,\\n    incidentAngleDeg: 30,\\n    wavelengthVacuumNm: 532,\\n    polarization: \'UNPOLARIZED\',\\n  });\\n  const normalMeta = buildPdfReportMetadata(normalRes, new Date(2026, 10, 25, 10, 15));\\n  assert.match(normalMeta.filename, /^EMRefract-Bao-cao-Khuc-xa-20261125-1015\\\\.pdf$/);\\n  assert.equal(normalMeta.incidentAngleText, \'30.00\302\260\');\\n  assert.equal(normalMeta.refractedAngleText, \'19.47\302\260\');\\n  assert.equal(normalMeta.deviationAngleText, \'10.53\302\260\');\\n\\n  const tirRes = computeEMRefraction({\\n    n1: 1.5,\\n    n2: 1.0,\\n    incidentAngleDeg: 60,\\n    wavelengthVacuumNm: 633,\\n    polarization: \'TE\',\\n  });\\n  const tirMeta = buildPdfReportMetadata(tirRes, new Date(2026, 10, 25, 10, 15));\\n  assert.equal(tirMeta.refractedAngleText, \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (TIR)\');\\n});\",\"StartLine\":170,\"TargetContent\":\"  assert.equal(errRes.ok, false);\\n  if (!errRes.ok) {\\n    assert.ok(Boolean(errRes.fieldErrors.incidentAngleDeg));\\n  }\\n});\",\"TargetFile\":\"/src/physics/emPhysics.test.ts\",\"toolAction\":\"Adding PDF metadata unit test\",\"toolSummary\":\"Add PDF metadata unit test\"}"
