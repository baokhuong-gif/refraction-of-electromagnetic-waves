        instruction: "Update WaveCanvas.tsx to import Ruler, batch optical protractor ticks into 2 draw calls, use Ruler for the angles toggle, keep bottom hint clear of the protractor normal/numerals, and color-code \316\273\342\202\201/\316\273\342\202\202 readouts."
        is_edit: true
        file {
          absolute_uri: "file:///src/components/WaveCanvas.tsx"
