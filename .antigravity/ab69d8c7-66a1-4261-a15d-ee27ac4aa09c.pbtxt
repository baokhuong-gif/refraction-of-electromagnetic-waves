            }
            lines {
              text: "      camera.updateProjectionMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      renderer.setSize(nextW, nextH);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const resizeObserver = new ResizeObserver(handleResize);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    resizeObserver.observe(container);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
