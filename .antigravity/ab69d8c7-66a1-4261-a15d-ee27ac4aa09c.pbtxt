  code_action {
    action_spec {
      command {
        instruction: "Import AnimatePresence, Info icon, and buildMaterialIndexTooltipData; track active tooltip row with smart top/bottom viewport-safe placement and render accessible floating tooltip with physical n-index explanation and derived EM metrics"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/RefractiveIndexComparisonChart.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useMemo, useState } from \'react\';\nimport { motion, useReducedMotion } from \'motion/react\';\nimport { OpticalMaterial } from \'../physics/materials\';\nimport {\n  buildRefractiveComparisonModel,\n  ComparisonCategoryFilter,\n  MaterialBracketSummary,\n} from \'../utils/refractiveComparison\';"
          replacement_content: "import React, { useMemo, useRef, useState } from \'react\';\nimport { Info } from \'lucide-react\';\nimport { AnimatePresence, motion, useReducedMotion } from \'motion/react\';\nimport { OpticalMaterial } from \'../physics/materials\';\nimport {\n  buildMaterialIndexTooltipData,\n  buildRefractiveComparisonModel,\n  ComparisonCategoryFilter,\n  MaterialBracketSummary,\n} from \'../utils/refractiveComparison\';"
          start_line: 1
          end_line: 10
        }
        replacement_chunks {
          target_content: "export const RefractiveIndexComparisonChart: React.FC<RefractiveIndexComparisonChartProps> = ({\n  n1,\n  n2,\n  material1Id,\n  material2Id,\n  material1Label,\n  material2Label,\n  onSelectMaterialForN1,\n  onSelectMaterialForN2,\n}) => {\n  const [categoryFilter, setCategoryFilter] = useState<ComparisonCategoryFilter>(\'ALL\');\n  const [assignTarget, setAssignTarget] = useState<\'N1\' | \'N2\'>(\'N2\');\n  const [hoveredMaterial, setHoveredMaterial] = useState<OpticalMaterial | null>(null);\n  const prefersReducedMotion = useReducedMotion();\n\n  const model = useMemo(\n    () =>\n      buildRefractiveComparisonModel({\n        n1,\n        n2,\n        material1Id,\n        material2Id,\n        categoryFilter,\n      }),\n    [n1, n2, material1Id, material2Id, categoryFilter]\n  );\n\n  const handleRowClick = (mat: OpticalMaterial) => {\n    if (assignTarget === \'N1\') {\n      onSelectMaterialForN1(mat);\n    } else {\n      onSelectMaterialForN2(mat);\n    }\n  };"
          replacement_content: "function formatSignedDelta(delta: number): string {\n  if (Math.abs(delta) < 0.0005) return \'0.000\';\n  return `${delta > 0 ? \'+\' : \'\'}${delta.toFixed(3)}`;\n}\n\nfunction formatVelocityShort(vMs: number): string {\n  return `${(vMs / 1e8).toFixed(2)}\303\22710\342\201\270 m/s`;\n}\n\ninterface ActiveTooltipState {\n  material: OpticalMaterial;\n  isCurrentN1: boolean;\n  isCurrentN2: boolean;\n  placement: \'top\' | \'bottom\';\n  topPx: number;\n  bottomOffsetPx: number;\n  leftPx: number | null;\n}\n\nexport const RefractiveIndexComparisonChart: React.FC<RefractiveIndexComparisonChartProps> = ({\n  n1,\n  n2,\n  material1Id,\n  material2Id,\n  material1Label,\n  material2Label,\n  onSelectMaterialForN1,\n  onSelectMaterialForN2,\n}) => {\n  const [categoryFilter, setCategoryFilter] = useState<ComparisonCategoryFilter>(\'ALL\');\n  const [assignTarget, setAssignTarget] = useState<\'N1\' | \'N2\'>(\'N2\');\n  const [activeTooltip, setActiveTooltip] = useState<ActiveTooltipState | null>(null);\n  const plotAreaRef = useRef<HTMLDivElement | null>(null);\n  const prefersReducedMotion = useReducedMotion();\n\n  const model = useMemo(\n    () =>\n      buildRefractiveComparisonModel({\n        n1,\n        n2,\n        material1Id,\n        material2Id,\n        categoryFilter,\n      }),\n    [n1, n2, material1Id, material2Id, categoryFilter]\n  );\n\n  const tooltipData = useMemo(() => {\n    if (!activeTooltip) return null;\n    return buildMaterialIndexTooltipData(activeTooltip.material, n1, n2);\n  }, [activeTooltip, n1, n2]);\n\n  const handleActivateTooltip = (\n    material: OpticalMaterial,\n    widthPct: number,\n    isCurrentN1: boolean,\n    isCurrentN2: boolean,\n    rowEl: HTMLButtonElement\n  ) => {\n    const plotEl = plotAreaRef.current;\n    if (!plotEl) return;\n\n    const plotWidth = plotEl.offsetWidth;\n    const plotHeight = plotEl.offsetHeight;\n    const rowRect = rowEl.getBoundingClientRect();\n    const spaceBelow = window.innerHeight - rowRect.bottom;\n    const spaceAbove = rowRect.top;\n    const placement: \'top\' | \'bottom\' =\n      spaceBelow < 255 && spaceAbove > spaceBelow ? \'top\' : \'bottom\';\n\n    const tooltipWidth = 420;\n    let leftPx: number | null = null;\n    if (plotWidth >= 540) {\n      const trackStart = 210;\n      const trackWidth = Math.max(120, plotWidth - trackStart - 104);\n      const desiredLeft = trackStart + (widthPct / 100) * trackWidth * 0.45 - 60;\n      leftPx = Math.max(0, Math.min(desiredLeft, plotWidth - tooltipWidth));\n    }\n\n    setActiveTooltip({\n      material,\n      isCurrentN1,\n      isCurrentN2,\n      placement,\n      topPx: rowEl.offsetTop + rowEl.offsetHeight + 8,\n      bottomOffsetPx: plotHeight - rowEl.offsetTop + 8,\n      leftPx,\n    });\n  };\n\n  const handleRowClick = (mat: OpticalMaterial) => {\n    if (assignTarget === \'N1\') {\n      onSelectMaterialForN1(mat);\n    } else {\n      onSelectMaterialForN2(mat);\n    }\n  };"
          start_line: 58
          end_line: 95
        }
        replacement_chunks {
          target_content: "        {/* Plot Area: Rows + Vertical Gridlines + n1/n2 Span & Reference Lines */}\n        <div className=\"relative\">"
          replacement_content: "        {/* Plot Area: Rows + Vertical Gridlines + n1/n2 Span & Reference Lines */}\n        <div ref={plotAreaRef} className=\"relative\">"
          start_line: 250
          end_line: 255
        }
        replacement_chunks {
          target_content: "          {/* Interactive Material Bar Rows */}\n          <div className=\"relative z-20 divide-y divide-slate-100/80\">\n            {model.items.map(({ material, widthPct, isCurrentN1, isCurrentN2 }) => {\n              const isMatched = isCurrentN1 || isCurrentN2;\n              const barColorClass =\n                isCurrentN1 && isCurrentN2\n                  ? \'bg-teal-600\'\n                  : isCurrentN1\n                  ? \'bg-sky-600\'\n                  : isCurrentN2\n                  ? \'bg-indigo-600\'\n                  : \'bg-slate-300 group-hover:bg-slate-400\';\n\n              return (\n                <button\n                  key={material.id}\n                  type=\"button\"\n                  data-testid={`comparison-bar-${material.id}`}\n                  onClick={() => handleRowClick(material)}\n                  onMouseEnter={() => setHoveredMaterial(material)}\n                  onMouseLeave={() => setHoveredMaterial(null)}\n                  onFocus={() => setHoveredMaterial(material)}\n                  onBlur={() => setHoveredMaterial(null)}\n                  aria-label={`Ch\341\273\215n ${material.name}, chi\341\272\277t su\341\272\245t ${material.refractiveIndex.toFixed(3)}, g\303\241n cho ${\n                    assignTarget === \'N1\' ? \'m\303\264i tr\306\260\341\273\235ng 1\' : \'m\303\264i tr\306\260\341\273\235ng 2\'\n                  }`}\n                  className={`group w-full text-left grid grid-cols-[118px_minmax(0,1fr)_52px] sm:grid-cols-[210px_minmax(0,1fr)_104px] gap-2 sm:gap-3 items-center py-2 rounded-md transition-colors cursor-pointer ${\n                    isMatched ? \'bg-slate-50/80\' : \'hover:bg-slate-50/70\'\n                  }`}\n                >\n                  {/* Material Name & Active Match Indicator (Zero-Pill unboxed text) */}\n                  <div className=\"min-w-0 pr-1\">\n                    <div className=\"flex items-center gap-1.5 min-w-0\">\n                      <span\n                        className={`text-[13px] truncate ${\n                          isMatched\n                            ? \'font-semibold text-slate-950\'\n                            : \'font-medium text-slate-700 group-hover:text-slate-950\'\n                        }`}\n                      >\n                        {material.name}\n                      </span>\n                      {isCurrentN1 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-sky-700 shrink-0\">\n                          n\342\202\201\n                        </span>\n                      )}\n                      {isCurrentN2 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-indigo-700 shrink-0\">\n                          n\342\202\202\n                        </span>\n                      )}\n                    </div>\n                  </div>\n\n                  {/* Calibrated Bar Track */}\n                  <div className=\"relative h-4 flex items-center\">\n                    <div className=\"w-full h-2.5 bg-slate-100/90 rounded-r-sm overflow-hidden\">\n                      <motion.div\n                        initial={false}\n                        animate={{ width: `${Math.max(1.2, widthPct)}%` }}\n                        transition={transition}\n                        className={`h-full rounded-r-sm transition-colors ${barColorClass}`}\n                      />\n                    </div>\n                  </div>\n\n                  {/* Tabular Numeric Readout: n and \316\265r */}\n                  <div className=\"text-right font-mono tabular-nums leading-tight shrink-0\">\n                    <span\n                      className={`text-[13px] ${\n                        isMatched ? \'font-semibold text-slate-950\' : \'font-medium text-slate-800\'\n                      }`}\n                    >\n                      {material.refractiveIndex.toFixed(3)}\n                    </span>\n                    <span className=\"text-[11px] text-slate-400 ml-1.5 hidden sm:inline\">\n                      ({material.relativePermittivity.toFixed(1)})\n                    </span>\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Positioning Summary & Legend (Unboxed Editorial Telemetry) */}\n      <div className=\"pt-3.5 border-t border-slate-200 flex flex-col gap-2.5 text-[13px] text-slate-600\">\n        {hoveredMaterial ? (\n          <div className=\"text-slate-800 leading-relaxed\">\n            <span className=\"font-semibold text-slate-950\">{hoveredMaterial.name}</span>\n            <span className=\"text-slate-400 mx-1.5\">\302\267</span>\n            <span className=\"font-mono text-xs text-slate-700 tabular-nums\">\n              n = {hoveredMaterial.refractiveIndex.toFixed(3)} \302\267 \316\265r ={\' \'}\n              {hoveredMaterial.relativePermittivity.toFixed(2)}\n            </span>\n            <span className=\"text-slate-400 mx-1.5\">\302\267</span>\n            <span>{hoveredMaterial.notes}</span>\n          </div>\n        ) : (\n          <div\n            data-testid=\"comparison-bracket-summary\"\n            className=\"grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 leading-relaxed\"\n          >\n            <div>\n              <span className=\"font-mono text-xs font-semibold text-sky-700 mr-1.5\">n\342\202\201</span>\n              {formatBracketDescription(material1Label, n1, model.n1Bracket)}\n            </div>\n            <div>\n              <span className=\"font-mono text-xs font-semibold text-indigo-700 mr-1.5\">n\342\202\202</span>\n              {formatBracketDescription(material2Label, n2, model.n2Bracket)}\n            </div>\n          </div>\n        )}\n\n        <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500\">\n          <div className=\"flex flex-wrap items-center gap-4 font-mono\">\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-xs bg-sky-600 inline-block\" />\n              M\303\264i tr\306\260\341\273\235ng 1 (n\342\202\201)\n            </span>\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-xs bg-indigo-600 inline-block\" />\n              M\303\264i tr\306\260\341\273\235ng 2 (n\342\202\202)\n            </span>\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span\n                className={`w-3 h-2.5 rounded-xs inline-block border ${\n                  model.deltaN >= 0\n                    ? \'bg-sky-100 border-sky-300\'\n                    : \'bg-amber-100 border-amber-300\'\n                }`}\n              />\n              {model.deltaN >= 0 ? \'V\303\271ng ch\303\252nh l\341\273\207ch chi\341\272\277t quang t\304\203ng\' : \'V\303\271ng chi\341\272\277t quang gi\341\272\243m (c\303\263 \316\270c)\'}\n            </span>\n          </div>\n          <span className=\"text-slate-400\">\n            Nh\341\272\245p b\341\272\245t k\341\273\263 thanh v\341\272\255t li\341\273\207u n\303\240o \304\221\341\273\203 n\341\272\241p nhanh v\303\240o {assignTarget === \'N1\' ? \'n\342\202\201\' : \'n\342\202\202\'}\n          </span>\n        </div>\n      </div>\n    </section>\n  );\n};"
          replacement_content: "          {/* Interactive Material Bar Rows */}\n          <div\n            onMouseLeave={() => setActiveTooltip(null)}\n            className=\"relative z-20 divide-y divide-slate-100/80\"\n          >\n            {model.items.map(({ material, widthPct, isCurrentN1, isCurrentN2 }) => {\n              const isMatched = isCurrentN1 || isCurrentN2;\n              const isRowHovered = activeTooltip?.material.id === material.id;\n              const barColorClass =\n                isCurrentN1 && isCurrentN2\n                  ? \'bg-teal-600\'\n                  : isCurrentN1\n                  ? \'bg-sky-600\'\n                  : isCurrentN2\n                  ? \'bg-indigo-600\'\n                  : \'bg-slate-300 group-hover:bg-slate-400\';\n\n              return (\n                <button\n                  key={material.id}\n                  type=\"button\"\n                  data-testid={`comparison-bar-${material.id}`}\n                  aria-describedby={isRowHovered ? \'material-index-tooltip\' : undefined}\n                  onClick={() => handleRowClick(material)}\n                  onMouseEnter={(e) =>\n                    handleActivateTooltip(\n                      material,\n                      widthPct,\n                      isCurrentN1,\n                      isCurrentN2,\n                      e.currentTarget\n                    )\n                  }\n                  onFocus={(e) =>\n                    handleActivateTooltip(\n                      material,\n                      widthPct,\n                      isCurrentN1,\n                      isCurrentN2,\n                      e.currentTarget\n                    )\n                  }\n                  onBlur={() => setActiveTooltip(null)}\n                  onKeyDown={(e) => {\n                    if (e.key === \'Escape\') setActiveTooltip(null);\n                  }}\n                  aria-label={`Ch\341\273\215n ${material.name}, chi\341\272\277t su\341\272\245t ${material.refractiveIndex.toFixed(3)}, g\303\241n cho ${\n                    assignTarget === \'N1\' ? \'m\303\264i tr\306\260\341\273\235ng 1\' : \'m\303\264i tr\306\260\341\273\235ng 2\'\n                  }`}\n                  className={`group w-full text-left grid grid-cols-[118px_minmax(0,1fr)_52px] sm:grid-cols-[210px_minmax(0,1fr)_104px] gap-2 sm:gap-3 items-center py-2 rounded-md transition-colors cursor-pointer ${\n                    isRowHovered\n                      ? \'bg-sky-50/60\'\n                      : isMatched\n                      ? \'bg-slate-50/80\'\n                      : \'hover:bg-slate-50/70\'\n                  }`}\n                >\n                  {/* Material Name, Info Affordance & Active Match Indicator (Zero-Pill unboxed text) */}\n                  <div className=\"min-w-0 pr-1\">\n                    <div className=\"flex items-center gap-1.5 min-w-0\">\n                      <span\n                        className={`text-[13px] truncate ${\n                          isMatched || isRowHovered\n                            ? \'font-semibold text-slate-950\'\n                            : \'font-medium text-slate-700 group-hover:text-slate-950\'\n                        }`}\n                      >\n                        {material.name}\n                      </span>\n                      {isCurrentN1 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-sky-700 shrink-0\">\n                          n\342\202\201\n                        </span>\n                      )}\n                      {isCurrentN2 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-indigo-700 shrink-0\">\n                          n\342\202\202\n                        </span>\n                      )}\n                      <Info\n                        aria-hidden=\"true\"\n                        className=\"hidden sm:inline-block w-3.5 h-3.5 text-slate-300 group-hover:text-sky-600 group-focus-visible:text-sky-600 transition-colors shrink-0 ml-auto\"\n                      />\n                    </div>\n                  </div>\n\n                  {/* Calibrated Bar Track */}\n                  <div className=\"relative h-4 flex items-center\">\n                    <div className=\"w-full h-2.5 bg-slate-100/90 rounded-r-sm overflow-hidden\">\n                      <motion.div\n                        initial={false}\n                        animate={{ width: `${Math.max(1.2, widthPct)}%` }}\n                        transition={transition}\n                        className={`h-full rounded-r-sm transition-colors ${barColorClass}`}\n                      />\n                    </div>\n                  </div>\n\n                  {/* Tabular Numeric Readout: n and \316\265r */}\n                  <div className=\"text-right font-mono tabular-nums leading-tight shrink-0\">\n                    <span\n                      className={`text-[13px] ${\n                        isMatched || isRowHovered\n                          ? \'font-semibold text-slate-950\'\n                          : \'font-medium text-slate-800\'\n                      }`}\n                    >\n                      {material.refractiveIndex.toFixed(3)}\n                    </span>\n                    <span className=\"text-[11px] text-slate-400 ml-1.5 hidden sm:inline\">\n                      ({material.relativePermittivity.toFixed(1)})\n                    </span>\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Floating Detailed Refractive Index Tooltip (Hover / Keyboard Focus) */}\n          <AnimatePresence>\n            {activeTooltip && tooltipData && (\n              <motion.div\n                key={activeTooltip.material.id}\n                id=\"material-index-tooltip\"\n                role=\"tooltip\"\n                data-testid=\"material-index-tooltip\"\n                initial={\n                  prefersReducedMotion\n                    ? { opacity: 1 }\n                    : {\n                        opacity: 0,\n                        y: activeTooltip.placement === \'top\' ? 5 : -5,\n                      }\n                }\n                animate={{ opacity: 1, y: 0 }}\n                exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0 }}\n                transition={{ duration: 0.14, ease: \'easeOut\' }}\n                style={\n                  activeTooltip.placement === \'top\'\n                    ? {\n                        bottom: `${activeTooltip.bottomOffsetPx}px`,\n                        ...(activeTooltip.leftPx !== null\n                          ? { left: `${activeTooltip.leftPx}px`, width: \'420px\' }\n                          : { left: 0, right: 0 }),\n                      }\n                    : {\n                        top: `${activeTooltip.topPx}px`,\n                        ...(activeTooltip.leftPx !== null\n                          ? { left: `${activeTooltip.leftPx}px`, width: \'420px\' }\n                          : { left: 0, right: 0 }),\n                      }\n                }\n                className=\"pointer-events-none absolute z-40 max-w-full bg-white/98 backdrop-blur-xs border border-slate-300/90 rounded-xl shadow-lg shadow-slate-900/12 p-3.5 sm:p-4 text-left\"\n              >\n                {/* Header: Material Name, Category, Exact Index n */}\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"min-w-0\">\n                    <div className=\"flex items-center gap-1.5 flex-wrap\">\n                      <span className=\"font-display text-sm font-semibold text-slate-950 leading-snug\">\n                        {tooltipData.material.name}\n                      </span>\n                      {activeTooltip.isCurrentN1 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-sky-700\">\n                          \302\267 \304\220ang l\303\240 n\342\202\201\n                        </span>\n                      )}\n                      {activeTooltip.isCurrentN2 && (\n                        <span className=\"font-mono text-[11px] font-semibold text-indigo-700\">\n                          \302\267 \304\220ang l\303\240 n\342\202\202\n                        </span>\n                      )}\n                    </div>\n                    <div className=\"text-[11px] text-slate-500 mt-0.5\">\n                      {tooltipData.material.category}\n                      {tooltipData.dispersionNote ? ` \302\267 ${tooltipData.dispersionNote}` : \'\'}\n                    </div>\n                  </div>\n                  <div className=\"text-right shrink-0\">\n                    <div className=\"font-mono text-sm font-bold text-slate-950 tabular-nums\">\n                      n = {tooltipData.material.refractiveIndex.toFixed(3)}\n                    </div>\n                    <div className=\"font-mono text-[11px] text-slate-500 tabular-nums\">\n                      \316\265r = {tooltipData.material.relativePermittivity.toFixed(2)}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Detailed Physical Explanation of Refractive Index n */}\n                <p\n                  data-testid=\"tooltip-n-explanation\"\n                  className=\"mt-2.5 text-xs text-slate-700 leading-relaxed\"\n                >\n                  {tooltipData.material.indexExplanation}\n                </p>\n\n                {/* Derived Electromagnetic & Optical Metrics Grid */}\n                <div className=\"mt-3 pt-2.5 border-t border-slate-100 grid grid-cols-2 gap-x-4 gap-y-2 text-[11px]\">\n                  <div>\n                    <div className=\"text-slate-500\">V\341\272\255n t\341\273\221c pha (v = c/n)</div>\n                    <div className=\"font-mono font-semibold text-slate-900 tabular-nums mt-0.5\">\n                      {formatVelocityShort(tooltipData.phaseVelocityMs)}{\' \'}\n                      <span className=\"font-normal text-slate-500\">\n                        ({tooltipData.speedPercentOfC.toFixed(1)}% c)\n                      </span>\n                    </div>\n                  </div>\n\n                  <div>\n                    <div className=\"text-slate-500\">N\303\251n b\306\260\341\273\233c s\303\263ng & Tr\341\273\237 kh\303\241ng</div>\n                    <div className=\"font-mono font-semibold text-slate-900 tabular-nums mt-0.5\">\n                      \316\273 = {tooltipData.wavelengthScalePct.toFixed(1)}% \316\273\342\202\200 \302\267{\' \'}\n                      <span className=\"font-normal text-slate-600\">\n                        {tooltipData.impedanceOhm.toFixed(0)} \316\251\n                      </span>\n                    </div>\n                  </div>\n\n                  <div>\n                    <div className=\"text-slate-500\">G\303\263c t\341\273\233i h\341\272\241n & Brewster (vs KK)</div>\n                    <div className=\"font-mono font-semibold text-slate-900 tabular-nums mt-0.5\">\n                      {tooltipData.criticalAngleToAirDeg !== null ? (\n                        <>\n                          \316\270c = {tooltipData.criticalAngleToAirDeg.toFixed(1)}\302\260 \302\267 \316\270B ={\' \'}\n                          {tooltipData.brewsterAngleFromAirDeg.toFixed(1)}\302\260\n                        </>\n                      ) : (\n                        \'Chu\341\272\251n tham chi\341\272\277u (kh\303\264ng c\303\263 \316\270c)\'\n                      )}\n                    </div>\n                  </div>\n\n                  <div>\n                    <div className=\"text-slate-500\">Ph\341\272\243n x\341\272\241 tr\341\273\261c giao t\341\273\253 kh\303\264ng kh\303\255</div>\n                    <div className=\"font-mono font-semibold text-slate-900 tabular-nums mt-0.5\">\n                      R\342\202\200 = {tooltipData.normalReflectanceFromAirPct.toFixed(2)}%\n                    </div>\n                  </div>\n                </div>\n\n                {/* Live Comparison Delta vs Active n1, n2 */}\n                <div className=\"mt-2.5 pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-[11px]\">\n                  <div className=\"font-mono text-slate-600 tabular-nums\">\n                    So v\341\273\233i hi\341\273\207n t\341\272\241i:{\' \'}\n                    <span className=\"text-sky-700 font-semibold\">\n                      \316\224n\342\202\201 {formatSignedDelta(tooltipData.deltaVsN1)}\n                    </span>{\' \'}\n                    \302\267{\' \'}\n                    <span className=\"text-indigo-700 font-semibold\">\n                      \316\224n\342\202\202 {formatSignedDelta(tooltipData.deltaVsN2)}\n                    </span>\n                  </div>\n                  <span className=\"text-slate-400\">\n                    Nh\341\272\245p \304\221\341\273\203 g\303\241n {assignTarget === \'N1\' ? \'n\342\202\201\' : \'n\342\202\202\'}\n                  </span>\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </div>\n\n      {/* Bottom Positioning Summary & Legend (Persistent Unboxed Editorial Telemetry) */}\n      <div className=\"pt-3.5 border-t border-slate-200 flex flex-col gap-2.5 text-[13px] text-slate-600\">\n        <div\n          data-testid=\"comparison-bracket-summary\"\n          className=\"grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 leading-relaxed\"\n        >\n          <div>\n            <span className=\"font-mono text-xs font-semibold text-sky-700 mr-1.5\">n\342\202\201</span>\n            {formatBracketDescription(material1Label, n1, model.n1Bracket)}\n          </div>\n          <div>\n            <span className=\"font-mono text-xs font-semibold text-indigo-700 mr-1.5\">n\342\202\202</span>\n            {formatBracketDescription(material2Label, n2, model.n2Bracket)}\n          </div>\n        </div>\n\n        <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500\">\n          <div className=\"flex flex-wrap items-center gap-4 font-mono\">\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-xs bg-sky-600 inline-block\" />\n              M\303\264i tr\306\260\341\273\235ng 1 (n\342\202\201)\n            </span>\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span className=\"w-2.5 h-2.5 rounded-xs bg-indigo-600 inline-block\" />\n              M\303\264i tr\306\260\341\273\235ng 2 (n\342\202\202)\n            </span>\n            <span className=\"inline-flex items-center gap-1.5\">\n              <span\n                className={`w-3 h-2.5 rounded-xs inline-block border ${\n                  model.deltaN >= 0\n                    ? \'bg-sky-100 border-sky-300\'\n                    : \'bg-amber-100 border-amber-300\'\n                }`}\n              />\n              {model.deltaN >= 0 ? \'V\303\271ng ch\303\252nh l\341\273\207ch chi\341\272\277t quang t\304\203ng\' : \'V\303\271ng chi\341\272\277t quang gi\341\272\243m (c\303\263 \316\270c)\'}\n            </span>\n          </div>\n          <span className=\"text-slate-400\">\n            Di chu\341\273\231t v\303\240o t\341\273\253ng d\303\262ng xem gi\341\272\243i th\303\255ch ch\341\273\211 s\341\273\221 n \302\267 Nh\341\272\245p \304\221\341\273\203 g\303\241n v\303\240o{\' \'}\n            {assignTarget === \'N1\' ? \'n\342\202\201\' : \'n\342\202\202\'}\n          </span>\n        </div>\n      </div>\n    </section>\n  );\n};"
