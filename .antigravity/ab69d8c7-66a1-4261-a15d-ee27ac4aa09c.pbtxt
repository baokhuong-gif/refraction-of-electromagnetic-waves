            }
            lines {
              text: "    drawIndexRail(44, cy - 18, p.n1, \'n\342\202\201\', \'#0284c7\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    drawIndexRail(cy + 40, height - 30, p.n2, \'n\342\202\202\', \'#2563eb\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
