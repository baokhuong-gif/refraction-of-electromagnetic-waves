      create_file {
        instruction: "export interface OpticalMaterial {\n  id: string;\n  name: string;\n  category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\' | \'Ch\341\272\245t l\341\273\217ng\' | \'Th\341\273\247y tinh & Quang h\341\273\215c\' | \'B\303\241n d\341\272\253n & RF\';\n  refractiveIndex: number;\n  relativePermittivity: number; // epsilon_r = n^2 (for non-magnetic dielectric mu_r = 1)\n  relativePermeability: number; // mu_r\n  abbeNumber?: number;\n  notes: string;\n  tintHex: string; // Subtle background tint for canvas visualization\n}\n\nexport const OPTICAL_MATERIALS: OpticalMaterial[] = [\n  {\n    id: \'vacuum\',\n    name: \'Ch\303\242n kh\303\264ng\',\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\n    refractiveIndex: 1.0,\n    relativePermittivity: 1.0,\n    relativePermeability: 1.0,\n    notes: \'M\303\264i tr\306\260\341\273\235ng chu\341\272\251n tuy\341\273\207t \304\221\341\273\221i, v\341\272\255n t\341\273\221c truy\341\273\201n b\341\272\261ng c.\',\n    tintHex: \'#f8fafc\',\n  },\n  {\n    id: \'air\',\n    name: \'Kh\303\264ng kh\303\255 (STP)\',\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\n    refractiveIndex: 1.0003,\n    relativePermittivity: 1.0006,\n    relativePermeability: 1.0,\n    notes: \'Chi\341\272\277t su\341\272\245t x\341\272\245p x\341\273\211 ch\303\242n kh\303\264ng \341\273\237 \304\221i\341\273\201u ki\341\273\207n ti\303\252u chu\341\272\251n.\',\n    tintHex: \'#f1f5f9\',\n  },\n  {\n    id: \'ice\',\n    name: \'B\304\203ng (N\306\260\341\273\233c \304\221\303\241)\',\n    category: \'Ch\341\272\245t l\341\273\217ng\',\n    refractiveIndex: 1.309,\n    relativePermittivity: 1.713,\n    relativePermeability: 1.0,\n    notes: \'Tinh th\341\273\203 l\341\273\245c gi\303\241c, chi\341\272\277t su\341\272\245t th\341\272\245p h\306\241n n\306\260\341\273\233c l\341\273\217ng.\',\n    tintHex: \'#e0f2fe\',\n  },\n  {\n    id: \'water\',\n    name: \'N\306\260\341\273\233c tinh khi\341\272\277t (20\302\260C)\',\n    category: \'Ch\341\272\245t l\341\273\217ng\',\n    refractiveIndex: 1.333,\n    relativePermittivity: 1.777,\n    relativePermeability: 1.0,\n    abbeNumber: 55.7,\n    notes: \'M\303\264i tr\306\260\341\273\235ng \304\221i\341\273\207n m\303\264i quang h\341\273\215c ph\341\273\225 bi\341\272\277n (\316\273 = 589 nm).\',\n    tintHex: \'#dbeafe\',\n  },\n  {\n    id: \'ptfe\',\n    name: \'Nh\341\273\261a PTFE (Teflon)\',\n    category: \'B\303\241n d\341\272\253n & RF\',\n    refractiveIndex: 1.38,\n    relativePermittivity: 1.904,\n    relativePermeability: 1.0,\n    notes: \'V\341\272\255t li\341\273\207u t\341\273\225n hao th\341\272\245p trong th\341\272\245u k\303\255nh vi s\303\263ng v\303\240 RF.\',\n    tintHex: \'#e2e8f0\',\n  },\n  {\n    id: \'fused-silica\',\n    name: \'Th\341\272\241ch anh n\303\263ng ch\341\272\243y (SiO\342\202\202)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.458,\n    relativePermittivity: 2.126,\n    relativePermeability: 1.0,\n    abbeNumber: 67.8,\n    notes: \'V\341\272\255t li\341\273\207u l\303\265i s\341\273\243i quang truy\341\273\201n d\341\272\253n vi\341\273\205n th\303\264ng.\',\n    tintHex: \'#e0e7ff\',\n  },\n  {\n    id: \'bk7\',\n    name: \'K\303\255nh Crown (BK7)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.517,\n    relativePermittivity: 2.301,\n    relativePermeability: 1.0,\n    abbeNumber: 64.2,\n    notes: \'Th\341\273\247y tinh quang h\341\273\215c ti\303\252u chu\341\272\251n cho l\304\203ng k\303\255nh v\303\240 th\341\272\245u k\303\255nh.\',\n    tintHex: \'#dbeafe\',\n  },\n  {\n    id: \'flint\',\n    name: \'K\303\255nh Flint (SF11)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.785,\n    relativePermittivity: 3.186,\n    relativePermeability: 1.0,\n    abbeNumber: 25.8,\n    notes: \'Chi\341\272\277t su\341\272\245t v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c cao, d\303\271ng cho quang h\341\273\215c t\303\241ch ph\341\273\225.\',\n    tintHex: \'#cbd5e1\',\n  },\n  {\n    id: \'sapphire\',\n    name: \'Sapphire (Al\342\202\202O\342\202\203)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.768,\n    relativePermittivity: 3.126,\n    relativePermeability: 1.0,\n    notes: \'C\341\273\255a s\341\273\225 quang h\341\273\215c ch\341\273\213u nhi\341\273\207t v\303\240 \303\241p su\341\272\245t cao.\',\n    tintHex: \'#d8e3f0\',\n  },\n  {\n    id: \'diamond\',\n    name: \'Kim c\306\260\306\241ng (C)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 2.417,\n    relativePermittivity: 5.842,\n    relativePermeability: 1.0,\n    abbeNumber: 55.3,\n    notes: \'Chi\341\272\277t su\341\272\245t r\341\272\245t cao, g\303\263c t\341\273\233i h\341\272\241n nh\341\273\217 (~24.4\302\260 trong kh\303\264ng kh\303\255).\',\n    tintHex: \'#cffafe\',\n  },\n  {\n    id: \'silicon\',\n    name: \'Silicon (IR / Vi s\303\263ng)\',\n    category: \'B\303\241n d\341\272\253n & RF\',\n    refractiveIndex: 3.42,\n    relativePermittivity: 11.696,\n    relativePermeability: 1.0,\n    notes: \'Ch\341\272\245t b\303\241n d\341\272\253n \304\221i\341\273\207n m\303\264i cao cho h\341\273\223ng ngo\341\272\241i v\303\240 m\341\272\241ch ph\341\272\263ng RF.\',\n    tintHex: \'#cbd5e1\',\n  },\n];\n\nexport type PolarizationMode = \'TE\' | \'TM\' | \'UNPOLARIZED\';\n\nexport type SpectrumBand = \'VISIBLE\' | \'INFRARED\' | \'MICROWAVE\';\n\nexport interface PresetScenario {\n  id: string;\n  title: string;\n  subtitle: string;\n  n1: number;\n  n2: number;\n  material1Id: string;\n  material2Id: string;\n  incidentAngleDeg: number;\n  polarization: PolarizationMode;\n  wavelengthNm: number;\n  band: SpectrumBand;\n}\n\nexport const PRESET_SCENARIOS: PresetScenario[] = [\n  {\n    id: \'air-bk7\',\n    title: \'Kh\303\272c x\341\272\241 chu\341\272\251n (Kh\303\264ng kh\303\255 \342\206\222 K\303\255nh BK7)\',\n    subtitle: \'Tia l\341\273\207ch v\341\273\201 ph\303\241p tuy\341\272\277n, b\306\260\341\273\233c s\303\263ng n\303\251n 1.52 l\341\272\247n\',\n    n1: 1.0003,\n    n2: 1.517,\n    material1Id: \'air\',\n    material2Id: \'bk7\',\n    incidentAngleDeg: 45,\n    polarization: \'UNPOLARIZED\',\n    wavelengthNm: 532,\n    band: \'VISIBLE\',\n  },\n  {\n    id: \'brewster-water\',\n    title: \'G\303\263c Brewster (Kh\303\264ng kh\303\255 \342\206\222 N\306\260\341\273\233c)\',\n    subtitle: \'Tri\341\273\207t ti\303\252u s\303\263ng ph\341\272\243n x\341\272\241 TM (Rp = 0%)\',\n    n1: 1.0003,\n    n2: 1.333,\n    material1Id: \'air\',\n    material2Id: \'water\',\n    incidentAngleDeg: 53.12,\n    polarization: \'TM\',\n    wavelengthNm: 589,\n    band: \'VISIBLE\',\n  },\n  {\n    id: \'tir-glass-air\',\n    title: \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (K\303\255nh BK7 \342\206\222 Kh\303\264ng kh\303\255)\',\n    subtitle: \'\316\270i > \316\270c, R = 100%, xu\341\272\245t hi\341\273\207n s\303\263ng suy gi\341\272\243m b\341\273\201 m\341\272\267t\',\n    n1: 1.517,\n    n2: 1.0003,\n    material1Id: \'bk7\',\n    material2Id: \'air\',\n    incidentAngleDeg: 54,\n    polarization: \'TE\',\n    wavelengthNm: 633,\n    band: \'VISIBLE\',\n  },\n  {\n    id: \'fiber-core\',\n    title: \'D\341\272\253n s\303\263ng s\341\273\243i quang (Th\341\272\241ch anh \342\206\222 Kh\303\264ng kh\303\255)\',\n    subtitle: \'G\303\263c t\341\273\233i h\341\272\241n \316\270c \342\211\210 43.3\302\260, kh\341\272\243o s\303\241t \304\221\341\273\231 s\303\242u xuy\303\252n th\341\272\245u\',\n    n1: 1.458,\n    n2: 1.0003,\n    material1Id: \'fused-silica\',\n    material2Id: \'air\',\n    incidentAngleDeg: 48,\n    polarization: \'TE\',\n    wavelengthNm: 1550,\n    band: \'INFRARED\',\n  },\n  {\n    id: \'rf-silicon\',\n    title: \'Vi s\303\263ng RF 10 GHz (Kh\303\264ng kh\303\255 \342\206\222 Silicon)\',\n    subtitle: \'Ph\341\272\243n x\341\272\241 \304\221i\341\273\207n m\303\264i m\341\272\241nh do ch\303\252nh l\341\273\207ch tr\341\273\237 kh\303\241ng s\303\263ng\',\n    n1: 1.0003,\n    n2: 3.42,\n    material1Id: \'air\',\n    material2Id: \'silicon\',\n    incidentAngleDeg: 35,\n    polarization: \'TM\',\n    wavelengthNm: 30_000_000, // 30 mm = 10 GHz\n    band: \'MICROWAVE\',\n  },\n];\n\nexport function findMaterialById(id: string): OpticalMaterial | undefined {\n  return OPTICAL_MATERIALS.find((m) => m.id === id);\n}\n\nexport function findMaterialLabel(n: number, selectedId: string): string {\n  if (selectedId !== \'custom\') {\n    const mat = findMaterialById(selectedId);\n    if (mat && Math.abs(mat.refractiveIndex - n) < 0.002) {\n      return mat.name;\n    }\n  }\n  return `M\303\264i tr\306\260\341\273\235ng t\303\271y ch\341\273\211nh (n = ${n.toFixed(3)})`;\n}\n"
