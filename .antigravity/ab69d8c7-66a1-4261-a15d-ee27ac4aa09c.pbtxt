            lines {
              text: "          <span className=\"font-medium text-slate-700\">M\303\264i tr\306\260\341\273\235ng:</span> {material1Label} \342\206\222{\' \'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          {material2Label}. \304\220\341\273\213nh lu\341\272\255t b\341\272\243o to\303\240n n\304\203ng l\306\260\341\273\243ng:{\' \'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
