              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Map real penetration depth ratio (delta_e / lambda_0) to crisp pixel decay depth"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
