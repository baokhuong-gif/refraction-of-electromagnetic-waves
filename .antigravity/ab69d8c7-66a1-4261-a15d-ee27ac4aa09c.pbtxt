            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Dynamic 3D E-field Sinusoidal Wave Ribbons (pre-allocated Float32Arrays \342\200\224 zero GC!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const createWaveLine = (colorHex: number) => {"
