              text: "  const padB = 34;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const plotW = W - padL - padR;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
