              text: "      for (let i = 0; i < PHOTON_COUNT_PER_BEAM; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const frac = (i / PHOTON_COUNT_PER_BEAM + (phase * 0.055 * v2Speed)) % 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!p.isTotalInternalReflection && vecs.transDirX !== null && vecs.transDirZ !== null) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dist = frac * 2.15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const s = clamp(0.45 + transStrength * 0.65, 0.45, 1.05);"
