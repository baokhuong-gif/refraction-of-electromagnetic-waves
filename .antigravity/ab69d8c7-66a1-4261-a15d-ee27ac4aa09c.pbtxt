              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    prediction.directionCategory === expectedCategory ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (prediction.directionCategory === \'GRAZING_REFRACTION\' &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      expectedCategory === \'AWAY_FROM_NORMAL\') ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (prediction.directionCategory === \'AWAY_FROM_NORMAL\' &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      expectedCategory === \'GRAZING_REFRACTION\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const angleDiscrepancyDeg ="
