      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Shorten quick preset button labels so they never truncate on desktop or mobile\",\"EndLine\":108,\"Instruction\":\"Use concise labels G\303\263c Brewster and Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n without truncation\",\"ReplacementContent\":\"        {/* Quick 1-click regime buttons for instant testing */}\\n        <div className=\\\"mt-2.5 grid grid-cols-2 gap-1.5\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onSelectScenario(PRESET_SCENARIOS[1])}\\n            className=\\\"px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap cursor-pointer\\\"\\n          >\\n            G\303\263c Brewster\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onSelectScenario(PRESET_SCENARIOS[2])}\\n            className=\\\"px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap cursor-pointer\\\"\\n          >\\n            Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\\n          </button>\\n        </div>\",\"StartLine\":89,\"TargetContent\":\"        {/* Quick 1-click regime buttons for instant testing */}\\n        <div className=\\\"mt-2.5 grid grid-cols-2 gap-1.5\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onSelectScenario(PRESET_SCENARIOS[1])}\\n            className=\\\"px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap truncate cursor-pointer\\\"\\n          >\\n            M\341\272\253u Brewster\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onSelectScenario(PRESET_SCENARIOS[2])}\\n            className=\\\"px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-md hover:bg-slate-100 transition-colors whitespace-nowrap truncate cursor-pointer\\\"\\n          >\\n            M\341\272\253u Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\\n          </button>\\n        </div>\",\"TargetFile\":\"/src/components/ControlDeck.tsx\",\"toolAction\":\"Fixing button truncation in ControlDeck\",\"toolSummary\":\"Fix ControlDeck button labels\"}"
