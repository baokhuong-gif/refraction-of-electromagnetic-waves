              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (Math.abs(n1 - n2) < 0.005) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      code: \'MATCHED_MEDIA\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      label: \'M\303\264i tr\306\260\341\273\235ng \304\221\341\273\223ng nh\341\272\245t \342\200\224 Kh\303\264ng kh\303\272c x\341\272\241\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortTag: \'\304\220\341\273\223ng nh\341\272\245t tr\341\273\237 kh\303\241ng\',"
