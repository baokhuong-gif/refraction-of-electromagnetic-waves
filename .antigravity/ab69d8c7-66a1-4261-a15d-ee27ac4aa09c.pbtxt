              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    notes: \'C\341\273\255a s\341\273\225 quang h\341\273\215c ch\341\273\213u nhi\341\273\207t v\303\240 \303\241p su\341\272\245t cao.\',"
