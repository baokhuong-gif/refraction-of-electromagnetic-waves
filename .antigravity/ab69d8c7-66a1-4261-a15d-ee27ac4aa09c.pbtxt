      id: "call_15985512104795541758"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport * as THREE from \'three\';\\nimport { OrbitControls } from \'three/addons/controls/OrbitControls.js\';\\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\\nimport {\\n  Camera,\\n  ChevronDown,\\n  ChevronUp,\\n  Eye,\\n  Pause,\\n  Play,\\n  RotateCcw,\\n} from \'lucide-react\';\\nimport {\\n  clamp,\\n  formatWavelength,\\n  WavePhysicsResult,\\n  wavelengthToColor,\\n} from \'../physics/emPhysics\';\\nimport { PolarizationMode, PRESET_SCENARIOS, PresetScenario } from \'../physics/materials\';\\nimport {\\n  computeOpticalBenchVectors3D,\\n  createBreadboardTextures,\\n  createContactShadowTexture,\\n  createDielectricBlockAssembly,\\n  createGoniometerDialTexture,\\n  createLaserEmitterAssembly,\\n  createOpticalBenchAssembly,\\n  createPhotodetectorAssembly,\\n} from \'../three/opticalBenchGeometry\';\\n\\ninterface WaveScene3DProps {\\n  physics: WavePhysicsResult;\\n  polarization: PolarizationMode;\\n  wavelengthVacuumNm: number;\\n  material1Label: string;\\n  material2Label: string;\\n  onChangeIncidentAngle: (deg: number) => void;\\n  onChangeN1: (n1: number) => void;\\n  onChangeN2: (n2: number) => void;\\n  onSelectScenario: (scenario: PresetScenario) => void;\\n}\\n\\ntype CameraPresetId = \'ISO\' | \'TOP\' | \'INTERFACE\' | \'EFIELD\';\\n\\ninterface CameraPresetConfig {\\n  id: CameraPresetId;\\n  label: string;\\n  position: [number, number, number];\\n  target: [number, number, number];\\n}\\n\\nconst CAMERA_PRESETS: CameraPresetConfig[] = [\\n  { id: \'ISO\', label: \'T\341\273\225ng quan\', position: [-6.4, 5.4, 7.2], target: [0, 1.85, 0.2] },\\n  { id: \'TOP\', label: \'T\341\273\253 tr\303\252n xu\341\273\221ng\', position: [0.01, 10.6, 0.6], target: [0, 1.85, 0] },\\n  { id: \'INTERFACE\', label: \'M\341\272\267t ph\303\242n c\303\241ch\', position: [-5.8, 2.7, 0.4], target: [0, 1.9, 0.2] },\\n  { id: \'EFIELD\', label: \'C\341\272\255n c\341\272\243nh tr\306\260\341\273\235ng E\', position: [4.2, 3.6, -4.6], target: [0, 2.0, -0.3] },\\n];\\n\\nconst WAVE_SEGMENTS = 96;\\nconst PHOTON_COUNT_PER_BEAM = 12;\\nconst TOTAL_PHOTONS = PHOTON_COUNT_PER_BEAM * 3;\\nconst BEAM_RADIUS_LEN = 2.68;\\n\\n// Pre-allocated module-scope scratch objects for zero-GC render loop\\nconst _mat4 = new THREE.Matrix4();\\nconst _pos = new THREE.Vector3();\\nconst _quat = new THREE.Quaternion();\\nconst _scale = new THREE.Vector3();\\nconst _color = new THREE.Color();\\nconst _upVec = new THREE.Vector3(0, 1, 0);\\nconst _dirVec = new THREE.Vector3();\\nconst _camGoalPos = new THREE.Vector3();\\nconst _camGoalTarget = new THREE.Vector3();\\n\\nfunction detectSoftwareWebGL(): boolean {\\n  try {\\n    const gl = document.createElement(\'canvas\').getContext(\'webgl2\');\\n    if (!gl) return true;\\n    const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\\n    const gpu = String(gl.getParameter(param));\\n    gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\\n    return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\\n  } catch {\\n    return true;\\n  }\\n}\\n\\nfunction updateCylinderBeamTransform(\\n  mesh: THREE.Mesh,\\n  startX: number,\\n  startY: number,\\n  startZ: number,\\n  endX: number,\\n  endY: number,\\n  endZ: number,\\n  radiusScale: number\\n) {\\n  _dirVec.set(endX - startX, endY - startY, endZ - startZ);\\n  const len = _dirVec.length();\\n  if (len < 0.001) {\\n    mesh.visible = false;\\n    return;\\n  }\\n  mesh.visible = true;\\n  mesh.position.set((startX + endX) * 0.5, (startY + endY) * 0.5, (startZ + endZ) * 0.5);\\n  _dirVec.divideScalar(len);\\n  mesh.quaternion.setFromUnitVectors(_upVec, _dirVec);\\n  mesh.scale.set(radiusScale, len, radiusScale);\\n}\\n\\nfunction writeWaveLineVertices(\\n  attr: THREE.BufferAttribute,\\n  startX: number,\\n  startY: number,\\n  startZ: number,\\n  dirX: number,\\n  dirZ: number,\\n  length: number,\\n  wavelengthUnits: number,\\n  phase: number,\\n  amplitude: number,\\n  oscillateVertical: boolean,\\n  evanescentDecay = 0\\n) {\\n  // Perpendicular vector in XZ plane for TM polarization\\n  const perpX = -dirZ;\\n  const perpZ = dirX;\\n  const k = (Math.PI * 2) / Math.max(0.28, wavelengthUnits);\\n\\n  for (let i = 0; i <= WAVE_SEGMENTS; i++) {\\n    const t = i / WAVE_SEGMENTS;\\n    const s = t * length;\\n    const envelope = evanescentDecay > 0 ? Math.exp(-s * evanescentDecay) : 1;\\n    const wave = Math.sin(k * s - phase) * amplitude * envelope;\\n\\n    const px = startX + dirX * s + (oscillateVertical ? 0 : perpX * wave);\\n    const py = startY + (oscillateVertical ? wave : 0);\\n    const pz = startZ + dirZ * s + (oscillateVertical ? 0 : perpZ * wave);\\n\\n    attr.setXYZ(i, px, py, pz);\\n  }\\n  attr.needsUpdate = true;\\n}\\n\\nexport const WaveScene3D: React.FC<WaveScene3DProps> = ({\\n  physics,\\n  polarization,\\n  wavelengthVacuumNm,\\n  material1Label,\\n  material2Label,\\n  onChangeIncidentAngle,\\n  onChangeN1,\\n  onChangeN2,\\n  onSelectScenario,\\n}) => {\\n  const canvasMountRef = useRef<HTMLDivElement | null>(null);\\n  const [isPlaying, setIsPlaying] = useState(true);\\n  const [showEField, setShowEField] = useState(true);\\n  const [dockExpanded, setDockExpanded] = useState(true);\\n  const [activeCamPreset, setActiveCamPreset] = useState<CameraPresetId>(\'ISO\');\\n\\n  // Mutable state refs so React updates never tear down the Three.js WebGL context\\n  const physicsRef = useRef(physics);\\n  const polarizationRef = useRef(polarization);\\n  const wavelengthRef = useRef(wavelengthVacuumNm);\\n  const isPlayingRef = useRef(isPlaying);\\n  const showEFieldRef = useRef(showEField);\\n  const cameraTransitionRef = useRef<{\\n    active: boolean;\\n    pos: [number, number, number];\\n    target: [number, number, number];\\n  }>({\\n    active: false,\\n    pos: CAMERA_PRESETS[0].position,\\n    target: CAMERA_PRESETS[0].target,\\n  });\\n\\n  physicsRef.current = physics;\\n  polarizationRef.current = polarization;\\n  wavelengthRef.current = wavelengthVacuumNm;\\n  isPlayingRef.current = isPlaying;\\n  showEFieldRef.current = showEField;\\n\\n  const triggerCameraPreset = (preset: CameraPresetConfig) => {\\n    setActiveCamPreset(preset.id);\\n    cameraTransitionRef.current = {\\n      active: true,\\n      pos: preset.position,\\n      target: preset.target,\\n    };\\n  };\\n\\n  // Keyboard shortcut H to collapse/expand bottom HUD\\n  useEffect(() => {\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      if (\\n        e.target instanceof HTMLInputElement ||\\n        e.target instanceof HTMLTextAreaElement ||\\n        e.target instanceof HTMLSelectElement\\n      ) {\\n        return;\\n      }\\n      if (e.key === \'h\' || e.key === \'H\') {\\n        setDockExpanded((v) => !v);\\n      }\\n    };\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\\n  }, []);\\n\\n  // Mount Three.js WebGLRenderer & Studio Optical Bench once\\n  useEffect(() => {\\n    const container = canvasMountRef.current;\\n    if (!container) return;\\n\\n    const isSoftwareGl = detectSoftwareWebGL();\\n    const width = Math.max(320, container.clientWidth);\\n    const height = Math.max(360, container.clientHeight);\\n\\n    const scene = new THREE.Scene();\\n    const bgHex = 0xeef2f6;\\n    scene.background = new THREE.Color(bgHex);\\n    scene.fog = new THREE.Fog(bgHex, 18, 42);\\n\\n    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 100);\\n    camera.position.set(...CAMERA_PRESETS[0].position);\\n\\n    const renderer = new THREE.WebGLRenderer({\\n      antialias: !isSoftwareGl,\\n      powerPreference: \'high-performance\',\\n    });\\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\\n    renderer.toneMappingExposure = 1.1;\\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\\n    renderer.setSize(width, height);\\n    renderer.shadowMap.enabled = !isSoftwareGl;\\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\\n\\n    container.innerHTML = \'\';\\n    container.appendChild(renderer.domElement);\\n\\n    // Studio IBL environment map via RoomEnvironment on EVERY device\\n    const pmremGenerator = new THREE.PMREMGenerator(renderer);\\n    const roomEnv = new RoomEnvironment();\\n    const envTarget = pmremGenerator.fromScene(roomEnv, 0.04);\\n    scene.environment = envTarget.texture;\\n    roomEnv.dispose();\\n    pmremGenerator.dispose();\\n\\n    // Warm/cool studio lighting rig (1 shadow-casting directional key + Hemisphere fill + cool rim)\\n    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x334155, 0.85);\\n    hemiLight.position.set(0, 16, 0);\\n    scene.add(hemiLight);\\n\\n    const keyLight = new THREE.DirectionalLight(0xfff4e0, 2.0);\\n    keyLight.position.set(7.5, 11.5, 6.5);\\n    keyLight.castShadow = !isSoftwareGl;\\n    keyLight.shadow.mapSize.width = 1024;\\n    keyLight.shadow.mapSize.height = 1024;\\n    keyLight.shadow.camera.near = 2;\\n    keyLight.shadow.camera.far = 28;\\n    keyLight.shadow.camera.left = -7.5;\\n    keyLight.shadow.camera.right = 7.5;\\n    keyLight.shadow.camera.top = 7.5;\\n    keyLight.shadow.camera.bottom = -7.5;\\n    keyLight.shadow.bias = -0.0005;\\n    keyLight.shadow.normalBias = 0.02;\\n    scene.add(keyLight);\\n\\n    const rimLight = new THREE.DirectionalLight(0x93c5fd, 0.75);\\n    rimLight.position.set(-8, 6, -7);\\n    scene.add(rimLight);\\n\\n    // Studio lab floor & radial contact shadow (grounded at y = 0)\\n    const floorGeo = new THREE.PlaneGeometry(70, 70);\\n    const floorMat = new THREE.MeshStandardMaterial({\\n      color: 0xe2e8f0,\\n      roughness: 0.88,\\n      metalness: 0.05,\\n    });\\n    const floorMesh = new THREE.Mesh(floorGeo, floorMat);\\n    floorMesh.rotation.x = -Math.PI / 2;\\n    floorMesh.position.y = 0;\\n    floorMesh.receiveShadow = true;\\n    scene.add(floorMesh);\\n\\n    const contactShadowTex = createContactShadowTexture();\\n    const contactShadowMat = new THREE.MeshBasicMaterial({\\n      map: contactShadowTex,\\n      transparent: true,\\n      opacity: 0.45,\\n      depthWrite: false,\\n    });\\n    const contactShadowMesh = new THREE.Mesh(new THREE.CircleGeometry(6.8, 48), contactShadowMat);\\n    contactShadowMesh.rotation.x = -Math.PI / 2;\\n    contactShadowMesh.position.y = 0.015;\\n    scene.add(contactShadowMesh);\\n\\n    // Procedural Textures & Composite 3-12 Part Hardware Assemblies\\n    const maxAniso = renderer.capabilities.getMaxAnisotropy();\\n    const breadboardMaps = createBreadboardTextures(maxAniso);\\n    const goniometerDialTex = createGoniometerDialTexture(maxAniso);\\n\\n    const { group: benchGroup, surfaceY } = createOpticalBenchAssembly(\\n      breadboardMaps,\\n      goniometerDialTex,\\n      !isSoftwareGl\\n    );\\n    scene.add(benchGroup);\\n\\n    const beamY = surfaceY + 0.72;\\n\\n    const { pivotGroup: emitterPivot, indicatorRingMat } = createLaserEmitterAssembly(\\n      !isSoftwareGl\\n    );\\n    emitterPivot.position.y = surfaceY;\\n    scene.add(emitterPivot);\\n\\n    const { pivotGroup: detectorPivot, sensorGlowMat } = createPhotodetectorAssembly(\\n      !isSoftwareGl\\n    );\\n    detectorPivot.position.y = surfaceY;\\n    scene.add(detectorPivot);\\n\\n    const { group: dielectricGroup, glassMaterial, medium1AuraMaterial } =\\n      createDielectricBlockAssembly(isSoftwareGl, !isSoftwareGl);\\n    dielectricGroup.position.y = surfaceY;\\n    scene.add(dielectricGroup);\\n\\n    // Dynamic 3D EM Laser Beams (shared unit CylinderGeometry scaled in place)\\n    const unitBeamGeo = new THREE.CylinderGeometry(0.032, 0.032, 1, 14);\\n    const incBeamMat = new THREE.MeshStandardMaterial({\\n      color: 0x22c55e,\\n      emissive: 0x22c55e,\\n      emissiveIntensity: 1.3,\\n      roughness: 0.2,\\n      transparent: true,\\n      opacity: 0.92,\\n    });\\n    const refBeamMat = new THREE.MeshStandardMaterial({\\n      color: 0xe11d48,\\n      emissive: 0xe11d48,\\n      emissiveIntensity: 1.2,\\n      roughness: 0.2,\\n      transparent: true,\\n      opacity: 0.55,\\n    });\\n    const transBeamMat = new THREE.MeshStandardMaterial({\\n      color: 0x059669,\\n      emissive: 0x059669,\\n      emissiveIntensity: 1.2,\\n      roughness: 0.2,\\n      transparent: true,\\n      opacity: 0.88,\\n    });\\n\\n    const incBeamMesh = new THREE.Mesh(unitBeamGeo, incBeamMat);\\n    const refBeamMesh = new THREE.Mesh(unitBeamGeo, refBeamMat);\\n    const transBeamMesh = new THREE.Mesh(unitBeamGeo, transBeamMat);\\n    scene.add(incBeamMesh, refBeamMesh, transBeamMesh);\\n\\n    // Optical interface glowing incidence spot\\n    const hitSpotMat = new THREE.MeshStandardMaterial({\\n      color: 0xffffff,\\n      emissive: 0x38bdf8,\\n      emissiveIntensity: 2.0,\\n      roughness: 0.1,\\n    });\\n    const hitSpotMesh = new THREE.Mesh(new THREE.SphereGeometry(0.085, 16, 16), hitSpotMat);\\n    hitSpotMesh.position.set(0, beamY, 0);\\n    scene.add(hitSpotMesh);\\n\\n    // Dynamic 3D E-field Sinusoidal Wave Ribbons (pre-allocated Float32Arrays \342\200\224 zero GC!)\\n    const createWaveLine = (colorHex: number) => {\\n      const positions = new Float32Array((WAVE_SEGMENTS + 1) * 3);\\n      const geo = new THREE.BufferGeometry();\\n      const attr = new THREE.BufferAttribute(positions, 3);\\n      attr.setUsage(THREE.DynamicDrawUsage);\\n      geo.setAttribute(\'position\', attr);\\n      const mat = new THREE.LineBasicMaterial({\\n        color: colorHex,\\n        transparent: true,\\n        opacity: 0.92,\\n      });\\n      const line = new THREE.Line(geo, mat);\\n      line.frustumCulled = false;\\n      scene.add(line);\\n      return { line, attr, mat, geo };\\n    };\\n\\n    const incWaveTE = createWaveLine(0x16a34a);\\n    const incWaveTM = createWaveLine(0x0284c7);\\n    const refWave = createWaveLine(0xe11d48);\\n    const transWave = createWaveLine(0x059669);\\n    const evanescentWave = createWaveLine(0xd97706);\\n\\n    // Instanced Photonic Wavefront Nodes along all 3 rays (InstancedMesh, frustumCulled = false)\\n    const photonGeo = new THREE.SphereGeometry(0.055, 10, 10);\\n    const photonMat = new THREE.MeshStandardMaterial({\\n      color: 0xffffff,\\n      emissive: 0xffffff,\\n      emissiveIntensity: 0.7,\\n      roughness: 0.2,\\n      metalness: 0.1,\\n    });\\n    const photonMesh = new THREE.InstancedMesh(photonGeo, photonMat, TOTAL_PHOTONS);\\n    photonMesh.frustumCulled = false;\\n    scene.add(photonMesh);\\n\\n    // OrbitControls with exponential damping (disabled on software WebGL per threejs skill)\\n    const controls = new OrbitControls(camera, renderer.domElement);\\n    controls.target.set(...CAMERA_PRESETS[0].target);\\n    controls.enableDamping = !isSoftwareGl;\\n    controls.dampingFactor = 0.06;\\n    controls.maxPolarAngle = Math.PI * 0.485;\\n    controls.minDistance = 4.2;\\n    controls.maxDistance = 17.5;\\n    controls.update();\\n\\n    controls.addEventListener(\'start\', () => {\\n      cameraTransitionRef.current.active = false;\\n    });\\n\\n    if (!isSoftwareGl) {\\n      renderer.compile(scene, camera);\\n    }\\n\\n    // ResizeObserver for crisp container fitting\\n    const handleResize = () => {\\n      const nextW = Math.max(320, container.clientWidth);\\n      const nextH = Math.max(360, container.clientHeight);\\n      camera.aspect = nextW / nextH;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(nextW, nextH);\\n    };\\n    const resizeObserver = new ResizeObserver(handleResize);\\n    resizeObserver.observe(container);\\n\\n    // Smooth damped mechanical state\\n    let dampedThetaI = physicsRef.current.incidentAngleRad;\\n    let phase = 0;\\n    let lastTime = performance.now();\\n    let frameId = 0;\\n    let disposed = false;\\n\\n    const afterDraw = (cb: () => void) => {\\n      const gl = renderer.getContext() as WebGL2RenderingContext;\\n      const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\\n      gl.flush();\\n      const poll = () => {\\n        if (disposed) {\\n          if (sync) gl.deleteSync(sync);\\n          return;\\n        }\\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\\n        if (state === gl.UNSIGNALED) {\\n          frameId = window.setTimeout(poll, 5);\\n        } else {\\n          if (sync) gl.deleteSync(sync);\\n          frameId = window.setTimeout(cb, 80);\\n        }\\n      };\\n      frameId = window.setTimeout(poll, 5);\\n    };\\n\\n    const tick = () => {\\n      if (disposed) return;\\n      const now = performance.now();\\n      const dt = Math.min(0.06, (now - lastTime) / 1000);\\n      lastTime = now;\\n\\n      const p = physicsRef.current;\\n      const pol = polarizationRef.current;\\n      const waveHex = wavelengthToColor(wavelengthRef.current);\\n\\n      if (isPlayingRef.current) {\\n        phase = (phase + dt * 5.2) % (Math.PI * 200);\\n      }\\n\\n      // Smooth camera preset damping\\n      if (cameraTransitionRef.current.active) {\\n        const [gx, gy, gz] = cameraTransitionRef.current.pos;\\n        const [tx, ty, tz] = cameraTransitionRef.current.target;\\n        _camGoalPos.set(gx, gy, gz);\\n        _camGoalTarget.set(tx, ty, tz);\\n\\n        const k = isSoftwareGl ? 18 : 6.5;\\n        const alpha = 1 - Math.exp(-k * dt);\\n        camera.position.lerp(_camGoalPos, alpha);\\n        controls.target.lerp(_camGoalTarget, alpha);\\n\\n        if (\\n          camera.position.distanceToSquared(_camGoalPos) < 0.002 &&\\n          controls.target.distanceToSquared(_camGoalTarget) < 0.002\\n        ) {\\n          camera.position.copy(_camGoalPos);\\n          controls.target.copy(_camGoalTarget);\\n          cameraTransitionRef.current.active = false;\\n        }\\n      }\\n\\n      // Smooth mechanical emitter & photodetector goniometer swing\\n      dampedThetaI = THREE.MathUtils.damp(\\n        dampedThetaI,\\n        p.incidentAngleRad,\\n        isSoftwareGl ? 24 : 11,\\n        dt\\n      );\\n      emitterPivot.rotation.y = dampedThetaI;\\n      detectorPivot.rotation.y = -dampedThetaI;\\n\\n      // Update optical material visual properties based on refractive indices n1, n2\\n      glassMaterial.ior = clamp(p.n2, 1.0, 2.33);\\n      const n2Tint = clamp((p.n2 - 1.0) / 2.4, 0, 1);\\n      glassMaterial.color.setRGB(\\n        0.85 - n2Tint * 0.42,\\n        0.95 - n2Tint * 0.24,\\n        1.0 - n2Tint * 0.06\\n      );\\n      glassMaterial.opacity = isSoftwareGl ? clamp(0.18 + n2Tint * 0.36, 0.14, 0.56) : 0.92;\\n\\n      const m1Opacity = p.n1 > 1.05 ? clamp((p.n1 - 1.0) * 0.18, 0.08, 0.34) : 0;\\n      medium1AuraMaterial.opacity = m1Opacity;\\n\\n      // Update beam & emitter colors\\n      _color.set(waveHex);\\n      indicatorRingMat.color.copy(_color);\\n      indicatorRingMat.emissive.copy(_color);\\n      incBeamMat.color.copy(_color);\\n      incBeamMat.emissive.copy(_color);\\n      hitSpotMat.emissive.copy(_color);\\n\\n      const vecs = computeOpticalBenchVectors3D(dampedThetaI, p.refractedAngleRad);\\n      const startX = -vecs.incDirX * BEAM_RADIUS_LEN;\\n      const startZ = -vecs.incDirZ * BEAM_RADIUS_LEN;\\n\\n      // Incident beam from emitter nozzle to origin (0, beamY, 0)\\n      updateCylinderBeamTransform(incBeamMesh, startX, beamY, startZ, 0, beamY, 0, 1.0);\\n\\n      // Reflected beam from origin toward detector\\n      const refStrength = Math.sqrt(clamp(p.reflectanceEffective, 0, 1));\\n      refBeamMat.opacity = clamp(0.18 + refStrength * 0.82, 0.18, 0.96);\\n      sensorGlowMat.emissiveIntensity = 0.3 + refStrength * 2.1;\\n      updateCylinderBeamTransform(\\n        refBeamMesh,\\n        0,\\n        beamY,\\n        0,\\n        vecs.refDirX * BEAM_RADIUS_LEN,\\n        beamY,\\n        vecs.refDirZ * BEAM_RADIUS_LEN,\\n        clamp(0.45 + refStrength * 0.6, 0.45, 1.05)\\n      );\\n\\n      // Refracted beam into dielectric block (hidden in TIR)\\n      const transStrength = Math.sqrt(clamp(p.transmittanceEffective, 0, 1));\\n      if (!p.isTotalInternalReflection && vecs.transDirX !== null && vecs.transDirZ !== null) {\\n        transBeamMat.opacity = clamp(0.2 + transStrength * 0.8, 0.2, 0.96);\\n        updateCylinderBeamTransform(\\n          transBeamMesh,\\n          0,\\n          beamY,\\n          0,\\n          vecs.transDirX * 2.22,\\n          beamY,\\n          vecs.transDirZ * 2.22,\\n          clamp(0.45 + transStrength * 0.6, 0.45, 1.05)\\n        );\\n      } else {\\n        transBeamMesh.visible = false;\\n      }\\n\\n      // 3D E-field wave ribbons showing TE vs TM polarization and wavelength compression\\n      const showWaves = showEFieldRef.current;\\n      const lambda1Units = clamp(0.85 / p.n1, 0.28, 1.05);\\n      const lambda2Units = clamp(0.85 / p.n2, 0.22, 1.05);\\n\\n      incWaveTE.line.visible = showWaves && (pol === \'TE\' || pol === \'UNPOLARIZED\');\\n      incWaveTM.line.visible = showWaves && (pol === \'TM\' || pol === \'UNPOLARIZED\');\\n      incWaveTE.mat.color.copy(_color);\\n\\n      if (incWaveTE.line.visible) {\\n        writeWaveLineVertices(\\n          incWaveTE.attr,\\n          startX,\\n          beamY,\\n          startZ,\\n          vecs.incDirX,\\n          vecs.incDirZ,\\n          BEAM_RADIUS_LEN,\\n          lambda1Units,\\n          phase,\\n          0.26,\\n          true\\n        );\\n      }\\n      if (incWaveTM.line.visible) {\\n        writeWaveLineVertices(\\n          incWaveTM.attr,\\n          startX,\\n          beamY,\\n          startZ,\\n          vecs.incDirX,\\n          vecs.incDirZ,\\n          BEAM_RADIUS_LEN,\\n          lambda1Units,\\n          phase,\\n          0.24,\\n          false\\n        );\\n      }\\n\\n      refWave.line.visible = showWaves && refStrength > 0.08;\\n      if (refWave.line.visible) {\\n        const phaseShiftRad =\\n          pol === \'TM\'\\n            ? (p.phaseShiftReflectedPDeg * Math.PI) / 180\\n            : (p.phaseShiftReflectedSDeg * Math.PI) / 180;\\n        writeWaveLineVertices(\\n          refWave.attr,\\n          0,\\n          beamY,\\n          0,\\n          vecs.refDirX,\\n          vecs.refDirZ,\\n          BEAM_RADIUS_LEN,\\n          lambda1Units,\\n          phase - phaseShiftRad,\\n          0.24 * clamp(refStrength, 0.25, 1),\\n          pol !== \'TM\'\\n        );\\n      }\\n\\n      transWave.line.visible =\\n        showWaves &&\\n        !p.isTotalInternalReflection &&\\n        vecs.transDirX !== null &&\\n        vecs.transDirZ !== null;\\n      if (transWave.line.visible && vecs.transDirX !== null && vecs.transDirZ !== null) {\\n        writeWaveLineVertices(\\n          transWave.attr,\\n          0,\\n          beamY,\\n          0,\\n          vecs.transDirX,\\n          vecs.transDirZ,\\n          2.18,\\n          lambda2Units,\\n          phase,\\n          0.26 * clamp(transStrength, 0.25, 1),\\n          pol !== \'TM\'\\n        );\\n      }\\n\\n      // 3D Evanescent Surface Wave decaying along +X/+Z boundary in TIR\\n      evanescentWave.line.visible = showWaves && p.isTotalInternalReflection;\\n      if (evanescentWave.line.visible) {\\n        writeWaveLineVertices(\\n          evanescentWave.attr,\\n          0,\\n          beamY,\\n          0.16,\\n          1,\\n          0.12,\\n          2.05,\\n          lambda1Units * 0.8,\\n          phase,\\n          0.3,\\n          true,\\n          1.35\\n        );\\n      }\\n\\n      // Update Instanced Photonic Wavefront Nodes along incident, reflected, refracted rays\\n      const v1Speed = 1 / p.n1;\\n      const v2Speed = 1 / p.n2;\\n      _quat.identity();\\n      let idx = 0;\\n\\n      // 1. Incident wavefront nodes\\n      _color.set(waveHex);\\n      for (let i = 0; i < PHOTON_COUNT_PER_BEAM; i++) {\\n        const frac = (i / PHOTON_COUNT_PER_BEAM + (phase * 0.055 * v1Speed)) % 1;\\n        const dist = frac * BEAM_RADIUS_LEN;\\n        _pos.set(startX + vecs.incDirX * dist, beamY, startZ + vecs.incDirZ * dist);\\n        _scale.set(1, 1, 1);\\n        _mat4.compose(_pos, _quat, _scale);\\n        photonMesh.setMatrixAt(idx, _mat4);\\n        photonMesh.setColorAt(idx, _color);\\n        idx++;\\n      }\\n\\n      // 2. Reflected wavefront nodes\\n      _color.setHex(0xe11d48);\\n      for (let i = 0; i < PHOTON_COUNT_PER_BEAM; i++) {\\n        const frac = (i / PHOTON_COUNT_PER_BEAM + (phase * 0.055 * v1Speed)) % 1;\\n        const dist = frac * BEAM_RADIUS_LEN;\\n        const s = refStrength > 0.08 ? clamp(0.45 + refStrength * 0.65, 0.45, 1.05) : 0.0001;\\n        _pos.set(vecs.refDirX * dist, beamY, vecs.refDirZ * dist);\\n        _scale.set(s, s, s);\\n        _mat4.compose(_pos, _quat, _scale);\\n        photonMesh.setMatrixAt(idx, _mat4);\\n        photonMesh.setColorAt(idx, _color);\\n        idx++;\\n      }\\n\\n      // 3. Refracted (or evanescent) wavefront nodes\\n      _color.setHex(p.isTotalInternalReflection ? 0xd97706 : 0x059669);\\n      for (let i = 0; i < PHOTON_COUNT_PER_BEAM; i++) {\\n        const frac = (i / PHOTON_COUNT_PER_BEAM + (phase * 0.055 * v2Speed)) % 1;\\n        if (!p.isTotalInternalReflection && vecs.transDirX !== null && vecs.transDirZ !== null) {\\n          const dist = frac * 2.15;\\n          const s = clamp(0.45 + transStrength * 0.65, 0.45, 1.05);\\n          _pos.set(vecs.transDirX * dist, beamY, vecs.transDirZ * dist);\\n          _scale.set(s, s, s);\\n        } else {\\n          // Evanescent surface decay dots hugging the interface\\n          const dist = frac * 1.65;\\n          const s = clamp(Math.exp(-dist * 1.4), 0.12, 0.9);\\n          _pos.set(dist, beamY, 0.16);\\n          _scale.set(s, s, s);\\n        }\\n        _mat4.compose(_pos, _quat, _scale);\\n        photonMesh.setMatrixAt(idx, _mat4);\\n        photonMesh.setColorAt(idx, _color);\\n        idx++;\\n      }\\n\\n      photonMesh.instanceMatrix.needsUpdate = true;\\n      if (photonMesh.instanceColor) photonMesh.instanceColor.needsUpdate = true;\\n\\n      controls.update();\\n      renderer.render(scene, camera);\\n\\n      if (isSoftwareGl) {\\n        afterDraw(tick);\\n      } else {\\n        frameId = requestAnimationFrame(tick);\\n      }\\n    };\\n\\n    tick();\\n\\n    return () => {\\n      disposed = true;\\n      cancelAnimationFrame(frameId);\\n      window.clearTimeout(frameId);\\n      resizeObserver.disconnect();\\n      controls.dispose();\\n      breadboardMaps.albedo.dispose();\\n      breadboardMaps.bump.dispose();\\n      goniometerDialTex.dispose();\\n      contactShadowTex.dispose();\\n      envTarget.dispose();\\n      unitBeamGeo.dispose();\\n      photonGeo.dispose();\\n      incWaveTE.geo.dispose();\\n      incWaveTM.geo.dispose();\\n      refWave.geo.dispose();\\n      transWave.geo.dispose();\\n      evanescentWave.geo.dispose();\\n      scene.traverse((obj) => {\\n        if (obj instanceof THREE.Mesh) {\\n          obj.geometry?.dispose();\\n          if (Array.isArray(obj.material)) {\\n            obj.material.forEach((m) => m.dispose());\\n          } else {\\n            obj.material?.dispose();\\n          }\\n        }\\n      });\\n      renderer.dispose();\\n    };\\n  }, []);\\n\\n  return (\\n    <section\\n      aria-label=\\\"Ph\303\262ng th\303\255 nghi\341\273\207m kh\303\272c x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 3D\\\"\\n      className=\\\"relative w-full h-[calc(100vh-3.5rem)] min-h-[560px] overflow-hidden bg-[#eef2f6] select-none\\\"\\n      data-testid=\\\"wave-scene-3d\\\"\\n      data-regime={physics.classification.code}\\n    >\\n      {/* Dedicated WebGL mount container outside sibling React HUD overlays */}\\n      <div ref={canvasMountRef} className=\\\"absolute inset-0 w-full h-full\\\" />\\n\\n      {/* Minimal Top-Left Optical Telemetry Readout (solid/rgba surface, NO backdrop-filter over WebGL) */}\\n      <div className=\\\"pointer-events-none absolute top-4 left-4 z-10 max-w-xs sm:max-w-sm rounded-xl border border-slate-300/90 bg-[rgba(255,255,255,0.93)] px-4 py-3 shadow-sm\\\">\\n        <div className=\\\"flex items-center justify-between gap-3\\\">\\n          <span className=\\\"text-xs font-semibold text-slate-900\\\">B\303\240n quang h\341\273\215c 3D</span>\\n          <span className=\\\"font-mono text-[11px] font-semibold text-sky-800\\\">\\n            {physics.classification.shortTag}\\n          </span>\\n        </div>\\n        <div className=\\\"mt-1 text-[11px] text-slate-600 truncate\\\">\\n          {material1Label} (n\342\202\201={physics.n1.toFixed(3)}) \342\206\222 {material2Label} (n\342\202\202={physics.n2.toFixed(3)})\\n        </div>\\n        <div className=\\\"mt-2 grid grid-cols-4 gap-2 border-t border-slate-200 pt-2 font-mono text-[11px] tabular-nums\\\">\\n          <div>\\n            <div className=\\\"text-slate-400 text-[10px]\\\">\316\270i</div>\\n            <div className=\\\"font-semibold text-slate-900\\\">{physics.incidentAngleDeg.toFixed(1)}\302\260</div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-400 text-[10px]\\\">\316\270t</div>\\n            <div className=\\\"font-semibold text-emerald-700\\\">\\n              {physics.refractedAngleDeg !== null ? `${physics.refractedAngleDeg.toFixed(1)}\302\260` : \'TIR\'}\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-400 text-[10px]\\\">R / T</div>\\n            <div className=\\\"font-semibold text-rose-700\\\">\\n              {(physics.reflectanceEffective * 100).toFixed(0)}/\\n              {(physics.transmittanceEffective * 100).toFixed(0)}%\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-400 text-[10px]\\\">\316\273\342\202\202</div>\\n            <div className=\\\"font-semibold text-slate-800\\\">{formatWavelength(physics.wavelength2Nm)}</div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Collapsible Unified Bottom Control Dock (Zero Mid-Screen Occlusion, NO backdrop-filter) */}\\n      <div className=\\\"absolute bottom-4 left-1/2 -translate-x-1/2 z-10 w-[min(920px,94vw)] flex flex-col items-center\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setDockExpanded((v) => !v)}\\n          aria-expanded={dockExpanded}\\n          className=\\\"inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-medium text-slate-700 bg-[rgba(255,255,255,0.95)] border border-slate-300 border-b-0 rounded-t-lg hover:bg-slate-50 transition-colors cursor-pointer\\\"\\n        >\\n          {dockExpanded ? <ChevronDown className=\\\"w-3.5 h-3.5\\\" /> : <ChevronUp className=\\\"w-3.5 h-3.5\\\" />}\\n          {dockExpanded ? \'\341\272\250n b\341\272\243ng \304\221i\341\273\201u khi\341\273\203n (H)\' : \'Hi\341\273\207n b\341\272\243ng \304\221i\341\273\201u khi\341\273\203n (H)\'}\\n        </button>\\n\\n        {dockExpanded && (\\n          <div className=\\\"w-full rounded-xl border border-slate-300 bg-[rgba(255,255,255,0.96)] p-3.5 shadow-md space-y-3\\\">\\n            {/* Row 1: Camera Presets + Playback + Scenarios */}\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-1.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsPlaying((v) => !v)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-800 hover:bg-slate-100 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  {isPlaying ? <Pause className=\\\"w-3.5 h-3.5\\\" /> : <Play className=\\\"w-3.5 h-3.5\\\" />}\\n                  {isPlaying ? \'T\341\272\241m d\341\273\253ng\' : \'Ph\303\241t s\303\263ng\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  aria-pressed={showEField}\\n                  onClick={() => setShowEField((v) => !v)}\\n                  className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md border cursor-pointer whitespace-nowrap ${\\n                    showEField\\n                      ? \'bg-sky-50 border-sky-200 text-sky-900\'\\n                      : \'bg-white border-slate-200 text-slate-600 hover:bg-slate-50\'\\n                  }`}\\n                >\\n                  <Eye className=\\\"w-3.5 h-3.5\\\" />\\n                  Tr\306\260\341\273\235ng E 3D\\n                </button>\\n\\n                <div\\n                  role=\\\"group\\\"\\n                  aria-label=\\\"G\303\263c nh\303\254n camera 3D\\\"\\n                  className=\\\"inline-flex items-center gap-1 pl-1.5 border-l border-slate-200\\\"\\n                >\\n                  <Camera className=\\\"w-3.5 h-3.5 text-slate-400 hidden sm:block mr-0.5\\\" />\\n                  {CAMERA_PRESETS.map((preset) => (\\n                    <button\\n                      key={preset.id}\\n                      type=\\\"button\\\"\\n                      aria-pressed={activeCamPreset === preset.id}\\n                      onClick={() => triggerCameraPreset(preset)}\\n                      className={`px-2 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                        activeCamPreset === preset.id\\n                          ? \'bg-slate-900 text-white\'\\n                          : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                      }`}\\n                    >\\n                      {preset.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-1.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onSelectScenario(PRESET_SCENARIOS[1])}\\n                  className=\\\"px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 bg-white text-slate-700 hover:bg-amber-50 hover:border-amber-200 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  G\303\263c Brewster\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onSelectScenario(PRESET_SCENARIOS[2])}\\n                  className=\\\"px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 bg-white text-slate-700 hover:bg-rose-50 hover:border-rose-200 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    onSelectScenario(PRESET_SCENARIOS[0]);\\n                    triggerCameraPreset(CAMERA_PRESETS[0]);\\n                  }}\\n                  aria-label=\\\"\304\220\341\272\267t l\341\272\241i c\341\272\243nh 3D\\\"\\n                  className=\\\"p-1.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 cursor-pointer\\\"\\n                >\\n                  <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Row 2: Direct Compact Physical Sliders (\316\270i, n1, n2) */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-200\\\">\\n              <label className=\\\"flex flex-col gap-1\\\">\\n                <span className=\\\"flex items-center justify-between text-[11px] font-medium text-slate-700\\\">\\n                  <span>G\303\263c t\341\273\233i \316\270i</span>\\n                  <span className=\\\"font-mono tabular-nums text-sky-800\\\">\\n                    {physics.incidentAngleDeg.toFixed(1)}\302\260\\n                  </span>\\n                </span>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={0}\\n                  max={89}\\n                  step={0.5}\\n                  value={physics.incidentAngleDeg}\\n                  onChange={(e) => onChangeIncidentAngle(Number(e.target.value))}\\n                  aria-label=\\\"\304\220i\341\273\201u ch\341\273\211nh g\303\263c t\341\273\233i 3D\\\"\\n                  className=\\\"w-full accent-sky-700 cursor-pointer\\\"\\n                />\\n              </label>\\n\\n              <label className=\\\"flex flex-col gap-1\\\">\\n                <span className=\\\"flex items-center justify-between text-[11px] font-medium text-slate-700\\\">\\n                  <span>Chi\341\272\277t su\341\272\245t n\342\202\201</span>\\n                  <span className=\\\"font-mono tabular-nums text-sky-800\\\">{physics.n1.toFixed(3)}</span>\\n                </span>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={1.0}\\n                  max={3.5}\\n                  step={0.005}\\n                  value={physics.n1}\\n                  onChange={(e) => onChangeN1(Number(e.target.value))}\\n                  aria-label=\\\"\304\220i\341\273\201u ch\341\273\211nh chi\341\272\277t su\341\272\245t n1 3D\\\"\\n                  className=\\\"w-full accent-sky-700 cursor-pointer\\\"\\n                />\\n              </label>\\n\\n              <label className=\\\"flex flex-col gap-1\\\">\\n                <span className=\\\"flex items-center justify-between text-[11px] font-medium text-slate-700\\\">\\n                  <span>Chi\341\272\277t su\341\272\245t n\342\202\202</span>\\n                  <span className=\\\"font-mono tabular-nums text-indigo-800\\\">\\n                    {physics.n2.toFixed(3)}\\n                  </span>\\n                </span>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={1.0}\\n                  max={3.5}\\n                  step={0.005}\\n                  value={physics.n2}\\n                  onChange={(e) => onChangeN2(Number(e.target.value))}\\n                  aria-label=\\\"\304\220i\341\273\201u ch\341\273\211nh chi\341\272\277t su\341\272\245t n2 3D\\\"\\n                  className=\\\"w-full accent-indigo-600 cursor-pointer\\\"\\n                />\\n              </label>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </section>\\n  );\\n};\\n\",\"Description\":\"Create full-bleed interactive Three.js 3D optical refraction bench component with RoomEnvironment PBR lighting, software-WebGL afterDraw pacing, animated 3D E-field waves, InstancedMesh wavefronts, and collapsible bottom dock.\",\"Overwrite\":true,\"TargetFile\":\"/src/components/WaveScene3D.tsx\",\"toolAction\":\"Creating Three.js 3D lab component\",\"toolSummary\":\"Create WaveScene3D.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15985512104795541517"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useState } from \'react\';\\nimport {\\n  ArrowRight,\\n  ExternalLink,\\n  Globe,\\n  History,\\n  Loader2,\\n  Search,\\n  Sparkles,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../contexts/AuthContext\';\\nimport { formatWavelength } from \'../physics/emPhysics\';\\n\\ninterface GroundedSource {\\n  title: string;\\n  uri: string;\\n}\\n\\ninterface SearchResultPayload {\\n  answer: string;\\n  suggestedN: number | null;\\n  sources: GroundedSource[];\\n  searchQueries: string[];\\n}\\n\\ninterface SavedSearchLogItem {\\n  id: number;\\n  query: string;\\n  summary: string;\\n  suggestedN: number | null;\\n  wavelengthNm: number | null;\\n  sources: GroundedSource[];\\n  createdAt: string;\\n}\\n\\ninterface MaterialSearchViewProps {\\n  currentN1: number;\\n  currentN2: number;\\n  wavelengthVacuumNm: number;\\n  onApplyRefractiveIndex: (n2: number, labelHint?: string) => void;\\n}\\n\\nconst EXAMPLE_QUERIES = [\\n  \'Chi\341\272\277t su\341\272\245t k\303\255nh quang h\341\273\215c N-BK7 v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c \341\273\237 b\306\260\341\273\233c s\303\263ng 532 nm\',\\n  \'H\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i v\303\240 chi\341\272\277t su\341\272\245t Silicon \304\221\306\241n tinh th\341\273\203 \341\273\237 b\304\203ng vi s\303\263ng 10 GHz\',\\n  \'Chi\341\272\277t su\341\272\245t n\306\260\341\273\233c bi\341\273\203n theo \304\221\341\273\231 m\341\272\267n v\303\240 nhi\341\273\207t \304\221\341\273\231 trong v\303\271ng \303\241nh s\303\241ng kh\341\272\243 ki\341\272\277n\',\\n  \'Chi\341\272\277t su\341\272\245t tinh th\341\273\203 Sapphire (Al2O3) v\303\240 \341\273\251ng d\341\273\245ng c\341\273\255a s\341\273\225 quang h\341\273\215c\',\\n];\\n\\nexport const MaterialSearchView: React.FC<MaterialSearchViewProps> = ({\\n  currentN1,\\n  currentN2,\\n  wavelengthVacuumNm,\\n  onApplyRefractiveIndex,\\n}) => {\\n  const { user, getIdToken } = useAuth();\\n  const [query, setQuery] = useState(EXAMPLE_QUERIES[0]);\\n  const [loading, setLoading] = useState(false);\\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\\n  const [result, setResult] = useState<SearchResultPayload | null>(null);\\n  const [history, setHistory] = useState<SavedSearchLogItem[]>([]);\\n\\n  const loadHistory = useCallback(async () => {\\n    if (!user) {\\n      setHistory([]);\\n      return;\\n    }\\n    const token = await getIdToken();\\n    if (!token) return;\\n    try {\\n      const res = await fetch(\'/api/search/history\', {\\n        headers: { Authorization: `Bearer ${token}` },\\n      });\\n      if (!res.ok) return;\\n      const data = (await res.json()) as { history?: SavedSearchLogItem[] };\\n      if (Array.isArray(data.history)) {\\n        setHistory(data.history);\\n      }\\n    } catch {\\n      // Non-fatal history refresh failure\\n    }\\n  }, [user, getIdToken]);\\n\\n  useEffect(() => {\\n    void loadHistory();\\n  }, [loadHistory]);\\n\\n  const executeSearch = async (targetQuery: string) => {\\n    const trimmed = targetQuery.trim();\\n    if (trimmed.length < 2) {\\n      setErrorMsg(\'Vui l\303\262ng nh\341\272\255p t\341\273\253 kh\303\263a v\341\272\255t li\341\273\207u ho\341\272\267c hi\341\273\207n t\306\260\341\273\243ng quang h\341\273\215c c\341\272\247n tra c\341\273\251u.\');\\n      return;\\n    }\\n\\n    setLoading(true);\\n    setErrorMsg(null);\\n    try {\\n      const headers: Record<string, string> = {\\n        \'Content-Type\': \'application/json\',\\n      };\\n      const token = await getIdToken();\\n      if (token) {\\n        headers.Authorization = `Bearer ${token}`;\\n      }\\n\\n      const response = await fetch(\'/api/search/material\', {\\n        method: \'POST\',\\n        headers,\\n        body: JSON.stringify({\\n          query: trimmed,\\n          wavelengthNm: wavelengthVacuumNm,\\n          currentN1,\\n          currentN2,\\n        }),\\n      });\\n\\n      const data = await response.json();\\n      if (!response.ok) {\\n        throw new Error(data?.error || \'Kh\303\264ng th\341\273\203 ho\303\240n t\341\272\245t tra c\341\273\251u d\341\273\257 li\341\273\207u l\303\272c n\303\240y.\');\\n      }\\n\\n      setResult(data as SearchResultPayload);\\n      if (user) {\\n        void loadHistory();\\n      }\\n    } catch (err: unknown) {\\n      setErrorMsg(\\n        err instanceof Error ? err.message : \'\304\220\303\243 x\341\272\243y ra l\341\273\227i khi tra c\341\273\251u d\341\273\257 li\341\273\207u tr\341\273\261c tuy\341\272\277n.\'\\n      );\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    void executeSearch(query);\\n  };\\n\\n  return (\\n    <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n      {/* Left: Search Form & Preset Research Queries */}\\n      <section\\n        aria-label=\\\"Tra c\341\273\251u d\341\273\257 li\341\273\207u v\341\272\255t li\341\273\207u \304\221i\341\273\207n m\303\264i qua Google Search\\\"\\n        className=\\\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 space-y-5\\\"\\n      >\\n        <div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Globe className=\\\"w-4 h-4 text-sky-700\\\" aria-hidden=\\\"true\\\" />\\n            <h1 className=\\\"text-lg font-semibold text-slate-900\\\">\\n              Tra c\341\273\251u v\341\272\255t li\341\273\207u & d\341\273\257 li\341\273\207u quang h\341\273\215c\\n            </h1>\\n          </div>\\n          <p className=\\\"text-xs text-slate-500 mt-1.5 leading-relaxed\\\">\\n            T\303\254m ki\341\272\277m th\303\264ng s\341\273\221 chi\341\272\277t su\341\272\245t theo b\306\260\341\273\233c s\303\263ng, h\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i v\303\240 t\303\240i li\341\273\207u th\341\273\261c nghi\341\273\207m\\n            m\341\273\233i nh\341\272\245t t\341\273\253 Google Search \304\221\341\273\203 n\341\272\241p tr\341\273\261c ti\341\272\277p v\303\240o b\341\273\231 m\303\264 ph\341\273\217ng.\\n          </p>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"space-y-3\\\">\\n          <div>\\n            <label htmlFor=\\\"material-search-input\\\" className=\\\"block text-xs font-medium text-slate-700 mb-1.5\\\">\\n              C\303\242u h\341\273\217i ho\341\272\267c t\303\252n v\341\272\255t li\341\273\207u c\341\272\247n tra c\341\273\251u\\n            </label>\\n            <textarea\\n              id=\\\"material-search-input\\\"\\n              rows={3}\\n              value={query}\\n              onChange={(e) => setQuery(e.target.value)}\\n              placeholder=\\\"V\303\255 d\341\273\245: Chi\341\272\277t su\341\272\245t th\341\272\241ch anh n\303\263ng ch\341\272\243y SiO2 \341\273\237 1550 nm...\\\"\\n              className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none resize-none\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"flex items-center justify-between text-[11px] font-mono text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2\\\">\\n            <span>B\341\273\221i c\341\272\243nh hi\341\273\207n t\341\272\241i:</span>\\n            <span className=\\\"tabular-nums text-slate-700\\\">\\n              \316\273\342\202\200={formatWavelength(wavelengthVacuumNm)} \302\267 n\342\202\201={currentN1.toFixed(3)} \302\267 n\342\202\202=\\n              {currentN2.toFixed(3)}\\n            </span>\\n          </div>\\n\\n          {errorMsg && (\\n            <div\\n              role=\\\"alert\\\"\\n              className=\\\"rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-800\\\"\\n            >\\n              {errorMsg}\\n            </div>\\n          )}\\n\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={loading}\\n            className=\\\"w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 text-sm font-semibold text-white bg-sky-700 hover:bg-sky-800 disabled:opacity-60 rounded-lg transition-colors cursor-pointer\\\"\\n          >\\n            {loading ? (\\n              <>\\n                <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                \304\220ang t\303\254m ki\341\272\277m ngu\341\273\223n x\303\241c th\341\273\261c...\\n              </>\\n            ) : (\\n              <>\\n                <Search className=\\\"w-4 h-4\\\" />\\n                Tra c\341\273\251u Google Search\\n              </>\\n            )}\\n          </button>\\n        </form>\\n\\n        <div className=\\\"pt-4 border-t border-slate-200 space-y-2\\\">\\n          <div className=\\\"text-xs font-semibold text-slate-800\\\">G\341\273\243i \303\275 tra c\341\273\251u nhanh</div>\\n          <div className=\\\"space-y-1.5\\\">\\n            {EXAMPLE_QUERIES.map((example) => (\\n              <button\\n                key={example}\\n                type=\\\"button\\\"\\n                disabled={loading}\\n                onClick={() => {\\n                  setQuery(example);\\n                  void executeSearch(example);\\n                }}\\n                className=\\\"w-full text-left px-3 py-2 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-sky-50/70 hover:border-sky-300 text-xs text-slate-700 transition-colors cursor-pointer\\\"\\n              >\\n                {example}\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Right: Grounded Answer, Extracted Refractive Index CTA, Sources & History */}\\n      <section\\n        aria-label=\\\"K\341\272\277t qu\341\272\243 tra c\341\273\251u v\303\240 ngu\341\273\223n tham kh\341\272\243o\\\"\\n        className=\\\"lg:col-span-7 space-y-5\\\"\\n      >\\n        {!result ? (\\n          <div className=\\\"bg-white border border-slate-200 rounded-xl p-8 text-center\\\">\\n            <Sparkles className=\\\"w-7 h-7 text-sky-600 mx-auto mb-3\\\" aria-hidden=\\\"true\\\" />\\n            <h2 className=\\\"text-sm font-semibold text-slate-900\\\">\\n              S\341\272\265n s\303\240ng tra c\341\273\251u d\341\273\257 li\341\273\207u quang h\341\273\215c & \304\221i\341\273\207n m\303\264i tr\341\273\261c tuy\341\272\277n\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500 mt-1.5 max-w-md mx-auto leading-relaxed\\\">\\n              Nh\341\272\255p t\303\252n v\341\272\255t li\341\273\207u, th\341\273\247y tinh quang h\341\273\215c, tinh th\341\273\203 ho\341\272\267c b\306\260\341\273\233c s\303\263ng c\341\273\245 th\341\273\203 \304\221\341\273\203 nh\341\272\255n th\303\264ng s\341\273\221\\n              chi\341\272\277t su\341\272\245t m\341\273\233i nh\341\272\245t k\303\250m danh s\303\241ch ngu\341\273\223n web \304\221\341\273\221i ch\341\273\251ng.\\n            </p>\\n          </div>\\n        ) : (\\n          <div className=\\\"bg-white border border-slate-200 rounded-xl overflow-hidden\\\">\\n            <div className=\\\"px-6 py-4 border-b border-slate-200 bg-slate-50/80 flex flex-wrap items-center justify-between gap-3\\\">\\n              <div>\\n                <h2 className=\\\"text-sm font-semibold text-slate-900\\\">\\n                  K\341\272\277t qu\341\272\243 t\341\273\225ng h\341\273\243p t\341\273\253 Google Search\\n                </h2>\\n                {result.searchQueries.length > 0 && (\\n                  <p className=\\\"text-[11px] font-mono text-slate-500 mt-0.5 truncate max-w-md\\\">\\n                    Truy v\341\272\245n: {result.searchQueries.join(\' \302\267 \')}\\n                  </p>\\n                )}\\n              </div>\\n\\n              {result.suggestedN !== null && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onApplyRefractiveIndex(result.suggestedN!, query)}\\n                  className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap cursor-pointer\\\"\\n                >\\n                  \303\201p d\341\273\245ng n\342\202\202 = {result.suggestedN.toFixed(4)}\\n                  <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              )}\\n            </div>\\n\\n            <div className=\\\"p-6 space-y-5\\\">\\n              <div className=\\\"text-sm text-slate-800 leading-relaxed whitespace-pre-line\\\">\\n                {result.answer}\\n              </div>\\n\\n              {result.sources.length > 0 && (\\n                <div className=\\\"pt-4 border-t border-slate-200\\\">\\n                  <h3 className=\\\"text-xs font-semibold text-slate-800 mb-2.5\\\">\\n                    Ngu\341\273\223n tham kh\341\272\243o x\303\241c th\341\273\261c ({result.sources.length})\\n                  </h3>\\n                  <ul className=\\\"space-y-1.5\\\">\\n                    {result.sources.map((src) => (\\n                      <li key={src.uri}>\\n                        <a\\n                          href={src.uri}\\n                          target=\\\"_blank\\\"\\n                          rel=\\\"noopener noreferrer\\\"\\n                          className=\\\"inline-flex items-center gap-1.5 text-xs text-sky-700 hover:text-sky-900 hover:underline break-all\\\"\\n                        >\\n                          <ExternalLink className=\\\"w-3.5 h-3.5 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                          <span>{src.title}</span>\\n                        </a>\\n                      </li>\\n                    ))}\\n                  </ul>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Saved Search History for Authenticated Users */}\\n        {history.length > 0 && (\\n          <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n            <div className=\\\"flex items-center gap-2 mb-3\\\">\\n              <History className=\\\"w-4 h-4 text-slate-500\\\" aria-hidden=\\\"true\\\" />\\n              <h2 className=\\\"text-sm font-semibold text-slate-900\\\">\\n                L\341\273\213ch s\341\273\255 tra c\341\273\251u \304\221\303\243 l\306\260u ({history.length})\\n              </h2>\\n            </div>\\n            <div className=\\\"divide-y divide-slate-100\\\">\\n              {history.slice(0, 6).map((item) => (\\n                <div\\n                  key={item.id}\\n                  className=\\\"py-3 flex flex-wrap items-center justify-between gap-3\\\"\\n                >\\n                  <div className=\\\"min-w-0 flex-1\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        setQuery(item.query);\\n                        setResult({\\n                          answer: item.summary,\\n                          suggestedN: item.suggestedN,\\n                          sources: item.sources,\\n                          searchQueries: [],\\n                        });\\n                      }}\\n                      className=\\\"text-left text-xs font-medium text-slate-900 hover:text-sky-700 truncate block w-full cursor-pointer\\\"\\n                    >\\n                      {item.query}\\n                    </button>\\n                    <p className=\\\"text-[11px] text-slate-500 truncate mt-0.5\\\">{item.summary}</p>\\n                  </div>\\n                  {item.suggestedN !== null && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onApplyRefractiveIndex(item.suggestedN!, item.query)}\\n                      className=\\\"px-2.5 py-1 text-[11px] font-mono font-medium rounded border border-slate-200 bg-slate-50 text-sky-800 hover:bg-sky-50 whitespace-nowrap cursor-pointer\\\"\\n                    >\\n                      N\341\272\241p n\342\202\202 = {item.suggestedN.toFixed(3)}\\n                    </button>\\n                  )}\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        )}\\n      </section>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Create Google Search Grounding material research view with verified source citations, extracted refractive index apply button, and synced search history.\",\"Overwrite\":true,\"TargetFile\":\"/src/components/MaterialSearchView.tsx\",\"toolAction\":\"Creating Google Search material lookup view\",\"toolSummary\":\"Create MaterialSearchView.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 4
      nanos: 181299468
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "VRUHa9bdPN7cvdIP4u7VkA8"
  }
