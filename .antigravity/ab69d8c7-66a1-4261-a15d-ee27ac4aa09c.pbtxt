      create_file {
        instruction: "import React, { useMemo, useState } from \'react\';\nimport {\n  AlertTriangle,\n  ArrowRight,\n  Box,\n  CheckCircle2,\n  Compass,\n  Loader2,\n  Send,\n  SlidersHorizontal,\n} from \'lucide-react\';\nimport { formatWavelength, WavePhysicsResult } from \'../physics/emPhysics\';\nimport { PolarizationMode } from \'../physics/materials\';\nimport {\n  AiWavePrediction,\n  computeTrajectorySvgGeometry,\n  PhysicsCrossCheck,\n} from \'../utils/aiWavePrediction\';\n\ninterface AiWavePredictorViewProps {\n  currentPhysics: WavePhysicsResult;\n  currentPolarization: PolarizationMode;\n  currentWavelengthNm: number;\n  material1Label: string;\n  material2Label: string;\n  onApplyPrediction: (\n    params: {\n      n1: number;\n      n2: number;\n      incidentAngleDeg: number;\n      wavelengthVacuumNm: number;\n      polarization: PolarizationMode;\n    },\n    targetTab: \'SIMULATOR\' | \'LAB_3D\'\n  ) => void;\n}\n\ninterface PredictionApiPayload {\n  prediction: AiWavePrediction;\n  crossCheck: PhysicsCrossCheck;\n}\n\nconst PRESET_SCENARIO_PROMPTS = [\n  {\n    title: \'L\303\265i s\341\273\243i quang th\341\272\241ch anh \342\206\222 Kh\303\264ng kh\303\255 (48\302\260)\',\n    prompt:\n      \'Tia laser h\341\273\223ng ngo\341\272\241i 1550 nm truy\341\273\201n t\341\273\253 l\303\265i s\341\273\243i quang th\341\272\241ch anh (n=1.458) ra kh\303\264ng kh\303\255 v\341\273\233i g\303\263c t\341\273\233i 48\302\260. D\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng v\303\240 ki\341\273\203m tra xem c\303\263 x\341\272\243y ra ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n hay kh\303\264ng.\',\n    attachLab: false,\n  },\n  {\n    title: \'Tia laser xanh 532 nm \342\206\222 M\341\272\267t n\306\260\341\273\233c (60\302\260)\',\n    prompt:\n      \'Ch\303\271m tia laser xanh l\303\241 532 nm ph\303\242n c\341\273\261c TM chi\341\272\277u t\341\273\253 kh\303\264ng kh\303\255 xu\341\273\221ng m\341\272\267t n\306\260\341\273\233c tinh khi\341\272\277t \341\273\237 g\303\263c t\341\273\233i 60\302\260. Tia kh\303\272c x\341\272\241 l\341\273\207ch v\341\273\201 h\306\260\341\273\233ng n\303\240o v\303\240 n\304\203ng l\306\260\341\273\243ng truy\341\273\201n qua ra sao?\',\n    attachLab: false,\n  },\n  {\n    title: \'S\303\263ng radar 10 GHz \342\206\222 T\341\272\245m Silicon (35\302\260)\',\n    prompt:\n      \'S\303\263ng \304\221i\341\273\207n t\341\273\253 vi s\303\263ng 10 GHz (b\306\260\341\273\233c s\303\263ng 30 mm) \304\221i t\341\273\253 kh\303\264ng kh\303\255 v\303\240o t\341\272\245m b\303\241n d\341\272\253n Silicon (n=3.42) \341\273\237 g\303\263c t\341\273\233i 35\302\260. D\341\273\261 \304\221o\303\241n g\303\263c kh\303\272c x\341\272\241, \304\221\341\273\231 l\341\273\207ch tia v\303\240 m\341\273\251c suy hao ph\341\272\243n x\341\272\241.\',\n    attachLab: false,\n  },\n  {\n    title: \'D\341\273\261 \304\221o\303\241n t\341\273\253 c\341\272\245u h\303\254nh \304\221ang m\303\264 ph\341\273\217ng (+15\302\260)\',\n    prompt:\n      \'D\341\273\261a tr\303\252n c\341\272\245u h\303\254nh hai m\303\264i tr\306\260\341\273\235ng hi\341\273\207n t\341\272\241i trong ph\303\262ng th\303\255 nghi\341\273\207m, n\341\272\277u t\304\203ng g\303\263c t\341\273\233i th\303\252m 15\302\260 th\303\254 h\306\260\341\273\233ng truy\341\273\201n tia kh\303\272c x\341\272\241 v\303\240 t\341\273\267 l\341\273\207 ph\341\272\243n x\341\272\241 s\341\272\275 bi\341\272\277n \304\221\341\273\225i nh\306\260 th\341\272\277 n\303\240o?\',\n    attachLab: true,\n  },\n];\n\nexport const AiWavePredictorView: React.FC<AiWavePredictorViewProps> = ({\n  currentPhysics,\n  currentPolarization,\n  currentWavelengthNm,\n  material1Label,\n  material2Label,\n  onApplyPrediction,\n}) => {\n  const [scenarioPrompt, setScenarioPrompt] = useState(PRESET_SCENARIO_PROMPTS[0].prompt);\n  const [useCurrentLabContext, setUseCurrentLabContext] = useState(true);\n  const [loading, setLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [result, setResult] = useState<PredictionApiPayload | null>(null);\n\n  const previewGeometry = useMemo(() => {\n    if (result) {\n      return computeTrajectorySvgGeometry(\n        result.prediction.inferredIncidentAngleDeg,\n        result.prediction.predictedRefractedAngleDeg,\n        420,\n        240\n      );\n    }\n    return computeTrajectorySvgGeometry(\n      currentPhysics.incidentAngleDeg,\n      currentPhysics.refractedAngleDeg,\n      420,\n      240\n    );\n  }, [result, currentPhysics.incidentAngleDeg, currentPhysics.refractedAngleDeg]);\n\n  const runPrediction = async (promptText: string, includeLabContext: boolean) => {\n    const trimmed = promptText.trim();\n    if (trimmed.length < 4) {\n      setErrorMsg(\'Vui l\303\262ng nh\341\272\255p m\303\264 t\341\272\243 k\341\273\213ch b\341\272\243n ho\341\272\267c c\303\242u h\341\273\217i truy\341\273\201n s\303\263ng \303\255t nh\341\272\245t 4 k\303\275 t\341\273\261.\');\n      return;\n    }\n\n    setLoading(true);\n    setErrorMsg(null);\n    try {\n      const response = await fetch(\'/api/ai/predict-wave\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          scenarioPrompt: trimmed,\n          useCurrentLabContext: includeLabContext,\n          currentN1: currentPhysics.n1,\n          currentN2: currentPhysics.n2,\n          currentIncidentAngleDeg: currentPhysics.incidentAngleDeg,\n          currentWavelengthNm,\n          currentPolarization,\n          material1Label,\n          material2Label,\n        }),\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data?.error || \'Kh\303\264ng th\341\273\203 ho\303\240n t\341\272\245t d\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng l\303\272c n\303\240y.\');\n      }\n\n      setResult(data as PredictionApiPayload);\n    } catch (err: unknown) {\n      setErrorMsg(\n        err instanceof Error ? err.message : \'\304\220\303\243 x\341\272\243y ra l\341\273\227i khi k\341\272\277t n\341\273\221i c\303\264ng c\341\273\245 d\341\273\261 \304\221o\303\241n AI.\'\n      );\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    void runPrediction(scenarioPrompt, useCurrentLabContext);\n  };\n\n  const activeN1 = result ? result.prediction.inferredN1 : currentPhysics.n1;\n  const activeN2 = result ? result.prediction.inferredN2 : currentPhysics.n2;\n  const activeThetaI = result\n    ? result.prediction.inferredIncidentAngleDeg\n    : currentPhysics.incidentAngleDeg;\n  const activeThetaT = result\n    ? result.prediction.predictedRefractedAngleDeg\n    : currentPhysics.refractedAngleDeg;\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n      {/* Left Column: Scenario Input & Lab Context */}\n      <section\n        aria-label=\"Nh\341\272\255p k\341\273\213ch b\341\272\243n d\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng b\341\272\261ng AI\"\n        className=\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 space-y-5\"\n      >\n        <div>\n          <h1 className=\"font-display text-xl sm:text-2xl font-bold text-slate-900 leading-snug\">\n            AI d\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng\n          </h1>\n          <p className=\"text-sm text-slate-600 mt-1.5 leading-relaxed\">\n            M\303\264 t\341\272\243 m\303\264i tr\306\260\341\273\235ng, g\303\263c chi\341\272\277u ho\341\272\267c hi\341\273\207n t\306\260\341\273\243ng th\341\273\261c t\341\272\277 \304\221\341\273\203 AI suy lu\341\272\255n qu\341\273\271 \304\221\341\272\241o tia kh\303\272c x\341\272\241,\n            ki\341\273\203m tra ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n v\303\240 \304\221\341\273\221i ch\341\273\251ng theo \304\221\341\273\213nh lu\341\272\255t Snell.\n          </p>\n        </div>\n\n        <form onSubmit={handleSubmit} noValidate className=\"space-y-4\">\n          <div>\n            <label\n              htmlFor=\"ai-wave-scenario-input\"\n              className=\"block text-[13px] font-semibold text-slate-800 mb-1.5\"\n            >\n              M\303\264 t\341\272\243 k\341\273\213ch b\341\272\243n ho\341\272\267c c\303\242u h\341\273\217i truy\341\273\201n s\303\263ng\n            </label>\n            <textarea\n              id=\"ai-wave-scenario-input\"\n              rows={4}\n              value={scenarioPrompt}\n              onChange={(e) => setScenarioPrompt(e.target.value)}\n              placeholder=\"V\303\255 d\341\273\245: Tia laser \304\221\341\273\217 633 nm \304\221i t\341\273\253 k\303\255nh th\341\273\247y tinh BK7 ra kh\303\264ng kh\303\255 \341\273\237 g\303\263c t\341\273\233i 45\302\260 s\341\272\275 truy\341\273\201n theo h\306\260\341\273\233ng n\303\240o?\"\n              className=\"w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm leading-relaxed text-slate-900 focus:border-sky-600 focus:outline-none resize-none\"\n            />\n          </div>\n\n          <label className=\"flex items-start gap-2.5 rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-2.5 cursor-pointer\">\n            <input\n              type=\"checkbox\"\n              checked={useCurrentLabContext}\n              onChange={(e) => setUseCurrentLabContext(e.target.checked)}\n              className=\"mt-0.5 h-4 w-4 rounded border-slate-300 accent-sky-700 cursor-pointer\"\n            />\n            <span className=\"text-[13px] text-slate-700 leading-snug\">\n              <span className=\"font-medium text-slate-900 block\">\n                \304\220\303\255nh k\303\250m c\341\272\245u h\303\254nh ph\303\262ng lab hi\341\273\207n t\341\272\241i\n              </span>\n              <span className=\"font-mono text-xs text-slate-500 tabular-nums\">\n                n\342\202\201={currentPhysics.n1.toFixed(3)} \302\267 n\342\202\202={currentPhysics.n2.toFixed(3)} \302\267 \316\270i=\n                {currentPhysics.incidentAngleDeg.toFixed(1)}\302\260 \302\267 \316\273\342\202\200=\n                {formatWavelength(currentWavelengthNm)}\n              </span>\n            </span>\n          </label>\n\n          {errorMsg && (\n            <div\n              role=\"alert\"\n              data-testid=\"ai-predict-error\"\n              className=\"flex items-start gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-[13px] text-rose-800 leading-relaxed\"\n            >\n              <AlertTriangle className=\"w-4 h-4 text-rose-600 shrink-0 mt-0.5\" aria-hidden=\"true\" />\n              <span>{errorMsg}</span>\n            </div>\n          )}\n\n          <button\n            type=\"submit\"\n            disabled={loading}\n            className=\"w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 text-sm font-semibold text-white bg-sky-700 hover:bg-sky-800 disabled:opacity-60 rounded-lg transition-colors cursor-pointer\"\n          >\n            {loading ? (\n              <>\n                <Loader2 className=\"w-4 h-4 animate-spin\" />\n                \304\220ang ph\303\242n t\303\255ch h\306\260\341\273\233ng truy\341\273\201n s\303\263ng...\n              </>\n            ) : (\n              <>\n                <Send className=\"w-4 h-4\" />\n                D\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng\n              </>\n            )}\n          </button>\n        </form>\n\n        <div className=\"pt-4 border-t border-slate-200 space-y-2.5\">\n          <div className=\"text-[13px] font-semibold text-slate-800\">K\341\273\213ch b\341\272\243n g\341\273\243i \303\275 nhanh</div>\n          <div className=\"space-y-2\">\n            {PRESET_SCENARIO_PROMPTS.map((item) => (\n              <button\n                key={item.title}\n                type=\"button\"\n                disabled={loading}\n                onClick={() => {\n                  setScenarioPrompt(item.prompt);\n                  setUseCurrentLabContext(item.attachLab);\n                  setErrorMsg(null);\n                }}\n                className=\"w-full text-left px-3.5 py-2.5 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-sky-50/70 hover:border-sky-300 transition-colors cursor-pointer\"\n              >\n                <div className=\"text-[13px] font-semibold text-slate-900\">{item.title}</div>\n                <div className=\"text-xs text-slate-500 mt-0.5 line-clamp-2 leading-relaxed\">\n                  {item.prompt}\n                </div>\n              </button>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Right Column: Vector Trajectory Diagram, Quantitative Readout & Reasoning */}\n      <section\n        aria-label=\"K\341\272\277t qu\341\272\243 d\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng v\303\240 ki\341\273\203m ch\341\273\251ng v\341\272\255t l\303\275\"\n        className=\"lg:col-span-7 space-y-5\"\n      >\n        {/* Vector Trajectory Diagram Card (Live Preview before run, AI Result after run) */}\n        <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\">\n          <div className=\"px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex flex-wrap items-center justify-between gap-3\">\n            <div>\n              <h2 className=\"font-display text-lg font-semibold text-slate-900\">\n                {result\n                  ? result.prediction.directionLabel\n                  : \'S\306\241 \304\221\341\273\223 vect\306\241 h\306\260\341\273\233ng truy\341\273\201n s\303\263ng hi\341\273\207n t\341\272\241i\'}\n              </h2>\n              <p className=\"text-[13px] text-slate-600 mt-0.5\">\n                {result\n                  ? result.prediction.scenarioSummary\n                  : \'Nh\341\272\245n \"D\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n s\303\263ng\" \304\221\341\273\203 AI suy lu\341\272\255n h\306\260\341\273\233ng tia v\303\240 ki\341\273\203m ch\341\273\251ng Snell.\'}\n              </p>\n            </div>\n            {result && (\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() =>\n                    onApplyPrediction(\n                      {\n                        n1: result.prediction.inferredN1,\n                        n2: result.prediction.inferredN2,\n                        incidentAngleDeg: result.prediction.inferredIncidentAngleDeg,\n                        wavelengthVacuumNm: result.prediction.inferredWavelengthNm,\n                        polarization: result.prediction.inferredPolarization,\n                      },\n                      \'SIMULATOR\'\n                    )\n                  }\n                  className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-[13px] font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap cursor-pointer\"\n                >\n                  <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n                  N\341\272\241p v\303\240o 2D\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() =>\n                    onApplyPrediction(\n                      {\n                        n1: result.prediction.inferredN1,\n                        n2: result.prediction.inferredN2,\n                        incidentAngleDeg: result.prediction.inferredIncidentAngleDeg,\n                        wavelengthVacuumNm: result.prediction.inferredWavelengthNm,\n                        polarization: result.prediction.inferredPolarization,\n                      },\n                      \'LAB_3D\'\n                    )\n                  }\n                  className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-[13px] font-semibold text-sky-900 bg-sky-50 border border-sky-200 hover:bg-sky-100 rounded-lg transition-colors whitespace-nowrap cursor-pointer\"\n                >\n                  <Box className=\"w-3.5 h-3.5\" />\n                  Xem 3D\n                </button>\n              </div>\n            )}\n          </div>\n\n          {/* Crisp SVG Vector Trajectory Visualization */}\n          <div className=\"px-6 py-5 bg-white\">\n            <svg\n              viewBox=\"0 0 420 240\"\n              role=\"img\"\n              aria-label=\"S\306\241 \304\221\341\273\223 d\341\273\261 \304\221o\303\241n h\306\260\341\273\233ng truy\341\273\201n tia t\341\273\233i, tia ph\341\272\243n x\341\272\241 v\303\240 tia kh\303\272c x\341\272\241\"\n              className=\"w-full max-w-[520px] mx-auto h-auto rounded-lg border border-slate-200\"\n            >\n              <defs>\n                <marker\n                  id=\"arrow-inc\"\n                  viewBox=\"0 0 10 10\"\n                  refX=\"7\"\n                  refY=\"5\"\n                  markerWidth=\"6\"\n                  markerHeight=\"6\"\n                  orient=\"auto-start-reverse\"\n                >\n                  <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#0284c7\" />\n                </marker>\n                <marker\n                  id=\"arrow-ref\"\n                  viewBox=\"0 0 10 10\"\n                  refX=\"7\"\n                  refY=\"5\"\n                  markerWidth=\"6\"\n                  markerHeight=\"6\"\n                  orient=\"auto-start-reverse\"\n                >\n                  <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#e11d48\" />\n                </marker>\n                <marker\n                  id=\"arrow-trans\"\n                  viewBox=\"0 0 10 10\"\n                  refX=\"7\"\n                  refY=\"5\"\n                  markerWidth=\"6\"\n                  markerHeight=\"6\"\n                  orient=\"auto-start-reverse\"\n                >\n                  <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#059669\" />\n                </marker>\n              </defs>\n\n              {/* Medium 1 & Medium 2 zones */}\n              <rect x=\"0\" y=\"0\" width=\"420\" height=\"120\" fill=\"#f8fafc\" />\n              <rect x=\"0\" y=\"120\" width=\"420\" height=\"120\" fill=\"#eff6ff\" />\n\n              {/* Boundary Interface */}\n              <line x1=\"0\" y1=\"120\" x2=\"420\" y2=\"120\" stroke=\"#334155\" strokeWidth=\"1.6\" />\n              {/* Normal Line */}\n              <line\n                x1={previewGeometry.cx}\n                y1=\"14\"\n                x2={previewGeometry.cx}\n                y2=\"226\"\n                stroke=\"#94a3b8\"\n                strokeWidth=\"1.2\"\n                strokeDasharray=\"4 4\"\n              />\n\n              {/* Incident Ray */}\n              <line\n                x1={previewGeometry.incStart.x}\n                y1={previewGeometry.incStart.y}\n                x2={previewGeometry.cx}\n                y2={previewGeometry.cy}\n                stroke=\"#0284c7\"\n                strokeWidth=\"2.6\"\n                markerEnd=\"url(#arrow-inc)\"\n              />\n\n              {/* Reflected Ray */}\n              <line\n                x1={previewGeometry.cx}\n                y1={previewGeometry.cy}\n                x2={previewGeometry.refEnd.x}\n                y2={previewGeometry.refEnd.y}\n                stroke=\"#e11d48\"\n                strokeWidth={previewGeometry.isTir ? \'3.0\' : \'2.0\'}\n                strokeOpacity={previewGeometry.isTir ? \'1\' : \'0.78\'}\n                markerEnd=\"url(#arrow-ref)\"\n              />\n\n              {/* Refracted Ray or Evanescent Boundary Wave */}\n              {previewGeometry.transEnd ? (\n                <line\n                  x1={previewGeometry.cx}\n                  y1={previewGeometry.cy}\n                  x2={previewGeometry.transEnd.x}\n                  y2={previewGeometry.transEnd.y}\n                  stroke=\"#059669\"\n                  strokeWidth=\"2.6\"\n                  markerEnd=\"url(#arrow-trans)\"\n                />\n              ) : (\n                <path\n                  d={`M ${previewGeometry.cx} 124 Q ${previewGeometry.cx + 22} 135 ${previewGeometry.cx + 44} 124 T ${previewGeometry.cx + 88} 124 T ${previewGeometry.cx + 126} 124`}\n                  fill=\"none\"\n                  stroke=\"#d97706\"\n                  strokeWidth=\"2.2\"\n                  strokeDasharray=\"4 3\"\n                />\n              )}\n\n              {/* Incidence Point */}\n              <circle cx={previewGeometry.cx} cy={previewGeometry.cy} r=\"4\" fill=\"#0f172a\" />\n\n              {/* Labels */}\n              <text x=\"14\" y=\"22\" className=\"fill-slate-700 text-[11px] font-mono font-semibold\">\n                MT1 \302\267 n\342\202\201 = {activeN1.toFixed(3)}\n              </text>\n              <text x=\"14\" y=\"226\" className=\"fill-slate-700 text-[11px] font-mono font-semibold\">\n                MT2 \302\267 n\342\202\202 = {activeN2.toFixed(3)}\n              </text>\n              <text\n                x={previewGeometry.cx + 6}\n                y=\"24\"\n                className=\"fill-slate-500 text-[10px] font-mono\"\n              >\n                Ph\303\241p tuy\341\272\277n\n              </text>\n              <text x=\"296\" y=\"22\" className=\"fill-sky-800 text-[11px] font-mono font-semibold\">\n                \316\270i = {activeThetaI.toFixed(1)}\302\260\n              </text>\n              <text\n                x=\"296\"\n                y=\"226\"\n                className={`text-[11px] font-mono font-semibold ${\n                  activeThetaT === null ? \'fill-amber-700\' : \'fill-emerald-700\'\n                }`}\n              >\n                {activeThetaT === null ? \'TIR (Kh\303\264ng kh\303\272c x\341\272\241)\' : `\316\270t = ${activeThetaT.toFixed(1)}\302\260`}\n              </text>\n            </svg>\n          </div>\n\n          {/* Quantitative Readout Grid (only when AI result is present) */}\n          {result && (\n            <div\n              data-testid=\"ai-prediction-metrics\"\n              className=\"grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-slate-200 border-t border-slate-200\"\n            >\n              <div className=\"p-4\">\n                <div className=\"text-xs font-medium text-slate-500 mb-1.5\">G\303\263c kh\303\272c x\341\272\241 AI (\316\270t)</div>\n                <div className=\"font-mono text-2xl font-semibold tabular-nums text-emerald-700\">\n                  {result.prediction.predictedRefractedAngleDeg !== null\n                    ? `${result.prediction.predictedRefractedAngleDeg.toFixed(2)}\302\260`\n                    : \'TIR\'}\n                </div>\n              </div>\n              <div className=\"p-4\">\n                <div className=\"text-xs font-medium text-slate-500 mb-1.5\">G\303\263c ph\341\272\243n x\341\272\241 (\316\270r)</div>\n                <div className=\"font-mono text-2xl font-semibold tabular-nums text-rose-700\">\n                  {result.prediction.predictedReflectedAngleDeg.toFixed(2)}\302\260\n                </div>\n              </div>\n              <div className=\"p-4\">\n                <div className=\"text-xs font-medium text-slate-500 mb-1.5\">\304\220\341\273\231 l\341\273\207ch tia (\316\224\316\270)</div>\n                <div className=\"font-mono text-2xl font-semibold tabular-nums text-slate-900\">\n                  {result.prediction.predictedDeviationDeg.toFixed(2)}\302\260\n                </div>\n              </div>\n              <div className=\"p-4\">\n                <div className=\"text-xs font-medium text-slate-500 mb-1.5\">\304\220\341\273\221i ch\341\273\251ng Snell</div>\n                <div className=\"font-mono text-2xl font-semibold tabular-nums text-sky-700\">\n                  {result.crossCheck.exactPhysics.refractedAngleDeg !== null\n                    ? `${result.crossCheck.exactPhysics.refractedAngleDeg.toFixed(2)}\302\260`\n                    : \'TIR\'}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Physical Reasoning, Snell Alignment & Engineering Recommendations */}\n        {result ? (\n          <div className=\"bg-white border border-slate-200 rounded-xl p-6 space-y-5\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-200\">\n              <div className=\"flex items-center gap-2\">\n                {result.crossCheck.isDirectionAligned ? (\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" aria-hidden=\"true\" />\n                ) : (\n                  <AlertTriangle className=\"w-4 h-4 text-amber-600 shrink-0\" aria-hidden=\"true\" />\n                )}\n                <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                  Gi\341\272\243i th\303\255ch v\341\272\255t l\303\275 & Ki\341\273\203m ch\341\273\251ng \304\221\341\273\213nh lu\341\272\255t Snell\n                </h3>\n              </div>\n              <span className=\"text-xs font-mono text-slate-600 tabular-nums\">\n                \304\220\341\273\231 tin c\341\272\255y: {result.prediction.confidenceLevel}\n                {result.crossCheck.angleDiscrepancyDeg !== null\n                  ? ` \302\267 Sai l\341\273\207ch |\316\224\316\270t| = ${result.crossCheck.angleDiscrepancyDeg.toFixed(2)}\302\260`\n                  : \'\'}\n              </span>\n            </div>\n\n            <p className=\"text-sm text-slate-700 leading-relaxed\">\n              {result.prediction.physicalReasoning}\n            </p>\n\n            {result.prediction.engineeringRecommendations.length > 0 && (\n              <div className=\"pt-4 border-t border-slate-200\">\n                <h4 className=\"text-[13px] font-semibold text-slate-900 mb-2.5\">\n                  G\341\273\243i \303\275 k\341\273\271 thu\341\272\255t & th\303\255 nghi\341\273\207m ti\341\272\277p theo\n                </h4>\n                <ul className=\"space-y-2 text-sm text-slate-700 leading-relaxed\">\n                  {result.prediction.engineeringRecommendations.map((tip, idx) => (\n                    <li key={idx} className=\"flex items-start gap-2.5\">\n                      <span className=\"font-mono text-xs font-semibold text-sky-700 mt-0.5 select-none\">\n                        0{idx + 1}.\n                      </span>\n                      <span>{tip}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            )}\n          </div>\n        ) : (\n          <div className=\"bg-white border border-slate-200 rounded-xl p-6 flex items-start gap-3.5\">\n            <Compass className=\"w-5 h-5 text-sky-700 shrink-0 mt-0.5\" aria-hidden=\"true\" />\n            <div className=\"space-y-1.5\">\n              <h3 className=\"font-display text-base font-semibold text-slate-900\">\n                C\306\241 ch\341\272\277 d\341\273\261 \304\221o\303\241n k\341\272\277t h\341\273\243p AI & Ki\341\273\203m ch\341\273\251ng v\341\272\255t l\303\275\n              </h3>\n              <p className=\"text-sm text-slate-600 leading-relaxed\">\n                M\303\264 h\303\254nh AI suy lu\341\272\255n chi\341\272\277t su\341\272\245t hai m\303\264i tr\306\260\341\273\235ng, g\303\263c t\341\273\233i v\303\240 nh\341\272\255n \304\221\341\273\213nh chi\341\273\201u b\341\272\273 cong\n                tia s\303\263ng t\341\273\253 m\303\264 t\341\272\243 t\341\273\261 nhi\303\252n c\341\273\247a b\341\272\241n; sau \304\221\303\263 h\341\273\207 th\341\273\221ng t\341\273\261 \304\221\341\273\231ng \304\221\341\273\221i chi\341\272\277u l\341\272\241i b\341\272\261ng \304\221\341\273\213nh\n                lu\341\272\255t Snell v\303\240 ph\306\260\306\241ng tr\303\254nh Fresnel \304\221\341\273\203 b\341\272\241n c\303\263 th\341\273\203 n\341\272\241p th\341\272\263ng sang m\303\264 ph\341\273\217ng 2D ho\341\272\267c b\303\240n\n                quang h\341\273\215c 3D.\n              </p>\n            </div>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
