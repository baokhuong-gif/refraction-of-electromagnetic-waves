    tool_calls {
      id: "call_13537349819433055384"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport { motion, useReducedMotion } from \'motion/react\';\\nimport { OpticalMaterial } from \'../physics/materials\';\\nimport {\\n  buildRefractiveComparisonModel,\\n  ComparisonCategoryFilter,\\n  MaterialBracketSummary,\\n} from \'../utils/refractiveComparison\';\\n\\ninterface RefractiveIndexComparisonChartProps {\\n  n1: number;\\n  n2: number;\\n  material1Id: string;\\n  material2Id: string;\\n  material1Label: string;\\n  material2Label: string;\\n  onSelectMaterialForN1: (material: OpticalMaterial) => void;\\n  onSelectMaterialForN2: (material: OpticalMaterial) => void;\\n}\\n\\nconst CATEGORY_TABS: Array<{ id: ComparisonCategoryFilter; label: string }> = [\\n  { id: \'ALL\', label: \'T\341\272\245t c\341\272\243\' },\\n  { id: \'GAS_LIQUID\', label: \'Kh\303\255 & L\341\273\217ng\' },\\n  { id: \'OPTICAL\', label: \'Quang h\341\273\215c\' },\\n  { id: \'RF_SEMI\', label: \'B\303\241n d\341\272\253n & RF\' },\\n];\\n\\nfunction formatBracketDescription(\\n  mediumLabel: string,\\n  n: number,\\n  bracket: MaterialBracketSummary\\n): string {\\n  if (bracket.exactMatch) {\\n    return `${mediumLabel} (n = ${n.toFixed(3)}) kh\341\273\233p chu\341\272\251n v\341\273\233i ${bracket.exactMatch.name}.`;\\n  }\\n  if (bracket.lowerNeighbor && bracket.upperNeighbor) {\\n    return `${mediumLabel} (n = ${n.toFixed(3)}) n\341\272\261m gi\341\273\257a ${bracket.lowerNeighbor.name} (${bracket.lowerNeighbor.refractiveIndex.toFixed(3)}) v\303\240 ${bracket.upperNeighbor.name} (${bracket.upperNeighbor.refractiveIndex.toFixed(3)}).`;\\n  }\\n  if (bracket.lowerNeighbor) {\\n    return `${mediumLabel} (n = ${n.toFixed(3)}) cao h\306\241n v\341\272\255t li\341\273\207u cao nh\341\272\245t trong th\306\260 vi\341\273\207n l\303\240 ${bracket.lowerNeighbor.name} (${bracket.lowerNeighbor.refractiveIndex.toFixed(3)}).`;\\n  }\\n  return `${mediumLabel} (n = ${n.toFixed(3)}) g\341\272\247n nh\341\272\245t v\341\273\233i ${bracket.nearest.name} (${bracket.nearest.refractiveIndex.toFixed(3)}).`;\\n}\\n\\nexport const RefractiveIndexComparisonChart: React.FC<RefractiveIndexComparisonChartProps> = ({\\n  n1,\\n  n2,\\n  material1Id,\\n  material2Id,\\n  material1Label,\\n  material2Label,\\n  onSelectMaterialForN1,\\n  onSelectMaterialForN2,\\n}) => {\\n  const [categoryFilter, setCategoryFilter] = useState<ComparisonCategoryFilter>(\'ALL\');\\n  const [assignTarget, setAssignTarget] = useState<\'N1\' | \'N2\'>(\'N2\');\\n  const [hoveredMaterial, setHoveredMaterial] = useState<OpticalMaterial | null>(null);\\n  const prefersReducedMotion = useReducedMotion();\\n\\n  const model = useMemo(\\n    () =>\\n      buildRefractiveComparisonModel({\\n        n1,\\n        n2,\\n        material1Id,\\n        material2Id,\\n        categoryFilter,\\n      }),\\n    [n1, n2, material1Id, material2Id, categoryFilter]\\n  );\\n\\n  const handleRowClick = (mat: OpticalMaterial) => {\\n    if (assignTarget === \'N1\') {\\n      onSelectMaterialForN1(mat);\\n    } else {\\n      onSelectMaterialForN2(mat);\\n    }\\n  };\\n\\n  const transition = prefersReducedMotion\\n    ? { duration: 0.01 }\\n    : { type: \'spring\' as const, stiffness: 320, damping: 32 };\\n\\n  const deltaSign = model.deltaN > 0.0005 ? \'+\' : \'\';\\n\\n  return (\\n    <section\\n      aria-label=\\\"Bi\341\273\203u \304\221\341\273\223 so s\303\241nh chi\341\272\277t su\341\272\245t v\341\273\233i th\306\260 vi\341\273\207n v\341\272\255t li\341\273\207u\\\"\\n      data-testid=\\\"refractive-comparison-chart\\\"\\n      className=\\\"bg-white border border-slate-200 rounded-xl p-5 sm:p-6 space-y-5\\\"\\n    >\\n      {/* Header & Interactive Controls */}\\n      <div className=\\\"flex flex-col xl:flex-row xl:items-start justify-between gap-4\\\">\\n        <div className=\\\"space-y-1\\\">\\n          <h3 className=\\\"font-display text-base sm:text-lg font-semibold text-slate-900\\\">\\n            Bi\341\273\203u \304\221\341\273\223 so s\303\241nh chi\341\272\277t su\341\272\245t (n\342\202\201, n\342\202\202) v\341\273\233i th\306\260 vi\341\273\207n v\341\272\255t li\341\273\207u\\n          </h3>\\n          <p className=\\\"text-[13px] text-slate-600 leading-relaxed\\\">\\n            \304\220\341\273\221i chi\341\272\277u nhanh hai m\303\264i tr\306\260\341\273\235ng \304\221ang m\303\264 ph\341\273\217ng tr\303\252n ph\341\273\225 chi\341\272\277t su\341\272\245t \304\221i\341\273\207n m\303\264i \302\267{\' \'}\\n            <span className=\\\"font-mono text-xs text-slate-700 tabular-nums\\\">\\n              n\342\202\202/n\342\202\201 = {model.ratioN2ToN1.toFixed(2)}\303\227 \302\267 \316\224n = {deltaSign}\\n              {model.deltaN.toFixed(3)}\\n            </span>\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2.5 shrink-0\\\">\\n          {/* Category Filter */}\\n          <div\\n            role=\\\"group\\\"\\n            aria-label=\\\"L\341\273\215c nh\303\263m v\341\272\255t li\341\273\207u trong bi\341\273\203u \304\221\341\273\223\\\"\\n            className=\\\"inline-flex items-center gap-1 p-1 bg-slate-100 rounded-lg\\\"\\n          >\\n            {CATEGORY_TABS.map((tab) => (\\n              <button\\n                key={tab.id}\\n                type=\\\"button\\\"\\n                aria-pressed={categoryFilter === tab.id}\\n                onClick={() => setCategoryFilter(tab.id)}\\n                className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                  categoryFilter === tab.id\\n                    ? \'bg-white text-slate-900 font-semibold shadow-xs\'\\n                    : \'text-slate-600 hover:text-slate-900\'\\n                }`}\\n              >\\n                {tab.label}\\n              </button>\\n            ))}\\n          </div>\\n\\n          {/* Click-to-assign Target Selector */}\\n          <div\\n            role=\\\"group\\\"\\n            aria-label=\\\"Ch\341\273\215n m\303\264i tr\306\260\341\273\235ng \303\241p d\341\273\245ng khi nh\341\272\245p thanh v\341\272\255t li\341\273\207u\\\"\\n            className=\\\"inline-flex items-center gap-1 p-1 bg-slate-100 rounded-lg\\\"\\n          >\\n            <span className=\\\"hidden sm:inline pl-2 pr-1 text-xs text-slate-500 whitespace-nowrap\\\">\\n              Nh\341\272\245p \304\221\341\273\203 g\303\241n:\\n            </span>\\n            <button\\n              type=\\\"button\\\"\\n              aria-pressed={assignTarget === \'N1\'}\\n              onClick={() => setAssignTarget(\'N1\')}\\n              className={`px-2.5 py-1 text-xs font-mono font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                assignTarget === \'N1\'\\n                  ? \'bg-sky-700 text-white shadow-xs\'\\n                  : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              n\342\202\201\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              aria-pressed={assignTarget === \'N2\'}\\n              onClick={() => setAssignTarget(\'N2\')}\\n              className={`px-2.5 py-1 text-xs font-mono font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                assignTarget === \'N2\'\\n                  ? \'bg-indigo-600 text-white shadow-xs\'\\n                  : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              n\342\202\202\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Calibrated Horizontal Bar Chart with Full-Height n1 & n2 Reference Overlay */}\\n      <div className=\\\"space-y-2\\\">\\n        {/* Top Reference Callout & Scale Axis Header */}\\n        <div className=\\\"grid grid-cols-[minmax(132px,195px)_minmax(0,1fr)_88px] sm:grid-cols-[210px_minmax(0,1fr)_104px] gap-3 items-end\\\">\\n          <div className=\\\"text-xs font-medium text-slate-500 pb-1\\\">V\341\272\255t li\341\273\207u chu\341\272\251n</div>\\n\\n          {/* Scale Track Header + Floating n1/n2 Pin Labels */}\\n          <div className=\\\"relative h-11\\\">\\n            {/* n1 marker label */}\\n            <motion.div\\n              data-testid=\\\"chart-marker-n1\\\"\\n              animate={{ left: `${model.n1Pct}%` }}\\n              transition={transition}\\n              style={{ transform: \'translateX(-50%)\' }}\\n              className={`absolute ${\\n                model.markersAreClose ? \'top-0\' : \'top-1\'\\n              } font-mono text-[11px] font-semibold text-sky-800 whitespace-nowrap tabular-nums select-none`}\\n            >\\n              n\342\202\201 {n1.toFixed(3)}\\n            </motion.div>\\n\\n            {/* n2 marker label (staggered vertically if close to n1 so labels never overlap) */}\\n            <motion.div\\n              data-testid=\\\"chart-marker-n2\\\"\\n              animate={{ left: `${model.n2Pct}%` }}\\n              transition={transition}\\n              style={{ transform: \'translateX(-50%)\' }}\\n              className={`absolute ${\\n                model.markersAreClose ? \'top-4\' : \'top-1\'\\n              } font-mono text-[11px] font-semibold text-indigo-700 whitespace-nowrap tabular-nums select-none`}\\n            >\\n              n\342\202\202 {n2.toFixed(3)}\\n            </motion.div>\\n\\n            {/* Calibrated numeric axis ticks along bottom of header */}\\n            <div className=\\\"absolute inset-x-0 bottom-0 flex items-center justify-between text-[11px] font-mono text-slate-400 tabular-nums border-b border-slate-200 pb-0.5\\\">\\n              {model.ticks.map((tick) => (\\n                <span key={tick}>{tick.toFixed(1)}</span>\\n              ))}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"text-xs font-medium text-slate-500 text-right pb-1\\\">n / \316\265r</div>\\n        </div>\\n\\n        {/* Plot Area: Rows + Vertical Gridlines + n1/n2 Span & Reference Lines */}\\n        <div className=\\\"relative\\\">\\n          {/* Background vertical gridlines & n1/n2 overlay aligned strictly to the middle column */}\\n          <div\\n            aria-hidden=\\\"true\\\"\\n            className=\\\"pointer-events-none absolute inset-0 grid grid-cols-[minmax(132px,195px)_minmax(0,1fr)_88px] sm:grid-cols-[210px_minmax(0,1fr)_104px] gap-3\\\"\\n          >\\n            <div />\\n            <div className=\\\"relative h-full\\\">\\n              {/* Vertical scale grid ticks */}\\n              {model.ticks.map((tick) => {\\n                const pct =\\n                  ((tick - model.minScale) / (model.maxScale - model.minScale)) * 100;\\n                return (\\n                  <div\\n                    key={tick}\\n                    style={{ left: `${pct}%` }}\\n                    className=\\\"absolute inset-y-0 border-l border-slate-100\\\"\\n                  />\\n                );\\n              })}\\n\\n              {/* Shaded Optical Contrast Span between n1 and n2 */}\\n              {model.spanWidthPct > 0.4 && (\\n                <motion.div\\n                  initial={false}\\n                  animate={{\\n                    left: `${model.spanLeftPct}%`,\\n                    width: `${model.spanWidthPct}%`,\\n                  }}\\n                  transition={transition}\\n                  className={`absolute inset-y-0 ${\\n                    model.deltaN >= 0 ? \'bg-sky-100/45\' : \'bg-amber-100/45\'\\n                  }`}\\n                />\\n              )}\\n\\n              {/* Full-height vertical reference line for n1 */}\\n              <motion.div\\n                initial={false}\\n                animate={{ left: `${model.n1Pct}%` }}\\n                transition={transition}\\n                className=\\\"absolute inset-y-0 w-0.5 bg-sky-600/85 z-10\\\"\\n              />\\n\\n              {/* Full-height vertical reference line for n2 */}\\n              <motion.div\\n                initial={false}\\n                animate={{ left: `${model.n2Pct}%` }}\\n                transition={transition}\\n                className=\\\"absolute inset-y-0 w-0.5 bg-indigo-600/85 z-10\\\"\\n              />\\n            </div>\\n            <div />\\n          </div>\\n\\n          {/* Interactive Material Bar Rows */}\\n          <div className=\\\"relative z-20 divide-y divide-slate-100/80\\\">\\n            {model.items.map(({ material, widthPct, isCurrentN1, isCurrentN2 }) => {\\n              const isMatched = isCurrentN1 || isCurrentN2;\\n              const barColorClass =\\n                isCurrentN1 && isCurrentN2\\n                  ? \'bg-teal-600\'\\n                  : isCurrentN1\\n                  ? \'bg-sky-600\'\\n                  : isCurrentN2\\n                  ? \'bg-indigo-600\'\\n                  : \'bg-slate-300 group-hover:bg-slate-400\';\\n\\n              return (\\n                <button\\n                  key={material.id}\\n                  type=\\\"button\\\"\\n                  data-testid={`comparison-bar-${material.id}`}\\n                  onClick={() => handleRowClick(material)}\\n                  onMouseEnter={() => setHoveredMaterial(material)}\\n                  onMouseLeave={() => setHoveredMaterial(null)}\\n                  onFocus={() => setHoveredMaterial(material)}\\n                  onBlur={() => setHoveredMaterial(null)}\\n                  aria-label={`Ch\341\273\215n ${material.name}, chi\341\272\277t su\341\272\245t ${material.refractiveIndex.toFixed(3)}, g\303\241n cho ${\\n                    assignTarget === \'N1\' ? \'m\303\264i tr\306\260\341\273\235ng 1\' : \'m\303\264i tr\306\260\341\273\235ng 2\'\\n                  }`}\\n                  className={`group w-full text-left grid grid-cols-[minmax(132px,195px)_minmax(0,1fr)_88px] sm:grid-cols-[210px_minmax(0,1fr)_104px] gap-3 items-center py-2 px-1 -mx-1 rounded-md transition-colors cursor-pointer ${\\n                    isMatched ? \'bg-slate-50/80\' : \'hover:bg-slate-50/70\'\\n                  }`}\\n                >\\n                  {/* Material Name & Active Match Indicator (Zero-Pill unboxed text) */}\\n                  <div className=\\\"min-w-0 pr-1\\\">\\n                    <div className=\\\"flex items-center gap-1.5 min-w-0\\\">\\n                      <span\\n                        className={`text-[13px] truncate ${\\n                          isMatched\\n                            ? \'font-semibold text-slate-950\'\\n                            : \'font-medium text-slate-700 group-hover:text-slate-950\'\\n                        }`}\\n                      >\\n                        {material.name}\\n                      </span>\\n                      {isCurrentN1 && (\\n                        <span className=\\\"font-mono text-[11px] font-semibold text-sky-700 shrink-0\\\">\\n                          n\342\202\201\\n                        </span>\\n                      )}\\n                      {isCurrentN2 && (\\n                        <span className=\\\"font-mono text-[11px] font-semibold text-indigo-700 shrink-0\\\">\\n                          n\342\202\202\\n                        </span>\\n                      )}\\n                    </div>\\n                  </div>\\n\\n                  {/* Calibrated Bar Track */}\\n                  <div className=\\\"relative h-4 flex items-center\\\">\\n                    <div className=\\\"w-full h-2.5 bg-slate-100/90 rounded-r-sm overflow-hidden\\\">\\n                      <motion.div\\n                        initial={false}\\n                        animate={{ width: `${Math.max(1.2, widthPct)}%` }}\\n                        transition={transition}\\n                        className={`h-full rounded-r-sm transition-colors ${barColorClass}`}\\n                      />\\n                    </div>\\n                  </div>\\n\\n                  {/* Tabular Numeric Readout: n and \316\265r */}\\n                  <div className=\\\"text-right font-mono tabular-nums leading-tight shrink-0\\\">\\n                    <span\\n                      className={`text-[13px] ${\\n                        isMatched ? \'font-semibold text-slate-950\' : \'font-medium text-slate-800\'\\n                      }`}\\n                    >\\n                      {material.refractiveIndex.toFixed(3)}\\n                    </span>\\n                    <span className=\\\"text-[11px] text-slate-400 ml-1.5 hidden sm:inline\\\">\\n                      ({material.relativePermittivity.toFixed(1)})\\n                    </span>\\n                  </div>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Bottom Positioning Summary & Legend (Unboxed Editorial Telemetry) */}\\n      <div className=\\\"pt-3.5 border-t border-slate-200 flex flex-col gap-2.5 text-[13px] text-slate-600\\\">\\n        {hoveredMaterial ? (\\n          <div className=\\\"text-slate-800 leading-relaxed\\\">\\n            <span className=\\\"font-semibold text-slate-950\\\">{hoveredMaterial.name}</span>\\n            <span className=\\\"text-slate-400 mx-1.5\\\">\302\267</span>\\n            <span className=\\\"font-mono text-xs text-slate-700 tabular-nums\\\">\\n              n = {hoveredMaterial.refractiveIndex.toFixed(3)} \302\267 \316\265r ={\' \'}\\n              {hoveredMaterial.relativePermittivity.toFixed(2)}\\n            </span>\\n            <span className=\\\"text-slate-400 mx-1.5\\\">\302\267</span>\\n            <span>{hoveredMaterial.notes}</span>\\n          </div>\\n        ) : (\\n          <div\\n            data-testid=\\\"comparison-bracket-summary\\\"\\n            className=\\\"grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 leading-relaxed\\\"\\n          >\\n            <div>\\n              <span className=\\\"font-mono text-xs font-semibold text-sky-700 mr-1.5\\\">n\342\202\201</span>\\n              {formatBracketDescription(material1Label, n1, model.n1Bracket)}\\n            </div>\\n            <div>\\n              <span className=\\\"font-mono text-xs font-semibold text-indigo-700 mr-1.5\\\">n\342\202\202</span>\\n              {formatBracketDescription(material2Label, n2, model.n2Bracket)}\\n            </div>\\n          </div>\\n        )}\\n\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-4 font-mono\\\">\\n            <span className=\\\"inline-flex items-center gap-1.5\\\">\\n              <span className=\\\"w-2.5 h-2.5 rounded-xs bg-sky-600 inline-block\\\" />\\n              M\303\264i tr\306\260\341\273\235ng 1 (n\342\202\201)\\n            </span>\\n            <span className=\\\"inline-flex items-center gap-1.5\\\">\\n              <span className=\\\"w-2.5 h-2.5 rounded-xs bg-indigo-600 inline-block\\\" />\\n              M\303\264i tr\306\260\341\273\235ng 2 (n\342\202\202)\\n            </span>\\n            <span className=\\\"inline-flex items-center gap-1.5\\\">\\n              <span\\n                className={`w-3 h-2.5 rounded-xs inline-block border ${\\n                  model.deltaN >= 0\\n                    ? \'bg-sky-100 border-sky-300\'\\n                    : \'bg-amber-100 border-amber-300\'\\n                }`}\\n              />\\n              {model.deltaN >= 0 ? \'V\303\271ng ch\303\252nh l\341\273\207ch chi\341\272\277t quang t\304\203ng\' : \'V\303\271ng chi\341\272\277t quang gi\341\272\243m (c\303\263 \316\270c)\'}\\n            </span>\\n          </div>\\n          <span className=\\\"text-slate-400\\\">\\n            Nh\341\272\245p b\341\272\245t k\341\273\263 thanh v\341\272\255t li\341\273\207u n\303\240o \304\221\341\273\203 n\341\272\241p nhanh v\303\240o {assignTarget === \'N1\' ? \'n\342\202\201\' : \'n\342\202\202\'}\\n          </span>\\n        </div>\\n      </div>\\n    </section>\\n  );\\n};\\n\",\"Description\":\"Create interactive RefractiveIndexComparisonChart displaying current n1 and n2 against library materials with reference lines, span shading, category filter, and one-click assignment\",\"Overwrite\":true,\"TargetFile\":\"/src/components/RefractiveIndexComparisonChart.tsx\",\"toolAction\":\"Creating refractive comparison chart component\",\"toolSummary\":\"Create RefractiveIndexComparisonChart.tsx\"}"
      original_name: "write_to_file"
    }
