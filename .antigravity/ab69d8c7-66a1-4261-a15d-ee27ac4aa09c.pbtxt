  view_file {
    absolute_path_uri: "file:///src/components/WaveCanvas.tsx"
    end_line: 74
    content: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Pause, Play, RotateCcw, StepForward } from \'lucide-react\';\nimport {\n  clamp,\n  degToRad,\n  formatWavelength,\n  radToDeg,\n  WavePhysicsResult,\n  wavelengthToColor,\n} from \'../physics/emPhysics\';\nimport { PolarizationMode } from \'../physics/materials\';\n\nexport interface WaveLayerToggles {\n  wavefronts: boolean;\n  rays: boolean;\n  eField: boolean;\n  angles: boolean;\n}\n\ninterface WaveCanvasProps {\n  physics: WavePhysicsResult;\n  polarization: PolarizationMode;\n  wavelengthVacuumNm: number;\n  material1Label: string;\n  material2Label: string;\n  onChangeIncidentAngle: (angleDeg: number) => void;\n  onResetSimulation: () => void;\n}\n\ninterface ProbeState {\n  active: boolean;\n  xPx: number;\n  yPx: number;\n  medium: 1 | 2;\n  normX: number;\n  normZ: number;\n  angleFromNormalDeg: number;\n}\n\nexport const WaveCanvas: React.FC<WaveCanvasProps> = ({\n  physics,\n  polarization,\n  wavelengthVacuumNm,\n  material1Label,\n  material2Label,\n  onChangeIncidentAngle,\n  onResetSimulation,\n}) => {\n  const containerRef = useRef<HTMLDivElement | null>(null);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  const [isPlaying, setIsPlaying] = useState(true);\n  const [speedMultiplier, setSpeedMultiplier] = useState(1.0);\n  const [layers, setLayers] = useState<WaveLayerToggles>({\n    wavefronts: true,\n    rays: true,\n    eField: true,\n    angles: true,\n  });\n  const [isDraggingSource, setIsDraggingSource] = useState(false);\n  const [probe, setProbe] = useState<ProbeState>({\n    active: false,\n    xPx: 0,\n    yPx: 0,\n    medium: 1,\n    normX: 0,\n    normZ: 0,\n    angleFromNormalDeg: 0,\n  });\n\n  // Mutable animation refs to avoid React re-renders at 60Hz\n  const phaseRef = useRef(0);\n  const isPlayingRef = useRef(isPlaying);\n  const speedRef = useRef(speedMultiplier);\n  const physicsRef = useRef(physics);"
    num_lines: 1046
    num_bytes: 32915
    line_range_bytes: 1880
  }
}
