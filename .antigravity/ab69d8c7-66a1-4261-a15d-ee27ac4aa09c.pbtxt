        use_fast_apply: true
        replacement_chunks {
          target_content: "  Repeat,\n  RotateCcw,\n  StepForward,"
          replacement_content: "  Repeat,\n  RotateCcw,\n  Ruler,\n  StepForward,"
          start_line: 7
          end_line: 15
        }
        replacement_chunks {
          target_content: "      for (let deg = 0; deg < 360; deg += 5) {\n        const rad = degToRad(deg);\n        const isMajor = deg % 30 === 0;\n        const isMed = deg % 15 === 0;\n        const innerR = isMajor ? pRadius - 11 : isMed ? pRadius - 7 : pRadius - 4;\n        ctx.strokeStyle = isMajor\n          ? \'rgba(71, 85, 105, 0.45)\'\n          : \'rgba(100, 116, 139, 0.24)\';\n        ctx.lineWidth = isMajor ? 1.2 : 0.8;\n        ctx.beginPath();\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\n        ctx.stroke();\n      }"
          replacement_content: "      // Batch major (30\302\260) and minor (5\302\260/15\302\260) ticks into two strokes for smooth frame performance\n      ctx.beginPath();\n      for (let deg = 0; deg < 360; deg += 5) {\n        if (deg % 30 === 0) continue;\n        const rad = degToRad(deg);\n        const innerR = deg % 15 === 0 ? pRadius - 7 : pRadius - 4;\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\n      }\n      ctx.strokeStyle = \'rgba(100, 116, 139, 0.24)\';\n      ctx.lineWidth = 0.8;\n      ctx.stroke();\n\n      ctx.beginPath();\n      for (let deg = 0; deg < 360; deg += 30) {\n        const rad = degToRad(deg);\n        const innerR = pRadius - 11;\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\n      }\n      ctx.strokeStyle = \'rgba(71, 85, 105, 0.45)\';\n      ctx.lineWidth = 1.2;\n      ctx.stroke();"
          start_line: 191
          end_line: 207
        }
