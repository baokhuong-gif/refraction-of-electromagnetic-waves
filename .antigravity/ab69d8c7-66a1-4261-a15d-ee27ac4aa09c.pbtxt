            lines {
              text: "                  <td className=\"py-2 pr-2 font-sans text-slate-600\">H\341\273\207 s\341\273\221 bi\303\252n \304\221\341\273\231 |r|</td>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
