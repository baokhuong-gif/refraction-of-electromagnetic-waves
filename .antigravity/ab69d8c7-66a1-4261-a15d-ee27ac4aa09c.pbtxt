            }
            lines {
              text: "        const x = xOfAngle(pt.angleDeg);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const y = isPhase ? yOfPhase(accessor(pt)) : yOfRatio(accessor(pt));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return `${i === 0 ? \'M\' : \'L\'}${x.toFixed(1)},${y.toFixed(1)}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
