    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli && \\\n  playwright-cli open --browser=chromium http://localhost:3000 && \\\n  playwright-cli resize 1440 900 && \\\n  playwright-cli run-code \'async (page) => {\n    const pauseBtn = page.getByRole(\"button\", { name: \"T\341\272\241m d\341\273\253ng\", exact: true });\n    if (await pauseBtn.isVisible()) await pauseBtn.click();\n\n    const openBtn = page.locator(\"[data-testid=\\\"open-formulas-modal-btn\\\"]\");\n    await openBtn.waitFor({ state: \"visible\", timeout: 10000 });\n    await openBtn.scrollIntoViewIfNeeded();\n    await openBtn.click();\n\n    const modal = page.locator(\"[data-testid=\\\"formulas-modal\\\"]\");\n    await modal.waitFor({ state: \"visible\", timeout: 5000 });\n    await page.waitForTimeout(250);\n    const modalText = await modal.textContent();\n    await page.screenshot({ path: \".playwright-cli/r15-formulas-desktop.png\", animations: \"disabled\" });\n\n    // Close with Escape\n    await page.keyboard.press(\"Escape\");\n    await page.waitForTimeout(250);\n    const countAfterEscape = await modal.count();\n\n    // Mobile 390x844 check\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.waitForTimeout(200);\n    await openBtn.scrollIntoViewIfNeeded();\n    await openBtn.click();\n    await modal.waitFor({ state: \"visible\", timeout: 5000 });\n    await page.waitForTimeout(250);\n    const mobileOverflow = await page.evaluate(() => ({\n      scrollWidth: document.documentElement.scrollWidth,\n      innerWidth: window.innerWidth,\n      hasOverflow: document.documentElement.scrollWidth > window.innerWidth\n    }));\n    await page.screenshot({ path: \".playwright-cli/r15-formulas-mobile.png\", animations: \"disabled\" });\n\n    return JSON.stringify({\n      hasSnell: modalText?.includes(\"n\342\202\201 \302\267 sin(\316\270i) = n\342\202\202 \302\267 sin(\316\270t)\"),\n      hasFresnelS: modalText?.includes(\"n\342\202\201 cos \316\270i \342\210\222 n\342\202\202 cos \316\270t\"),\n      hasFresnelP: modalText?.includes(\"n\342\202\202 cos \316\270i \342\210\222 n\342\202\201 cos \316\270t\"),\n      hasGlossary: modalText?.includes(\"Gi\341\272\243i th\303\255ch chi ti\341\272\277t c\303\241c k\303\275 hi\341\273\207u\"),\n      countAfterEscape,\n      mobileOverflow\n    }, null, 2);\n  }\' && \\\n  playwright-cli console"
