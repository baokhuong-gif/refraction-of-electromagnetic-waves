  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, sans-serif;\n  --font-mono: \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace;\n}\n\n@layer base {\n  html {\n    font-family: var(--font-sans);\n    scroll-behavior: smooth;\n  }\n\n  h1, h2, h3 {\n    text-wrap: balance;\n  }\n}\n\n/* Precision range slider styling for scientific controls */\ninput[type=\"range\"].lab-slider {\n  -webkit-appearance: none;\n  appearance: none;\n  background: transparent;\n  cursor: pointer;\n}\n\ninput[type=\"range\"].lab-slider::-webkit-slider-runnable-track {\n  height: 4px;\n  border-radius: 2px;\n  background: #cbd5e1;\n}\n\ninput[type=\"range\"].lab-slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  height: 16px;\n  width: 16px;\n  border-radius: 9999px;\n  background: #0284c7;\n  border: 2px solid #ffffff;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);\n  margin-top: -6px;\n  transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1), background-color 150ms ease;\n}\n\ninput[type=\"range\"].lab-slider:hover::-webkit-slider-thumb {\n  background: #0369a1;\n  transform: scale(1.1);\n}\n\ninput[type=\"range\"].lab-slider:focus-visible {\n  outline: none;\n}\n\ninput[type=\"range\"].lab-slider:focus-visible::-webkit-slider-thumb {\n  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.35);\n}\n\ninput[type=\"range\"].lab-slider::-moz-range-track {\n  height: 4px;\n  border-radius: 2px;\n  background: #cbd5e1;\n}\n\ninput[type=\"range\"].lab-slider::-moz-range-thumb {\n  height: 16px;\n  width: 16px;\n  border-radius: 9999px;\n  background: #0284c7;\n  border: 2px solid #ffffff;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * {\n    scroll-behavior: auto !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
