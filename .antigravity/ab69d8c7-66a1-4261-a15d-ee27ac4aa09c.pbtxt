            }
            lines {
              text: "    mx - headLen * Math.cos(angle + Math.PI / 6),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    my - headLen * Math.sin(angle + Math.PI / 6)"
