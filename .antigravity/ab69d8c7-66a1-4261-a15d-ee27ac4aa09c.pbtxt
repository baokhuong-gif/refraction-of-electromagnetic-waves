              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    name: \'Sapphire (Al\342\202\202O\342\202\203)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    refractiveIndex: 1.768,"
