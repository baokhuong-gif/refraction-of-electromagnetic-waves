              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tinh th\341\273\203 oxit nh\303\264m x\341\272\277p ch\341\272\267t t\341\272\241o ra chi\341\272\277t su\341\272\245t cao n = 1.768 v\303\240 tr\341\273\237 kh\303\241ng s\303\263ng th\341\272\245p (~213 \316\251), khi\341\272\277n ph\341\272\243n x\341\272\241 b\341\273\201 m\341\272\267t t\341\272\241i g\303\263c t\341\273\233i vu\303\264ng g\303\263c \304\221\341\272\241t kho\341\272\243ng 7.7%. R\341\272\245t b\341\273\201n c\306\241 h\341\273\215c v\303\240 truy\341\273\201n t\341\273\221t t\341\273\253 t\341\273\255 ngo\341\272\241i \304\221\341\272\277n trung h\341\273\223ng ngo\341\272\241i.\',"
