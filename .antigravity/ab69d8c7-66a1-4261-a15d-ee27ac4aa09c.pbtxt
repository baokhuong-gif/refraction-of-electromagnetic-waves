              text: "    indexExplanation:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Li\303\252n k\341\272\277t c\341\273\231ng h\303\263a tr\341\273\213 Si\342\200\223O b\341\273\201n v\341\273\257ng t\341\272\241o chi\341\272\277t su\341\272\245t n = 1.458 c\303\271ng \304\221\341\273\231 t\303\241n s\341\272\257c r\341\272\245t th\341\272\245p (s\341\273\221 Abbe 67.8). Nh\341\273\235 suy hao quang h\341\273\215c c\341\273\261c nh\341\273\217 \341\273\237 1550 nm, th\341\272\241ch anh l\303\240 n\341\273\201n t\341\272\243ng c\341\273\247a l\303\265i s\341\273\243i quang d\341\272\253n s\303\263ng b\341\272\261ng ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n.\',"
