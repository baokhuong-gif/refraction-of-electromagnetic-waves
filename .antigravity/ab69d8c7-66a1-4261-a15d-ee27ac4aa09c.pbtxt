        replacement_chunks {
          target_content: "    // 8. Medium Labels (Corner HUD inside canvas, crisp typography, no pill boxes)\n    ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n    ctx.fillStyle = \'#0f172a\';\n    ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 1: ${labelsRef.current.m1}`, 16, 26);\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#475569\';\n    ctx.fillText(\n      `n\342\202\201 = ${p.n1.toFixed(3)} \302\267 \316\265r\342\202\201 = ${p.permittivity1.toFixed(2)} \302\267 Z\342\202\201 = ${p.impedance1Ohm.toFixed(1)} \316\251`,\n      16,\n      44\n    );\n\n    ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n    ctx.fillStyle = \'#0f172a\';\n    ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 2: ${labelsRef.current.m2}`, 16, cy + 26);\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#475569\';\n    ctx.fillText(\n      `n\342\202\202 = ${p.n2.toFixed(3)} \302\267 \316\265r\342\202\202 = ${p.permittivity2.toFixed(2)} \302\267 Z\342\202\202 = ${p.impedance2Ohm.toFixed(1)} \316\251`,\n      16,\n      cy + 44\n    );\n\n    // Subtle right-hand energy flux readout (offset left of refractive drag rails)\n    const railX = width - 30;\n    ctx.textAlign = \'right\';\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#b91c1c\';\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, railX - 24, 24);\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\n    ctx.fillText(\n      p.isTotalInternalReflection\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\n      railX - 24,\n      cy + 24\n    );\n    ctx.textAlign = \'left\';"
          replacement_content: "    // 8. Medium Labels (Adaptive for desktop vs compact mobile canvas so labels never collide)\n    const isCompactCanvas = width < 520;\n    const railX = width - 30;\n\n    if (isCompactCanvas) {\n      drawHaloText(\n        ctx,\n        `MT1 \302\267 n\342\202\201 = ${p.n1.toFixed(3)}`,\n        12,\n        22,\n        \'#0f172a\',\n        \'600 11px \"IBM Plex Mono\", monospace\',\n        \'left\'\n      );\n      drawHaloText(\n        ctx,\n        `MT2 \302\267 n\342\202\202 = ${p.n2.toFixed(3)}`,\n        12,\n        cy + 22,\n        \'#0f172a\',\n        \'600 11px \"IBM Plex Mono\", monospace\',\n        \'left\'\n      );\n      drawHaloText(\n        ctx,\n        `R = ${(p.reflectanceEffective * 100).toFixed(1)}%`,\n        railX - 18,\n        22,\n        \'#b91c1c\',\n        \'600 11px \"IBM Plex Mono\", monospace\',\n        \'right\'\n      );\n      drawHaloText(\n        ctx,\n        p.isTotalInternalReflection\n          ? \'T = 0% (TIR)\'\n          : `T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\n        railX - 18,\n        cy + 22,\n        p.isTotalInternalReflection ? \'#b45309\' : \'#047857\',\n        \'600 11px \"IBM Plex Mono\", monospace\',\n        \'right\'\n      );\n    } else {\n      ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n      ctx.fillStyle = \'#0f172a\';\n      ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 1: ${labelsRef.current.m1}`, 16, 26);\n      ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n      ctx.fillStyle = \'#475569\';\n      ctx.fillText(\n        `n\342\202\201 = ${p.n1.toFixed(3)} \302\267 \316\265r\342\202\201 = ${p.permittivity1.toFixed(2)} \302\267 Z\342\202\201 = ${p.impedance1Ohm.toFixed(1)} \316\251`,\n        16,\n        44\n      );\n\n      ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n      ctx.fillStyle = \'#0f172a\';\n      ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 2: ${labelsRef.current.m2}`, 