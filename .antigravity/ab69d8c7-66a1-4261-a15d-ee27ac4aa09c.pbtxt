            }
            lines {
              text: "        // Out-of-plane E-field markers (dot = out of screen, cross = into screen)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const spacing = Math.max(18, lambdaPx * 0.5);"
