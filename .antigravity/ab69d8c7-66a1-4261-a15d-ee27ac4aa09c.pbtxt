              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'H\303\240m l\306\260\341\273\243ng oxit kim lo\341\272\241i n\341\272\267ng cao l\303\240m t\304\203ng m\341\272\241nh \304\221\341\273\231 ph\303\242n c\341\273\261c \304\221i\341\273\207n t\341\273\255, \304\221\341\272\251y chi\341\272\277t su\341\272\245t l\303\252n n = 1.785 v\303\240 t\341\272\241o t\303\241n s\341\272\257c m\341\272\241nh (s\341\273\221 Abbe th\341\272\245p 25.8). Tia s\303\241ng b\341\273\213 b\341\272\273 g\303\243y m\341\272\241nh khi \304\221i qua m\341\272\267t ph\303\242n c\303\241ch v\303\240 t\303\241ch m\303\240u r\303\265 r\341\273\207t trong l\304\203ng k\303\255nh quang ph\341\273\225.\',"
