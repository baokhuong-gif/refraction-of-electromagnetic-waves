            }
            lines {
              text: "    controls.minDistance = 4.2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    controls.maxDistance = 17.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    controls.update();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    controls.addEventListener(\'start\', () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraTransitionRef.current.active = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!isSoftwareGl) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      renderer.compile(scene, camera);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // ResizeObserver for crisp container fitting"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const handleResize = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const nextW = Math.max(320, container.clientWidth);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const nextH = Math.max(360, container.clientHeight);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.aspect = nextW / nextH;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.updateProjectionMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      renderer.setSize(nextW, nextH);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const resizeObserver = new ResizeObserver(handleResize);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    resizeObserver.observe(container);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Smooth damped mechanical state"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let dampedThetaI = physicsRef.current.incidentAngleRad;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let phase = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let lastTime = performance.now();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let frameId = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let disposed = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const afterDraw = (cb: () => void) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gl = renderer.getContext() as WebGL2RenderingContext;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gl.flush();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const poll = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (disposed) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (sync) gl.deleteSync(sync);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (state === gl.UNSIGNALED) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          frameId = window.setTimeout(poll, 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (sync) gl.deleteSync(sync);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          frameId = window.setTimeout(cb, 80);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      frameId = window.setTimeout(poll, 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const tick = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (disposed) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const now = performance.now();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dt = Math.min(0.06, (now - lastTime) / 1000);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      lastTime = now;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const p = physicsRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pol = polarizationRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const waveHex = wavelengthToColor(wavelengthRef.current);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (isPlayingRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        phase = (phase + dt * 5.2) % (Math.PI * 200);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Smooth camera preset damping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (cameraTransitionRef.current.active) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const [gx, gy, gz] = cameraTransitionRef.current.pos;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const [tx, ty, tz] = cameraTransitionRef.current.target;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _camGoalPos.set(gx, gy, gz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _camGoalTarget.set(tx, ty, tz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const k = isSoftwareGl ? 18 : 6.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const alpha = 1 - Math.exp(-k * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        camera.position.lerp(_camGoalPos, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        controls.target.lerp(_camGoalTarget, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          camera.position.distanceToSquared(_camGoalPos) < 0.002 &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          controls.target.distanceToSquared(_camGoalTarget) < 0.002"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          camera.position.copy(_camGoalPos);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          controls.target.copy(_camGoalTarget);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          cameraTransitionRef.current.active = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Smooth mechanical emitter & photodetector goniometer swing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      dampedThetaI = THREE.MathUtils.damp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dampedThetaI,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        p.incidentAngleRad,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        isSoftwareGl ? 24 : 11,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      emitterPivot.rotation.y = dampedThetaI;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      detectorPivot.rotation.y = -dampedThetaI;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Update optical material visual properties based on refractive indices n1, n2"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      glassMaterial.ior = clamp(p.n2, 1.0, 2.33);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const n2Tint = clamp((p.n2 - 1.0) / 2.4, 0, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      glassMaterial.color.setRGB("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        0.85 - n2Tint * 0.42,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        0.95 - n2Tint * 0.24,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        1.0 - n2Tint * 0.06"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      glassMaterial.opacity = isSoftwareGl ? clamp(0.18 + n2Tint * 0.36, 0.14, 0.56) : 0.92;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const m1Opacity = p.n1 > 1.05 ? clamp((p.n1 - 1.0) * 0.18, 0.08, 0.34) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      medium1AuraMaterial.opacity = m1Opacity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Update beam & emitter colors"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _color.set(waveHex);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      indicatorRingMat.color.copy(_color);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      indicatorRingMat.emissive.copy(_color);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      incBeamMat.color.copy(_color);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      incBeamMat.emissive.copy(_color);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      hitSpotMat.emissive.copy(_color);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const vecs = computeOpticalBenchVectors3D(dampedThetaI, p.refractedAngleRad);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const startX = -vecs.incDirX * BEAM_RADIUS_LEN;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const startZ = -vecs.incDirZ * BEAM_RADIUS_LEN;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Incident beam from emitter nozzle to origin (0, beamY, 0)"
