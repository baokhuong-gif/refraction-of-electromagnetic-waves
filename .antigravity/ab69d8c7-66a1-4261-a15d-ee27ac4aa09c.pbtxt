          replacement_content: "  // 4. Category filter returns only optical glass/crystal materials\n  const opticalOnly = filterMaterialsByGroup(sortedLibrary, \'OPTICAL\');\n  assert.ok(opticalOnly.length >= 4);\n  assert.ok(opticalOnly.every((m) => m.category === \'Th\341\273\247y tinh & Quang h\341\273\215c\'));\n});\n\ntest(\'Material index tooltip builder computes exact phase velocity, impedance, critical/Brewster angles, and deltas\', async () => {\n  const { buildMaterialIndexTooltipData } = await import(\'../utils/refractiveComparison\');\n  const { findMaterialById } = await import(\'./materials\');\n\n  const diamond = findMaterialById(\'diamond\');\n  const air = findMaterialById(\'air\');\n  const flint = findMaterialById(\'flint\');\n  assert.ok(diamond && air && flint);\n\n  const diamondTip = buildMaterialIndexTooltipData(diamond, 1.0003, 1.517);\n  assert.ok(Math.abs(diamondTip.speedPercentOfC - (100 / 2.417)) < 0.05);\n  assert.ok(Math.abs(diamondTip.impedanceOhm - VACUUM_IMPEDANCE / 2.417) < 0.1);\n  assert.ok(diamondTip.criticalAngleToAirDeg !== null && Math.abs(diamondTip.criticalAngleToAirDeg - 24.44) < 0.1);\n  assert.ok(Math.abs(diamondTip.brewsterAngleFromAirDeg - 67.52) < 0.1);\n  assert.ok(Math.abs(diamondTip.deltaVsN2 - (2.417 - 1.517)) < 1e-4);\n  assert.ok(diamondTip.material.indexExplanation.length > 40);\n\n  const airTip = buildMaterialIndexTooltipData(air, 1.0003, 1.517);\n  assert.equal(airTip.criticalAngleToAirDeg, null);\n  assert.ok(airTip.normalReflectanceFromAirPct < 1e-6);\n\n  const flintTip = buildMaterialIndexTooltipData(flint, 1.0003, 1.517);\n  assert.ok(flintTip.dispersionNote?.includes(\'t\303\241n s\341\272\257c m\341\272\241nh\'));\n});\n"
