  code_action {
    action_spec {
      create_file {
        instruction: "import { jsPDF } from \'jspdf\';\nimport {\n  formatFrequency,\n  formatWavelength,\n  WavePhysicsResult,\n} from \'../physics/emPhysics\';\nimport { PolarizationMode } from \'../physics/materials\';\n\nexport interface PdfReportParams {\n  physics: WavePhysicsResult;\n  polarization: PolarizationMode;\n  wavelengthVacuumNm: number;\n  material1Label: string;\n  material2Label: string;\n  canvasElement: HTMLCanvasElement | null;\n}\n\nexport interface PdfReportSummaryData {\n  filename: string;\n  generatedAt: string;\n  incidentAngleText: string;\n  refractedAngleText: string;\n  deviationAngleText: string;\n  n1Text: string;\n  n2Text: string;\n}\n\n/**\n * Formats deterministic structured summary strings for PDF report generation and unit testing.\n */\nexport function buildPdfReportMetadata(\n  physics: WavePhysicsResult,\n  now: Date = new Date()\n): PdfReportSummaryData {\n  const pad = (n: number) => String(n).padStart(2, \'0\');\n  const stamp = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(\n    now.getHours()\n  )}${pad(now.getMinutes())}`;\n\n  return {\n    filename: `EMRefract-Bao-cao-Khuc-xa-${stamp}.pdf`,\n    generatedAt: now.toLocaleString(\'vi-VN\'),\n    incidentAngleText: `${physics.incidentAngleDeg.toFixed(2)}\302\260`,\n    refractedAngleText: physics.isTotalInternalReflection\n      ? \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (TIR)\'\n      : `${physics.refractedAngleDeg!.toFixed(2)}\302\260`,\n    deviationAngleText: physics.isTotalInternalReflection\n      ? \'Kh\303\264ng truy\341\273\201n xa (100% ph\341\272\243n x\341\272\241)\'\n      : `${physics.deviationAngleDeg!.toFixed(2)}\302\260`,\n    n1Text: physics.n1.toFixed(4),\n    n2Text: physics.n2.toFixed(4),\n  };\n}\n\n/**\n * Renders a crisp A4 Vietnamese scientific report onto a high-DPI offscreen canvas\n * (preserving full Vietnamese diacritics and mathematical notation) and exports it as a real PDF.\n */\nexport function exportRefractionPdfReport(params: PdfReportParams): PdfReportSummaryData {\n  const {\n    physics,\n    polarization,\n    wavelengthVacuumNm,\n    material1Label,\n    material2Label,\n    canvasElement,\n  } = params;\n\n  const meta = buildPdfReportMetadata(physics);\n\n  // High-DPI A4 page canvas (1240 x 1754 px \342\211\210 150 DPI A4)\n  const W = 1240;\n  const H = 1754;\n  const pageCanvas = document.createElement(\'canvas\');\n  pageCanvas.width = W;\n  pageCanvas.height = H;\n  const ctx = pageCanvas.getContext(\'2d\');\n  if (!ctx) {\n    throw new Error(\'Kh\303\264ng th\341\273\203 kh\341\273\237i t\341\272\241o ng\341\273\257 c\341\272\243nh \304\221\341\273\223 h\341\273\215a \304\221\341\273\203 xu\341\272\245t b\303\241o c\303\241o PDF.\');\n  }\n\n  // Background\n  ctx.fillStyle = \'#ffffff\';\n  ctx.fillRect(0, 0, W, H);\n\n  const margin = 76;\n  const contentW = W - margin * 2;\n  let y = 78;\n\n  // Header band\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 32px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\'EMRefract Lab\', margin, y);\n\n  ctx.fillStyle = \'#0284c7\';\n  ctx.font = \'600 18px \"IBM Plex Mono\", monospace\';\n  ctx.textAlign = \'right\';\n  ctx.fillText(`Th\341\273\235i \304\221i\341\273\203m xu\341\272\245t: ${meta.generatedAt}`, W - margin, y);\n  ctx.textAlign = \'left\';\n\n  y += 34;\n  ctx.fillStyle = \'#475569\';\n  ctx.font = \'500 20px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\n    \'B\303\241o c\303\241o M\303\264 ph\341\273\217ng & Nh\341\272\255n d\341\272\241ng \304\220\341\272\267c t\303\255nh Truy\341\273\201n s\303\263ng Kh\303\272c x\341\272\241 \304\220i\341\273\207n t\341\273\253\',\n    margin,\n    y\n  );\n\n  y += 22;\n  ctx.strokeStyle = \'#cbd5e1\';\n  ctx.lineWidth = 2;\n  ctx.beginPath();\n  ctx.moveTo(margin, y);\n  ctx.lineTo(W - margin, y);\n  ctx.stroke();\n\n  // Section 1: Embedded Live Simulation Diagram\n  y += 38;\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 21px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\'01. S\306\241 \304\221\341\273\223 truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch\', margin, y);\n  y += 18;\n\n  const diagramH = 420;\n  ctx.strokeStyle = \'#cbd5e1\';\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(margin, y, contentW, diagramH);\n\n  if (canvasElement && canvasElement.width > 0 && canvasElement.height > 0) {\n    // Aspect-preserving fit inside diagram box\n    const srcAspect = canvasElement.width / canvasElement.height;\n    const dstAspect = contentW / diagramH;\n    let drawW = contentW;\n    let drawH = diagramH;\n    let drawX = margin;\n    let drawY = y;\n    if (srcAspect > dstAspect) {\n      drawH = contentW / srcAspect;\n      drawY = y + (diagramH - drawH) / 2;\n    } else {\n      drawW = diagramH * srcAspect;\n      drawX = margin + (contentW - drawW) / 2;\n    }\n    ctx.fillStyle = \'#f8fafc\';\n    ctx.fillRect(margin + 1, y + 1, contentW - 2, diagramH - 2);\n    ctx.drawImage(canvasElement, drawX, drawY, drawW, drawH);\n  }\n  y += diagramH + 46;\n\n  // Section 2: Key Calculated Results (Primary Highlight Row)\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 21px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\'02. K\341\272\277t qu\341\272\243 t\303\255nh to\303\241n kh\303\272c x\341\272\241 & \304\221\341\273\231 l\341\273\207ch tia s\303\241ng\', margin, y);\n  y += 20;\n\n  const kpis = [\n    { label: \'G\303\263c t\341\273\233i (\316\270i)\', value: meta.incidentAngleText, accent: \'#0f172a\' },\n    { label: \'G\303\263c kh\303\272c x\341\272\241 (\316\270t)\', value: meta.refractedAngleText, accent: \'#047857\' },\n    { label: \'\304\220\341\273\231 l\341\273\207ch tia (\316\224\316\270)\', value: meta.deviationAngleText, accent: \'#0284c7\' },\n    {\n      label: \'Ph\341\272\243n x\341\272\241 / Truy\341\273\201n qua\',\n      value: `${(physics.reflectanceEffective * 100).toFixed(1)}% / ${(\n        physics.transmittanceEffective * 100\n      ).toFixed(1)}%`,\n      accent: \'#b91c1c\',\n    },\n  ];\n\n  const colW = contentW / 4;\n  ctx.fillStyle = \'#f8fafc\';\n  ctx.fillRect(margin, y, contentW, 110);\n  ctx.strokeStyle = \'#cbd5e1\';\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(margin, y, contentW, 110);\n\n  kpis.forEach((kpi, idx) => {\n    const kx = margin + idx * colW;\n    if (idx > 0) {\n      ctx.beginPath();\n      ctx.moveTo(kx, y);\n      ctx.lineTo(kx, y + 110);\n      ctx.stroke();\n    }\n    ctx.fillStyle = \'#64748b\';\n    ctx.font = \'500 16px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n    ctx.fillText(kpi.label, kx + 18, y + 36);\n\n    ctx.fillStyle = kpi.accent;\n    ctx.font = \'700 23px \"IBM Plex Mono\", monospace\';\n    ctx.fillText(kpi.value, kx + 18, y + 80);\n  });\n  y += 148;\n\n  // Section 3: Automatic Propagation Regime Classification\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 21px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\'03. Nh\341\272\255n d\341\272\241ng ch\341\272\277 \304\221\341\273\231 truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253\', margin, y);\n  y += 20;\n\n  const boxFill =\n    physics.classification.severity === \'critical\'\n      ? \'#fff1f2\'\n      : physics.classification.severity === \'transition\'\n      ? \'#fffbeb\'\n      : \'#f0f9ff\';\n  const boxBorder =\n    physics.classification.severity === \'critical\'\n      ? \'#fecdd3\'\n      : physics.classification.severity === \'transition\'\n      ? \'#fde68a\'\n      : \'#bae6fd\';\n\n  ctx.fillStyle = boxFill;\n  ctx.fillRect(margin, y, contentW, 196);\n  ctx.strokeStyle = boxBorder;\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(margin, y, contentW, 196);\n\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 20px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(physics.classification.label, margin + 22, y + 38);\n\n  ctx.fillStyle = \'#334155\';\n  ctx.font = \'400 16px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  const summaryLines = wrapText(ctx, physics.classification.summary, contentW - 44);\n  summaryLines.slice(0, 2).forEach((line, i) => {\n    ctx.fillText(line, margin + 22, y + 70 + i * 24);\n  });\n\n  ctx.font = \'500 15px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  physics.classification.keyCharacteristics.forEach((char, idx) => {\n    ctx.fillStyle = \'#475569\';\n    ctx.fillText(`0${idx + 1}. ${char}`, margin + 22, y + 128 + idx * 24);\n  });\n  y += 236;\n\n  // Section 4: Detailed Input & Electromagnetic Parameters Table\n  ctx.fillStyle = \'#0f172a\';\n  ctx.font = \'700 21px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\'04. B\341\272\243ng th\303\264ng s\341\273\221 \304\221\341\272\247u v\303\240o v\303\240 \304\221\341\272\267c tr\306\260ng \304\221i\341\273\207n m\303\264i\', margin, y);\n  y += 22;\n\n  const polLabel =\n    polarization === \'TE\'\n      ? \'TE (ph\303\242n c\341\273\261c s \342\200\224 vu\303\264ng g\303\263c m\341\272\267t ph\341\272\263ng t\341\273\233i)\'\n      : polarization === \'TM\'\n      ? \'TM (ph\303\242n c\341\273\261c p \342\200\224 song song m\341\272\267t ph\341\272\263ng t\341\273\233i)\'\n      : \'Kh\303\264ng ph\303\242n c\341\273\261c (trung b\303\254nh TE & TM)\';\n\n  const tableRows: [string, string][] = [\n    [\'M\303\264i tr\306\260\341\273\235ng 1 (S\303\263ng t\341\273\233i)\', `${material1Label} \302\267 n\342\202\201 = ${meta.n1Text} \302\267 \316\265r\342\202\201 = ${physics.permittivity1.toFixed(3)}`],\n    [\'M\303\264i tr\306\260\341\273\235ng 2 (Kh\303\272c x\341\272\241)\', `${material2Label} \302\267 n\342\202\202 = ${meta.n2Text} \302\267 \316\265r\342\202\202 = ${physics.permittivity2.toFixed(3)}`],\n    [\'Ngu\341\273\223n s\303\263ng \304\221i\341\273\207n t\341\273\253\', `\316\273\342\202\200 = ${formatWavelength(wavelengthVacuumNm)} \302\267 f = ${formatFrequency(physics.frequencyHz)} \302\267 ${polLabel}`],\n    [\'G\303\263c \304\221\341\272\267c tr\306\260ng (Brewster / T\341\273\233i h\341\272\241n)\', `\316\270B = ${physics.brewsterAngleDeg.toFixed(2)}\302\260 \302\267 ${physics.criticalAngleDeg !== null ? `\316\270c = ${physics.criticalAngleDeg.toFixed(2)}\302\260` : \'Kh\303\264ng t\341\273\223n t\341\272\241i \316\270c (n\342\202\202 \342\211\245 n\342\202\201)\'}`],\n    [\'H\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 Fresnel (TE / TM)\', `Rs = ${(physics.reflectanceS * 100).toFixed(2)}% \302\267 Rp = ${(physics.reflectanceP * 100).toFixed(2)}% \302\267 R_eff = ${(physics.reflectanceEffective * 100).toFixed(2)}%`],\n    [\'\304\220\341\273\231 d\341\273\213ch pha ph\341\272\243n x\341\272\241 (\316\224\317\206s / \316\224\317\206p)\', `\316\224\317\206s = ${physics.phaseShiftSDeg.toFixed(1)}\302\260 \302\267 \316\224\317\206p = ${physics.phaseShiftPDeg.toFixed(1)}\302\260`],\n    [\'Tr\341\273\237 kh\303\241ng s\303\263ng n\341\273\231i t\341\272\241i (Z\342\202\201 / Z\342\202\202)\', `Z\342\202\201 = ${physics.impedance1Ohm.toFixed(1)} \316\251 \302\267 Z\342\202\202 = ${physics.impedance2Ohm.toFixed(1)} \316\251`],\n    [\'V\341\272\255n t\341\273\221c pha & B\306\260\341\273\233c s\303\263ng MT2\', `v\342\202\202 = ${(physics.phaseVelocity2 / 1e8).toFixed(3)}\303\22710\342\201\270 m/s \302\267 \316\273\342\202\202 = ${formatWavelength(physics.wavelength2Nm)} (\316\273\342\202\202/\316\273\342\202\201 = ${physics.wavelengthRatio.toFixed(3)})`],\n  ];\n\n  if (physics.isTotalInternalReflection && physics.evanescentPenetrationDepthNm !== null) {\n    tableRows.push([\n      \'\304\220\341\273\231 s\303\242u xuy\303\252n th\341\272\245u s\303\263ng suy gi\341\272\243m (\316\264e)\',\n      `${formatWavelength(physics.evanescentPenetrationDepthNm)} (bi\303\252n \304\221\341\273\231 gi\341\272\243m c\303\262n 1/e t\341\272\241i kho\341\272\243ng c\303\241ch z = \316\264e)`,\n    ]);\n  }\n\n  const rowH = 42;\n  ctx.strokeStyle = \'#e2e8f0\';\n  ctx.lineWidth = 1;\n  tableRows.forEach(([key, val], idx) => {\n    const ry = y + idx * rowH;\n    if (idx % 2 === 0) {\n      ctx.fillStyle = \'#f8fafc\';\n      ctx.fillRect(margin, ry, contentW, rowH);\n    }\n    ctx.strokeRect(margin, ry, contentW, rowH);\n\n    ctx.fillStyle = \'#475569\';\n    ctx.font = \'600 15px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n    ctx.fillText(key, margin + 16, ry + 26);\n\n    ctx.fillStyle = \'#0f172a\';\n    ctx.font = \'500 15px \"IBM Plex Mono\", monospace\';\n    ctx.fillText(val, margin + 350, ry + 26);\n  });\n\n  // Footer\n  ctx.strokeStyle = \'#e2e8f0\';\n  ctx.lineWidth = 1.5;\n  ctx.beginPath();\n  ctx.moveTo(margin, H - 76);\n  ctx.lineTo(W - margin, H - 76);\n  ctx.stroke();\n\n  ctx.fillStyle = \'#64748b\';\n  ctx.font = \'400 14px \"Plus Jakarta Sans\", system-ui, sans-serif\';\n  ctx.fillText(\n    \'EMRefract Lab \302\267 \304\220\341\273\213nh lu\341\272\255t Snell (n\342\202\201 sin \316\270i = n\342\202\202 sin \316\270t) & Ph\306\260\306\241ng tr\303\254nh Fresnel (\316\274r = 1)\',\n    margin,\n    H - 46\n  );\n\n  // Assemble A4 PDF via jsPDF\n  const doc = new jsPDF({\n    orientation: \'portrait\',\n    unit: \'mm\',\n    format: \'a4\',\n  });\n  const imgData = pageCanvas.toDataURL(\'image/png\');\n  doc.addImage(imgData, \'PNG\', 0, 0, 210, 297);\n  doc.save(meta.filename);\n\n  return meta;\n}\n\nfunction wrapText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number): string[] {\n  const words = text.split(\' \');\n  const lines: string[] = [];\n  let current = \'\';\n  for (const w of words) {\n    const test = current ? `${current} ${w}` : w;\n    if (ctx.measureText(test).width > maxWidth && current) {\n      lines.push(current);\n      current = w;\n    } else {\n      current = test;\n    }\n  }\n  if (current) lines.push(current);\n  return lines;\n}\n"
