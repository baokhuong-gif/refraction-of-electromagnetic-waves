      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add unit tests for AI wave propagation direction normalization, Snell cross-checking, and SVG trajectory math\",\"EndLine\":258,\"Instruction\":\"Append unit tests for src/utils/aiWavePrediction.ts to src/physics/emPhysics.test.ts.\",\"ReplacementContent\":\"  assert.equal(extractRefractiveIndexFromText(\'Chi\341\272\277t su\341\272\245t n \342\211\210 1.768 \304\221\341\273\221i v\341\273\233i Sapphire.\'), 1.768);\\n  assert.equal(extractRefractiveIndexFromText(\'Kh\303\264ng c\303\263 ch\341\273\211 s\341\273\221 h\341\273\243p l\341\273\207 [N_INDEX: 99.5]\'), null);\\n});\\n\\ntest(\'AI wave prediction normalizer and Snell cross-check validate normal refraction and TIR accurately\', async () => {\\n  const {\\n    normalizeAiWavePrediction,\\n    crossCheckAiPredictionWithSnell,\\n    computeTrajectorySvgGeometry,\\n  } = await import(\'../utils/aiWavePrediction\');\\n\\n  const normalPred = normalizeAiWavePrediction({\\n    scenarioSummary: \'Tia laser xanh \304\221i t\341\273\253 kh\303\264ng kh\303\255 v\303\240o k\303\255nh BK7 \341\273\237 45\302\260\',\\n    inferredN1: 1.0003,\\n    inferredN2: 1.517,\\n    inferredIncidentAngleDeg: 45,\\n    inferredWavelengthNm: 532,\\n    inferredPolarization: \'UNPOLARIZED\',\\n    directionCategory: \'TOWARD_NORMAL\',\\n    directionLabel: \'Kh\303\272c x\341\272\241 l\341\273\207ch l\341\272\241i g\341\272\247n ph\303\241p tuy\341\272\277n\',\\n    predictedRefractedAngleDeg: 27.79,\\n    predictedReflectedAngleDeg: 45,\\n    predictedDeviationDeg: 17.21,\\n    confidenceLevel: \'HIGH\',\\n    physicalReasoning: \'Chi\341\272\277t su\341\272\245t t\304\203ng l\303\240m v\341\272\255n t\341\273\221c pha gi\341\272\243m n\303\252n tia s\303\241ng b\341\272\273 g\341\272\247n ph\303\241p tuy\341\272\277n.\',\\n    engineeringRecommendations: [\'D\303\271ng ph\303\242n c\341\273\261c TM g\341\272\247n g\303\263c Brewster \304\221\341\273\203 t\304\203ng truy\341\273\201n qua.\'],\\n  });\\n\\n  const normalCheck = crossCheckAiPredictionWithSnell(normalPred);\\n  assert.equal(normalCheck.isDirectionAligned, true);\\n  assert.ok(normalCheck.angleDiscrepancyDeg !== null && normalCheck.angleDiscrepancyDeg < 0.05);\\n\\n  const tirPred = normalizeAiWavePrediction({\\n    scenarioSummary: \'S\341\273\243i quang th\341\272\241ch anh ra kh\303\264ng kh\303\255 \341\273\237 48\302\260\',\\n    inferredN1: 1.458,\\n    inferredN2: 1.0003,\\n    inferredIncidentAngleDeg: 48,\\n    inferredWavelengthNm: 1550,\\n    inferredPolarization: \'TE\',\\n    directionCategory: \'TOTAL_INTERNAL_REFLECTION\',\\n    directionLabel: \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n v\341\273\201 m\303\264i tr\306\260\341\273\235ng 1\',\\n    predictedRefractedAngleDeg: null,\\n    predictedReflectedAngleDeg: 48,\\n    predictedDeviationDeg: 84,\\n    confidenceLevel: \'HIGH\',\\n    physicalReasoning: \'G\303\263c t\341\273\233i 48\302\260 l\341\273\233n h\306\241n g\303\263c t\341\273\233i h\341\272\241n 43.32\302\260 n\303\252n x\341\272\243y ra ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n.\',\\n    engineeringRecommendations: [\'Gi\341\273\257 g\303\263c t\341\273\233i l\341\273\233n h\306\241n 44\302\260 \304\221\341\273\203 duy tr\303\254 d\341\272\253n s\303\263ng quang.\'],\\n  });\\n\\n  const tirCheck = crossCheckAiPredictionWithSnell(tirPred);\\n  assert.equal(tirCheck.exactPhysics.isTotalInternalReflection, true);\\n  assert.equal(tirCheck.isDirectionAligned, true);\\n  assert.equal(tirCheck.angleDiscrepancyDeg, 0);\\n\\n  const svgNormal = computeTrajectorySvgGeometry(45, 27.79, 420, 240);\\n  assert.equal(svgNormal.isTir, false);\\n  assert.ok(svgNormal.transEnd !== null && svgNormal.transEnd.y > svgNormal.cy);\\n\\n  const svgTir = computeTrajectorySvgGeometry(48, null, 420, 240);\\n  assert.equal(svgTir.isTir, true);\\n  assert.equal(svgTir.transEnd, null);\\n\\n  assert.throws(() => normalizeAiWavePrediction({ scenarioSummary: \'Thi\341\272\277u d\341\273\257 li\341\273\207u s\341\273\221\' }));\\n});\\n\",\"StartLine\":254,\"TargetContent\":\"  assert.equal(extractRefractiveIndexFromText(\'Chi\341\272\277t su\341\272\245t n \342\211\210 1.768 \304\221\341\273\221i v\341\273\233i Sapphire.\'), 1.768);\\n  assert.equal(extractRefractiveIndexFromText(\'Kh\303\264ng c\303\263 ch\341\273\211 s\341\273\221 h\341\273\243p l\341\273\207 [N_INDEX: 99.5]\'), null);\\n});\",\"TargetFile\":\"/src/physics/emPhysics.test.ts\",\"toolAction\":\"Adding AI wave prediction unit tests\",\"toolSummary\":\"Add AI wave prediction tests\"}"
      original_name: "replace_file_content"
    }
