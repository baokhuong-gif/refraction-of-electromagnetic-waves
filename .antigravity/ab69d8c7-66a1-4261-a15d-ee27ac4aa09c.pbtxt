              text: "    const cy = rect.height * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const dx = cx - x; // positive to the left of normal"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const dy = cy - y; // positive above interface"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (dy < 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
