            }
            lines {
              text: "    // ResizeObserver for crisp container fitting"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const handleResize = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const nextW = Math.max(320, container.clientWidth);"
