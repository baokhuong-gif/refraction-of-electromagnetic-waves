      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Batch protractor canvas strokes for smoother performance, replace duplicate Repeat icon on angle toggle with Ruler, prevent bottom hint overlap with protractor numerals, and clarify wavelength SVG legend.\",\"Instruction\":\"Update WaveCanvas.tsx to import Ruler, batch optical protractor ticks into 2 draw calls, use Ruler for the angles toggle, keep bottom hint clear of the protractor normal/numerals, and color-code \316\273\342\202\201/\316\273\342\202\202 readouts.\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":15,\"ReplacementContent\":\"  Repeat,\\n  RotateCcw,\\n  Ruler,\\n  StepForward,\",\"StartLine\":7,\"TargetContent\":\"  Repeat,\\n  RotateCcw,\\n  StepForward,\"},{\"AllowMultiple\":false,\"EndLine\":207,\"ReplacementContent\":\"      // Batch major (30\302\260) and minor (5\302\260/15\302\260) ticks into two strokes for smooth frame performance\\n      ctx.beginPath();\\n      for (let deg = 0; deg < 360; deg += 5) {\\n        if (deg % 30 === 0) continue;\\n        const rad = degToRad(deg);\\n        const innerR = deg % 15 === 0 ? pRadius - 7 : pRadius - 4;\\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\\n      }\\n      ctx.strokeStyle = \'rgba(100, 116, 139, 0.24)\';\\n      ctx.lineWidth = 0.8;\\n      ctx.stroke();\\n\\n      ctx.beginPath();\\n      for (let deg = 0; deg < 360; deg += 30) {\\n        const rad = degToRad(deg);\\n        const innerR = pRadius - 11;\\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\\n      }\\n      ctx.strokeStyle = \'rgba(71, 85, 105, 0.45)\';\\n      ctx.lineWidth = 1.2;\\n      ctx.stroke();\",\"StartLine\":191,\"TargetContent\":\"      for (let deg = 0; deg < 360; deg += 5) {\\n        const rad = degToRad(deg);\\n        const isMajor = deg % 30 === 0;\\n        const isMed = deg % 15 === 0;\\n        const innerR = isMajor ? pRadius - 11 : isMed ? pRadius - 7 : pRadius - 4;\\n        ctx.strokeStyle = isMajor\\n          ? \'rgba(71, 85, 105, 0.45)\'\\n          : \'rgba(100, 116, 139, 0.24)\';\\n        ctx.lineWidth = isMajor ? 1.2 : 0.8;\\n        ctx.beginPath();\\n        ctx.moveTo(cx + Math.sin(rad) * innerR, cy - Math.cos(rad) * innerR);\\n        ctx.lineTo(cx + Math.sin(rad) * pRadius, cy - Math.cos(rad) * pRadius);\\n        ctx.stroke();\\n      }\"},{\"AllowMultiple\":false,\"EndLine\":1278,\"ReplacementContent\":\"              [\'wavefronts\', \'S\303\263ng ph\341\272\263ng\', Waves],\\n              [\'rays\', \'Tia s\303\263ng\', MoveUpRight],\\n              [\'eField\', \'Tr\306\260\341\273\235ng E\', Activity],\\n              [\'angles\', \'G\303\263c & \316\224\316\270\', Ruler],\\n              [\'protractor\', \'Th\306\260\341\273\233c \304\221o g\303\263c\', Compass],\",\"StartLine\":1269,\"TargetContent\":\"              [\'wavefronts\', \'S\303\263ng ph\341\272\263ng\', Waves],\\n              [\'rays\', \'Tia s\303\263ng\', MoveUpRight],\\n              [\'eField\', \'Tr\306\260\341\273\235ng E\', Activity],\\n              [\'angles\', \'G\303\263c & \316\224\316\270\', Repeat],\\n              [\'protractor\', \'Th\306\260\341\273\233c \304\221o g\303\263c\', Compass],\"},{\"AllowMultiple\":false,\"EndLine\":1348,\"ReplacementContent\":\"        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\\n        <div className=\\\"pointer-events-none absolute bottom-2 left-3 right-14 flex items-center justify-between text-[11px] font-mono text-slate-500\\\">\\n          <span className=\\\"truncate bg-white/85 px-2 py-0.5 rounded\\\">\\n            K\303\251o ngu\341\273\223n ph\303\241t ch\341\273\211nh \316\270i \302\267 K\303\251o thanh ph\341\272\243i ch\341\273\211nh n\342\202\201, n\342\202\202\\n          </span>\\n          {probe.active && (\\n        