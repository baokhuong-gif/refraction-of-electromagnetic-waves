        target_content: "        // Map real penetration depth ratio (delta_e / lambda_0) to crisp pixel decay depth\n        const ratio =\n          p.evanescentPenetrationDepthNm !== null\n            ? clamp(p.evanescentPenetrationDepthNm / wavelengthRef.current, 0.08, 1.8)\n            : 0.35;\n        const decayDepthPx = clamp(ratio * 95, 18, height * 0.34);\n        const kx = (2 * Math.PI * sinI) / lambda1Px;\n\n        const spanStart = cx - beamHalfWidth * 0.9;\n        const spanEnd = Math.min(width - 12, cx + width * 0.42);\n        const cols = 4;\n\n        for (let z = 2; z <= decayDepthPx * 2.6; z += 4) {\n          const decay = Math.exp(-z / decayDepthPx);\n          if (decay < 0.04) break;\n          for (let x = spanStart; x <= spanEnd; x += cols) {\n            const dx = x - cx;\n            const envX =\n              dx < 0\n                ? Math.exp(-Math.pow(dx / (beamHalfWidth * 0.7), 2))\n                : Math.exp(-dx / (width * 0.32));\n            const val = Math.cos(kx * dx - phase) * decay * envX;\n            if (Math.abs(val) < 0.06) continue;\n            ctx.fillStyle =\n              val >= 0\n                ? hexToRgba(\'#d97706\', Math.abs(val) * 0.65)\n                : hexToRgba(\'#0f172a\', Math.abs(val) * 0.25);\n            ctx.fillRect(x, cy + z, cols, 3.2);\n          }\n        }\n\n        // Draw penetration depth 1/e indicator bracket\n        const bracketX = Math.min(width - 96, cx + 110);\n        ctx.strokeStyle = \'#b45309\';\n        ctx.lineWidth = 1.4;\n        ctx.beginPath();\n        ctx.moveTo(bracketX, cy + 2);\n        ctx.lineTo(bracketX, cy + decayDepthPx);\n        ctx.moveTo(bracketX - 5, cy + decayDepthPx);\n        ctx.lineTo(bracketX + 5, cy + decayDepthPx);\n        ctx.stroke();\n\n        ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n        ctx.fillStyle = \'#92400e\';\n        const depthLabel =\n          p.evanescentPenetrationDepthNm !== null\n            ? `\316\264e = ${formatWavelength(p.evanescentPenetrationDepthNm)}`\n            : \'S\303\263ng suy gi\341\272\243m\';\n        ctx.fillText(depthLabel, bracketX + 8, cy + decayDepthPx * 0.5 + 4);\n        ctx.restore();\n      }\n    }\n\n    // 3. Interface Boundary Line & Normal Line\n    ctx.strokeStyle = \'#334155\';\n    ctx.lineWidth = 1.75;\n    ctx.beginPath();\n    ctx.moveTo(0, cy);\n    ctx.lineTo(width, cy);\n    ctx.stroke();\n\n    if (ly.angles) {\n      // Normal line (dashed vertical through origin)\n      ctx.save();\n      ctx.strokeStyle = \'#64748b\';\n      ctx.lineWidth = 1.2;\n      ctx.setLineDash([5, 5]);\n      ctx.beginPath();\n      ctx.moveTo(cx, 16);\n      ctx.lineTo(cx, height - 16);\n      ctx.stroke();\n      ctx.restore();\n\n      ctx.font = \'500 11px \"Plus Jakarta Sans\", sans-serif\';\n      ctx.fillStyle = \'#64748b\';\n      ctx.fillText(\'Ph\303\241p tuy\341\272\277n (N)\', cx + 7, 26);\n\n      // Optional critical angle reference line in upper-left quadrant\n      if (p.criticalAngleDeg !== null) {\n        const cRad = degToRad(p.criticalAngleDeg);\n        const cLen = maxRayLen * 0.85;\n        ctx.save();\n        ctx.strokeStyle = \'rgba(217, 119, 6, 0.55)\';\n        ctx.lineWidth = 1.1;\n        ctx.setLineDash([3, 4]);\n        ctx.beginPath();\n        ctx.moveTo(cx, cy);\n        ctx.lineTo(cx - Math.sin(cRad) * cLen, cy - Math.cos(cRad) * cLen);\n        ctx.stroke();\n        ctx.restore();\n\n        ctx.font = \'500 10.5px \"IBM Plex Mono\", monospace\';\n        ctx.fillStyle = \'#b45309\';\n        ctx.fillText(\n          `\316\270c=${p.criticalAngleDeg.toFixed(1)}\302\260`,\n          cx - Math.sin(cRad) * (cLen * 0.72) - 46,\n          cy - Math.cos(cRad) * (cLen * 0.72)\n        );\n      }\n    }\n\n    // 4. E-field oscillation overlays along rays\n    if (ly.eField) {\n      drawEFieldVectors(\n        cx,\n        cy,\n        -incDirX,\n        -incDirY,\n        maxRayLen * 0.92,\n        lambda1Px,\n        0,\n        1.0,\n        waveHex,\n        \'top\',\n        true\n      );\n      if (refAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          refDirX,\n          refDirY,\n          maxRayLen * 0.92,\n          lambda1Px,\n          refPhaseRad,\n          refAmp,\n          \'#dc2626\',\n          \'top\',\n          false\n        );\n      }\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && transAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          Math.sin(p.refractedAngleRad),\n          Math.cos(p.refractedAngleRad),\n          maxRayLen * 0.92,\n          lambda2Px,\n          0,\n          transAmp,\n          \'#059669\',\n          \'bottom\',\n          false\n        );\n      }\n    }\n\n    // 5. Crisp Ray Arrows (Incident, Reflected, Refracted)\n    const srcX = cx - incDirX * maxRayLen;\n    const srcY = cy - incDirY * maxRayLen;\n\n    if (ly.rays) {\n      // Incident ray\n      drawRayArrow(ctx, srcX, srcY, cx, cy, waveHex, 2.8, 1.0);\n\n      // Reflected ray (opacity + thickness scales with sqrt(R))\n      const refAlpha = clamp(0.18 + refAmp * 0.82, 0.18, 1);\n      const refWidth = 1.4 + refAmp * 1.8;\n      drawRayArrow(\n        ctx,\n        cx,\n        cy,\n        cx + refDirX * maxRayLen,\n        cy + refDirY * maxRayLen,\n        \'#dc2626\',\n        refWidth,\n        refAlpha\n      );\n\n      // Refracted ray\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null) {\n        const transAlpha = clamp(0.2 + transAmp * 0.8, 0.2, 1);\n        const transWidth = 1.4 + transAmp * 1.8;\n        drawRayArrow(\n          ctx,\n          cx,\n          cy,\n          cx + Math.sin(p.refractedAngleRad) * maxRayLen,\n          cy + Math.cos(p.refractedAngleRad) * maxRayLen,\n          \'#059669\',\n          transWidth,\n          transAlpha\n        );\n      }\n    }\n\n    // 6. Angle Arcs & Numeric Annotations\n    if (ly.angles) {\n      const arcR = 52;\n      // Incident angle arc (measured from top normal -pi/2 counter-clockwise to incident ray)\n      if (p.incidentAngleDeg > 1.5) {\n        ctx.strokeStyle = waveHex;\n        ctx.lineWidth = 1.6;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, -Math.PI / 2 - thetaI, -Math.PI / 2);\n        ctx.stroke();\n\n        const midI = -Math.PI / 2 - thetaI * 0.5;\n        ctx.font = \'600 11.5px \"IBM Plex Mono\", monospace\';\n        ctx.fillStyle = \'#0f172a\';\n        ctx.fillText(\n          `\316\270i ${p.incidentAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midI) * (arcR + 14) - 24,\n          cy + Math.sin(midI) * (arcR + 14)\n        );\n      }\n\n      // Reflected angle arc\n      if (p.incidentAngleDeg > 1.5 && p.reflectanceEffective > 0.002) {\n        ctx.strokeStyle = \'#dc2626\';\n        ctx.lineWidth = 1.4;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR - 10, -Math.PI / 2, -Math.PI / 2 + thetaI);\n        ctx.stroke();\n\n        const midR = -Math.PI / 2 + thetaI * 0.5;\n        ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n        ctx.fillStyle = \'#b91c1c\';\n        ctx.fillText(\n          `\316\270r ${p.reflectedAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midR) * (arcR + 8) + 2,\n          cy + Math.sin(midR) * (arcR + 8)\n        );\n      }\n\n      // Refracted angle arc\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && p.refractedAngleDeg! > 1.5) {\n        ctx.strokeStyle = \'#059669\';\n        ctx.lineWidth = 1.6;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\n        ctx.stroke();\n\n        const midT = Math.PI / 2 - p.refractedAngleRad * 0.5;\n        ctx.font = \'600 11.5px \"IBM Plex Mono\", monospace\';\n        ctx.fillStyle = \'#047857\';\n        ctx.fillText(\n          `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\n          cx + Math.cos(midT) * (arcR + 16) + 2,\n          cy + Math.sin(midT) * (arcR + 16) + 4\n        );\n      }\n    }"
        replacement_content: "        // Map real penetration depth ratio (delta_e / lambda_0) to crisp pixel decay depth\n        const ratio =\n          p.evanescentPenetrationDepthNm !== null\n            ? clamp(p.evanescentPenetrationDepthNm / wavelengthRef.current, 0.1, 1.8)\n            : 0.35;\n        const decayDepthPx = clamp(ratio * 110, 26, height * 0.34);\n        const kx = (2 * Math.PI * sinI) / lambda1Px;\n\n        const spanStart = cx - beamHalfWidth * 0.95;\n        const spanEnd = Math.min(width - 12, cx + width * 0.44);\n        const cols = 4;\n\n        for (let z = 2; z <= decayDepthPx * 2.8; z += 4) {\n          const decay = Math.exp(-z / decayDepthPx);\n          if (decay < 0.04) break;\n          for (let x = spanStart; x <= spanEnd; x += cols) {\n            const dx = x - cx;\n            const envX =\n              dx < 0\n                ? Math.exp(-Math.pow(dx / (beamHalfWidth * 0.72), 2))\n                : Math.exp(-dx / (width * 0.34));\n            const val = Math.cos(kx * dx - phase) * decay * envX;\n            if (Math.abs(val) < 0.05) continue;\n            ctx.fillStyle =\n              val >= 0\n                ? hexToRgba(\'#d97706\', Math.abs(val) * 0.82)\n                : hexToRgba(\'#0f172a\', Math.abs(val) * 0.32);\n            ctx.fillRect(x, cy + z, cols, 3.4);\n          }\n        }\n\n        // Dashed 1/e decay horizon line\n        ctx.save();\n        ctx.strokeStyle = \'rgba(180, 83, 9, 0.45)\';\n        ctx.lineWidth = 1;\n        ctx.setLineDash([4, 4]);\n        ctx.beginPath();\n        ctx.moveTo(cx - 20, cy + decayDepthPx);\n        ctx.lineTo(Math.min(width - 120, cx + 150), cy + decayDepthPx);\n        ctx.stroke();\n        ctx.restore();\n\n        // Draw penetration depth 1/e indicator bracket\n        const bracketX = Math.min(width - 130, cx + 118);\n        ctx.strokeStyle = \'#b45309\';\n        ctx.lineWidth = 1.6;\n        ctx.beginPath();\n        ctx.moveTo(bracketX, cy + 2);\n        ctx.lineTo(bracketX, cy + decayDepthPx);\n        ctx.moveTo(bracketX - 5, cy + decayDepthPx);\n        ctx.lineTo(bracketX + 5, cy + decayDepthPx);\n        ctx.stroke();\n\n        const depthLabel =\n          p.evanescentPenetrationDepthNm !== null\n            ? `\316\264e = ${formatWavelength(p.evanescentPenetrationDepthNm)}`\n            : \'S\303\263ng suy gi\341\272\243m\';\n        drawHaloText(\n          ctx,\n          depthLabel,\n          bracketX + 9,\n          cy + Math.max(14, decayDepthPx * 0.55 + 3),\n          \'#92400e\',\n          \'600 11px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n        ctx.restore();\n      }\n    }\n\n    // 3. Interface Boundary Line & Normal Line\n    ctx.strokeStyle = \'#334155\';\n    ctx.lineWidth = 1.75;\n    ctx.beginPath();\n    ctx.moveTo(0, cy);\n    ctx.lineTo(width, cy);\n    ctx.stroke();\n\n    if (ly.angles) {\n      // Normal line (dashed vertical through origin)\n      ctx.save();\n      ctx.strokeStyle = \'#64748b\';\n      ctx.lineWidth = 1.2;\n      ctx.setLineDash([5, 5]);\n      ctx.beginPath();\n      ctx.moveTo(cx, 16);\n      ctx.lineTo(cx, height - 16);\n      ctx.stroke();\n      ctx.restore();\n\n      drawHaloText(\n        ctx,\n        \'Ph\303\241p tuy\341\272\277n (N)\',\n        cx + 8,\n        24,\n        \'#64748b\',\n        \'500 11px \"Plus Jakarta Sans\", sans-serif\',\n        \'left\'\n      );\n\n      // Optional critical angle reference line in upper-left quadrant\n      if (p.criticalAngleDeg !== null) {\n        const cRad = degToRad(p.criticalAngleDeg);\n        const cLen = maxRayLen * 0.96;\n        ctx.save();\n        ctx.strokeStyle = \'rgba(217, 119, 6, 0.65)\';\n        ctx.lineWidth = 1.25;\n        ctx.setLineDash([4, 4]);\n        ctx.beginPath();\n        ctx.moveTo(cx, cy);\n        ctx.lineTo(cx - Math.sin(cRad) * cLen, cy - Math.cos(cRad) * cLen);\n        ctx.stroke();\n        ctx.restore();\n\n        drawHaloText(\n          ctx,\n          `\316\270c = ${p.criticalAngleDeg.toFixed(1)}\302\260`,\n          cx - Math.sin(cRad) * (cLen * 0.88) - 8,\n          cy - Math.cos(cRad) * (cLen * 0.88) - 6,\n          \'#b45309\',\n          \'600 11px \"IBM Plex Mono\", monospace\',\n          \'right\'\n        );\n      }\n    }\n\n    // 4. E-field oscillation overlays along rays\n    if (ly.eField) {\n      drawEFieldVectors(\n        cx,\n        cy,\n        -incDirX,\n        -incDirY,\n        maxRayLen * 0.92,\n        lambda1Px,\n        0,\n        1.0,\n        waveHex,\n        \'top\',\n        true\n      );\n      if (refAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          refDirX,\n          refDirY,\n          maxRayLen * 0.92,\n          lambda1Px,\n          refPhaseRad,\n          refAmp,\n          \'#dc2626\',\n          \'top\',\n          false\n        );\n      }\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && transAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          Math.sin(p.refractedAngleRad),\n          Math.cos(p.refractedAngleRad),\n          maxRayLen * 0.92,\n          lambda2Px,\n          0,\n          transAmp,\n          \'#059669\',\n          \'bottom\',\n          false\n        );\n      }\n    }\n\n    // 5. Crisp Ray Arrows (Incident, Reflected, Refracted)\n    const srcX = cx - incDirX * maxRayLen;\n    const srcY = cy - incDirY * maxRayLen;\n\n    if (ly.rays) {\n      // Incident ray\n      drawRayArrow(ctx, srcX, srcY, cx, cy, waveHex, 2.8, 1.0);\n\n      // Reflected ray (opacity + thickness scales with sqrt(R))\n      const refAlpha = clamp(0.18 + refAmp * 0.82, 0.18, 1);\n      const refWidth = 1.4 + refAmp * 1.8;\n      drawRayArrow(\n        ctx,\n        cx,\n        cy,\n        cx + refDirX * maxRayLen,\n        cy + refDirY * maxRayLen,\n        \'#dc2626\',\n        refWidth,\n        refAlpha\n      );\n\n      // Refracted ray\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null) {\n        const transAlpha = clamp(0.2 + transAmp * 0.8, 0.2, 1);\n        const transWidth = 1.4 + transAmp * 1.8;\n        drawRayArrow(\n          ctx,\n          cx,\n          cy,\n          cx + Math.sin(p.refractedAngleRad) * maxRayLen,\n          cy + Math.cos(p.refractedAngleRad) * maxRayLen,\n          \'#059669\',\n          transWidth,\n          transAlpha\n        );\n      }\n    }\n\n    // 6. Angle Arcs & Haloed Numeric Annotations (positioned cleanly along arc bisectors)\n    if (ly.angles) {\n      const arcR = 54;\n      // Incident angle arc\n      if (p.incidentAngleDeg > 1.5) {\n        ctx.strokeStyle = waveHex;\n        ctx.lineWidth = 1.8;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, -Math.PI / 2 - thetaI, -Math.PI / 2);\n        ctx.stroke();\n\n        const midI = -Math.PI / 2 - thetaI * 0.45;\n        const labelR = arcR + 22;\n        drawHaloText(\n          ctx,\n          `\316\270i ${p.incidentAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midI) * labelR - 6,\n          cy + Math.sin(midI) * labelR,\n          \'#0f172a\',\n          \'600 11.5px \"IBM Plex Mono\", monospace\',\n          \'right\'\n        );\n      }\n\n      // Reflected angle arc\n      if (p.incidentAngleDeg > 1.5 && p.reflectanceEffective > 0.002) {\n        ctx.strokeStyle = \'#dc2626\';\n        ctx.lineWidth = 1.6;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR - 12, -Math.PI / 2, -Math.PI / 2 + thetaI);\n        ctx.stroke();\n\n        const midR = -Math.PI / 2 + thetaI * 0.45;\n        const labelR = arcR + 18;\n        drawHaloText(\n          ctx,\n          `\316\270r ${p.reflectedAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midR) * labelR + 6,\n          cy + Math.sin(midR) * labelR,\n          \'#b91c1c\',\n          \'600 11px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n      }\n\n      // Refracted angle arc\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && p.refractedAngleDeg! > 1.5) {\n        ctx.strokeStyle = \'#059669\';\n        ctx.lineWidth = 1.8;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\n        ctx.stroke();\n\n        const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\n        const labelR = arcR + 22;\n        drawHaloText(\n          ctx,\n          `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\n          cx + Math.cos(midT) * labelR + 6,\n          cy + Math.sin(midT) * labelR + 4,\n          \'#047857\',\n          \'600 11.5px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n      }\n    }"
        start_line: 296
        end_line: 495
      }
      use_global_match: true
    }
    description: "Add crisp haloed angle labels, clean label placement without ray collision, and clearer evanescent wave rendering in WaveCanvas.tsx"
