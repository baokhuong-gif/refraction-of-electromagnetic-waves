      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add \'Hi\341\273\203n th\341\273\213 c\303\264ng th\341\273\251c\' button to ControlDeck and wire it to open PhysicsFormulasModal\", \"Instruction\":\"Import BookOpen icon and PhysicsFormulasModal, add modal open state, and place the \'Hi\341\273\203n th\341\273\213 c\303\264ng th\341\273\251c\' button directly below \'Xu\341\272\245t b\303\241o c\303\241o PDF\' in ControlDeck\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":19, \"ReplacementContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { ArrowUpDown, BookOpen, FileDown } from \'lucide-react\';\\nimport { motion } from \'motion/react\';\\nimport {\\n  formatFrequency,\\n  formatWavelength,\\n  WavePhysicsResult,\\n  wavelengthToColor,\\n} from \'../physics/emPhysics\';\\nimport {\\n  OPTICAL_MATERIALS,\\n  PolarizationMode,\\n  PRESET_SCENARIOS,\\n  PresetScenario,\\n  SpectrumBand,\\n} from \'../physics/materials\';\\nimport { AnimatedLabSlider, SliderMarker } from \'./AnimatedLabSlider\';\\nimport { PhysicsFormulasModal } from \'./PhysicsFormulasModal\';\", \"StartLine\":1, \"TargetContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { ArrowUpDown, FileDown } from \'lucide-react\';\\nimport { motion } from \'motion/react\';\\nimport {\\n  formatFrequency,\\n  formatWavelength,\\n  WavePhysicsResult,\\n  wavelengthToColor,\\n} from \'../physics/emPhysics\';\\nimport {\\n  OPTICAL_MATERIALS,\\n  PolarizationMode,\\n  PRESET_SCENARIOS,\\n  PresetScenario,\\n  SpectrumBand,\\n} from \'../physics/materials\';\\nimport { AnimatedLabSlider, SliderMarker } from \'./AnimatedLabSlider\';\"}, {\"AllowMultiple\":false, \"EndLine\":74, \"ReplacementContent\":\"  const [angleError, setAngleError] = useState<string | null>(null);\\n  const [n1Error, setN1Error] = useState<string | null>(null);\\n  const [n2Error, setN2Error] = useState<string | null>(null);\\n  const [isFormulasOpen, setIsFormulasOpen] = useState(false);\", \"StartLine\":68, \"TargetContent\":\"  const [angleError, setAngleError] = useState<string | null>(null);\\n  const [n1Error, setN1Error] = useState<string | null>(null);\\n  const [n2Error, setN2Error] = useState<string | null>(null);\"}, {\"AllowMultiple\":false, \"EndLine\":486, \"ReplacementContent\":\"        <div className=\\\"space-y-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onExportPdf}\\n            className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-[13px] font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap cursor-pointer\\\"\\n          >\\n            <FileDown className=\\\"w-4 h-4\\\" />\\n            Xu\341\272\245t b\303\241o c\303\241o PDF\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            data-testid=\\\"open-formulas-modal-btn\\\"\\n            onClick={() => setIsFormulasOpen(true)}\\n            className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-[13px] font-medium text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg transition-colors whitespace-nowrap cursor-pointer\\\"\\n          >\\n            <BookOpen className=\\\"w-4 h-4 text-sky-700\\\" />\\n            Hi\341\273\203n th\341\273\213 c\303\264ng th\341\273\251c\\n          </button>\\n        </div>\\n      </div>\", \"StartLine\":474, \"TargetContent\":\"        <button\\n          type=\\\"button\\\"\\n          onClick={onExportPdf}\\n          className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-[13px] font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap cursor-pointer\\\"\\n        >\\n          <FileDown className=\\\"w-4 h-4\\\" />\\n          Xu\341\272\245t b\303\241o c\303\241o PDF\\n        </button>\\n      </div>\"}, {\"AllowMultiple\":false, \"EndLine\":598, \"ReplacementContent\":\"        <AnimatedLabSlider\\n          id=\\\"wavelength-slider\\\"\\n          ariaLabel={`\316\273\342\202\200 = ${formatWavelength(wavelengthVacuumNm)}`}\\n          min={bandSliderConfig.min}\\n          max={bandSliderConfig.max}\\n          step={bandSliderConfig.step}\\n          value={wavelengthVacuumNm}\\n          onChange={onChangeWavelengthNm}\\n          formatTooltip={(v) => formatWavelength(v)}\\n          accentColor={waveColor}\\n        />\\n      </div>\\n\\n      <PhysicsFormulasModal\\n        isOpen={isFormulasOpen}\\n        onClose={() => setIsFormulasOpen(false)}\\n        n1={n1}\\n        n2={n2}\\n        incidentAngleDeg={incidentAngleDeg}\\n        wavelengthVacuumNm={wavelengthVacuumNm}\\n        physics={physics}\\n      />\\n    </aside>\\n  );\\n};\", \"StartLine\":582, \"TargetContent\":\"        <AnimatedLabSlider\\n          id=\\\"wavelength-slider\\\"\\n          ariaLabel={`\316\273\342\202\200 = ${formatWavelength(wavelengthVacuumNm)}`}\\n          min={bandSliderConfig.min}\\n          max={bandSliderConfig.max}\\n          step={bandSliderConfig.step}\\n          value={wavelengthVacuumNm}\\n          onChange={onChangeWavelengthNm}\\n          formatTooltip={(v) => formatWavelength(v)}\\n          accentColor={waveColor}\\n        />\\n      </div>\\n    </aside>\\n  );\\n};\"}], \"TargetFile\":\"/src/components/ControlDeck.tsx\", \"toolAction\":\"Adding View Formulas button and modal to ControlDeck\", \"toolSummary\":\"Add View Formulas button to ControlDeck\"}"
      original_name: "multi_replace_file_content"
    }
