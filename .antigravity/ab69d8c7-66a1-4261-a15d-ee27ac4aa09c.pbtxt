            }
            lines {
              text: "            : hexToRgba(\'#475569\', alpha * 0.42);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ctx.lineWidth = val >= 0 ? 2.1 : 1.1;"
