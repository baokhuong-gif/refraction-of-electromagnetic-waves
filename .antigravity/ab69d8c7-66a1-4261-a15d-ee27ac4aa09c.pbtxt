            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Helper: draw planar electromagnetic wavefronts along a finite beam corridor"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const drawWavefrontBeam = ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
