            }
            lines {
              text: "          const s = clamp(Math.exp(-dist * 1.4), 0.12, 0.9);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _pos.set(dist, beamY, 0.16);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          _scale.set(s, s, s);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
