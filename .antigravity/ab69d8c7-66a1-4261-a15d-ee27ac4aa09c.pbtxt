  view_file {
    absolute_path_uri: "file:///src/components/CharacteristicsPanel.tsx"
    end_line: 166
    content: "import React from \'react\';\nimport { AlertTriangle, CheckCircle2, Info } from \'lucide-react\';\nimport { formatWavelength, WavePhysicsResult } from \'../physics/emPhysics\';\n\ninterface CharacteristicsPanelProps {\n  physics: WavePhysicsResult;\n}\n\nexport const CharacteristicsPanel: React.FC<CharacteristicsPanelProps> = ({ physics }) => {\n  const { classification } = physics;\n\n  const severityStyles =\n    classification.severity === \'critical\'\n      ? {\n          container: \'bg-rose-50/70 border-rose-200\',\n          title: \'text-rose-950\',\n          text: \'text-rose-900/90\',\n          statusColor: \'text-rose-700\',\n          icon: <AlertTriangle className=\"w-4 h-4 text-rose-600 shrink-0\" aria-hidden=\"true\" />,\n          glyph: \'\342\226\262\',\n        }\n      : classification.severity === \'transition\'\n      ? {\n          container: \'bg-amber-50/70 border-amber-200\',\n          title: \'text-amber-950\',\n          text: \'text-amber-900/90\',\n          statusColor: \'text-amber-700\',\n          icon: <Info className=\"w-4 h-4 text-amber-600 shrink-0\" aria-hidden=\"true\" />,\n          glyph: \'\342\227\206\',\n        }\n      : {\n          container: \'bg-sky-50/60 border-sky-200\',\n          title: \'text-slate-900\',\n          text: \'text-slate-700\',\n          statusColor: \'text-sky-700\',\n          icon: <CheckCircle2 className=\"w-4 h-4 text-sky-600 shrink-0\" aria-hidden=\"true\" />,\n          glyph: \'\342\227\217\',\n        };\n\n  return (\n    <section\n      aria-label=\"Nh\341\272\255n d\341\272\241ng \304\221\341\272\267c t\303\255nh truy\341\273\201n s\303\263ng t\341\273\261 \304\221\341\273\231ng\"\n      className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\"\n    >\n      {/* Automatic Propagation Regime Header */}\n      <div className={`px-5 py-4 border-b ${severityStyles.container}`}>\n        <div className=\"flex flex-wrap items-center justify-between gap-2 mb-1.5\">\n          <div className=\"flex items-center gap-2\">\n            {severityStyles.icon}\n            <h2\n              data-testid=\"regime-label\"\n              className={`text-base font-semibold ${severityStyles.title}`}\n            >\n              {classification.label}\n            </h2>\n          </div>\n          <span className={`text-xs font-mono font-semibold ${severityStyles.statusColor}`}>\n            {severityStyles.glyph} {classification.shortTag}\n          </span>\n        </div>\n\n        <p className={`text-sm leading-relaxed ${severityStyles.text}`}>{classification.summary}</p>\n\n        <ul className=\"mt-3 grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-1.5 text-xs text-slate-700\">\n          {classification.keyCharacteristics.map((item, idx) => (\n            <li key={idx} className=\"flex items-start gap-1.5\">\n              <span className=\"font-mono text-slate-400 select-none\">0{idx + 1}.</span>\n              <span>{item}</span>\n            </li>\n          ))}\n        </ul>\n      </div>\n\n      {/* Quantitative Wave Propagation Metrics Strip (6-column tabular telemetry grid) */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 divide-x divide-y md:divide-y-0 divide-slate-200\">\n        {/* Metric 1: Refracted Angle / TIR Depth */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">\n            {physics.isTotalInternalReflection ? \'S\303\263ng suy gi\341\272\243m (\316\264e)\' : \'G\303\263c kh\303\272c x\341\272\241 (\316\270t)\'}\n          </div>\n          <div\n            data-testid=\"metric-refracted\"\n            className=\"font-mono text-xl font-semibold tabular-nums text-slate-900\"\n          >\n            {physics.isTotalInternalReflection\n              ? physics.evanescentPenetrationDepthNm !== null\n                ? formatWavelength(physics.evanescentPenetrationDepthNm)\n                : \'TIR\'\n              : `${physics.refractedAngleDeg!.toFixed(2)}\302\260`}\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums\">\n            {physics.isTotalInternalReflection\n              ? \'Tia l\303\263 tri\341\273\207t ti\303\252u (TIR)\'\n              : `\304\220\341\273\231 l\341\273\207ch \316\224\316\270 = ${physics.deviationAngleDeg!.toFixed(2)}\302\260`}\n          </div>\n        </div>\n\n        {/* Metric 2: Power Reflectance */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">Ph\341\272\243n x\341\272\241 c\303\264ng su\341\272\245t (R)</div>\n          <div\n            data-testid=\"metric-reflectance\"\n            className=\"font-mono text-xl font-semibold tabular-nums text-rose-700\"\n          >\n            {(physics.reflectanceEffective * 100).toFixed(2)}\n            <span className=\"text-xs font-normal text-slate-400 ml-1\">%</span>\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums\">\n            Rs {(physics.reflectanceS * 100).toFixed(1)}% \302\267 Rp {(physics.reflectanceP * 100).toFixed(1)}%\n          </div>\n        </div>\n\n        {/* Metric 3: Power Transmittance */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">Truy\341\273\201n qua c\303\264ng su\341\272\245t (T)</div>\n          <div\n            data-testid=\"metric-transmittance\"\n            className=\"font-mono text-xl font-semibold tabular-nums text-emerald-700\"\n          >\n            {(physics.transmittanceEffective * 100).toFixed(2)}\n            <span className=\"text-xs font-normal text-slate-400 ml-1\">%</span>\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums\">\n            Ts {(physics.transmittanceS * 100).toFixed(1)}% \302\267 Tp {(physics.transmittanceP * 100).toFixed(1)}%\n          </div>\n        </div>\n\n        {/* Metric 4: Characteristic Angles */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">G\303\263c Brewster (\316\270B)</div>\n          <div className=\"font-mono text-xl font-semibold tabular-nums text-slate-900\">\n            {physics.brewsterAngleDeg.toFixed(2)}\302\260\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums whitespace-nowrap\">\n            {physics.criticalAngleDeg !== null\n              ? `\316\270c = ${physics.criticalAngleDeg.toFixed(2)}\302\260`\n              : \'Kh\303\264ng c\303\263 \316\270c (n\342\202\202 \342\211\245 n\342\202\201)\'}\n          </div>\n        </div>\n\n        {/* Metric 5: Reflection Phase Shift */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">D\341\273\213ch pha ph\341\272\243n x\341\272\241 (\316\224\317\206)</div>\n          <div className=\"font-mono text-xl font-semibold tabular-nums text-slate-900\">\n            {physics.phaseShiftSDeg.toFixed(0)}\302\260\n            <span className=\"text-xs font-normal text-slate-400 ml-1\">TE</span>\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums whitespace-nowrap\">\n            TM (p): {physics.phaseShiftPDeg.toFixed(0)}\302\260\n          </div>\n        </div>\n\n        {/* Metric 6: Wavelength & Phase Velocity in Medium 2 */}\n        <div className=\"p-4\">\n          <div className=\"text-xs text-slate-500 mb-1\">B\306\260\341\273\233c s\303\263ng M\303\264i tr\306\260\341\273\235ng 2</div>\n          <div className=\"font-mono text-xl font-semibold tabular-nums text-slate-900\">\n            {formatWavelength(physics.wavelength2Nm)}\n          </div>\n          <div className=\"mt-1 text-[11px] font-mono text-slate-500 tabular-nums whitespace-nowrap\">\n            v\342\202\202 = {(physics.phaseVelocity2 / 1e8).toFixed(2)}\303\22710\342\201\270 m/s\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 167
    num_bytes: 7208
    line_range_bytes: 7208
  }
}
