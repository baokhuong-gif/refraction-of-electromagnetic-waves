      arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close\' EXIT\\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\\\\n  playwright-cli resize 1440 900 && \\\\\\n  sleep 0.6 && \\\\\\n  playwright-cli run-code \'async (page) => {\\n    // 1. Capture Round 2 desktop first paint\\n    await page.screenshot({ path: \\\".playwright-cli/r2-desktop.png\\\" });\\n\\n    // 2. Test direct numeric inputs (\316\270i = 60, n1 = 1.000, n2 = 1.800)\\n    await page.getByLabel(\\\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p g\303\263c t\341\273\233i theo \304\221\341\273\231\\\").fill(\\\"60\\\");\\n    await page.getByLabel(\\\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng 1\\\").fill(\\\"1.000\\\");\\n    await page.getByLabel(\\\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng 2\\\").fill(\\\"1.800\\\");\\n    await page.waitForTimeout(250);\\n    const thetaT = await page.getByTestId(\\\"sidebar-theta-t\\\").textContent();\\n    const devAngle = await page.getByTestId(\\\"sidebar-deviation\\\").textContent();\\n    console.log(\\\"NUMERIC_INPUT_CHECK:\\\", { thetaT, devAngle });\\n\\n    // 3. Test direct canvas drag-and-drop for n2 rail and incident angle\\n    const canvas = page.getByTestId(\\\"em-wave-canvas\\\");\\n    const box = await canvas.boundingBox();\\n    if (!box) throw new Error(\\\"Canvas bounding box missing\\\");\\n\\n    // Drag n2 rail upward (increases n2 toward higher refractive index)\\n    const railX = box.x + box.width - 30;\\n    const n2StartY = box.y + box.height * 0.78;\\n    const n2EndY = box.y + box.height * 0.62;\\n    await page.mouse.move(railX, n2StartY);\\n    await page.mouse.down();\\n    await page.mouse.move(railX, n2EndY, { steps: 6 });\\n    await page.mouse.up();\\n    await page.waitForTimeout(200);\\n    const n2AfterDrag = await page.getByLabel(\\\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng 2\\\").inputValue();\\n\\n    // Drag incident ray in Medium 1 to change incident angle\\n    const incX = box.x + box.width * 0.34;\\n    const incY = box.y + box.height * 0.22;\\n    await page.mouse.move(incX, incY);\\n    await page.mouse.down();\\n    await page.mouse.move(box.x + box.width * 0.25, box.y + box.height * 0.32, { steps: 6 });\\n    await page.mouse.up();\\n    await page.waitForTimeout(200);\\n    const angleAfterDrag = await page.getByLabel(\\\"Nh\341\272\255p tr\341\273\261c ti\341\272\277p g\303\263c t\341\273\233i theo \304\221\341\273\231\\\").inputValue();\\n    console.log(\\\"CANVAS_DRAG_CHECK:\\\", { n2AfterDrag, angleAfterDrag });\\n\\n    // 4. Test real PDF report download\\n    const downloadPromise = page.waitForEvent(\\\"download\\\");\\n    await page.getByRole(\\\"button\\\", { name: \\\"Xu\341\272\245t b\303\241o c\303\241o PDF\\\" }).click();\\n    const download = await downloadPromise;\\n    const suggestedName = download.suggestedFilename();\\n    const savedPath = await download.path();\\n    console.log(\\\"PDF_DOWNLOAD_CHECK:\\\", { suggestedName, hasFile: Boolean(savedPath) });\\n\\n    // 5. Capture refined TIR screenshot + verify Fresnel chart below\\n    await page.getByRole(\\\"button\\\", { name: \\\"Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\\\" }).click();\\n    await page.waitForTimeout(400);\\n    await page.screenshot({ path: \\\".playwright-cli/r2-tir.png\\\" });\\n\\n    // 6. Verify mobile viewport reflow (390x844)\\n    await page.setViewportSize({ width: 390, height: 844 });\\n    await page.waitForTimeout(400);\\n    const mobileOverflowX = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\\n    console.log(\\\"MOBILE_OVERFLOW_X:\\\", mobileOverflowX);\\n    await page.screenshot({ path: \\\".playwright-cli/r2-mobile.png\\\" });\\n  }\' && \\\\\\n  