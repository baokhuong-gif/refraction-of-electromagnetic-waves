            lines {
              text: "      scene.add(line);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return { line, attr, mat, geo };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
