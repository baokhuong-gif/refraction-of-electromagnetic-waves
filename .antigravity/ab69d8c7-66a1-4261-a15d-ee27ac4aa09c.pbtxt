    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli && \\\n  playwright-cli open --browser=chromium http://localhost:3000 && \\\n  playwright-cli resize 1440 900 && \\\n  playwright-cli run-code \'async (page) => {\n    const pauseBtn = page.getByRole(\"button\", { name: \"T\341\272\241m d\341\273\253ng\", exact: true });\n    if (await pauseBtn.isVisible()) await pauseBtn.click();\n\n    const chart = page.locator(\"[data-testid=\\\"refractive-comparison-chart\\\"]\");\n    await chart.waitFor({ state: \"visible\", timeout: 10000 });\n    await chart.scrollIntoViewIfNeeded();\n    await page.waitForTimeout(250);\n\n    // 1. Hover top-area row (water)\n    const waterRow = chart.locator(\"[data-testid=\\\"comparison-bar-water\\\"]\");\n    await waterRow.hover();\n    const tooltip = page.locator(\"[data-testid=\\\"material-index-tooltip\\\"]\");\n    await tooltip.waitFor({ state: \"visible\", timeout: 5000 });\n    await page.waitForTimeout(200);\n    const waterTooltipText = await tooltip.textContent();\n    const waterBounds = await tooltip.boundingBox();\n    await page.screenshot({ path: \".playwright-cli/r14-tooltip-water.png\", animations: \"disabled\" });\n\n    // 2. Hover bottom-area row (diamond) to confirm automatic upward flip & zero viewport clipping\n    const diamondRow = chart.locator(\"[data-testid=\\\"comparison-bar-diamond\\\"]\");\n    await diamondRow.hover();\n    await page.waitForTimeout(200);\n    const diamondTooltipText = await tooltip.textContent();\n    const diamondBounds = await tooltip.boundingBox();\n    await page.screenshot({ path: \".playwright-cli/r14-tooltip-diamond.png\", animations: \"disabled\" });\n\n    // 3. Move mouse outside chart rows and verify tooltip dismisses cleanly\n    await page.mouse.move(10, 10);\n    await page.waitForTimeout(250);\n    const visibleAfterLeave = await tooltip.count();\n\n    // 4. Mobile 390x844 verification with keyboard focus on diamond row\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.waitForTimeout(250);\n    await chart.scrollIntoViewIfNeeded();\n    await page.waitForTimeout(200);\n    await diamondRow.focus();\n    await tooltip.waitFor({ state: \"visible\", timeout: 5000 });\n    await page.waitForTimeout(200);\n    const mobileOverflow = await page.evaluate(() => ({\n      scrollWidth: document.documentElement.scrollWidth,\n      innerWidth: window.innerWidth,\n      hasOverflow: document.documentElement.scrollWidth > window.innerWidth\n    }));\n    await page.screenshot({ path: \".playwright-cli/r14-tooltip-mobile.png\", animations: \"disabled\" });\n\n    return JSON.stringify({\n      waterHasExplanation: waterTooltipText?.includes(\"H\342\202\202O\"),\n      waterBounds,\n      diamondHasExplanation: diamondTooltipText?.includes(\"24.4\302\260\"),\n      diamondBounds,\n      visibleAfterLeave,\n      mobileOverflow\n    }, null, 2);\n  }\' && \\\n  playwright-cli console"
