    start_line: 484
    end_line: 734
    content: "\n      drawHaloText(\n        ctx,\n        \'Ph\303\241p tuy\341\272\277n (N)\',\n        cx + 8,\n        24,\n        \'#64748b\',\n        \'500 11px \"Plus Jakarta Sans\", sans-serif\',\n        \'left\'\n      );\n\n      // Optional critical angle reference line in upper-left quadrant\n      if (p.criticalAngleDeg !== null) {\n        const cRad = degToRad(p.criticalAngleDeg);\n        const cLen = maxRayLen * 0.96;\n        ctx.save();\n        ctx.strokeStyle = \'rgba(217, 119, 6, 0.65)\';\n        ctx.lineWidth = 1.25;\n        ctx.setLineDash([4, 4]);\n        ctx.beginPath();\n        ctx.moveTo(cx, cy);\n        ctx.lineTo(cx - Math.sin(cRad) * cLen, cy - Math.cos(cRad) * cLen);\n        ctx.stroke();\n        ctx.restore();\n\n        drawHaloText(\n          ctx,\n          `\316\270c = ${p.criticalAngleDeg.toFixed(1)}\302\260`,\n          cx - Math.sin(cRad) * (cLen * 0.88) - 8,\n          cy - Math.cos(cRad) * (cLen * 0.88) - 6,\n          \'#b45309\',\n          \'600 11px \"IBM Plex Mono\", monospace\',\n          \'right\'\n        );\n      }\n    }\n\n    // 4. E-field oscillation overlays along rays\n    if (ly.eField) {\n      drawEFieldVectors(\n        cx,\n        cy,\n        -incDirX,\n        -incDirY,\n        maxRayLen * 0.92,\n        lambda1Px,\n        0,\n        1.0,\n        waveHex,\n        \'top\',\n        true\n      );\n      if (refAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          refDirX,\n          refDirY,\n          maxRayLen * 0.92,\n          lambda1Px,\n          refPhaseRad,\n          refAmp,\n          \'#dc2626\',\n          \'top\',\n          false\n        );\n      }\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && transAmp > 0.08) {\n        drawEFieldVectors(\n          cx,\n          cy,\n          Math.sin(p.refractedAngleRad),\n          Math.cos(p.refractedAngleRad),\n          maxRayLen * 0.92,\n          lambda2Px,\n          0,\n          transAmp,\n          \'#059669\',\n          \'bottom\',\n          false\n        );\n      }\n    }\n\n    // 5. Crisp Ray Arrows (Incident, Reflected, Refracted)\n    const srcX = cx - incDirX * maxRayLen;\n    const srcY = cy - incDirY * maxRayLen;\n\n    if (ly.rays) {\n      // Incident ray\n      drawRayArrow(ctx, srcX, srcY, cx, cy, waveHex, 2.8, 1.0);\n\n      // Reflected ray (opacity + thickness scales with sqrt(R))\n      const refAlpha = clamp(0.18 + refAmp * 0.82, 0.18, 1);\n      const refWidth = 1.4 + refAmp * 1.8;\n      drawRayArrow(\n        ctx,\n        cx,\n        cy,\n        cx + refDirX * maxRayLen,\n        cy + refDirY * maxRayLen,\n        \'#dc2626\',\n        refWidth,\n        refAlpha\n      );\n\n      // Refracted ray\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null) {\n        const transAlpha = clamp(0.2 + transAmp * 0.8, 0.2, 1);\n        const transWidth = 1.4 + transAmp * 1.8;\n        drawRayArrow(\n          ctx,\n          cx,\n          cy,\n          cx + Math.sin(p.refractedAngleRad) * maxRayLen,\n          cy + Math.cos(p.refractedAngleRad) * maxRayLen,\n          \'#059669\',\n          transWidth,\n          transAlpha\n        );\n      }\n    }\n\n    // 6. Angle Arcs & Haloed Numeric Annotations (positioned cleanly along arc bisectors)\n    if (ly.angles) {\n      const arcR = 54;\n      // Incident angle arc\n      if (p.incidentAngleDeg > 1.5) {\n        ctx.strokeStyle = waveHex;\n        ctx.lineWidth = 1.8;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, -Math.PI / 2 - thetaI, -Math.PI / 2);\n        ctx.stroke();\n\n        const midI = -Math.PI / 2 - thetaI * 0.45;\n        const labelR = arcR + 22;\n        drawHaloText(\n          ctx,\n          `\316\270i ${p.incidentAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midI) * labelR - 6,\n          cy + Math.sin(midI) * labelR,\n          \'#0f172a\',\n          \'600 11.5px \"IBM Plex Mono\", monospace\',\n          \'right\'\n        );\n      }\n\n      // Reflected angle arc\n      if (p.incidentAngleDeg > 1.5 && p.reflectanceEffective > 0.002) {\n        ctx.strokeStyle = \'#dc2626\';\n        ctx.lineWidth = 1.6;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR - 12, -Math.PI / 2, -Math.PI / 2 + thetaI);\n        ctx.stroke();\n\n        const midR = -Math.PI / 2 + thetaI * 0.45;\n        const labelR = arcR + 18;\n        drawHaloText(\n          ctx,\n          `\316\270r ${p.reflectedAngleDeg.toFixed(1)}\302\260`,\n          cx + Math.cos(midR) * labelR + 6,\n          cy + Math.sin(midR) * labelR,\n          \'#b91c1c\',\n          \'600 11px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n      }\n\n      // Refracted angle arc\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && p.refractedAngleDeg! > 1.5) {\n        ctx.strokeStyle = \'#059669\';\n        ctx.lineWidth = 1.8;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\n        ctx.stroke();\n\n        const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\n        const labelR = arcR + 22;\n        drawHaloText(\n          ctx,\n          `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\n          cx + Math.cos(midT) * labelR + 6,\n          cy + Math.sin(midT) * labelR + 4,\n          \'#047857\',\n          \'600 11.5px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n      }\n    }\n\n    // 7. Interactive Emitter Handle on Incident Ray\n    ctx.save();\n    ctx.beginPath();\n    ctx.arc(srcX, srcY, 10, 0, Math.PI * 2);\n    ctx.fillStyle = \'#ffffff\';\n    ctx.fill();\n    ctx.lineWidth = 2.5;\n    ctx.strokeStyle = waveHex;\n    ctx.stroke();\n\n    ctx.beginPath();\n    ctx.arc(srcX, srcY, 4, 0, Math.PI * 2);\n    ctx.fillStyle = waveHex;\n    ctx.fill();\n    ctx.restore();\n\n    // Origin incidence marker\n    ctx.beginPath();\n    ctx.arc(cx, cy, 4, 0, Math.PI * 2);\n    ctx.fillStyle = \'#0f172a\';\n    ctx.fill();\n\n    // 8. Medium Labels (Corner HUD inside canvas, crisp typography, no pill boxes)\n    ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n    ctx.fillStyle = \'#0f172a\';\n    ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 1: ${labelsRef.current.m1}`, 16, 26);\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#475569\';\n    ctx.fillText(\n      `n\342\202\201 = ${p.n1.toFixed(3)} \302\267 \316\265r\342\202\201 = ${p.permittivity1.toFixed(2)} \302\267 Z\342\202\201 = ${p.impedance1Ohm.toFixed(1)} \316\251`,\n      16,\n      44\n    );\n\n    ctx.font = \'600 12px \"Plus Jakarta Sans\", sans-serif\';\n    ctx.fillStyle = \'#0f172a\';\n    ctx.fillText(`M\303\264i tr\306\260\341\273\235ng 2: ${labelsRef.current.m2}`, 16, cy + 26);\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#475569\';\n    ctx.fillText(\n      `n\342\202\202 = ${p.n2.toFixed(3)} \302\267 \316\265r\342\202\202 = ${p.permittivity2.toFixed(2)} \302\267 Z\342\202\202 = ${p.impedance2Ohm.toFixed(1)} \316\251`,\n      16,\n      cy + 44\n    );\n\n    // Subtle right-hand energy flux readout\n    ctx.textAlign = \'right\';\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#b91c1c\';\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, width - 16, 26);\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\n    ctx.fillText(\n      p.isTotalInternalReflection\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\n      width - 16,\n      cy + 26\n    );\n    ctx.textAlign = \'left\';\n\n    ctx.restore();"
    num_lines: 1046
