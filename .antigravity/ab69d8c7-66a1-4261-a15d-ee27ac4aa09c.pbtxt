            }
            lines {
              text: "      const geo = new THREE.BufferGeometry();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const attr = new THREE.BufferAttribute(positions, 3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      attr.setUsage(THREE.DynamicDrawUsage);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      geo.setAttribute(\'position\', attr);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const mat = new THREE.LineBasicMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
