            }
            lines {
              text: "        const dist = frac * BEAM_RADIUS_LEN;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const s = refStrength > 0.08 ? clamp(0.45 + refStrength * 0.65, 0.45, 1.05) : 0.0001;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _pos.set(vecs.refDirX * dist, beamY, vecs.refDirZ * dist);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _scale.set(s, s, s);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        _mat4.compose(_pos, _quat, _scale);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        photonMesh.setMatrixAt(idx, _mat4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
