       </tbody>\n            </table>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 leading-relaxed\">\n          <span className=\"font-medium text-slate-700\">M\303\264i tr\306\260\341\273\235ng:</span> {material1Label} \342\206\222{\' \'}\n          {material2Label}. \304\220\341\273\213nh lu\341\272\255t b\341\272\243o to\303\240n n\304\203ng l\306\260\341\273\243ng:{\' \'}\n          <span className=\"font-mono text-slate-800\">\n            R + T = {((physics.reflectanceEffective + physics.transmittanceEffective) * 100).toFixed(1)}%\n          </span>\n          .\n        </div>\n      </div>"
