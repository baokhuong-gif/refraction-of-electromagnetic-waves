              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                ? Math.exp(-Math.pow(dx / (beamHalfWidth * 0.72), 2))"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                : Math.exp(-dx / (width * 0.34));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
