          target_content: "      // Refracted angle arc\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && p.refractedAngleDeg! > 1.5) {\n        ctx.strokeStyle = \'#059669\';\n        ctx.lineWidth = 1.8;\n        ctx.beginPath();\n        ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\n        ctx.stroke();\n\n        const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\n        const labelR = arcR + 22;\n        drawHaloText(\n          ctx,\n          `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\n          cx + Math.cos(midT) * labelR + 6,\n          cy + Math.sin(midT) * labelR + 4,\n          \'#047857\',\n          \'600 11.5px \"IBM Plex Mono\", monospace\',\n          \'left\'\n        );\n      }\n    }"
          replacement_content: "      // Refracted angle arc & ray deviation (\316\224\316\270) visual cue\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null) {\n        if (p.refractedAngleDeg! > 1.5) {\n          ctx.strokeStyle = \'#059669\';\n          ctx.lineWidth = 1.8;\n          ctx.beginPath();\n          ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\n          ctx.stroke();\n\n          const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\n          const labelR = arcR + 22;\n          drawHaloText(\n            ctx,\n            `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\n            cx + Math.cos(midT) * labelR + 6,\n            cy + Math.sin(midT) * labelR + 4,\n            \'#047857\',\n            \'600 11.5px \"IBM Plex Mono\", monospace\',\n            \'left\'\n          );\n        }\n\n        // Undeviated dashed ray extension into Medium 2 + deviation angle \316\224\316\270 arc\n        if (p.deviationAngleDeg !== null && p.deviationAngleDeg > 2.0) {\n          ctx.save();\n          ctx.strokeStyle = \'rgba(100, 116, 139, 0.55)\';\n          ctx.lineWidth = 1.25;\n          ctx.setLineDash([4, 4]);\n          ctx.beginPath();\n          ctx.moveTo(cx, cy);\n          ctx.lineTo(cx + incDirX * maxRayLen * 0.85, cy + incDirY * maxRayLen * 0.85);\n          ctx.stroke();\n          ctx.restore();\n\n          const devArcR = arcR + 30;\n          const a1 = Math.PI / 2 - thetaI;\n          const a2 = Math.PI / 2 - p.refractedAngleRad;\n          const startA = Math.min(a1, a2);\n          const endA = Math.max(a1, a2);\n          ctx.strokeStyle = \'#0284c7\';\n          ctx.lineWidth = 1.5;\n          ctx.beginPath();\n          ctx.arc(cx, cy, devArcR, startA, endA);\n          ctx.stroke();\n\n          const midDev = (startA + endA) * 0.5;\n          drawHaloText(\n            ctx,\n            `\316\224\316\270 ${p.deviationAngleDeg.toFixed(1)}\302\260`,\n            cx + Math.cos(midDev) * (devArcR + 12) + 4,\n            cy + Math.sin(midDev) * (devArcR + 12) + 4,\n            \'#0369a1\',\n            \'600 10.5px \"IBM Plex Mono\", monospace\',\n            \'left\'\n          );\n        }\n      }\n    }"
