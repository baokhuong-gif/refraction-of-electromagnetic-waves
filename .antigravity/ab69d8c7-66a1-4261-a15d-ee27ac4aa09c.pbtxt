            }
            lines {
              text: "    abbeNumber: 64.2,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    notes: \'Th\341\273\247y tinh quang h\341\273\215c ti\303\252u chu\341\272\251n cho l\304\203ng k\303\255nh v\303\240 th\341\272\245u k\303\255nh.\',"
