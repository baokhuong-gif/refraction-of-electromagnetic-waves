        replacement_chunks {
          target_content: "  return (\n    <section\n      aria-label=\"S\303\242n kh\341\272\245u m\303\264 ph\341\273\217ng truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253\"\n      className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\"\n    >\n      {/* Compact Instrument Toolbar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 border-b border-slate-200 bg-slate-50/70\">\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => setIsPlaying((v) => !v)}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-800 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            {isPlaying ? \'T\341\272\241m d\341\273\253ng\' : \'Ph\303\241t s\303\263ng\'}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handleStepFrame}\n            aria-label=\"B\306\260\341\273\233c khung s\303\263ng k\341\272\277 ti\341\272\277p\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <StepForward className=\"w-3.5 h-3.5\" />\n            B\306\260\341\273\233c pha\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onResetSimulation}\n            aria-label=\"\304\220\341\272\267t l\341\272\241i tham s\341\273\221 m\303\264 ph\341\273\217ng\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            \304\220\341\272\267t l\341\272\241i\n          </button>\n\n          <div className=\"hidden sm:flex items-center gap-1.5 pl-2 border-l border-slate-200 text-xs text-slate-600\">\n            <label htmlFor=\"wave-speed-select\" className=\"whitespace-nowrap\">\n              T\341\273\221c \304\221\341\273\231:\n            </label>\n            <select\n              id=\"wave-speed-select\"\n              value={speedMultiplier}\n              onChange={(e) => setSpeedMultiplier(Number(e.target.value))}\n              className=\"bg-white border border-slate-200 rounded px-1.5 py-1 text-xs font-mono text-slate-800\"\n            >\n              <option value={0.5}>0.5\303\227</option>\n              <option value={1}>1.0\303\227</option>\n              <option value={1.8}>1.8\303\227</option>\n            </select>\n          </div>\n        </div>\n\n        {/* Layer Visibility Toggles */}\n        <div\n          role=\"group\"\n          aria-label=\"L\341\273\233p hi\341\273\203n th\341\273\213 m\303\264 ph\341\273\217ng\"\n          className=\"flex flex-wrap items-center gap-1 bg-slate-100 p-1 rounded-lg\"\n        >\n          {(\n            [\n              [\'wavefronts\', \'S\303\263ng ph\341\272\263ng\'],\n              [\'rays\', \'Tia s\303\263ng\'],\n              [\'eField\', \'Tr\306\260\341\273\235ng E\'],\n              [\'angles\', \'G\303\263c & Ph\303\241p tuy\341\272\277n\'],\n            ] as const\n          ).map(([key, label]) => (\n            <button\n              key={key}\n              type=\"button\"\n              aria-pressed={layers[key]}\n              onClick={() => toggleLayer(key)}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                layers[key]\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              {label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main Canvas Stage */}\n      <div\n        ref={containerRef}\n        className=\"relative w-full h-[380px] sm:h-[430px] select-none bg-white\"\n        data-testid=\"em-wave-canvas-container\"\n        data-regime={physics.classification.code}\n      >\n        <canvas\n          ref={(node) => {\n            canvasRef.current = node;\n            if (canvasElementRef) canvasElementRef.current = node;\n          }}\n          data-testid=\"em-wave-canvas\"\n          onPointerDown={handlePointerDown}\n          onPointerMove={handlePointerMove}\n          onPointerUp={handlePointerUp}\n          onPointerLeave={() => {\n            setProbe((prev) => ({ ...prev, active: false }));\n          }}\n          className={`w-full h-full block ${\n            dragMode !== \'NONE\' ? \'cursor-grabbing\' : \'cursor-crosshair\'\n          }`}\n          aria-label=\"Bi\341\273\203u \304\221\341\273\223 tr\341\273\261c quan kh\303\272c x\341\272\241 v\303\240 ph\341\272\243n x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\"\n        />\n\n        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\n        <div className=\"pointer-events-none absolute bottom-2.5 left-4 right-14 flex items-center justify-between text-[11px] font-mono text-slate-500\">\n          <span className=\"truncate\">\n            K\303\251o ngu\341\273\223n ph\303\241t \304\221\341\273\203 ch\341\273\211nh \316\270i \302\267 K\303\251o thanh b\303\252n ph\341\272\243i \304\221\341\273\203 ch\341\273\211nh chi\341\272\277t su\341\272\245t n\342\202\201, n\342\202\202 tr\341\273\261c ti\341\272\277p\n          </span>\n          {probe.active && (\n            <span className=\"hidden sm:inline bg-white/90 px-2 py-0.5 rounded border border-slate-200 tabular-nums text-slate-700 shrink-0 ml-2\">\n              MT{probe.medium} \302\267 x={probe.normX.toFixed(2)} \302\267 z={probe.normZ.toFixed(2)} \302\267 \342\210\240N=\n              {probe.angleFromNormalDeg.toFixed(1)}\302\260\n            </span>\n          )}\n        </div>\n      </div>\n    </section>\n  );\n};"
          replacement_content: "  const handleZoomStep = (delta: number) => {\n    setZoomLevel((prev) => clamp(Math.round((prev + delta) * 100) / 100, 0.75, 1.75));\n  };\n\n  // Build miniature wavelength comparison sine SVG paths for the visual instrument strip\n  const waveColor = wavelengthToColor(wavelengthVacuumNm);\n  const miniPath1 = buildMiniSinePath(112, 20, clamp(28 / physics.n1, 7, 36));\n  const miniPath2 = buildMiniSinePath(112, 20, clamp(28 / physics.n2, 7, 36));\n  const refPct = clamp(physics.reflectanceEffective * 100, 0, 100);\n  const transPct = clamp(physics.transmittanceEffective * 100, 0, 100);\n\n  return (\n    <section\n      aria-label=\"S\303\242n kh\341\272\245u m\303\264 ph\341\273\217ng truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253\"\n      className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\"\n    >\n      {/* Visual Instrument Toolbar Row 1: Playback, Auto-Sweep, Zoom & Speed */}\n      <div className=\"flex flex-wrap items-center justify-between gap-2.5 px-4 py-2.5 border-b border-slate-200 bg-slate-50/80\">\n        <div className=\"flex flex-wrap items-center gap-1.5\">\n          <button\n            type=\"button\"\n            onClick={() => setIsPlaying((v) => !v)}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-800 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            {isPlaying ? \'T\341\272\241m d\341\273\253ng\' : \'Ph\303\241t s\303\263ng\'}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handleStepFrame}\n            aria-label=\"B\306\260\341\273\233c khung s\303\263ng k\341\272\277 ti\341\272\277p\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <StepForward className=\"w-3.5 h-3.5\" />\n            B\306\260\341\273\233c pha\n          </button>\n\n          <button\n            type=\"button\"\n            aria-pressed={isSweeping}\n            onClick={() => setIsSweeping((v) => !v)}\n            className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md border transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              isSweeping\n                ? \'bg-sky-700 border-sky-700 text-white\'\n                : \'bg-white border-slate-200 text-slate-700 hover:bg-slate-100\'\n            }`}\n          >\n            <Repeat className=\"w-3.5 h-3.5\" />\n            {isSweeping ? \'D\341\273\253ng qu\303\251t\' : \'Qu\303\251t g\303\263c\'}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              setIsSweeping(false);\n              setZoomLevel(1.0);\n              onResetSimulation();\n            }}\n            aria-label=\"\304\220\341\272\267t l\341\272\241i tham s\341\273\221 m\303\264 ph\341\273\217ng\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            \304\220\341\272\267t l\341\272\241i\n          </button>\n        </div>\n\n        {/* Right Group: Zoom Lens & Wave Speed */}\n        <div className=\"flex items-center gap-2\">\n          <div\n            role=\"group\"\n            aria-label=\"Thu ph\303\263ng khung m\303\264 ph\341\273\217ng\"\n            className=\"inline-flex items-center bg-white border border-slate-200 rounded-md overflow-hidden\"\n          >\n            <button\n              type=\"button\"\n              onClick={() => handleZoomStep(-0.25)}\n              disabled={zoomLevel <= 0.75}\n              aria-label=\"Thu nh\341\273\217 s\306\241 \304\221\341\273\223 s\303\263ng\"\n              className=\"px-2 py-1.5 text-slate-600 hover:bg-slate-100 disabled:opacity-35 transition-colors cursor-pointer\"\n            >\n              <ZoomOut className=\"w-3.5 h-3.5\" />\n            </button>\n            <span className=\"px-2 text-[11px] font-mono tabular-nums text-slate-700 border-x border-slate-200\">\n              {Math.round(zoomLevel * 100)}%\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => handleZoomStep(0.25)}\n              disabled={zoomLevel >= 1.75}\n              aria-label=\"Ph\303\263ng \304\221\341\272\241i s\306\241 \304\221\341\273\223 s\303\263ng\"\n              className=\"px-2 py-1.5 text-slate-600 hover:bg-slate-100 disabled:opacity-35 transition-colors cursor-pointer\"\n            >\n              <ZoomIn className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"hidden sm:flex items-center gap-1.5 pl-2 border-l border-slate-200 text-xs text-slate-600\">\n            <label htmlFor=\"wave-speed-select\" className=\"whitespace-nowrap\">\n              T\341\273\221c \304\221\341\273\231:\n            </label>\n            <select\n              id=\"wave-speed-select\"\n              value={speedMultiplier}\n              onChange={(e) => setSpeedMultiplier(Number(e.target.value))}\n              className=\"bg-white border border-slate-200 rounded px-1.5 py-1 text-xs font-mono text-slate-800\"\n            >\n              <option value={0.5}>0.5\303\227</option>\n              <option value={1}>1.0\303\227</option>\n              <option value={1.8}>1.8\303\227</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Visual Instrument Toolbar Row 2: Icon-Coded Optical Layer Toggles */}\n      <div className=\"flex flex-wrap items-center justify-between gap-2 px-4 py-2 border-b border-slate-200 bg-white\">\n        <div\n          role=\"group\"\n          aria-label=\"L\341\273\233p hi\341\273\203n th\341\273\213 m\303\264 ph\341\273\217ng\"\n          className=\"flex flex-wrap items-center gap-1.5\"\n        >\n          {(\n            [\n              [\'wavefronts\', \'S\303\263ng ph\341\272\263ng\', Waves],\n              [\'rays\', \'Tia s\303\263ng\', MoveUpRight],\n              [\'eField\', \'Tr\306\260\341\273\235ng E\', Activity],\n              [\'angles\', \'G\303\263c & \316\224\316\270\', Repeat],\n              [\'protractor\', \'Th\306\260\341\273\233c \304\221o g\303\263c\', Compass],\n            ] as const\n          ).map(([key, label, Icon]) => (\n            <button\n              key={key}\n              type=\"button\"\n              aria-pressed={layers[key]}\n              onClick={() => toggleLayer(key)}\n              className={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md border transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                layers[key]\n                  ? \'bg-sky-50 border-sky-200 text-sky-900\'\n                  : \'bg-slate-50 border-slate-200 text-slate-500 hover:text-slate-800\'\n              }`}\n            >\n              <Icon className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n              {label}\n            </button>\n          ))}\n        </div>\n\n        {/* Compact Color Legend */}\n        <div className=\"hidden xl:flex items-center gap-3 text-[11px] text-slate-500 font-mono\">\n          <span className=\"inline-flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-0.5 inline-block\" style={{ backgroundColor: waveColor }} />\n            Tia t\341\273\233i\n          </span>\n          <span className=\"inline-flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-0.5 bg-rose-600 inline-block\" />\n            Ph\341\272\243n x\341\272\241\n          </span>\n          <span className=\"inline-flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-0.5 bg-emerald-600 inline-block\" />\n            Kh\303\272c x\341\272\241\n          </span>\n        </div>\n      </div>\n\n      {/* Main Canvas Stage */}\n      <div\n        ref={containerRef}\n        className=\"relative w-full h-[380px] sm:h-[430px] select-none bg-white\"\n        data-testid=\"em-wave-canvas-container\"\n        data-regime={physics.classification.code}\n      >\n        <canvas\n          ref={(node) => {\n            canvasRef.current = node;\n            if (canvasElementRef) canvasElementRef.current = node;\n          }}\n          data-testid=\"em-wave-canvas\"\n          onPointerDown={handlePointerDown}\n          onPointerMove={handlePointerMove}\n          onPointerUp={handlePointerUp}\n          onPointerLeave={() => {\n            setProbe((prev) => ({ ...prev, active: false }));\n          }}\n          className={`w-full h-full block ${\n            dragMode !== \'NONE\' ? \'cursor-grabbing\' : \'cursor-crosshair\'\n          }`}\n          aria-label=\"Bi\341\273\203u \304\221\341\273\223 tr\341\273\261c quan kh\303\272c x\341\272\241 v\303\240 ph\341\272\243n x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\"\n        />\n\n        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\n        <div className=\"pointer-events-none absolute bottom-2.5 left-4 right-14 flex items-center justify-between text-[11px] font-mono text-slate-500\">\n          <span className=\"truncate\">\n            K\303\251o ngu\341\273\223n ph\303\241t \304\221\341\273\203 ch\341\273\211nh \316\270i \302\267 K\303\251o thanh b\303\252n ph\341\272\243i \304\221\341\273\203 ch\341\273\211nh chi\341\272\277t su\341\272\245t n\342\202\201, n\342\202\202 tr\341\273\261c ti\341\272\277p\n          </span>\n          {probe.active && (\n            <span className=\"hidden sm:inline bg-white/90 px-2 py-0.5 rounded border border-slate-200 tabular-nums text-slate-700 shrink-0 ml-2\">\n              MT{probe.medium} \302\267 x={probe.normX.toFixed(2)} \302\267 z={probe.normZ.toFixed(2)} \302\267 \342\210\240N=\n              {probe.angleFromNormalDeg.toFixed(1)}\302\260\n            </span>\n          )}\n        </div>\n      </div>\n\n      {/* Live Visual Instrument Strip: Animated Energy Flux Bar + Wavelength Compression Gauge */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 px-4 py-3 border-t border-slate-200 bg-slate-50/70 items-center\">\n        {/* Energy Split Meter */}\n        <div className=\"md:col-span-7 space-y-1.5\">\n          <div className=\"flex items-center justify-between text-[11px] font-mono tabular-nums\">\n            <span className=\"text-rose-700 font-semibold\">\n              Ph\341\272\243n x\341\272\241 R: {refPct.toFixed(1)}%\n            </span>\n            <span className=\"text-slate-400\">Ph\303\242n b\341\273\225 n\304\203ng l\306\260\341\273\243ng s\303\263ng</span>\n            <span\n              className={`font-semibold ${\n                physics.isTotalInternalReflection ? \'text-amber-700\' : \'text-emerald-700\'\n              }`}\n            >\n              {physics.isTotalInternalReflection\n                ? \'S\303\263ng suy gi\341\272\243m (T = 0%)\'\n                : `Truy\341\273\201n qua T: ${transPct.toFixed(1)}%`}\n            </span>\n          </div>\n          <div\n            aria-label=\"Thanh \304\221o t\341\273\267 l\341\273\207 n\304\203ng l\306\260\341\273\243ng ph\341\272\243n x\341\272\241 v\303\240 truy\341\273\201n qua\"\n            className=\"h-2.5 w-full rounded-full bg-slate-200 overflow-hidden flex\"\n          >\n            <motion.div\n              className=\"h-full bg-rose-600 origin-left\"\n              initial={false}\n              animate={{ width: `${refPct}%` }}\n              transition={\n                prefersReducedMotion\n                  ? { duration: 0.01 }\n                  : { type: \'spring\', stiffness: 360, damping: 34 }\n              }\n            />\n            <motion.div\n              className=\"h-full bg-emerald-600 origin-right\"\n              initial={false}\n              animate={{ width: `${transPct}%` }}\n              transition={\n                prefersReducedMotion\n                  ? { duration: 0.01 }\n                  : { type: \'spring\', stiffness: 360, damping: 34 }\n              }\n            />\n          </div>\n        </div>\n\n        {/* Live Spatial Wavelength Compression Preview */}\n        <div className=\"md:col-span-5 md:border-l md:border-slate-200 md:pl-4 flex items-center justify-between gap-3\">\n          <div className=\"space-y-1 min-w-0\">\n            <div className=\"text-[11px] text-slate-500\">N\303\251n / gi\303\243n b\306\260\341\273\233c s\303\263ng (\316\273\342\202\201 \342\206\222 \316\273\342\202\202)</div>\n            <div className=\"font-mono text-xs text-slate-800 tabular-nums whitespace-nowrap\">\n              {formatWavelength(physics.wavelength1Nm)} \342\206\222 {formatWavelength(physics.wavelength2Nm)}\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\" aria-hidden=\"true\">\n            <svg width=\"112\" height=\"24\" viewBox=\"0 0 112 24\" className=\"overflow-visible\">\n              <path\n                d={miniPath1}\n                fill=\"none\"\n                stroke={waveColor}\n                strokeWidth=\"1.6\"\n                opacity=\"0.45\"\n              />\n              <path\n                d={miniPath2}\n                fill=\"none\"\n                stroke={physics.isTotalInternalReflection ? \'#d97706\' : \'#059669\'}\n                strokeWidth=\"1.9\"\n              />\n            </svg>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nfunction buildMiniSinePath(width: number, height: number, lambdaPx: number): string {\n  const midY = height / 2 + 2;\n  const amp = height * 0.36;\n  const pts: string[] = [];\n  for (let x = 0; x <= width; x += 2) {\n    const y = midY - Math.sin((x / lambdaPx) * Math.PI * 2) * amp;\n    pts.push(`${x === 0 ? \'M\' : \'L\'}${x},${y.toFixed(1)}`);\n  }\n  return pts.join(\' \');\n}"
