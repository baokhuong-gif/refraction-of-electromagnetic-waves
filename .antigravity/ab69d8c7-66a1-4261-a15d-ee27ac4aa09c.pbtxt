            }
            lines {
              text: "  const phaseVelocity2 = SPEED_OF_LIGHT / n2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const wavelength1Nm = wavelengthVacuumNm / n1;"
