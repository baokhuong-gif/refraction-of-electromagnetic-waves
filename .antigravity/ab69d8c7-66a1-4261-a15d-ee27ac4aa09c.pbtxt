              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // OrbitControls with exponential damping (disabled on software WebGL per threejs skill)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const controls = new OrbitControls(camera, renderer.domElement);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    controls.target.set(...CAMERA_PRESETS[0].target);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    controls.enableDamping = !isSoftwareGl;"
