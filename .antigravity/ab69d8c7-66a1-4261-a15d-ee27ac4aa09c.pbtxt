            }
            lines {
              text: " * evanescent penetration depth, and automatic propagation regime classification"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * for a non-magnetic isotropic lossless dielectric interface (mu_r1 = mu_r2 = 1)."
