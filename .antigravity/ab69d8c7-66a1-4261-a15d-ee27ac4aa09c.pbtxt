            }
            lines {
              text: "function classifyPropagationRegime(params: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  n1: number;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
