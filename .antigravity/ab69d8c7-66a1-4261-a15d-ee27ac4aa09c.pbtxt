1 t\303\241n s\341\272\257c cao, d\303\271ng cho quang h\341\273\215c t\303\241ch ph\341\273\225.\',\n    tintHex: \'#cbd5e1\',\n  },\n  {\n    id: \'sapphire\',\n    name: \'Sapphire (Al\342\202\202O\342\202\203)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.768,\n    relativePermittivity: 3.126,\n    relativePermeability: 1.0,\n    notes: \'C\341\273\255a s\341\273\225 quang h\341\273\215c ch\341\273\213u nhi\341\273\207t v\303\240 \303\241p su\341\272\245t cao.\',\n    tintHex: \'#d8e3f0\',\n  },\n  {\n    id: \'diamond\',\n    name: \'Kim c\306\260\306\241ng (C)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 2.417,\n    relativePermittivity: 5.842,\n    relativePermeability: 1.0,\n    abbeNumber: 55.3,\n    notes: \'Chi\341\272\277t su\341\272\245t r\341\272\245t cao, g\303\263c t\341\273\233i h\341\272\241n nh\341\273\217 (~24.4\302\260 trong kh\303\264ng kh\303\255).\',\n    tintHex: \'#cffafe\',\n  },\n  {\n    id: \'silicon\',\n    name: \'Silicon (IR / Vi s\303\263ng)\',\n    category: \'B\303\241n d\341\272\253n & RF\',\n    refractiveIndex: 3.42,\n    relativePermittivity: 11.696,\n    relativePermeability: 1.0,\n    notes: \'Ch\341\272\245t b\303\241n d\341\272\253n \304\221i\341\273\207n m\303\264i cao cho h\341\273\223ng ngo\341\272\241i v\303\240 m\341\272\241ch ph\341\272\263ng RF.\',\n    tintHex: \'#cbd5e1\',\n  },\n];"
        replacement_content: "export interface OpticalMaterial {\n  id: string;\n  name: string;\n  category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\' | \'Ch\341\272\245t l\341\273\217ng\' | \'Th\341\273\247y tinh & Quang h\341\273\215c\' | \'B\303\241n d\341\272\253n & RF\';\n  refractiveIndex: number;\n  relativePermittivity: number; // epsilon_r = n^2 (for non-magnetic dielectric mu_r = 1)\n  relativePermeability: number; // mu_r\n  abbeNumber?: number;\n  notes: string;\n  indexExplanation: string;\n  tintHex: string; // Subtle background tint for canvas visualization\n}\n\nexport const OPTICAL_MATERIALS: OpticalMaterial[] = [\n  {\n    id: \'vacuum\',\n    name: \'Ch\303\242n kh\303\264ng\',\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\n    refractiveIndex: 1.0,\n    relativePermittivity: 1.0,\n    relativePermeability: 1.0,\n    notes: \'M\303\264i tr\306\260\341\273\235ng chu\341\272\251n tuy\341\273\207t \304\221\341\273\221i, v\341\272\255n t\341\273\221c truy\341\273\201n b\341\272\261ng c.\',\n    indexExplanation:\n      \'Chi\341\272\277t su\341\272\245t n = 1.000 theo \304\221\341\273\213nh ngh\304\251a chu\341\272\251n v\303\254 kh\303\264ng c\303\263 m\341\272\255t \304\221\341\273\231 \304\221i\341\273\207n t\341\273\255 hay l\306\260\341\273\241ng c\341\273\261c \304\221i\341\273\207n \304\221\341\273\203 l\303\240m ch\341\272\255m s\303\263ng \304\221i\341\273\207n t\341\273\253. S\303\263ng lan truy\341\273\201n v\341\273\233i v\341\272\255n t\341\273\221c c\341\273\261c \304\221\341\272\241i c v\303\240 b\306\260\341\273\233c s\303\263ng kh\303\264ng b\341\273\213 n\303\251n.\',\n    tintHex: \'#f8fafc\',\n  },\n  {\n    id: \'air\',\n    name: \'Kh\303\264ng kh\303\255 (STP)\',\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\n    refractiveIndex: 1.0003,\n    relativePermittivity: 1.0006,\n    relativePermeability: 1.0,\n    notes: \'Chi\341\272\277t su\341\272\245t x\341\272\245p x\341\273\211 ch\303\242n kh\303\264ng \341\273\237 \304\221i\341\273\201u ki\341\273\207n ti\303\252u chu\341\272\251n.\',\n    indexExplanation:\n      \'M\341\272\255t \304\221\341\273\231 ph\303\242n t\341\273\255 kh\303\255 \341\273\237 \304\221i\341\273\201u ki\341\273\207n ti\303\252u chu\341\272\251n (0\302\260C, 1 atm) r\341\272\245t lo\303\243ng n\303\252n \304\221\341\273\231 ph\303\242n c\341\273\261c \304\221i\341\273\207n m\303\264i c\341\273\261c nh\341\273\217, khi\341\272\277n n ch\341\273\211 l\341\273\233n h\306\241n ch\303\242n kh\303\264ng 0.03%. Th\306\260\341\273\235ng \304\221\306\260\341\273\243c d\303\271ng l\303\240m m\303\264i tr\306\260\341\273\235ng tham chi\341\272\277u cho c\303\241c ph\303\251p \304\221o quang h\341\273\215c.\',\n    tintHex: \'#f1f5f9\',\n  },\n  {\n    id: \'ice\',\n    name: \'B\304\203ng (N\306\260\341\273\233c \304\221\303\241)\',\n    category: \'Ch\341\272\245t l\341\273\217ng\',\n    refractiveIndex: 1.309,\n    relativePermittivity: 1.713,\n    relativePermeability: 1.0,\n    notes: \'Tinh th\341\273\203 l\341\273\245c gi\303\241c, chi\341\272\277t su\341\272\245t th\341\272\245p h\306\241n n\306\260\341\273\233c l\341\273\217ng.\',\n    indexExplanation:\n      \'C\341\272\245u tr\303\272c m\341\272\241ng tinh th\341\273\203 l\341\273\245c gi\303\241c m\341\273\237 r\341\273\231ng c\341\273\247a n\306\260\341\273\233c \304\221\303\241 l\303\240m gi\341\272\243m m\341\272\255t \304\221\341\273\231 ph\303\242n t\341\273\255 tr\303\252n \304\221\306\241n v\341\273\213 th\341\273\203 t\303\255ch so v\341\273\233i n\306\260\341\273\233c l\341\273\217ng, n\303\252n ch\341\273\211 s\341\273\221 n = 1.309 th\341\272\245p h\306\241n n\306\260\341\273\233c. Chi\341\272\277t su\341\272\245t n\303\240y t\341\272\241o n\303\252n c\303\241c hi\341\273\207n t\306\260\341\273\243ng quang h\341\273\215c kh\303\255 quy\341\273\203n nh\306\260 qu\341\272\247ng m\341\272\267t tr\341\273\235i 22\302\260.\',\n    tintHex: \'#e0f2fe\',\n  },\n  {\n    id: \'water\',\n    name: \'N\306\260\341\273\233c tinh khi\341\272\277t (20\302\260C)\',\n    category: \'Ch\341\272\245t l\341\273\217ng\',\n    refractiveIndex: 1.333,\n    relativePermittivity: 1.777,\n    relativePermeability: 1.0,\n    abbeNumber: 55.7,\n    notes: \'M\303\264i tr\306\260\341\273\235ng \304\221i\341\273\207n m\303\264i quang h\341\273\215c ph\341\273\225 bi\341\272\277n (\316\273 = 589 nm).\',\n    indexExplanation:\n      \'\341\273\236 v\303\271ng \303\241nh s\303\241ng kh\341\272\243 ki\341\272\277n, s\341\273\261 ph\303\242n c\341\273\261c \304\221i\341\273\207n t\341\273\255 c\341\273\247a ph\303\242n t\341\273\255 H\342\202\202O l\303\240m gi\341\272\243m v\341\272\255n t\341\273\221c pha c\341\273\247a s\303\263ng xu\341\273\221ng c\303\262n 75% t\341\273\221c \304\221\341\273\231 \303\241nh s\303\241ng (n = 1.333). \304\220\303\242y l\303\240 nguy\303\252n nh\303\242n g\303\242y ra g\303\263c kh\303\272c x\341\272\241 r\303\265 r\341\273\207t v\303\240 hi\341\273\207n t\306\260\341\273\243ng ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n t\341\273\253 g\303\263c t\341\273\233i 48.6\302\260.\',\n    tintHex: \'#dbeafe\',\n  },\n  {\n    id: \'ptfe\',\n    name: \'Nh\341\273\261a PTFE (Teflon)\',\n    category: \'B\303\241n d\341\272\253n & RF\',\n    refractiveIndex: 1.38,\n    relativePermittivity: 1.904,\n    relativePermeability: 1.0,\n    notes: \'V\341\272\255t li\341\273\207u t\341\273\225n hao th\341\272\245p trong th\341\272\245u k\303\255nh vi s\303\263ng v\303\240 RF.\',\n    indexExplanation:\n      \'Chu\341\273\227i polymer fluorocarbon \304\221\341\273\221i x\341\273\251ng kh\303\264ng ph\303\242n c\341\273\261c gi\303\272p PTFE duy tr\303\254 n \342\211\210 1.38 \341\273\225n \304\221\341\273\213nh t\341\273\253 quang h\341\273\215c \304\221\341\272\277n d\341\272\243i vi s\303\263ng GHz v\341\273\233i suy hao \304\221i\341\273\207n m\303\264i r\341\272\245t th\341\272\245p. Ph\303\271 h\341\273\243p ch\341\272\277 t\341\272\241o th\341\272\245u k\303\255nh RF, v\341\273\217 b\341\272\243o v\341\273\207 anten v\303\240 c\303\241p \304\221\341\273\223ng tr\341\273\245c.\',\n    tintHex: \'#e2e8f0\',\n  },\n  {\n    id: \'fused-silica\',\n    name: \'Th\341\272\241ch anh n\303\263ng ch\341\272\243y (SiO\342\202\202)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.458,\n    relativePermittivity: 2.126,\n    relativePermeability: 1.0,\n    abbeNumber: 67.8,\n    notes: \'V\341\272\255t li\341\273\207u l\303\265i s\341\273\243i quang truy\341\273\201n d\341\272\253n vi\341\273\205n th\303\264ng.\',\n    indexExplanation:\n      \'Li\303\252n k\341\272\277t c\341\273\231ng h\303\263a tr\341\273\213 Si\342\200\223O b\341\273\201n v\341\273\257ng t\341\272\241o chi\341\272\277t su\341\272\245t n = 1.458 c\303\271ng \304\221\341\273\231 t\303\241n s\341\272\257c r\341\272\245t th\341\272\245p (s\341\273\221 Abbe 67.8). Nh\341\273\235 suy hao quang h\341\273\215c c\341\273\261c nh\341\273\217 \341\273\237 1550 nm, th\341\272\241ch anh l\303\240 n\341\273\201n t\341\272\243ng c\341\273\247a l\303\265i s\341\273\243i quang d\341\272\253n s\303\263ng b\341\272\261ng ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n.\',\n    tintHex: \'#e0e7ff\',\n  },\n  {\n    id: \'bk7\',\n    name: \'K\303\255nh Crown (BK7)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.517,\n    relativePermittivity: 2.301,\n    relativePermeability: 1.0,\n    abbeNumber: 64.2,\n    notes: \'Th\341\273\247y tinh quang h\341\273\215c ti\303\252u chu\341\272\251n cho l\304\203ng k\303\255nh v\303\240 th\341\272\245u k\303\255nh.\',\n    indexExplanation:\n      \'Th\341\273\247y tinh borosilicate chu\341\272\251n quang h\341\273\215c v\341\273\233i n = 1.517, l\303\240m n\303\251n b\306\260\341\273\233c s\303\263ng xu\341\273\221ng kho\341\272\243ng 65.9% so v\341\273\233i trong ch\303\242n kh\303\264ng. \304\220\341\273\231 truy\341\273\201n qua cao v\303\240 t\303\241n s\341\272\257c th\341\272\245p (Abbe 64.2) gi\303\272p BK7 tr\341\273\237 th\303\240nh chu\341\272\251n tham chi\341\272\277u cho l\304\203ng k\303\255nh v\303\240 th\341\272\245u k\303\255nh h\341\273\231i t\341\273\245.\',\n    tintHex: \'#dbeafe\',\n  },\n  {\n    id: \'flint\',\n    name: \'K\303\255nh Flint (SF11)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.785,\n    relativePermittivity: 3.186,\n    relativePermeability: 1.0,\n    abbeNumber: 25.8,\n    notes: \'Chi\341\272\277t su\341\272\245t v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c cao, d\303\271ng cho quang h\341\273\215c t\303\241ch ph\341\273\225.\',\n    indexExplanation:\n      \'H\303\240m l\306\260\341\273\243ng oxit kim lo\341\272\241i n\341\272\267ng cao l\303\240m t\304\203ng m\341\272\241nh \304\221\341\273\231 ph\303\242n c\341\273\261c \304\221i\341\273\207n t\341\273\255, \304\221\341\272\251y chi\341\272\277t su\341\272\245t l\303\252n n = 1.785 v\303\240 t\341\272\241o t\303\241n s\341\272\257c m\341\272\241nh (s\341\273\221 Abbe th\341\272\245p 25.8). Tia s\303\241ng b\341\273\213 b\341\272\273 g\303\243y m\341\272\241nh khi \304\221i qua m\341\272\267t ph\303\242n c\303\241ch v\303\240 t\303\241ch m\303\240u r\303\265 r\341\273\207t trong l\304\203ng k\303\255nh quang ph\341\273\225.\',\n    tintHex: \'#cbd5e1\',\n  },\n  {\n    id: \'sapphire\',\n    name: \'Sapphire (Al\342\202\202O\342\202\203)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 1.768,\n    relativePermittivity: 3.126,\n    relativePermeability: 1.0,\n    notes: \'C\341\273\255a s\341\273\225 quang h\341\273\215c ch\341\273\213u nhi\341\273\207t v\303\240 \303\241p su\341\272\245t cao.\',\n    indexExplanation:\n      \'Tinh th\341\273\203 oxit nh\303\264m x\341\272\277p ch\341\272\267t t\341\272\241o ra chi\341\272\277t su\341\272\245t cao n = 1.768 v\303\240 tr\341\273\237 kh\303\241ng s\303\263ng th\341\272\245p (~213 \316\251), khi\341\272\277n ph\341\272\243n x\341\272\241 b\341\273\201 m\341\272\267t t\341\272\241i g\303\263c t\341\273\233i vu\303\264ng g\303\263c \304\221\341\272\241t kho\341\272\243ng 7.7%. R\341\272\245t b\341\273\201n c\306\241 h\341\273\215c v\303\240 truy\341\273\201n t\341\273\221t t\341\273\253 t\341\273\255 ngo\341\272\241i \304\221\341\272\277n trung h\341\273\223ng ngo\341\272\241i.\',\n    tintHex: \'#d8e3f0\',\n  },\n  {\n    id: \'diamond\',\n    name: \'Kim c\306\260\306\241ng (C)\',\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\n    refractiveIndex: 2.417,\n    relativePermittivity: 5.842,\n    relativePermeability: 1.0,\n    abbeNumber: 55.3,\n    notes: \'Chi\341\272\277t su\341\272\245t r\341\272\245t cao, g\303\263c t\341\273\233i h\341\272\241n nh\341\273\217 (~24.4\302\260 trong kh\303\264ng kh\303\255).\',\n    indexExplanation:\n      \'M\341\272\241ng tinh th\341\273\203 carbon t\341\273\251 di\341\273\207n si\303\252u \304\221\341\272\267c l\303\240m gi\341\272\243m v\341\272\255n t\341\273\221c \303\241nh s\303\241ng xu\341\273\221ng ch\341\273\211 c\303\262n 41.4% t\341\273\221c \304\221\341\273\231 trong ch\303\242n kh\303\264ng (n = 2.417). Do g\303\263c t\341\273\233i h\341\272\241n ch\341\273\211 24.4\302\260 trong kh\303\264ng kh\303\255, \303\241nh s\303\241ng \304\221i v\303\240o r\341\272\245t d\341\273\205 b\341\273\213 gi\341\273\257 l\341\272\241i v\303\240 ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n nhi\341\273\201u l\341\272\247n.\',\n    tintHex: \'#cffafe\',\n  },\n  {\n    id: \'silicon\',\n    name: \'Silicon (IR / Vi s\303\263ng)\',\n    category: \'B\303\241n d\341\272\253n & RF\',\n    refractiveIndex: 3.42,\n    relativePermittivity: 11.696,\n    relativePermeability: 1.0,\n    notes: \'Ch\341\272\245t b\303\241n d\341\272\253n \304\221i\341\273\207n m\303\264i cao cho h\341\273\223ng ngo\341\272\241i v\303\240 m\341\272\241ch ph\341\272\263ng RF.\',\n    indexExplanation:\n      \'\304\220\341\273\231 r\341\273\231ng v\303\271ng c\341\272\245m nh\341\273\217 t\341\272\241o \304\221\341\273\231 ph\303\242n c\341\273\261c \304\221i\341\273\207n t\341\273\255 c\341\273\261c l\341\273\233n \341\273\237 v\303\271ng h\341\273\223ng ngo\341\272\241i v\303\240 vi s\303\263ng (n = 3.420, \316\265r \342\211\210 11.7). B\306\260\341\273\233c s\303\263ng b\341\273\213 n\303\251n h\306\241n 3.4 l\341\272\247n b\303\252n trong tinh th\341\273\203, cho ph\303\251p thu nh\341\273\217 \341\273\221ng d\341\272\253n s\303\263ng quang t\341\273\255 v\303\240 m\341\272\241ch vi d\341\272\243i RF.\',\n    tintHex: \'#cbd5e1\',\n  },\n];"
