        replacement_chunks {
          target_content: "    // Subtle right-hand energy flux readout\n    ctx.textAlign = \'right\';\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#b91c1c\';\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, width - 16, 26);\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\n    ctx.fillText(\n      p.isTotalInternalReflection\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\n      width - 16,\n      cy + 26\n    );\n    ctx.textAlign = \'left\';\n\n    ctx.restore();\n  };"
          replacement_content: "    // Subtle right-hand energy flux readout (offset left of refractive drag rails)\n    const railX = width - 30;\n    ctx.textAlign = \'right\';\n    ctx.font = \'500 11px \"IBM Plex Mono\", monospace\';\n    ctx.fillStyle = \'#b91c1c\';\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, railX - 24, 24);\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\n    ctx.fillText(\n      p.isTotalInternalReflection\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\n      railX - 24,\n      cy + 24\n    );\n    ctx.textAlign = \'left\';\n\n    // 9. Interactive On-Canvas Drag Rails for Refractive Indices n1 (Top) & n2 (Bottom)\n    const drawIndexRail = (\n      topY: number,\n      bottomY: number,\n      value: number,\n      label: string,\n      accentHex: string\n    ) => {\n      const span = Math.max(40, bottomY - topY);\n      const t = clamp((value - N_RAIL_MIN) / (N_RAIL_MAX - N_RAIL_MIN), 0, 1);\n      // Higher refractive index sits toward the top of each rail for intuitive vertical dragging\n      const knobY = bottomY - t * span;\n\n      // Track background\n      ctx.strokeStyle = \'rgba(148, 163, 184, 0.55)\';\n      ctx.lineWidth = 4;\n      ctx.lineCap = \'round\';\n      ctx.beginPath();\n      ctx.moveTo(railX, topY);\n      ctx.lineTo(railX, bottomY);\n      ctx.stroke();\n\n      // Active fill from bottom up to knob\n      ctx.strokeStyle = accentHex;\n      ctx.lineWidth = 4;\n      ctx.beginPath();\n      ctx.moveTo(railX, bottomY);\n      ctx.lineTo(railX, knobY);\n      ctx.stroke();\n\n      // Draggable knob\n      ctx.beginPath();\n      ctx.arc(railX, knobY, 7.5, 0, Math.PI * 2);\n      ctx.fillStyle = \'#ffffff\';\n      ctx.fill();\n      ctx.lineWidth = 2.2;\n      ctx.strokeStyle = accentHex;\n      ctx.stroke();\n\n      ctx.beginPath();\n      ctx.arc(railX, knobY, 2.8, 0, Math.PI * 2);\n      ctx.fillStyle = accentHex;\n      ctx.fill();\n\n      // Crisp haloed numeric readout beside knob\n      drawHaloText(\n        ctx,\n        `${label} ${value.toFixed(2)}`,\n        railX - 13,\n        knobY + 4,\n        \'#0f172a\',\n        \'600 10.5px \"IBM Plex Mono\", monospace\',\n        \'right\'\n      );\n    };\n\n    drawIndexRail(44, cy - 18, p.n1, \'n\342\202\201\', \'#0284c7\');\n    drawIndexRail(cy + 40, height - 30, p.n2, \'n\342\202\202\', \'#2563eb\');\n\n    ctx.restore();\n  };"
