  planner_response {
    thinking: "**Initiating Parallel Updates**\n\nI\'m initiating parallel updates to `WaveCanvas.tsx`, `ControlDeck.tsx`, `App.tsx`, and `emPhysics.test.ts`. Currently, I\'m verifying and planning the addition of necessary components within the `WaveCanvas.tsx` file. I\'m focusing on ensuring each change aligns perfectly before execution.\n\n\n**Implementing Canvas UI Controls**\n\nI\'m now fully immersed in implementing canvas UI controls. I\'m focusing on adding refractive index drag controls directly within the canvas, utilizing rails on the right margin. I\'m also adding drag functionality for the deviation angle and refractive indices, refining the `dragMode` state. I\'m targeting rendering the undeviated incident ray extension and deviation angle with labels when not in TIR.\n\n\n"
    message_id: "OM8Ga_rSDqeN694Pv6mukQM"
    tool_calls {
      id: "call_9685968543213747353"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add direct canvas drag rails for n1 and n2, ray deviation visualization, canvas ref forwarding, and drawHaloText helper in WaveCanvas.tsx\",\"Instruction\":\"Update WaveCanvas props, drag modes, deviation angle rendering, on-canvas n1/n2 drag handles, and add drawHaloText helper\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":62,\"ReplacementContent\":\"interface WaveCanvasProps {\\n  physics: WavePhysicsResult;\\n  polarization: PolarizationMode;\\n  wavelengthVacuumNm: number;\\n  material1Label: string;\\n  material2Label: string;\\n  canvasElementRef?: React.MutableRefObject<HTMLCanvasElement | null>;\\n  onChangeIncidentAngle: (angleDeg: number) => void;\\n  onChangeN1: (n1: number) => void;\\n  onChangeN2: (n2: number) => void;\\n  onResetSimulation: () => void;\\n}\\n\\ntype CanvasDragMode = \'NONE\' | \'ANGLE\' | \'N1\' | \'N2\';\\n\\ninterface ProbeState {\\n  active: boolean;\\n  xPx: number;\\n  yPx: number;\\n  medium: 1 | 2;\\n  normX: number;\\n  normZ: number;\\n  angleFromNormalDeg: number;\\n}\\n\\nconst N_RAIL_MIN = 1.0;\\nconst N_RAIL_MAX = 3.8;\\n\\nexport const WaveCanvas: React.FC<WaveCanvasProps> = ({\\n  physics,\\n  polarization,\\n  wavelengthVacuumNm,\\n  material1Label,\\n  material2Label,\\n  canvasElementRef,\\n  onChangeIncidentAngle,\\n  onChangeN1,\\n  onChangeN2,\\n  onResetSimulation,\\n}) => {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\\n\\n  const [isPlaying, setIsPlaying] = useState(true);\\n  const [speedMultiplier, setSpeedMultiplier] = useState(1.0);\\n  const [layers, setLayers] = useState<WaveLayerToggles>({\\n    wavefronts: true,\\n    rays: true,\\n    eField: true,\\n    angles: true,\\n  });\\n  const [dragMode, setDragMode] = useState<CanvasDragMode>(\'NONE\');\",\"StartLine\":20,\"TargetContent\":\"interface WaveCanvasProps {\\n  physics: WavePhysicsResult;\\n  polarization: PolarizationMode;\\n  wavelengthVacuumNm: number;\\n  material1Label: string;\\n  material2Label: string;\\n  onChangeIncidentAngle: (angleDeg: number) => void;\\n  onResetSimulation: () => void;\\n}\\n\\ninterface ProbeState {\\n  active: boolean;\\n  xPx: number;\\n  yPx: number;\\n  medium: 1 | 2;\\n  normX: number;\\n  normZ: number;\\n  angleFromNormalDeg: number;\\n}\\n\\nexport const WaveCanvas: React.FC<WaveCanvasProps> = ({\\n  physics,\\n  polarization,\\n  wavelengthVacuumNm,\\n  material1Label,\\n  material2Label,\\n  onChangeIncidentAngle,\\n  onResetSimulation,\\n}) => {\\n  const containerRef = useRef<HTMLDivElement | null>(null);\\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\\n\\n  const [isPlaying, setIsPlaying] = useState(true);\\n  const [speedMultiplier, setSpeedMultiplier] = useState(1.0);\\n  const [layers, setLayers] = useState<WaveLayerToggles>({\\n    wavefronts: true,\\n    rays: true,\\n    eField: true,\\n    angles: true,\\n  });\\n  const [isDraggingSource, setIsDraggingSource] = useState(false);\"},{\"AllowMultiple\":false,\"EndLine\":675,\"ReplacementContent\":\"      // Refracted angle arc & ray deviation (\316\224\316\270) visual cue\\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null) {\\n        if (p.refractedAngleDeg! > 1.5) {\\n          ctx.strokeStyle = \'#059669\';\\n          ctx.lineWidth = 1.8;\\n          ctx.beginPath();\\n          ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\\n          ctx.stroke();\\n\\n          const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\\n          const labelR = arcR + 22;\\n          drawHaloText(\\n            ctx,\\n            `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\\n            cx + Math.cos(midT) * labelR + 6,\\n            cy + Math.sin(midT) * labelR + 4,\\n            \'#047857\',\\n            \'600 11.5px \\\"IBM Plex Mono\\\", monospace\',\\n            \'left\'\\n          );\\n        }\\n\\n        // Undeviated dashed ray extension into Medium 2 + deviation angle \316\224\316\270 arc\\n        if (p.deviationAngleDeg !== null && p.deviationAngleDeg > 2.0) {\\n          ctx.save();\\n          ctx.strokeStyle = \'rgba(100, 116, 139, 0.55)\';\\n          ctx.lineWidth = 1.25;\\n          ctx.setLineDash([4, 4]);\\n          ctx.beginPath();\\n          ctx.moveTo(cx, cy);\\n          ctx.lineTo(cx + incDirX * maxRayLen * 0.85, cy + incDirY * maxRayLen * 0.85);\\n          ctx.stroke();\\n          ctx.restore();\\n\\n          const devArcR = arcR + 30;\\n          const a1 = Math.PI / 2 - thetaI;\\n          const a2 = Math.PI / 2 - p.refractedAngleRad;\\n          const startA = Math.min(a1, a2);\\n          const endA = Math.max(a1, a2);\\n          ctx.strokeStyle = \'#0284c7\';\\n          ctx.lineWidth = 1.5;\\n          ctx.beginPath();\\n          ctx.arc(cx, cy, devArcR, startA, endA);\\n          ctx.stroke();\\n\\n          const midDev = (startA + endA) * 0.5;\\n          drawHaloText(\\n            ctx,\\n            `\316\224\316\270 ${p.deviationAngleDeg.toFixed(1)}\302\260`,\\n            cx + Math.cos(midDev) * (devArcR + 12) + 4,\\n            cy + Math.sin(midDev) * (devArcR + 12) + 4,\\n            \'#0369a1\',\\n            \'600 10.5px \\\"IBM Plex Mono\\\", monospace\',\\n            \'left\'\\n          );\\n        }\\n      }\\n    }\",\"StartLine\":653,\"TargetContent\":\"      // Refracted angle arc\\n      if (!p.isTotalInternalReflection && p.refractedAngleRad !== null && p.refractedAngleDeg! > 1.5) {\\n        ctx.strokeStyle = \'#059669\';\\n        ctx.lineWidth = 1.8;\\n        ctx.beginPath();\\n        ctx.arc(cx, cy, arcR, Math.PI / 2 - p.refractedAngleRad, Math.PI / 2);\\n        ctx.stroke();\\n\\n        const midT = Math.PI / 2 - p.refractedAngleRad * 0.45;\\n        const labelR = arcR + 22;\\n        drawHaloText(\\n          ctx,\\n          `\316\270t ${p.refractedAngleDeg!.toFixed(1)}\302\260`,\\n          cx + Math.cos(midT) * labelR + 6,\\n          cy + Math.sin(midT) * labelR + 4,\\n          \'#047857\',\\n          \'600 11.5px \\\"IBM Plex Mono\\\", monospace\',\\n          \'left\'\\n        );\\n      }\\n    }\"},{\"AllowMultiple\":false,\"EndLine\":737,\"ReplacementContent\":\"    // Subtle right-hand energy flux readout (offset left of refractive drag rails)\\n    const railX = width - 30;\\n    ctx.textAlign = \'right\';\\n    ctx.font = \'500 11px \\\"IBM Plex Mono\\\", monospace\';\\n    ctx.fillStyle = \'#b91c1c\';\\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, railX - 24, 24);\\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\\n    ctx.fillText(\\n      p.isTotalInternalReflection\\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\\n      railX - 24,\\n      cy + 24\\n    );\\n    ctx.textAlign = \'left\';\\n\\n    // 9. Interactive On-Canvas Drag Rails for Refractive Indices n1 (Top) & n2 (Bottom)\\n    const drawIndexRail = (\\n      topY: number,\\n      bottomY: number,\\n      value: number,\\n      label: string,\\n      accentHex: string\\n    ) => {\\n      const span = Math.max(40, bottomY - topY);\\n      const t = clamp((value - N_RAIL_MIN) / (N_RAIL_MAX - N_RAIL_MIN), 0, 1);\\n      // Higher refractive index sits toward the top of each rail for intuitive vertical dragging\\n      const knobY = bottomY - t * span;\\n\\n      // Track background\\n      ctx.strokeStyle = \'rgba(148, 163, 184, 0.55)\';\\n      ctx.lineWidth = 4;\\n      ctx.lineCap = \'round\';\\n      ctx.beginPath();\\n      ctx.moveTo(railX, topY);\\n      ctx.lineTo(railX, bottomY);\\n      ctx.stroke();\\n\\n      // Active fill from bottom up to knob\\n      ctx.strokeStyle = accentHex;\\n      ctx.lineWidth = 4;\\n      ctx.beginPath();\\n      ctx.moveTo(railX, bottomY);\\n      ctx.lineTo(railX, knobY);\\n      ctx.stroke();\\n\\n      // Draggable knob\\n      ctx.beginPath();\\n      ctx.arc(railX, knobY, 7.5, 0, Math.PI * 2);\\n      ctx.fillStyle = \'#ffffff\';\\n      ctx.fill();\\n      ctx.lineWidth = 2.2;\\n      ctx.strokeStyle = accentHex;\\n      ctx.stroke();\\n\\n      ctx.beginPath();\\n      ctx.arc(railX, knobY, 2.8, 0, Math.PI * 2);\\n      ctx.fillStyle = accentHex;\\n      ctx.fill();\\n\\n      // Crisp haloed numeric readout beside knob\\n      drawHaloText(\\n        ctx,\\n        `${label} ${value.toFixed(2)}`,\\n        railX - 13,\\n        knobY + 4,\\n        \'#0f172a\',\\n        \'600 10.5px \\\"IBM Plex Mono\\\", monospace\',\\n        \'right\'\\n      );\\n    };\\n\\n    drawIndexRail(44, cy - 18, p.n1, \'n\342\202\201\', \'#0284c7\');\\n    drawIndexRail(cy + 40, height - 30, p.n2, \'n\342\202\202\', \'#2563eb\');\\n\\n    ctx.restore();\\n  };\",\"StartLine\":720,\"TargetContent\":\"    // Subtle right-hand energy flux readout\\n    ctx.textAlign = \'right\';\\n    ctx.font = \'500 11px \\\"IBM Plex Mono\\\", monospace\';\\n    ctx.fillStyle = \'#b91c1c\';\\n    ctx.fillText(`Ph\341\272\243n x\341\272\241 R = ${(p.reflectanceEffective * 100).toFixed(1)}%`, width - 16, 26);\\n    ctx.fillStyle = p.isTotalInternalReflection ? \'#b45309\' : \'#047857\';\\n    ctx.fillText(\\n      p.isTotalInternalReflection\\n        ? \'Truy\341\273\201n xa T = 0.0% (S\303\263ng suy gi\341\272\243m)\'\\n        : `Truy\341\273\201n qua T = ${(p.transmittanceEffective * 100).toFixed(1)}%`,\\n      width - 16,\\n      cy + 26\\n    );\\n    ctx.textAlign = \'left\';\\n\\n    ctx.restore();\\n  };\"},{\"AllowMultiple\":false,\"EndLine\":860,\"ReplacementContent\":\"  const updateNFromRail = (clientY: number, medium: 1 | 2) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const y = clientY - rect.top;\\n    const cy = rect.height * 0.5;\\n    const topY = medium === 1 ? 44 : cy + 40;\\n    const bottomY = medium === 1 ? cy - 18 : rect.height - 30;\\n    const t = clamp((bottomY - y) / Math.max(40, bottomY - topY), 0, 1);\\n    const nextN = Math.round((N_RAIL_MIN + t * (N_RAIL_MAX - N_RAIL_MIN)) * 200) / 200;\\n    if (medium === 1) onChangeN1(nextN);\\n    else onChangeN2(nextN);\\n  };\\n\\n  const updateAngleFromPointer = (clientX: number, clientY: number) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const x = clientX - rect.left;\\n    const y = clientY - rect.top;\\n    const cx = rect.width * 0.5;\\n    const cy = rect.height * 0.5;\\n\\n    const dx = cx - x; // positive to the left of normal\\n    const dy = cy - y; // positive above interface\\n    if (dy < 2) {\\n      onChangeIncidentAngle(89.0);\\n      return;\\n    }\\n    const clampedDx = Math.max(0, dx);\\n    const angle = radToDeg(Math.atan2(clampedDx, dy));\\n    onChangeIncidentAngle(Math.round(clamp(angle, 0, 89.5) * 10) / 10);\\n  };\\n\\n  const handlePointerDown = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const x = e.clientX - rect.left;\\n    const y = e.clientY - rect.top;\\n    const cy = rect.height * 0.5;\\n\\n    // Hit-test right-edge refractive index drag rails first\\n    if (x >= rect.width - 76) {\\n      const targetMode: CanvasDragMode = y < cy ? \'N1\' : \'N2\';\\n      setDragMode(targetMode);\\n      e.currentTarget.setPointerCapture(e.pointerId);\\n      updateNFromRail(e.clientY, y < cy ? 1 : 2);\\n      return;\\n    }\\n\\n    // Otherwise drag anywhere in Medium 1 to aim the incident wave\\n    if (y <= cy + 8) {\\n      setDragMode(\'ANGLE\');\\n      e.currentTarget.setPointerCapture(e.pointerId);\\n      updateAngleFromPointer(e.clientX, e.clientY);\\n    }\\n  };\\n\\n  const handlePointerMove = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const x = e.clientX - rect.left;\\n    const y = e.clientY - rect.top;\\n    const cx = rect.width * 0.5;\\n    const cy = rect.height * 0.5;\\n\\n    const normX = (x - cx) / (rect.width * 0.5);\\n    const normZ = (y - cy) / (rect.height * 0.5);\\n    const angleFromNormalDeg = radToDeg(Math.atan2(Math.abs(x - cx), Math.max(1, Math.abs(y - cy))));\\n\\n    setProbe({\\n      active: true,\\n      xPx: x,\\n      yPx: y,\\n      medium: y <= cy ? 1 : 2,\\n      normX,\\n      normZ,\\n      angleFromNormalDeg,\\n    });\\n\\n    if (dragMode === \'ANGLE\') {\\n      updateAngleFromPointer(e.clientX, e.clientY);\\n    } else if (dragMode === \'N1\') {\\n      updateNFromRail(e.clientY, 1);\\n    } else if (dragMode === \'N2\') {\\n      updateNFromRail(e.clientY, 2);\\n    }\\n  };\\n\\n  const handlePointerUp = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    if (dragMode !== \'NONE\') {\\n      setDragMode(\'NONE\');\\n      if (e.currentTarget.hasPointerCapture(e.pointerId)) {\\n        e.currentTarget.releasePointerCapture(e.pointerId);\\n      }\\n    }\\n  };\",\"StartLine\":787,\"TargetContent\":\"  const updateAngleFromPointer = (clientX: number, clientY: number) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const x = clientX - rect.left;\\n    const y = clientY - rect.top;\\n    const cx = rect.width * 0.5;\\n    const cy = rect.height * 0.5;\\n\\n    const dx = cx - x; // positive to the left of normal\\n    const dy = cy - y; // positive above interface\\n    if (dy < 2) {\\n      onChangeIncidentAngle(89.0);\\n      return;\\n    }\\n    const clampedDx = Math.max(0, dx);\\n    const angle = radToDeg(Math.atan2(clampedDx, dy));\\n    onChangeIncidentAngle(Math.round(clamp(angle, 0, 89.5) * 10) / 10);\\n  };\\n\\n  const handlePointerDown = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const y = e.clientY - rect.top;\\n    // Allow dragging anywhere in Medium 1 to aim the incident wave\\n    if (y <= rect.height * 0.52) {\\n      setIsDraggingSource(true);\\n      e.currentTarget.setPointerCapture(e.pointerId);\\n      updateAngleFromPointer(e.clientX, e.clientY);\\n    }\\n  };\\n\\n  const handlePointerMove = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const rect = canvas.getBoundingClientRect();\\n    const x = e.clientX - rect.left;\\n    const y = e.clientY - rect.top;\\n    const cx = rect.width * 0.5;\\n    const cy = rect.height * 0.5;\\n\\n    const normX = (x - cx) / (rect.width * 0.5);\\n    const normZ = (y - cy) / (rect.height * 0.5);\\n    const angleFromNormalDeg = radToDeg(Math.atan2(Math.abs(x - cx), Math.max(1, Math.abs(y - cy))));\\n\\n    setProbe({\\n      active: true,\\n      xPx: x,\\n      yPx: y,\\n      medium: y <= cy ? 1 : 2,\\n      normX,\\n      normZ,\\n      angleFromNormalDeg,\\n    });\\n\\n    if (isDraggingSource) {\\n      updateAngleFromPointer(e.clientX, e.clientY);\\n    }\\n  };\\n\\n  const handlePointerUp = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n    if (isDraggingSource) {\\n      setIsDraggingSource(false);\\n      if (e.currentTarget.hasPointerCapture(e.pointerId)) {\\n        e.currentTarget.releasePointerCapture(e.pointerId);\\n      }\\n    }\\n  };\"},{\"AllowMultiple\":false,\"EndLine\":986,\"ReplacementContent\":\"        <canvas\\n          ref={(node) => {\\n            canvasRef.current = node;\\n            if (canvasElementRef) canvasElementRef.current = node;\\n          }}\\n          data-testid=\\\"em-wave-canvas\\\"\\n          onPointerDown={handlePointerDown}\\n          onPointerMove={handlePointerMove}\\n          onPointerUp={handlePointerUp}\\n          onPointerLeave={() => {\\n            setProbe((prev) => ({ ...prev, active: false }));\\n          }}\\n          className={`w-full h-full block ${\\n            dragMode !== \'NONE\' ? \'cursor-grabbing\' : \'cursor-crosshair\'\\n          }`}\\n          aria-label=\\\"Bi\341\273\203u \304\221\341\273\223 tr\341\273\261c quan kh\303\272c x\341\272\241 v\303\240 ph\341\272\243n x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\\\"\\n        />\\n\\n        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\\n        <div className=\\\"pointer-events-none absolute bottom-2.5 left-4 right-14 flex items-center justify-between text-[11px] font-mono text-slate-500\\\">\\n          <span className=\\\"truncate\\\">\\n            K\303\251o ngu\341\273\223n ph\303\241t \304\221\341\273\203 ch\341\273\211nh \316\270i \302\267 K\303\251o thanh b\303\252n ph\341\272\243i \304\221\341\273\203 ch\341\273\211nh chi\341\272\277t su\341\272\245t n\342\202\201, n\342\202\202 tr\341\273\261c ti\341\272\277p\\n          </span>\\n          {probe.active && (\\n            <span className=\\\"hidden sm:inline bg-white/90 px-2 py-0.5 rounded border border-slate-200 tabular-nums text-slate-700 shrink-0 ml-2\\\">\\n              MT{probe.medium} \302\267 x={probe.normX.toFixed(2)} \302\267 z={probe.normZ.toFixed(2)} \302\267 \342\210\240N=\\n              {probe.angleFromNormalDeg.toFixed(1)}\302\260\\n            </span>\\n          )}\\n        </div>\\n      </div>\\n    </section>\",\"StartLine\":958,\"TargetContent\":\"        <canvas\\n          ref={canvasRef}\\n          data-testid=\\\"em-wave-canvas\\\"\\n          onPointerDown={handlePointerDown}\\n          onPointerMove={handlePointerMove}\\n          onPointerUp={handlePointerUp}\\n          onPointerLeave={() => {\\n            setProbe((prev) => ({ ...prev, active: false }));\\n          }}\\n          className={`w-full h-full block ${\\n            isDraggingSource ? \'cursor-grabbing\' : \'cursor-crosshair\'\\n          }`}\\n          aria-label=\\\"Bi\341\273\203u \304\221\341\273\223 tr\341\273\261c quan kh\303\272c x\341\272\241 v\303\240 ph\341\272\243n x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\\\"\\n        />\\n\\n        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\\n        <div className=\\\"pointer-events-none absolute bottom-2.5 left-4 right-4 flex items-center justify-between text-[11px] font-mono text-slate-500\\\">\\n          <span>K\303\251o ngu\341\273\223n ph\303\241t \341\273\237 m\303\264i tr\306\260\341\273\235ng 1 \304\221\341\273\203 thay \304\221\341\273\225i g\303\263c t\341\273\233i \316\270i tr\341\273\261c ti\341\272\277p</span>\\n          {probe.active && (\\n            <span className=\\\"hidden sm:inline bg-white/90 px-2 py-0.5 rounded border border-slate-200 tabular-nums text-slate-700\\\">\\n              M\303\264i tr\306\260\341\273\235ng {probe.medium} \302\267 x={probe.normX.toFixed(2)} \302\267 z={probe.normZ.toFixed(2)} \302\267 \342\210\240N=\\n              {probe.angleFromNormalDeg.toFixed(1)}\302\260\\n            </span>\\n          )}\\n        </div>\\n      </div>\\n    </section>\"},{\"AllowMultiple\":false,\"EndLine\":1046,\"ReplacementContent\":\"function drawHaloText(\\n  ctx: CanvasRenderingContext2D,\\n  text: string,\\n  x: number,\\n  y: number,\\n  fillColor: string,\\n  font: string,\\n  align: CanvasTextAlign = \'left\'\\n) {\\n  ctx.save();\\n  ctx.font = font;\\n  ctx.textAlign = align;\\n  ctx.lineJoin = \'round\';\\n  ctx.lineWidth = 3.5;\\n  ctx.strokeStyle = \'rgba(255, 255, 255, 0.92)\';\\n  ctx.strokeText(text, x, y);\\n  ctx.fillStyle = fillColor;\\n  ctx.fillText(text, x, y);\\n  ctx.restore();\\n}\\n\\nfunction hexToRgba(hex: string, alpha: number): string {\\n  const clean = hex.replace(\'#\', \'\');\\n  const full =\\n    clean.length === 3\\n      ? clean\\n          .split(\'\')\\n          .map((c) => c + c)\\n          .join(\'\')\\n      : clean;\\n  const num = parseInt(full, 16);\\n  const r = (num >> 16) & 255;\\n  const g = (num >> 8) & 255;\\n  const b = num & 255;\\n  return `rgba(${r}, ${g}, ${b}, ${clamp(alpha, 0, 1).toFixed(3)})`;\\n}\",\"StartLine\":1030,\"TargetContent\":\"function hexToRgba(hex: string, alpha: number): string {\\n  const clean = hex.replace(\'#\', \'\');\\n  const full =\\n    clean.length === 3\\n      ? clean\\n          .split(\'\')\\n          .map((c) => c + c)\\n          .join(\'\')\\n      : clean;\\n  const num = parseInt(full, 16);\\n  const r = (num >> 16) & 255;\\n  const g = (num >> 8) & 255;\\n  const b = num & 255;\\n  return `rgba(${r}, ${g}, ${b}, ${clamp(alpha, 0, 1).toFixed(3)})`;\\n}\"}],\"TargetFile\":\"/src/components/WaveCanvas.tsx\",\"toolAction\":\"Adding on-canvas n1/n2 drag rails and deviation angle to WaveCanvas\",\"toolSummary\":\"Add canvas drag rails & \316\224\316\270\"}"
