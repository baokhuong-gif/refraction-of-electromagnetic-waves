      arguments_json: "{\"CodeContent\":\"export interface OpticalMaterial {\\n  id: string;\\n  name: string;\\n  category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\' | \'Ch\341\272\245t l\341\273\217ng\' | \'Th\341\273\247y tinh & Quang h\341\273\215c\' | \'B\303\241n d\341\272\253n & RF\';\\n  refractiveIndex: number;\\n  relativePermittivity: number; // epsilon_r = n^2 (for non-magnetic dielectric mu_r = 1)\\n  relativePermeability: number; // mu_r\\n  abbeNumber?: number;\\n  notes: string;\\n  tintHex: string; // Subtle background tint for canvas visualization\\n}\\n\\nexport const OPTICAL_MATERIALS: OpticalMaterial[] = [\\n  {\\n    id: \'vacuum\',\\n    name: \'Ch\303\242n kh\303\264ng\',\\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\\n    refractiveIndex: 1.0,\\n    relativePermittivity: 1.0,\\n    relativePermeability: 1.0,\\n    notes: \'M\303\264i tr\306\260\341\273\235ng chu\341\272\251n tuy\341\273\207t \304\221\341\273\221i, v\341\272\255n t\341\273\221c truy\341\273\201n b\341\272\261ng c.\',\\n    tintHex: \'#f8fafc\',\\n  },\\n  {\\n    id: \'air\',\\n    name: \'Kh\303\264ng kh\303\255 (STP)\',\\n    category: \'Kh\303\255 & Ch\303\242n kh\303\264ng\',\\n    refractiveIndex: 1.0003,\\n    relativePermittivity: 1.0006,\\n    relativePermeability: 1.0,\\n    notes: \'Chi\341\272\277t su\341\272\245t x\341\272\245p x\341\273\211 ch\303\242n kh\303\264ng \341\273\237 \304\221i\341\273\201u ki\341\273\207n ti\303\252u chu\341\272\251n.\',\\n    tintHex: \'#f1f5f9\',\\n  },\\n  {\\n    id: \'ice\',\\n    name: \'B\304\203ng (N\306\260\341\273\233c \304\221\303\241)\',\\n    category: \'Ch\341\272\245t l\341\273\217ng\',\\n    refractiveIndex: 1.309,\\n    relativePermittivity: 1.713,\\n    relativePermeability: 1.0,\\n    notes: \'Tinh th\341\273\203 l\341\273\245c gi\303\241c, chi\341\272\277t su\341\272\245t th\341\272\245p h\306\241n n\306\260\341\273\233c l\341\273\217ng.\',\\n    tintHex: \'#e0f2fe\',\\n  },\\n  {\\n    id: \'water\',\\n    name: \'N\306\260\341\273\233c tinh khi\341\272\277t (20\302\260C)\',\\n    category: \'Ch\341\272\245t l\341\273\217ng\',\\n    refractiveIndex: 1.333,\\n    relativePermittivity: 1.777,\\n    relativePermeability: 1.0,\\n    abbeNumber: 55.7,\\n    notes: \'M\303\264i tr\306\260\341\273\235ng \304\221i\341\273\207n m\303\264i quang h\341\273\215c ph\341\273\225 bi\341\272\277n (\316\273 = 589 nm).\',\\n    tintHex: \'#dbeafe\',\\n  },\\n  {\\n    id: \'ptfe\',\\n    name: \'Nh\341\273\261a PTFE (Teflon)\',\\n    category: \'B\303\241n d\341\272\253n & RF\',\\n    refractiveIndex: 1.38,\\n    relativePermittivity: 1.904,\\n    relativePermeability: 1.0,\\n    notes: \'V\341\272\255t li\341\273\207u t\341\273\225n hao th\341\272\245p trong th\341\272\245u k\303\255nh vi s\303\263ng v\303\240 RF.\',\\n    tintHex: \'#e2e8f0\',\\n  },\\n  {\\n    id: \'fused-silica\',\\n    name: \'Th\341\272\241ch anh n\303\263ng ch\341\272\243y (SiO\342\202\202)\',\\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\\n    refractiveIndex: 1.458,\\n    relativePermittivity: 2.126,\\n    relativePermeability: 1.0,\\n    abbeNumber: 67.8,\\n    notes: \'V\341\272\255t li\341\273\207u l\303\265i s\341\273\243i quang truy\341\273\201n d\341\272\253n vi\341\273\205n th\303\264ng.\',\\n    tintHex: \'#e0e7ff\',\\n  },\\n  {\\n    id: \'bk7\',\\n    name: \'K\303\255nh Crown (BK7)\',\\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\\n    refractiveIndex: 1.517,\\n    relativePermittivity: 2.301,\\n    relativePermeability: 1.0,\\n    abbeNumber: 64.2,\\n    notes: \'Th\341\273\247y tinh quang h\341\273\215c ti\303\252u chu\341\272\251n cho l\304\203ng k\303\255nh v\303\240 th\341\272\245u k\303\255nh.\',\\n    tintHex: \'#dbeafe\',\\n  },\\n  {\\n    id: \'flint\',\\n    name: \'K\303\255nh Flint (SF11)\',\\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\\n    refractiveIndex: 1.785,\\n    relativePermittivity: 3.186,\\n    relativePermeability: 1.0,\\n    abbeNumber: 25.8,\\n    notes: \'Chi\341\272\277t su\341\272\245t v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c cao, d\303\271ng cho quang h\341\273\215c t\303\241ch ph\341\273\225.\',\\n    tintHex: \'#cbd5e1\',\\n  },\\n  {\\n    id: \'sapphire\',\\n    name: \'Sapphire (Al\342\202\202O\342\202\203)\',\\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\\n    refractiveIndex: 1.768,\\n    relativePermittivity: 3.126,\\n    relativePermeability: 1.0,\\n    notes: \'C\341\273\255a s\341\273\225 quang h\341\273\215c ch\341\273\213u nhi\341\273\207t v\303\240 \303\241p su\341\272\245t cao.\',\\n    tintHex: \'#d8e3f0\',\\n  },\\n  {\\n    id: \'diamond\',\\n    name: \'Kim c\306\260\306\241ng (C)\',\\n    category: \'Th\341\273\247y tinh & Quang h\341\273\215c\',\\n    refractiveIndex: 2.417,\\n    relativePermittivity: 5.842,\\n    relativePermeability: 1.0,\\n    abbeNumber: 55.3,\\n    notes: \'Chi\341\272\277t su\341\272\245t r\341\272\245t cao, g\303\263c t\341\273\233i h\341\272\241n nh\341\273\217 (~24.4\302\260 trong kh\303\264ng kh\303\255).\',\\n    tintHex: \'#cffafe\',\\n  },\\n  {\\n    id: \'silicon\',\\n    name: \'Silicon (IR / Vi s\303\263ng)\',\\n    category: \'B\303\241n d\341\272\253n & RF\',\\n    refractiveIndex: 3.42,\\n    relativePermittivity: 11.696,\\n    relativePermeability: 1.0,\\n    notes: \'Ch\341\272\245t b\303\241n d\341\272\253n \304\221i\341\273\207n m\303\264i cao cho h\341\273\223ng ngo\341\272\241i v\303\240 m\341\272\241ch ph\341\272\263ng RF.\',\\n    tintHex: \'#cbd5e1\',\\n  },\\n];\\n\\nexport type PolarizationMode = \'TE\' | \'TM\' | \'UNPOLARIZED\';\\n\\nexport type SpectrumBand = \'VISIBLE\' | \'INFRARED\' | \'MICROWAVE\';\\n\\nexport interface PresetScenario {\\n  id: string;\\n  title: string;\\n  subtitle: string;\\n  n1: number;\\n  n2: number;\\n  material1Id: string;\\n  material2Id: string;\\n  incidentAngleDeg: number;\\n  polarization: PolarizationMode;\\n  wavelengthNm: number;\\n  band: SpectrumBand;\\n}\\n\\nexport const PRESET_SCENARIOS: PresetScenario[] = [\\n  {\\n    id: \'air-bk7\',\\n    title: \'Kh\303\272c x\341\272\241 chu\341\272\251n (Kh\303\264ng kh\303\255 \342\206\222 K\303\255nh BK7)\',\\n    subtitle: \'Tia l\341\273\207ch v\341\273\201 ph\303\241p tuy\341\272\277n, b\306\260\341\273\233c s\303\263ng n\303\251n 1.52 l\341\272\247n\',\\n    n1: 1.0003,\\n    n2: 1.517,\\n    material1Id: \'air\',\\n    material2Id: \'bk7\',\\n    incidentAngleDeg: 45,\\n    polarization: \'UNPOLARIZED\',\\n    wavelengthNm: 532,\\n    band: \'VISIBLE\',\\n  },\\n  {\\n    id: \'brewster-water\',\\n    title: \'G\303\263c Brewster (Kh\303\264ng kh\303\255 \342\206\222 N\306\260\341\273\233c)\',\\n    subtitle: \'Tri\341\273\207t ti\303\252u s\303\263ng ph\341\272\243n x\341\272\241 TM (Rp = 0%)\',\\n    n1: 1.0003,\\n    n2: 1.333,\\n    material1Id: \'air\',\\n    material2Id: \'water\',\\n    incidentAngleDeg: 53.12,\\n    polarization: \'TM\',\\n    wavelengthNm: 589,\\n    band: \'VISIBLE\',\\n  },\\n  {\\n    id: \'tir-glass-air\',\\n    title: \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (K\303\255nh BK7 \342\206\222 Kh\303\264ng kh\303\255)\',\\n    subtitle: \'\316\270i > \316\270c, R = 100%, xu\341\272\245t hi\341\273\207n s\303\263ng suy gi\341\272\243m b\341\273\201 m\341\272\267t\',\\n    n1: 1.517,\\n    n2: 1.0003,\\n    material1Id: \'bk7\',\\n    material2Id: \'air\',\\n    incidentAngleDeg: 54,\\n    polarization: \'TE\',\\n    wavelengthNm: 633,\\n    band: \'VISIBLE\',\\n  },\\n  {\\n    id: \'fiber-core\',\\n    title: \'D\341\272\253n s\303\263ng s\341\273\243i quang (Th\341\272\241ch anh \342\206\222 Kh\303\264ng kh\303\255)\',\\n    subtitle: \'G\303\263c t\341\273\233i h\341\272\241n \316\270c \342\211\210 43.3\302\260, kh\341\272\243o s\303\241t \304\221\341\273\231 s\303\242u xuy\303\252n th\341\272\245u\',\\n    n1: 1.458,\\n    n2: 1.0003,\\n    material1Id: \'fused-silica\',\\n    material2Id: \'air\',\\n    incidentAngleDeg: 48,\\n    polarization: \'TE\',\\n    wavelengthNm: 1550,\\n    band: \'INFRARED\',\\n  },\\n  {\\n    id: \'rf-silicon\',\\n    title: \'Vi s\303\263ng RF 10 GHz (Kh\303\264ng kh\303\255 \342\206\222 Silicon)\',\\n    subtitle: \'Ph\341\272\243n x\341\272\241 \304\221i\341\273\207n m\303\264i m\341\272\241nh do ch\303\252nh l\341\273\207ch tr\341\273\237 kh\303\241ng s\303\263ng\',\\n    n1: 1.0003,\\n    n2: 3.42,\\n    material1Id: \'air\',\\n    material2Id: \'silicon\',\\n    incidentAngleDeg: 35,\\n    polarization: \'TM\',\\n    wavelengthNm: 30_000_000, // 30 mm = 10 GHz\\n    band: \'MICROWAVE\',\\n  },\\n];\\n\\nexport function findMaterialById(id: string): OpticalMaterial | undefined {\\n  return OPTICAL_MATERIALS.find((m) => m.id === id);\\n}\\n\\nexport function findMaterialLabel(n: number, selectedId: string): string {\\n  if (selectedId !== \'custom\') {\\n    const mat = findMaterialById(selectedId);\\n    if (mat && Math.abs(mat.refractiveIndex - n) < 0.002) {\\n      return mat.name;\\n    }\\n  }\\n  return `M\303\264i tr\306\260\341\273\235ng t\303\271y ch\341\273\211nh (n = ${n.toFixed(3)})`;\\n}\\n\",\"Description\":\"Create optical and RF dielectric materials catalog and preset scenarios\",\"Overwrite\":true,\"TargetFile\":\"/src/physics/materials.ts\",\"toolAction\":\"Creating optical materials catalog\",\"toolSummary\":\"Create materials catalog\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11608530883906358004"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { PolarizationMode } from \'./materials\';\\n\\nexport const SPEED_OF_LIGHT = 299_792_458; // m/s\\nexport const VACUUM_IMPEDANCE = 376.730313668; // Ohms (Z0 = sqrt(mu0/eps0))\\n\\nexport type PropagationRegimeCode =\\n  | \'MATCHED_MEDIA\'\\n  | \'NORMAL_INCIDENCE\'\\n  | \'BREWSTER_ANGLE\'\\n  | \'CRITICAL_THRESHOLD\'\\n  | \'TOTAL_INTERNAL_REFLECTION\'\\n  | \'REFRACTION_TO_DENSER\'\\n  | \'REFRACTION_TO_RARER\';\\n\\nexport interface WaveSimulationInput {\\n  n1: number;\\n  n2: number;\\n  incidentAngleDeg: number; // [0, 89.9]\\n  wavelengthVacuumNm: number; // vacuum wavelength in nm (e.g. 532 nm or 30,000,000 nm for 10 GHz)\\n  polarization: PolarizationMode;\\n}\\n\\nexport interface PropagationClassification {\\n  code: PropagationRegimeCode;\\n  label: string;\\n  shortTag: string;\\n  severity: \'nominal\' | \'transition\' | \'critical\';\\n  summary: string;\\n  keyCharacteristics: string[];\\n}\\n\\nexport interface WavePhysicsResult {\\n  n1: number;\\n  n2: number;\\n  incidentAngleDeg: number;\\n  incidentAngleRad: number;\\n  reflectedAngleDeg: number;\\n  refractedAngleDeg: number | null; // null in TIR\\n  refractedAngleRad: number | null;\\n  deviationAngleDeg: number | null;\\n  isTotalInternalReflection: boolean;\\n  isNearCritical: boolean;\\n  isNearBrewster: boolean;\\n\\n  criticalAngleDeg: number | null; // exists iff n1 > n2\\n  brewsterAngleDeg: number;\\n\\n  // Fresnel amplitude reflection coefficients (complex magnitude and phase shift in degrees)\\n  rsMag: number;\\n  rpMag: number;\\n  phaseShiftSDeg: number;\\n  phaseShiftPDeg: number;\\n\\n  // Fresnel power reflectance & transmittance [0, 1]\\n  reflectanceS: number;\\n  reflectanceP: number;\\n  reflectanceEffective: number;\\n  transmittanceS: number;\\n  transmittanceP: number;\\n  transmittanceEffective: number;\\n\\n  // Wave kinematics & electromagnetic medium parameters\\n  frequencyHz: number;\\n  phaseVelocity1: number; // m/s\\n  phaseVelocity2: number; // m/s\\n  wavelength1Nm: number;\\n  wavelength2Nm: number;\\n  wavelengthRatio: number; // lambda2 / lambda1 = n1 / n2\\n  waveNumber1: number; // rad/m\\n  waveNumber2: number; // rad/m\\n  impedance1Ohm: number;\\n  impedance2Ohm: number;\\n  permittivity1: number;\\n  permittivity2: number;\\n\\n  // Evanescent wave decay depth (1/e amplitude decay) in nm when TIR occurs\\n  evanescentPenetrationDepthNm: number | null;\\n\\n  // Automatic characteristic identification\\n  classification: PropagationClassification;\\n}\\n\\nexport interface FresnelCurvePoint {\\n  angleDeg: number;\\n  Rs: number;\\n  Rp: number;\\n  Runpol: number;\\n  Teff: number;\\n  phaseS: number;\\n  phaseP: number;\\n}\\n\\nexport function clamp(val: number, min: number, max: number): number {\\n  return Math.min(max, Math.max(min, val));\\n}\\n\\nexport function degToRad(deg: number): number {\\n  return (deg * Math.PI) / 180;\\n}\\n\\nexport function radToDeg(rad: number): number {\\n  return (rad * 180) / Math.PI;\\n}\\n\\n/**\\n * Computes complete Snell\'s Law, Fresnel reflectance/transmittance, phase shifts,\\n * evanescent penetration depth, and automatic propagation regime classification\\n * for a non-magnetic isotropic lossless dielectric interface (mu_r1 = mu_r2 = 1).\\n */\\nexport function computeEMRefraction(input: WaveSimulationInput): WavePhysicsResult {\\n  const n1 = clamp(input.n1, 1.0, 5.0);\\n  const n2 = clamp(input.n2, 1.0, 5.0);\\n  const incidentAngleDeg = clamp(input.incidentAngleDeg, 0, 89.9);\\n  const incidentAngleRad = degToRad(incidentAngleDeg);\\n  const wavelengthVacuumNm = Math.max(1, input.wavelengthVacuumNm);\\n\\n  const sinI = Math.sin(incidentAngleRad);\\n  const cosI = Math.cos(incidentAngleRad);\\n\\n  const brewsterAngleDeg = radToDeg(Math.atan2(n2, n1));\\n  const criticalAngleDeg = n1 > n2 ? radToDeg(Math.asin(n2 / n1)) : null;\\n\\n  const sinT = (n1 / n2) * sinI;\\n  const isTotalInternalReflection = sinT > 1 + 1e-12;\\n  const isNearCritical =\\n    criticalAngleDeg !== null && Math.abs(incidentAngleDeg - criticalAngleDeg) <= 0.6;\\n  const isNearBrewster =\\n    Math.abs(n1 - n2) > 0.005 && Math.abs(incidentAngleDeg - brewsterAngleDeg) <= 0.6;\\n\\n  let refractedAngleRad: number | null = null;\\n  let refractedAngleDeg: number | null = null;\\n  let deviationAngleDeg: number | null = null;\\n\\n  let rsMag = 0;\\n  let rpMag = 0;\\n  let phaseShiftSDeg = 0;\\n  let phaseShiftPDeg = 0;\\n\\n  let reflectanceS = 0;\\n  let reflectanceP = 0;\\n  let transmittanceS = 1;\\n  let transmittanceP = 1;\\n  let evanescentPenetrationDepthNm: number | null = null;\\n\\n  if (isTotalInternalReflection) {\\n    // Total Internal Reflection (TIR): |r_s| = |r_p| = 1, T = 0\\n    rsMag = 1;\\n    rpMag = 1;\\n    reflectanceS = 1;\\n    reflectanceP = 1;\\n    transmittanceS = 0;\\n    transmittanceP = 0;\\n\\n    // Exact TIR phase shifts (Born & Wolf / Hecht convention)\\n    const radical = Math.sqrt(Math.max(0, sinI * sinI - (n2 / n1) * (n2 / n1)));\\n    const phiSRad = 2 * Math.atan2(radical, cosI);\\n    const phiPRad = 2 * Math.atan2(radical, (n2 / n1) * (n2 / n1) * cosI);\\n    phaseShiftSDeg = radToDeg(phiSRad);\\n    phaseShiftPDeg = radToDeg(phiPRad);\\n\\n    // Evanescent field decay depth: delta_e = lambda_0 / (2 * pi * sqrt(n1^2 sin^2(theta_i) - n2^2))\\n    const decayTerm = Math.sqrt(Math.max(1e-12, n1 * n1 * sinI * sinI - n2 * n2));\\n    evanescentPenetrationDepthNm = wavelengthVacuumNm / (2 * Math.PI * decayTerm);\\n  } else {\\n    const clampedSinT = clamp(sinT, -1, 1);\\n    refractedAngleRad = Math.asin(clampedSinT);\\n    refractedAngleDeg = radToDeg(refractedAngleRad);\\n    deviationAngleDeg = Math.abs(incidentAngleDeg - refractedAngleDeg);\\n\\n    const cosT = Math.cos(refractedAngleRad);\\n\\n    // Fresnel amplitude reflection coefficients (r_s for TE, r_p for TM)\\n    // Using standard optical convention:\\n    // r_s = (n1 cosI - n2 cosT) / (n1 cosI + n2 cosT)\\n    // r_p = (n2 cosI - n1 cosT) / (n2 cosI + n1 cosT)\\n    const rs = (n1 * cosI - n2 * cosT) / (n1 * cosI + n2 * cosT);\\n    const rp = (n2 * cosI - n1 * cosT) / (n2 * cosI + n1 * cosT);\\n\\n    rsMag = Math.abs(rs);\\n    rpMag = Math.abs(rp);\\n    phaseShiftSDeg = rs < -1e-12 ? 180 : 0;\\n    phaseShiftPDeg = rp < -1e-12 ? 180 : 0;\\n\\n    reflectanceS = clamp(rs * rs, 0, 1);\\n    reflectanceP = clamp(rp * rp, 0, 1);\\n    transmittanceS = clamp(1 - reflectanceS, 0, 1);\\n    transmittanceP = clamp(1 - reflectanceP, 0, 1);\\n  }\\n\\n  let reflectanceEffective: number;\\n  let transmittanceEffective: number;\\n\\n  if (input.polarization === \'TE\') {\\n    reflectanceEffective = reflectanceS;\\n    transmittanceEffective = transmittanceS;\\n  } else if (input.polarization === \'TM\') {\\n    reflectanceEffective = reflectanceP;\\n    transmittanceEffective = transmittanceP;\\n  } else {\\n    reflectanceEffective = 0.5 * (reflectanceS + reflectanceP);\\n    transmittanceEffective = 0.5 * (transmittanceS + transmittanceP);\\n  }\\n\\n  // Wave kinematics\\n  const wavelengthVacuumM = wavelengthVacuumNm * 1e-9;\\n  const frequencyHz = SPEED_OF_LIGHT / wavelengthVacuumM;\\n  const phaseVelocity1 = SPEED_OF_LIGHT / n1;\\n  const phaseVelocity2 = SPEED_OF_LIGHT / n2;\\n  const wavelength1Nm = wavelengthVacuumNm / n1;\\n  const wavelength2Nm = wavelengthVacuumNm / n2;\\n  const wavelengthRatio = n1 / n2;\\n  const waveNumber1 = (2 * Math.PI) / (wavelength1Nm * 1e-9);\\n  const waveNumber2 = (2 * Math.PI) / (wavelength2Nm * 1e-9);\\n  const impedance1Ohm = VACUUM_IMPEDANCE / n1;\\n  const impedance2Ohm = VACUUM_IMPEDANCE / n2;\\n  const permittivity1 = n1 * n1;\\n  const permittivity2 = n2 * n2;\\n\\n  const classification = classifyPropagationRegime({\\n    n1,\\n    n2,\\n    incidentAngleDeg,\\n    refractedAngleDeg,\\n    isTotalInternalReflection,\\n    isNearCritical,\\n    isNearBrewster,\\n    criticalAngleDeg,\\n    brewsterAngleDeg,\\n    reflectanceS,\\n    reflectanceP,\\n    polarization: input.polarization,\\n    evanescentPenetrationDepthNm,\\n    wavelengthRatio,\\n  });\\n\\n  return {\\n    n1,\\n    n2,\\n    incidentAngleDeg,\\n    incidentAngleRad,\\n    reflectedAngleDeg: incidentAngleDeg,\\n    refractedAngleDeg,\\n    refractedAngleRad,\\n    deviationAngleDeg,\\n    isTotalInternalReflection,\\n    isNearCritical,\\n    isNearBrewster,\\n    criticalAngleDeg,\\n    brewsterAngleDeg,\\n    rsMag,\\n    rpMag,\\n    phaseShiftSDeg,\\n    phaseShiftPDeg,\\n    reflectanceS,\\n    reflectanceP,\\n    reflectanceEffective,\\n    transmittanceS,\\n    transmittanceP,\\n    transmittanceEffective,\\n    frequencyHz,\\n    phaseVelocity1,\\n    phaseVelocity2,\\n    wavelength1Nm,\\n    wavelength2Nm,\\n    wavelengthRatio,\\n    waveNumber1,\\n    waveNumber2,\\n    impedance1Ohm,\\n    impedance2Ohm,\\n    permittivity1,\\n    permittivity2,\\n    evanescentPenetrationDepthNm,\\n    classification,\\n  };\\n}\\n\\nfunction classifyPropagationRegime(params: {\\n  n1: number;\\n  n2: number;\\n  incidentAngleDeg: number;\\n  refractedAngleDeg: number | null;\\n  isTotalInternalReflection: boolean;\\n  isNearCritical: boolean;\\n  isNearBrewster: boolean;\\n  criticalAngleDeg: number | null;\\n  brewsterAngleDeg: number;\\n  reflectanceS: number;\\n  reflectanceP: number;\\n  polarization: PolarizationMode;\\n  evanescentPenetrationDepthNm: number | null;\\n  wavelengthRatio: number;\\n}): PropagationClassification {\\n  const {\\n    n1,\\n    n2,\\n    incidentAngleDeg,\\n    isTotalInternalReflection,\\n    isNearCritical,\\n    isNearBrewster,\\n    criticalAngleDeg,\\n    brewsterAngleDeg,\\n    reflectanceS,\\n    reflectanceP,\\n    evanescentPenetrationDepthNm,\\n    wavelengthRatio,\\n  } = params;\\n\\n  if (Math.abs(n1 - n2) < 0.005) {\\n    return {\\n      code: \'MATCHED_MEDIA\',\\n      label: \'M\303\264i tr\306\260\341\273\235ng \304\221\341\273\223ng nh\341\272\245t \342\200\224 Kh\303\264ng kh\303\272c x\341\272\241\',\\n      shortTag: \'\304\220\341\273\223ng nh\341\272\245t tr\341\273\237 kh\303\241ng\',\\n      severity: \'nominal\',\\n      summary:\\n        \'Hai m\303\264i tr\306\260\341\273\235ng c\303\263 chi\341\272\277t su\341\272\245t v\303\240 tr\341\273\237 kh\303\241ng s\303\263ng t\306\260\306\241ng \304\221\306\260\306\241ng (Z\342\202\201 \342\211\210 Z\342\202\202). S\303\263ng \304\221i\341\273\207n t\341\273\253 truy\341\273\201n th\341\272\263ng g\341\272\247n nh\306\260 ho\303\240n to\303\240n kh\303\264ng ph\341\272\243n x\341\272\241.\',\\n      keyCharacteristics: [\\n        \'G\303\263c kh\303\272c x\341\272\241 b\341\272\261ng g\303\263c t\341\273\233i (\316\270t \342\211\210 \316\270i), \304\221\341\273\231 l\341\273\207ch tia \342\211\210 0\302\260\',\\n        \'H\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 Fresnel x\341\272\245p x\341\273\211 0% cho c\341\272\243 ph\303\242n c\341\273\261c TE v\303\240 TM\',\\n        \'Kh\303\264ng c\303\263 s\341\273\261 n\303\251n hay gi\303\243n b\306\260\341\273\233c s\303\263ng qua m\341\272\267t ph\303\242n c\303\241ch\',\\n      ],\\n    };\\n  }\\n\\n  if (isTotalInternalReflection) {\\n    const depthStr =\\n      evanescentPenetrationDepthNm !== null\\n        ? formatWavelength(evanescentPenetrationDepthNm)\\n        : \'\342\200\224\';\\n    return {\\n      code: \'TOTAL_INTERNAL_REFLECTION\',\\n      label: \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n & S\303\263ng suy gi\341\272\243m (TIR)\',\\n      shortTag: \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n\',\\n      severity: \'critical\',\\n      summary: `G\303\263c t\341\273\233i v\306\260\341\273\243t ng\306\260\341\273\241ng t\341\273\233i h\341\272\241n \316\270c = ${criticalAngleDeg?.toFixed(2)}\302\260. To\303\240n b\341\273\231 c\303\264ng su\341\272\245t ph\341\272\243n x\341\272\241 v\341\273\201 m\303\264i tr\306\260\341\273\235ng 1 (R = 100%) v\303\240 t\341\272\241o s\303\263ng suy gi\341\272\243m (evanescent) lan s\303\241t m\341\272\267t ph\303\242n c\303\241ch.`,\\n      keyCharacteristics: [\\n        \'C\303\264ng su\341\272\245t truy\341\273\201n xa T = 0%, to\303\240n b\341\273\231 n\304\203ng l\306\260\341\273\243ng b\341\272\243o to\303\240n trong tia ph\341\272\243n x\341\272\241\',\\n        `\304\220\341\273\231 s\303\242u xuy\303\252n th\341\272\245u bi\303\252n \304\221\341\273\231 1/e c\341\273\247a s\303\263ng suy gi\341\272\243m: \316\264e \342\211\210 ${depthStr}`,\\n        \'Xu\341\272\245t hi\341\273\207n d\341\273\213ch pha phi tuy\341\272\277n li\303\252n t\341\273\245c (hi\341\273\207u \341\273\251ng Goos\342\200\223H\303\244nchen) gi\341\273\257a TE v\303\240 TM\',\\n      ],\\n    };\\n  }\\n\\n  if (isNearCritical && criticalAngleDeg !== null) {\\n    return {\\n      code: \'CRITICAL_THRESHOLD\',\\n      label: \'Ng\306\260\341\273\241ng g\303\263c t\341\273\233i h\341\272\241n (Critical Angle)\',\\n      shortTag: \'Ng\306\260\341\273\241ng t\341\273\233i h\341\272\241n\',\\n      severity: \'transition\',\\n      summary: `G\303\263c t\341\273\233i ti\341\273\207m c\341\272\255n ng\306\260\341\273\241ng t\341\273\233i h\341\272\241n \316\270c = ${criticalAngleDeg.toFixed(2)}\302\260. Tia kh\303\272c x\341\272\241 truy\341\273\201n s\303\241t m\341\272\267t ph\303\242n c\303\241ch (\316\270t \342\206\222 90\302\260), h\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 t\304\203ng d\341\273\221c v\341\273\201 100%.`,\\n      keyCharacteristics: [\\n        \'Tia l\303\263 \304\221i l\303\240 l\303\240 d\341\273\215c bi\303\252n ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng \304\221i\341\273\207n m\303\264i\',\\n        \'Ch\341\273\211 c\341\272\247n t\304\203ng nh\341\272\271 g\303\263c t\341\273\233i s\341\272\275 k\303\255ch ho\341\272\241t ch\341\272\277 \304\221\341\273\231 ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (TIR)\',\\n        \'Nh\341\272\241y c\341\272\243m cao v\341\273\233i bi\341\272\277n thi\303\252n chi\341\272\277t su\341\272\245t \342\200\224 \341\273\251ng d\341\273\245ng trong c\341\272\243m bi\341\272\277n quang h\341\273\215c\',\\n      ],\\n    };\\n  }\\n\\n  if (isNearBrewster) {\\n    return {\\n      code: \'BREWSTER_ANGLE\',\\n      label: \'G\303\263c Brewster \342\200\224 Tri\341\273\207t ti\303\252u ph\341\272\243n x\341\272\241 TM\',\\n      shortTag: \'G\303\263c Brewster\',\\n      severity: \'transition\',\\n      summary: `T\341\272\241i \316\270B = ${brewsterAngleDeg.toFixed(2)}\302\260, tia ph\341\272\243n x\341\272\241 v\303\240 tia kh\303\272c x\341\272\241 vu\303\264ng g\303\263c nhau (\316\270i + \316\270t = 90\302\260). Th\303\240nh ph\341\272\247n ph\303\242n c\341\273\261c TM truy\341\273\201n qua 100% (Rp \342\211\210 ${(reflectanceP * 100).toFixed(2)}%).`,\\n      keyCharacteristics: [\\n        \'Tia ph\341\272\243n x\341\272\241 b\341\273\213 ph\303\242n c\341\273\261c tuy\341\272\277n t\303\255nh thu\341\272\247n TE (vu\303\264ng g\303\263c m\341\272\267t ph\341\272\263ng t\341\273\233i)\',\\n        `C\303\264ng su\341\272\245t ph\341\272\243n x\341\272\241 Rp \342\211\210 ${(reflectanceP * 100).toFixed(2)}%, trong khi Rs = ${(reflectanceS * 100).toFixed(2)}%`,\\n        \'\341\273\250ng d\341\273\245ng trong c\341\273\255a s\341\273\225 laser Brewster v\303\240 k\303\255nh l\341\273\215c ch\341\273\221ng ch\303\263i ph\303\242n c\341\273\261c\',\\n      ],\\n    };\\n  }\\n\\n  if (incidentAngleDeg <= 0.5) {\\n    const rPct = (reflectanceS * 100).toFixed(2);\\n    return {\\n      code: \'NORMAL_INCIDENCE\',\\n      label: \'Chi\341\272\277u vu\303\264ng g\303\263c ph\303\241p tuy\341\272\277n (Normal Incidence)\',\\n      shortTag: \'Chi\341\272\277u ph\303\241p tuy\341\272\277n\',\\n      severity: \'nominal\',\\n      summary: `S\303\263ng \304\221i\341\273\207n t\341\273\253 \304\221\341\272\255p vu\303\264ng g\303\263c m\341\272\267t ph\303\242n c\303\241ch (\316\270i \342\211\210 0\302\260). Kh\303\264ng x\341\272\243y ra b\341\272\273 cong ph\306\260\306\241ng truy\341\273\201n, ph\303\242n c\341\273\261c TE v\303\240 TM \304\221\341\273\221i x\341\273\251ng ho\303\240n to\303\240n (Rs = Rp = ${rPct}%).`,\\n      keyCharacteristics: [\\n        \'Tia truy\341\273\201n th\341\272\263ng (\316\270t = 0\302\260), ch\341\273\211 thay \304\221\341\273\225i v\341\272\255n t\341\273\221c pha v\303\240 b\306\260\341\273\233c s\303\263ng\',\\n        `H\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 ph\341\273\245 thu\341\273\231c thu\341\272\247n v\303\240o \304\221\341\273\231 l\341\273\207ch tr\341\273\237 kh\303\241ng: R = ((n\342\202\201 \342\210\222 n\342\202\202)/(n\342\202\201 + n\342\202\202))\302\262 = ${rPct}%`,\\n        n2 > n1\\n          ? \'Tia ph\341\272\243n x\341\272\241 \304\221\341\272\243o pha 180\302\260 do \304\221i v\303\240o m\303\264i tr\306\260\341\273\235ng chi\341\272\277t quang h\306\241n\'\\n          : \'Tia ph\341\272\243n x\341\272\241 gi\341\273\257 nguy\303\252n pha 0\302\260 do \304\221i v\303\240o m\303\264i tr\306\260\341\273\235ng k\303\251m chi\341\272\277t quang h\306\241n\',\\n      ],\\n    };\\n  }\\n\\n  if (n2 > n1) {\\n    return {\\n      code: \'REFRACTION_TO_DENSER\',\\n      label: \'Kh\303\272c x\341\272\241 chu\341\272\251n \342\200\224 Chi\341\272\277t quang t\304\203ng (n\342\202\202 > n\342\202\201)\',\\n      shortTag: \'Chi\341\272\277t quang t\304\203ng\',\\n      severity: \'nominal\',\\n      summary: `S\303\263ng \304\221i v\303\240o m\303\264i tr\306\260\341\273\235ng chi\341\272\277t quang h\306\241n (v\342\202\202 < v\342\202\201). Tia kh\303\272c x\341\272\241 l\341\273\207ch l\341\272\241i g\341\272\247n ph\303\241p tuy\341\272\277n (\316\270t < \316\270i), b\306\260\341\273\233c s\303\263ng b\341\273\213 n\303\251n c\303\262n ${(wavelengthRatio * 100).toFixed(1)}% so v\341\273\233i m\303\264i tr\306\260\341\273\235ng 1.`,\\n      keyCharacteristics: [\\n        \'Kh\303\264ng t\341\273\223n t\341\272\241i g\303\263c t\341\273\233i h\341\272\241n (s\303\263ng lu\303\264n truy\341\273\201n \304\221\306\260\341\273\243c v\303\240o m\303\264i tr\306\260\341\273\235ng 2 v\341\273\233i m\341\273\215i g\303\263c t\341\273\233i)\',\\n        \'Th\303\240nh ph\341\272\247n TE \304\221\341\272\243o pha 180\302\260 khi ph\341\272\243n x\341\272\241; th\303\240nh ph\341\272\247n TM \304\221\341\273\225i pha khi v\306\260\341\273\243t g\303\263c Brewster\',\\n        `T\341\273\267 s\341\273\221 n\303\251n b\306\260\341\273\233c s\303\263ng \316\273\342\202\202/\316\273\342\202\201 = ${wavelengthRatio.toFixed(3)}, tr\341\273\237 kh\303\241ng s\303\263ng gi\341\272\243m`,\\n      ],\\n    };\\n  }\\n\\n  return {\\n    code: \'REFRACTION_TO_RARER\',\\n    label: \'Kh\303\272c x\341\272\241 chu\341\272\251n \342\200\224 Chi\341\272\277t quang gi\341\272\243m (n\342\202\201 > n\342\202\202)\',\\n    shortTag: \'Chi\341\272\277t quang gi\341\272\243m\',\\n    severity: \'nominal\',\\n    summary: `S\303\263ng \304\221i sang m\303\264i tr\306\260\341\273\235ng chi\341\272\277t su\341\272\245t th\341\272\245p h\306\241n (v\342\202\202 > v\342\202\201). Tia kh\303\272c x\341\272\241 l\341\273\207ch xa ph\303\241p tuy\341\272\277n (\316\270t > \316\270i), b\306\260\341\273\233c s\303\263ng gi\303\243n ra ${(wavelengthRatio).toFixed(2)} l\341\272\247n. G\303\263c t\341\273\233i h\341\272\241n \316\270c = ${criticalAngleDeg?.toFixed(2)}\302\260.`,\\n    keyCharacteristics: [\\n      `T\341\273\223n t\341\272\241i ng\306\260\341\273\241ng ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n t\341\272\241i \316\270c = ${criticalAngleDeg?.toFixed(2)}\302\260`,\\n      \'Tia ph\341\272\243n x\341\272\241 gi\341\273\257 nguy\303\252n pha (0\302\260) \304\221\341\273\221i v\341\273\233i ph\303\242n c\341\273\261c TE d\306\260\341\273\233i ng\306\260\341\273\241ng t\341\273\233i h\341\272\241n\',\\n      `V\341\272\255n t\341\273\221c pha t\304\203ng t\341\273\253 ${(SPEED_OF_LIGHT / n1 / 1e8).toFixed(2)}\303\22710\342\201\270 l\303\252n ${(SPEED_OF_LIGHT / n2 / 1e8).toFixed(2)}\303\22710\342\201\270 m/s`,\\n    ],\\n  };\\n}\\n\\n/**\\n * Generates sampled Fresnel curves from 0\302\260 to 89.5\302\260 for interactive plotting.\\n */\\nexport function generateFresnelCurve(\\n  n1: number,\\n  n2: number,\\n  polarization: PolarizationMode,\\n  wavelengthVacuumNm: number,\\n  stepDeg = 1\\n): FresnelCurvePoint[] {\\n  const points: FresnelCurvePoint[] = [];\\n  for (let angle = 0; angle <= 89; angle += stepDeg) {\\n    const res = computeEMRefraction({\\n      n1,\\n      n2,\\n      incidentAngleDeg: angle,\\n      wavelengthVacuumNm,\\n      polarization,\\n    });\\n    points.push({\\n      angleDeg: angle,\\n      Rs: res.reflectanceS,\\n      Rp: res.reflectanceP,\\n      Runpol: 0.5 * (res.reflectanceS + res.reflectanceP),\\n      Teff: res.transmittanceEffective,\\n      phaseS: res.phaseShiftSDeg,\\n      phaseP: res.phaseShiftPDeg,\\n    });\\n  }\\n  // Ensure 89.9 endpoint for smooth grazing finish\\n  const endRes = computeEMRefraction({\\n    n1,\\n    n2,\\n    incidentAngleDeg: 89.9,\\n    wavelengthVacuumNm,\\n    polarization,\\n  });\\n  points.push({\\n    angleDeg: 89.9,\\n    Rs: endRes.reflectanceS,\\n    Rp: endRes.reflectanceP,\\n    Runpol: 0.5 * (endRes.reflectanceS + endRes.reflectanceP),\\n    Teff: endRes.transmittanceEffective,\\n    phaseS: endRes.phaseShiftSDeg,\\n    phaseP: endRes.phaseShiftPDeg,\\n  });\\n  return points;\\n}\\n\\n/**\\n * Converts a visible wavelength (380-750 nm) or IR/Microwave band to a calibrated display RGB hex color.\\n */\\nexport function wavelengthToColor(wavelengthNm: number): string {\\n  if (wavelengthNm > 780) {\\n    // Infrared or RF/Microwave: calibrated high-contrast scientific accent\\n    return wavelengthNm >= 1_000_000 ? \'#0284c7\' : \'#dc2626\';\\n  }\\n  if (wavelengthNm < 380) {\\n    return \'#6d28d9\';\\n  }\\n\\n  let r = 0;\\n  let g = 0;\\n  let b = 0;\\n\\n  if (wavelengthNm >= 380 && wavelengthNm < 440) {\\n    r = -(wavelengthNm - 440) / (440 - 380);\\n    g = 0;\\n    b = 1;\\n  } else if (wavelengthNm >= 440 && wavelengthNm < 490) {\\n    r = 0;\\n    g = (wavelengthNm - 440) / (490 - 440);\\n    b = 1;\\n  } else if (wavelengthNm >= 490 && wavelengthNm < 510) {\\n    r = 0;\\n    g = 1;\\n    b = -(wavelengthNm - 510) / (510 - 490);\\n  } else if (wavelengthNm >= 510 && wavelengthNm < 580) {\\n    r = (wavelengthNm - 510) / (580 - 510);\\n    g = 1;\\n    b = 0;\\n  } else if (wavelengthNm >= 580 && wavelengthNm < 645) {\\n    r = 1;\\n    g = -(wavelengthNm - 645) / (645 - 580);\\n    b = 0;\\n  } else {\\n    r = 1;\\n    g = 0;\\n    b = 0;\\n  }\\n\\n  // Slightly darken overly bright yellow/green for clean legibility on light lab canvas\\n  const lumScale = wavelengthNm >= 520 && wavelengthNm <= 600 ? 0.78 : 0.88;\\n  const toHex = (c: number) =>\\n    Math.round(clamp(c * lumScale, 0, 1) * 255)\\n      .toString(16)\\n      .padStart(2, \'0\');\\n\\n  return `#${toHex(r)}${toHex(g)}${toHex(b)}`;\\n}\\n\\nexport function formatWavelength(wavelengthNm: number): string {\\n  if (wavelengthNm >= 1e9) {\\n    return `${(wavelengthNm / 1e9).toFixed(2)} m`;\\n  }\\n  if (wavelengthNm >= 1e6) {\\n    return `${(wavelengthNm / 1e6).toFixed(2)} mm`;\\n  }\\n  if (wavelengthNm >= 1e3) {\\n    return `${(wavelengthNm / 1e3).toFixed(2)} \302\265m`;\\n  }\\n  return `${wavelengthNm.toFixed(1)} nm`;\\n}\\n\\nexport function formatFrequency(freqHz: number): string {\\n  if (freqHz >= 1e12) {\\n    return `${(freqHz / 1e12).toFixed(1)} THz`;\\n  }\\n  if (freqHz >= 1e9) {\\n    return `${(freqHz / 1e9).toFixed(2)} GHz`;\\n  }\\n  if (freqHz >= 1e6) {\\n    return `${(freqHz / 1e6).toFixed(2)} MHz`;\\n  }\\n  return `${freqHz.toFixed(0)} Hz`;\\n}\\n\",\"Description\":\"Implement core Snell, Fresnel, phase shift, evanescent wave, and propagation regime physics engine\",\"Overwrite\":true,\"TargetFile\":\"/src/physics/emPhysics.ts\",\"toolAction\":\"Creating EM refraction physics engine\",\"toolSummary\":\"Create EM physics engine\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11608530883906355999"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  computeEMRefraction,\\n  degToRad,\\n  radToDeg,\\n  SPEED_OF_LIGHT,\\n  VACUUM_IMPEDANCE,\\n  WavePhysicsResult,\\n} from \'./emPhysics\';\\nimport { OPTICAL_MATERIALS, OpticalMaterial, PolarizationMode } from \'./materials\';\\n\\nexport type MeasurementMode = \'SNELL_ANGLES\' | \'CRITICAL_ANGLE\' | \'BREWSTER_ANGLE\';\\n\\nexport interface InverseMeasurementInput {\\n  mode: MeasurementMode;\\n  knownN1: number;\\n  incidentAngleDeg: number; // Used in SNELL_ANGLES\\n  refractedAngleDeg: number; // Used in SNELL_ANGLES\\n  measuredCriticalAngleDeg: number; // Used in CRITICAL_ANGLE\\n  measuredBrewsterAngleDeg: number; // Used in BREWSTER_ANGLE\\n  measuredReflectancePct: number | null; // Optional cross-check (0 - 100)\\n  polarization: PolarizationMode;\\n  wavelengthVacuumNm: number;\\n}\\n\\nexport interface MaterialCandidateMatch {\\n  material: OpticalMaterial;\\n  deltaN: number;\\n  confidencePct: number;\\n}\\n\\nexport interface ReflectanceConsistencyCheck {\\n  measuredPct: number;\\n  predictedPct: number;\\n  residualPct: number;\\n  status: \'MATCH\' | \'MODERATE_DRIFT\' | \'ANOMALY\';\\n  diagnosis: string;\\n}\\n\\nexport interface InverseIdentificationResult {\\n  ok: true;\\n  estimatedN2: number;\\n  estimatedPermittivity2: number;\\n  estimatedImpedance2Ohm: number;\\n  estimatedVelocity2: number;\\n  wavelengthRatio: number;\\n  methodUsed: string;\\n  formulaTrace: string;\\n  physicsPreview: WavePhysicsResult;\\n  topCandidates: MaterialCandidateMatch[];\\n  consistencyCheck: ReflectanceConsistencyCheck | null;\\n}\\n\\nexport interface InverseIdentificationError {\\n  ok: false;\\n  fieldErrors: Record<string, string>;\\n  message: string;\\n}\\n\\nexport type InverseIdentificationOutput =\\n  | InverseIdentificationResult\\n  | InverseIdentificationError;\\n\\nexport interface MysterySamplePreset {\\n  id: string;\\n  title: string;\\n  description: string;\\n  input: InverseMeasurementInput;\\n}\\n\\nexport const MYSTERY_SAMPLES: MysterySamplePreset[] = [\\n  {\\n    id: \'sample-a\',\\n    title: \'M\341\272\253u \304\221o A \342\200\224 Kh\341\273\221i quang h\341\273\215c trong su\341\273\221t\',\\n    description: \'Chi\341\272\277u tia 532 nm t\341\273\253 kh\303\264ng kh\303\255 \341\273\237 \316\270i = 45.0\302\260, \304\221o \304\221\306\260\341\273\243c \316\270t = 27.78\302\260 v\303\240 R \342\211\210 4.9%.\',\\n    input: {\\n      mode: \'SNELL_ANGLES\',\\n      knownN1: 1.0003,\\n      incidentAngleDeg: 45.0,\\n      refractedAngleDeg: 27.78,\\n      measuredCriticalAngleDeg: 41.2,\\n      measuredBrewsterAngleDeg: 56.6,\\n      measuredReflectancePct: 4.9,\\n      polarization: \'UNPOLARIZED\',\\n      wavelengthVacuumNm: 532,\\n    },\\n  },\\n  {\\n    id: \'sample-b\',\\n    title: \'M\341\272\253u \304\221o B \342\200\224 Tinh th\341\273\203 chi\341\272\277t su\341\272\245t cao (G\303\263c Brewster)\',\\n    description: \'\304\220o \304\221\306\260\341\273\243c g\303\263c tri\341\273\207t ti\303\252u ph\341\272\243n x\341\272\241 TM t\341\272\241i \316\270B = 67.52\302\260 trong kh\303\264ng kh\303\255.\',\\n    input: {\\n      mode: \'BREWSTER_ANGLE\',\\n      knownN1: 1.0003,\\n      incidentAngleDeg: 67.52,\\n      refractedAngleDeg: 22.48,\\n      measuredCriticalAngleDeg: 24.4,\\n      measuredBrewsterAngleDeg: 67.52,\\n      measuredReflectancePct: 0.05,\\n      polarization: \'TM\',\\n      wavelengthVacuumNm: 589,\\n    },\\n  },\\n  {\\n    id: \'sample-c\',\\n    title: \'M\341\272\253u \304\221o C \342\200\224 X\303\241c \304\221\341\273\213nh v\341\273\217 b\341\273\215c s\341\273\243i quang qua g\303\263c t\341\273\233i h\341\272\241n\',\\n    description: \'S\303\263ng t\341\273\253 l\303\265i th\341\272\241ch anh (n\342\202\201 = 1.458) b\341\272\257t \304\221\341\272\247u ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n t\341\272\241i \316\270c = 66.1\302\260.\',\\n    input: {\\n      mode: \'CRITICAL_ANGLE\',\\n      knownN1: 1.458,\\n      incidentAngleDeg: 66.1,\\n      refractedAngleDeg: 89,\\n      measuredCriticalAngleDeg: 66.1,\\n      measuredBrewsterAngleDeg: 42.4,\\n      measuredReflectancePct: 99.8,\\n      polarization: \'TE\',\\n      wavelengthVacuumNm: 1550,\\n    },\\n  },\\n  {\\n    id: \'sample-d\',\\n    title: \'M\341\272\253u \304\221o D \342\200\224 Ph\303\241t hi\341\273\207n b\341\272\245t th\306\260\341\273\235ng t\341\273\225n hao h\341\272\245p th\341\273\245\',\\n    description: \'G\303\263c Snell cho n\342\202\202 \342\211\210 1.333 nh\306\260ng \304\221\341\273\231 ph\341\272\243n x\341\272\241 \304\221o \304\221\306\260\341\273\243c cao b\341\272\245t th\306\260\341\273\235ng (18.5%).\',\\n    input: {\\n      mode: \'SNELL_ANGLES\',\\n      knownN1: 1.0003,\\n      incidentAngleDeg: 40.0,\\n      refractedAngleDeg: 28.83,\\n      measuredCriticalAngleDeg: 48.6,\\n      measuredBrewsterAngleDeg: 53.1,\\n      measuredReflectancePct: 18.5,\\n      polarization: \'UNPOLARIZED\',\\n      wavelengthVacuumNm: 633,\\n    },\\n  },\\n];\\n\\n/**\\n * Identifies unknown medium refractive index, dielectric permittivity, impedance,\\n * closest physical materials, and checks Fresnel reflectance consistency from\\n * experimental wave refraction measurements.\\n */\\nexport function identifyWaveMedium(\\n  input: InverseMeasurementInput\\n): InverseIdentificationOutput {\\n  const fieldErrors: Record<string, string> = {};\\n\\n  if (!Number.isFinite(input.knownN1) || input.knownN1 < 1.0 || input.knownN1 > 5.0) {\\n    fieldErrors.knownN1 = \'Chi\341\272\277t su\341\272\245t m\303\264i tr\306\260\341\273\235ng bi\341\272\277t tr\306\260\341\273\233c n\342\202\201 ph\341\272\243i n\341\272\261m trong kho\341\272\243ng 1.00 \304\221\341\272\277n 5.00.\';\\n  }\\n\\n  if (\\n    input.measuredReflectancePct !== null &&\\n    (!Number.isFinite(input.measuredReflectancePct) ||\\n      input.measuredReflectancePct < 0 ||\\n      input.measuredReflectancePct > 100)\\n  ) {\\n    fieldErrors.measuredReflectancePct = \'H\341\273\207 s\341\273\221 ph\341\272\243n x\341\272\241 \304\221o \304\221\306\260\341\273\243c ph\341\272\243i n\341\272\261m trong kho\341\272\243ng 0% \304\221\341\272\277n 100%.\';\\n  }\\n\\n  let estimatedN2 = 1.0;\\n  let methodUsed = \'\';\\n  let formulaTrace = \'\';\\n  let previewAngleDeg = 45;\\n\\n  if (input.mode === \'SNELL_ANGLES\') {\\n    if (\\n      !Number.isFinite(input.incidentAngleDeg) ||\\n      input.incidentAngleDeg <= 0.1 ||\\n      input.incidentAngleDeg >= 89.9\\n    ) {\\n      fieldErrors.incidentAngleDeg =\\n        \'G\303\263c t\341\273\233i \316\270i ph\341\272\243i l\341\273\233n h\306\241n 0.1\302\260 v\303\240 nh\341\273\217 h\306\241n 89.9\302\260 \304\221\341\273\203 t\303\255nh \304\221\341\273\213nh lu\341\272\255t Snell.\';\\n    }\\n    if (\\n      !Number.isFinite(input.refractedAngleDeg) ||\\n      input.refractedAngleDeg <= 0.1 ||\\n      input.refractedAngleDeg >= 89.9\\n    ) {\\n      fieldErrors.refractedAngleDeg =\\n        \'G\303\263c kh\303\272c x\341\272\241 \316\270t ph\341\272\243i l\341\273\233n h\306\241n 0.1\302\260 v\303\240 nh\341\273\217 h\306\241n 89.9\302\260.\';\\n    }\\n\\n    if (Object.keys(fieldErrors).length === 0) {\\n      const sinI = Math.sin(degToRad(input.incidentAngleDeg));\\n      const sinT = Math.sin(degToRad(input.refractedAngleDeg));\\n      estimatedN2 = (input.knownN1 * sinI) / sinT;\\n      previewAngleDeg = input.incidentAngleDeg;\\n      methodUsed = \'\304\220\341\273\213nh lu\341\272\255t Snell \304\221\341\272\243o (sin \316\270i / sin \316\270t)\';\\n      formulaTrace = `n\342\202\202 = n\342\202\201 \302\267 sin(${input.incidentAngleDeg.toFixed(2)}\302\260) / sin(${input.refractedAngleDeg.toFixed(2)}\302\260) = ${estimatedN2.toFixed(4)}`;\\n    }\\n  } else if (input.mode === \'CRITICAL_ANGLE\') {\\n    if (\\n      !Number.isFinite(input.measuredCriticalAngleDeg) ||\\n      input.measuredCriticalAngleDeg <= 5 ||\\n      input.measuredCriticalAngleDeg >= 89.5\\n    ) {\\n      fieldErrors.measuredCriticalAngleDeg =\\n        \'G\303\263c t\341\273\233i h\341\272\241n \316\270c ph\341\272\243i n\341\272\261m trong kho\341\272\243ng 5\302\260 \304\221\341\272\277n 89.5\302\260.\';\\n    }\\n    if (Object.keys(fieldErrors).length === 0) {\\n      estimatedN2 = input.knownN1 * Math.sin(degToRad(input.measuredCriticalAngleDeg));\\n      previewAngleDeg = Math.min(88, input.measuredCriticalAngleDeg + 2);\\n      methodUsed = \'Nh\341\272\255n d\341\272\241ng t\341\273\253 g\303\263c t\341\273\233i h\341\272\241n ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (\316\270c)\';\\n      formulaTrace = `n\342\202\202 = n\342\202\201 \302\267 sin(${input.measuredCriticalAngleDeg.toFixed(2)}\302\260) = ${estimatedN2.toFixed(4)}`;\\n    }\\n  } else if (input.mode === \'BREWSTER_ANGLE\') {\\n    if (\\n      !Number.isFinite(input.measuredBrewsterAngleDeg) ||\\n      input.measuredBrewsterAngleDeg <= 5 ||\\n      input.measuredBrewsterAngleDeg >= 85\\n    ) {\\n      fieldErrors.measuredBrewsterAngleDeg =\\n        \'G\303\263c Brewster \316\270B ph\341\272\243i n\341\272\261m trong kho\341\272\243ng 5\302\260 \304\221\341\272\277n 85\302\260.\';\\n    }\\n    if (Object.keys(fieldErrors).length === 0) {\\n      estimatedN2 = input.knownN1 * Math.tan(degToRad(input.measuredBrewsterAngleDeg));\\n      previewAngleDeg = input.measuredBrewsterAngleDeg;\\n      methodUsed = \'Nh\341\272\255n d\341\272\241ng t\341\273\253 g\303\263c ph\303\242n c\341\273\261c Brewster (tan \316\270B)\';\\n      formulaTrace = `n\342\202\202 = n\342\202\201 \302\267 tan(${input.measuredBrewsterAngleDeg.toFixed(2)}\302\260) = ${estimatedN2.toFixed(4)}`;\\n    }\\n  }\\n\\n  if (Object.keys(fieldErrors).length > 0) {\\n    return {\\n      ok: false,\\n      fieldErrors,\\n      message: \'Vui l\303\262ng ki\341\273\203m tra l\341\272\241i c\303\241c th\303\264ng s\341\273\221 \304\221o ch\306\260a h\341\273\243p l\341\273\207.\',\\n    };\\n  }\\n\\n  if (estimatedN2 < 0.99 || estimatedN2 > 5.5) {\\n    return {\\n      ok: false,\\n      fieldErrors: {\\n        general: `K\341\272\277t qu\341\272\243 suy lu\341\272\255n n\342\202\202 = ${estimatedN2.toFixed(3)} n\341\272\261m ngo\303\240i mi\341\273\201n \304\221i\341\273\207n m\303\264i chu\341\272\251n (1.00 \342\200\223 5.50). Ki\341\273\203m tra l\341\272\241i g\303\263c \304\221o ho\341\272\267c n\342\202\201.`,\\n      },\\n      message: `Gi\303\241 tr\341\273\213 suy lu\341\272\255n n\342\202\202 = ${estimatedN2.toFixed(3)} kh\303\264ng kh\341\272\243 thi v\341\273\201 m\341\272\267t v\341\272\255t l\303\275 cho \304\221i\341\273\207n m\303\264i th\303\264ng th\306\260\341\273\235ng.`,\\n    };\\n  }\\n\\n  const clampedN2 = Math.max(1.0, estimatedN2);\\n  const estimatedPermittivity2 = clampedN2 * clampedN2;\\n  const estimatedImpedance2Ohm = VACUUM_IMPEDANCE / clampedN2;\\n  const estimatedVelocity2 = SPEED_OF_LIGHT / clampedN2;\\n  const wavelengthRatio = input.knownN1 / clampedN2;\\n\\n  const physicsPreview = computeEMRefraction({\\n    n1: input.knownN1,\\n    n2: clampedN2,\\n    incidentAngleDeg: previewAngleDeg,\\n    wavelengthVacuumNm: input.wavelengthVacuumNm,\\n    polarization: input.polarization,\\n  });\\n\\n  // Rank closest physical optical/RF materials by |n - n_est|\\n  const topCandidates: MaterialCandidateMatch[] = OPTICAL_MATERIALS.map((material) => {\\n    const deltaN = Math.abs(material.refractiveIndex - clampedN2);\\n    // Gaussian-like similarity curve calibrated so deltaN = 0.01 -> ~99%, deltaN = 0.05 -> ~82%, deltaN = 0.2 -> ~20%\\n    const confidencePct = Math.round(Math.exp(-(deltaN * deltaN) / (2 * 0.09 * 0.09)) * 1000) / 10;\\n    return {\\n      material,\\n      deltaN,\\n      confidencePct,\\n    };\\n  })\\n    .sort((a, b) => a.deltaN - b.deltaN)\\n    .slice(0, 4);\\n\\n  // Cross-check measured reflectance against ideal lossless Fresnel prediction\\n  let consistencyCheck: ReflectanceConsistencyCheck | null = null;\\n  if (input.measuredReflectancePct !== null) {\\n    const predictedPct = physicsPreview.reflectanceEffective * 100;\\n    const residualPct = Math.abs(input.measuredReflectancePct - predictedPct);\\n\\n    if (residualPct <= 2.5) {\\n      consistencyCheck = {\\n        measuredPct: input.measuredReflectancePct,\\n        predictedPct,\\n        residualPct,\\n        status: \'MATCH\',\\n        diagnosis:\\n          \'Ph\303\271 h\341\273\243p cao v\341\273\233i m\303\264 h\303\254nh \304\221i\341\273\207n m\303\264i l\303\275 t\306\260\341\273\237ng kh\303\264ng t\341\273\225n hao (ph\306\260\306\241ng tr\303\254nh Fresnel chu\341\272\251n).\',\\n      };\\n    } else if (residualPct <= 8.0) {\\n      consistencyCheck = {\\n        measuredPct: input.measuredReflectancePct,\\n        predictedPct,\\n        residualPct,\\n        status: \'MODERATE_DRIFT\',\\n        diagnosis:\\n          \'C\303\263 sai l\341\273\207ch trung b\303\254nh so v\341\273\233i Fresnel l\303\275 t\306\260\341\273\237ng \342\200\224 c\303\263 th\341\273\203 do nh\303\241m b\341\273\201 m\341\272\267t, l\341\273\233p ph\341\273\247 m\341\273\217ng ho\341\272\267c l\341\273\207ch g\303\263c ph\303\242n c\341\273\261c.\',\\n      };\\n    } else {\\n      consistencyCheck = {\\n        measuredPct: input.measuredReflectancePct,\\n        predictedPct,\\n        residualPct,\\n        status: \'ANOMALY\',\\n        diagnosis:\\n          \'Ph\303\241t hi\341\273\207n b\341\272\245t th\306\260\341\273\235ng ph\341\272\243n x\341\272\241! M\303\264i tr\306\260\341\273\235ng c\303\263 th\341\273\203 l\303\240 \304\221i\341\273\207n m\303\264i c\303\263 t\341\273\225n hao (h\341\272\245p th\341\273\245 ph\341\273\251c \316\272 > 0), b\303\241n d\341\272\253n d\341\272\253n \304\221i\341\273\207n, ho\341\272\267c thi\341\272\277t l\341\272\255p sai ph\303\242n c\341\273\261c TE/TM.\',\\n      };\\n    }\\n  }\\n\\n  return {\\n    ok: true,\\n    estimatedN2: clampedN2,\\n    estimatedPermittivity2,\\n    estimatedImpedance2Ohm,\\n    estimatedVelocity2,\\n    wavelengthRatio,\\n    methodUsed,\\n    formulaTrace,\\n    physicsPreview,\\n    topCandidates,\\n    consistencyCheck,\\n  };\\n}\\n\\n/**\\n * Helper to compute expected Snell refracted angle for unit tests and presets.\\n */\\nexport function expectedSnellAngleDeg(n1: number, n2: number, thetaIDeg: number): number | null {\\n  const sinT = (n1 / n2) * Math.sin(degToRad(thetaIDeg));\\n  if (sinT > 1) return null;\\n  return radToDeg(Math.asin(sinT));\\n}\\n\",\"Description\":\"Implement inverse electromagnetic wave characteristic and material identification engine\",\"Overwrite\":true,\"TargetFile\":\"/src/physics/identifier.ts\",\"toolAction\":\"Creating inverse wave identification engine\",\"toolSummary\":\"Create inverse identifier engine\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11608530883906358090"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import test from \'node:test\';\\nimport assert from \'node:assert/strict\';\\nimport {\\n  computeEMRefraction,\\n  generateFresnelCurve,\\n  SPEED_OF_LIGHT,\\n  VACUUM_IMPEDANCE,\\n} from \'./emPhysics\';\\nimport { identifyWaveMedium } from \'./identifier\';\\n\\ntest(\'Snell law computes accurate refracted angle for Air -> BK7 Glass at 45 deg\', () => {\\n  const res = computeEMRefraction({\\n    n1: 1.0003,\\n    n2: 1.517,\\n    incidentAngleDeg: 45,\\n    wavelengthVacuumNm: 532,\\n    polarization: \'UNPOLARIZED\',\\n  });\\n\\n  assert.equal(res.isTotalInternalReflection, false);\\n  assert.ok(res.refractedAngleDeg !== null);\\n  // arcsin((1.0003 / 1.517) * sin(45\302\260)) \342\211\210 27.791\302\260\\n  assert.ok(Math.abs(res.refractedAngleDeg - 27.791) < 0.02);\\n  assert.equal(res.classification.code, \'REFRACTION_TO_DENSER\');\\n});\\n\\ntest(\'Energy conservation R + T = 1 holds across TE, TM, and Unpolarized states\', () => {\\n  const angles = [0, 15, 30, 45, 53.12, 70, 85];\\n  for (const angle of angles) {\\n    for (const pol of [\'TE\', \'TM\', \'UNPOLARIZED\'] as const) {\\n      const res = computeEMRefraction({\\n        n1: 1.0,\\n        n2: 1.5,\\n        incidentAngleDeg: angle,\\n        wavelengthVacuumNm: 550,\\n        polarization: pol,\\n      });\\n      assert.ok(Math.abs(res.reflectanceS + res.transmittanceS - 1) < 1e-12);\\n      assert.ok(Math.abs(res.reflectanceP + res.transmittanceP - 1) < 1e-12);\\n      assert.ok(Math.abs(res.reflectanceEffective + res.transmittanceEffective - 1) < 1e-12);\\n    }\\n  }\\n});\\n\\ntest(\'Brewster angle zeroes TM (p-polarized) reflectance and triggers BREWSTER_ANGLE classification\', () => {\\n  const n1 = 1.0;\\n  const n2 = 1.333;\\n  const thetaB = (Math.atan(n2 / n1) * 180) / Math.PI; // ~53.123\302\260\\n\\n  const res = computeEMRefraction({\\n    n1,\\n    n2,\\n    incidentAngleDeg: thetaB,\\n    wavelengthVacuumNm: 589,\\n    polarization: \'TM\',\\n  });\\n\\n  assert.ok(res.reflectanceP < 1e-10, `Expected Rp \342\211\210 0 at Brewster angle, got ${res.reflectanceP}`);\\n  assert.ok(Math.abs(res.transmittanceP - 1) < 1e-10);\\n  assert.equal(res.classification.code, \'BREWSTER_ANGLE\');\\n});\\n\\ntest(\'Total Internal Reflection triggers above critical angle with R = 1, T = 0, and finite evanescent depth\', () => {\\n  const res = computeEMRefraction({\\n    n1: 1.517,\\n    n2: 1.0003,\\n    incidentAngleDeg: 55,\\n    wavelengthVacuumNm: 633,\\n    polarization: \'TE\',\\n  });\\n\\n  assert.equal(res.isTotalInternalReflection, true);\\n  assert.equal(res.refractedAngleDeg, null);\\n  assert.equal(res.reflectanceS, 1);\\n  assert.equal(res.reflectanceP, 1);\\n  assert.equal(res.transmittanceEffective, 0);\\n  assert.ok(res.criticalAngleDeg !== null && Math.abs(res.criticalAngleDeg - 41.25) < 0.05);\\n  assert.ok(\\n    res.evanescentPenetrationDepthNm !== null && res.evanescentPenetrationDepthNm > 50 && res.evanescentPenetrationDepthNm < 400\\n  );\\n  assert.equal(res.classification.code, \'TOTAL_INTERNAL_REFLECTION\');\\n});\\n\\ntest(\'Wavelength compression, phase velocity, and intrinsic impedance obey EM wave equations\', () => {\\n  const res = computeEMRefraction({\\n    n1: 1.0,\\n    n2: 2.0,\\n    incidentAngleDeg: 0,\\n    wavelengthVacuumNm: 600,\\n    polarization: \'TE\',\\n  });\\n\\n  assert.equal(res.classification.code, \'NORMAL_INCIDENCE\');\\n  assert.ok(Math.abs(res.wavelength2Nm - 300) < 1e-9);\\n  assert.ok(Math.abs(res.phaseVelocity2 - SPEED_OF_LIGHT / 2) < 1e-3);\\n  assert.ok(Math.abs(res.impedance2Ohm - VACUUM_IMPEDANCE / 2) < 1e-6);\\n  // Normal incidence reflectance R = ((1-2)/(1+2))^2 = 1/9\\n  assert.ok(Math.abs(res.reflectanceEffective - 1 / 9) < 1e-10);\\n});\\n\\ntest(\'Fresnel curve generates monotonic coverage from 0 to 89.9 deg\', () => {\\n  const curve = generateFresnelCurve(1.0, 1.5, \'UNPOLARIZED\', 550, 2);\\n  assert.ok(curve.length >= 45);\\n  assert.equal(curve[0].angleDeg, 0);\\n  assert.equal(curve[curve.length - 1].angleDeg, 89.9);\\n  assert.ok(curve[curve.length - 1].Rs > 0.98);\\n});\\n\\ntest(\'Inverse identifier recovers BK7 glass from Snell angles and matches top material\', () => {\\n  const result = identifyWaveMedium({\\n    mode: \'SNELL_ANGLES\',\\n    knownN1: 1.0003,\\n    incidentAngleDeg: 45.0,\\n    refractedAngleDeg: 27.79,\\n    measuredCriticalAngleDeg: 41.2,\\n    measuredBrewsterAngleDeg: 56.6,\\n    measuredReflectancePct: 4.9,\\n    polarization: \'UNPOLARIZED\',\\n    wavelengthVacuumNm: 532,\\n  });\\n\\n  assert.equal(result.ok, true);\\n  if (result.ok) {\\n    assert.ok(Math.abs(result.estimatedN2 - 1.517) < 0.005);\\n    assert.equal(result.topCandidates[0].material.id, \'bk7\');\\n    assert.equal(result.consistencyCheck?.status, \'MATCH\');\\n  }\\n});\\n\\ntest(\'Inverse identifier detects Diamond from Brewster angle and flags reflectance anomalies\', () => {\\n  const brewsterRes = identifyWaveMedium({\\n    mode: \'BREWSTER_ANGLE\',\\n    knownN1: 1.0003,\\n    incidentAngleDeg: 67.52,\\n    refractedAngleDeg: 22.48,\\n    measuredCriticalAngleDeg: 24.4,\\n    measuredBrewsterAngleDeg: 67.52,\\n    measuredReflectancePct: 0.05,\\n    polarization: \'TM\',\\n    wavelengthVacuumNm: 589,\\n  });\\n  assert.equal(brewsterRes.ok, true);\\n  if (brewsterRes.ok) {\\n    assert.equal(brewsterRes.topCandidates[0].material.id, \'diamond\');\\n  }\\n\\n  const anomalyRes = identifyWaveMedium({\\n    mode: \'SNELL_ANGLES\',\\n    knownN1: 1.0003,\\n    incidentAngleDeg: 40,\\n    refractedAngleDeg: 28.83,\\n    measuredCriticalAngleDeg: 48.6,\\n    measuredBrewsterAngleDeg: 53.1,\\n    measuredReflectancePct: 22.0,\\n    polarization: \'UNPOLARIZED\',\\n    wavelengthVacuumNm: 633,\\n  });\\n  assert.equal(anomalyRes.ok, true);\\n  if (anomalyRes.ok) {\\n    assert.equal(anomalyRes.consistencyCheck?.status, \'ANOMALY\');\\n  }\\n});\\n\\ntest(\'Inverse identifier rejects invalid input angles without falling back silently\', () => {\\n  const errRes = identifyWaveMedium({\\n    mode: \'SNELL_ANGLES\',\\n    knownN1: 1.0,\\n    incidentAngleDeg: 95,\\n    refractedAngleDeg: 30,\\n    measuredCriticalAngleDeg: 45,\\n    measuredBrewsterAngleDeg: 55,\\n    measuredReflectancePct: null,\\n    polarization: \'UNPOLARIZED\',\\n    wavelengthVacuumNm: 532,\\n  });\\n  assert.equal(errRes.ok, false);\\n  if (!errRes.ok) {\\n    assert.ok(Boolean(errRes.fieldErrors.incidentAngleDeg));\\n  }\\n});\\n\",\"Description\":\"Write unit tests for EM refraction physics engine and inverse medium identifier\",\"Overwrite\":true,\"TargetFile\":\"/src/physics/emPhysics.test.ts\",\"toolAction\":\"Creating physics unit tests\",\"toolSummary\":\"Create physics unit tests\"}"
      original_name: "write_to_file"
    }
