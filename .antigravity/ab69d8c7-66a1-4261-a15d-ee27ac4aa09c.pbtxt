            lines {
              text: "        \'Hai m\303\264i tr\306\260\341\273\235ng c\303\263 chi\341\272\277t su\341\272\245t v\303\240 tr\341\273\237 kh\303\241ng s\303\263ng t\306\260\306\241ng \304\221\306\260\306\241ng (Z\342\202\201 \342\211\210 Z\342\202\202). S\303\263ng \304\221i\341\273\207n t\341\273\253 truy\341\273\201n th\341\272\263ng g\341\272\247n nh\306\260 ho\303\240n to\303\240n kh\303\264ng ph\341\272\243n x\341\272\241.\',"
