              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    phaseShiftPDeg,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reflectanceS,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reflectanceP,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reflectanceEffective,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    transmittanceS,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
