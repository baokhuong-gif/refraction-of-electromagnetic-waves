            }
            lines {
              text: "  ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.moveTo(x1, y1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.lineTo(x2, y2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
