      arguments_json: "{\"CodeContent\":\"import { initializeApp, getApps } from \'firebase-admin/app\';\\nimport { getAuth } from \'firebase-admin/auth\';\\nimport firebaseConfig from \'../../firebase-applet-config.json\';\\n\\nif (!getApps().length) {\\n  initializeApp({\\n    projectId: firebaseConfig.projectId,\\n  });\\n}\\n\\nexport const adminAuth = getAuth();\\n\",\"Description\":\"Initialize Firebase Admin SDK server-side using static JSON import of firebase-applet-config.json.\",\"Overwrite\":true,\"TargetFile\":\"/src/lib/firebase-admin.ts\",\"toolAction\":\"Creating Firebase Admin setup\",\"toolSummary\":\"Create src/lib/firebase-admin.ts\"}"
      original_name: "write_to_file"
