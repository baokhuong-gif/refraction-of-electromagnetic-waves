      thinking_signature: "\022\361\r\n\356\r\001i\024}\023\345`\253b\220\222\037\321o\'}\000$R\257\370\230\334\360\206\225/!\236\2156\346\320$\224\343^S\037\246}\301\204\342\0016\215\273\266\373\317k,\264\213\323\003\354I\347\255\214]\366\217\223|\001u\203X\217,\326\214r\322\036\370\373\261\377\230\264\265\354-\006K=\313\017k\345:\211\t\206\021\341\361>[\0026\245%\221\333\033.\347\323\323.\303\001\017*\177\331\332\f\234\305E\003#=\3053}\217\333\262\303\347\204\264\274=\366?&$\262\254o;\216\364\017.,\362\222\251\306\310p\355\365\001 \016IZ\'?q\271\234\372\317\206\327\005\246@\2040\320\224-\0241S)fa\265G2|\212\316G?\325\356\254c\3110\373S\020\374$!\333\367\210\206\246\252Z\300\\M\377\355~\016\"\230a\301\277U^-}\211\316\236\244\247\373x\317\352q:fIn\005i\354\230(\341\221\003\331\310\266>\275\324`$T\272\320T0\373\322%\253\210\323\332\321\356\323[\335t\266\311_\302d5\327V\000s\240\364\277_\366\370\206\266e\303V%\2079t\003\354@\363\306\t\004]I\256\252\316/:c)\321\037\243\362Ww\251\332\210v\025/\251\313<\301?\355\337\nh\315\203\036\f\316\277\254vA\346\001\232\203\242\210\207\271\202\233X\226\b\261\256\202c\260\355\254\034\214\021\037\266:Y\ft\360\340\350\3048\217\201\323\337\320\335\026>Ee\332\350\326\250\246\263\372\222\276.\227\301$~r\025\230{\325\357\314\2671I\374Wa\325\276\240\2547\"xH@e\320K\351\021>\227\211\003\004g\017\353z\036\245\251\227\321\344\221\313O\210\252:a\364\017\344(bN|\025\000m\327\272k\256\2465\276M\331C\030\200\r\353\024\242)\375\230g\226Kd\353\344\202\'\246\250\302<3\266\020\225\201g\313\363\272\254-\221^C\365$yf\r_\214\211\325\33478$\233\037\334\030\225\035\362c\033\311U\335]\274\000\335\344\317\240\3220\300\363\216d\217X{\0168y;u\272@\213/p\212\003J\351u:\242$\252O\216\021n\353\271\361J~\324\244\250\032\a)K]\340\255 \262\224TW\317\004D{\357\345\220\241v\367\a\277E\343\213n\315\3637\275\366^\234\313\356\341\372\303u\376\220L\343k\23506\370\310\230\3369\305/\312\354\227\024\354\321G|BX\353^\210\313\325\235f\347?\312)t>\360\360\231e\372\301\250Uhf\v\235\246\236+\005\205\222\254LmL\247\033\307\026\365\321:\251\217z\032\340\316W\2050\326G\234p\356\222\265\256\262\231I\033\270\306\036J-.\266#\253\2226W?\267\275j\035\301m\251UW\022\207\256\306\203\334\320\r\214.\325\326\245\0248\227 \373\033\340\312\022\273bci\025\272\366\264\313:>,\230\256\233\351\315\276{E\242\t\256\232M\n@X\270\347\340\333\021\3606!\302\033skI\005\004\313\021Y\307\003t\327NeM\372\213\253G\363O\242\343\355\26223\036\244\331\315TE\247L\005\243\211\367H\202M\327\n\360(\360]c\225S$\263\320`H;\210\264\240\016\327\225k\025\220\204\331\255\236N\262%\2136\264V\336ms\316\264\332\322E\313\av\205\235\341(W+Z\330?\337\302\226\021\3251s\177<\352X\204\275\250\024u\241\207\024\242\333\357\326\335-\357Y\322\016\320\334\235.p\235\004Uo\204\347\240\205\375\271M\"\3348\302`\213>O_6R\016\244g\233\352\276\004\325j\333^H\016O\321\272\314\aS8\311\277p\274\324\202I\374\266\023\\\261\302a\333\356\227\033Z\274\346`\354\000\371u\036\322\237\000\346\344\202l\205\373h\030\263\274<\254\251\177h\205\245x\342\355.\333\301mZ\025$\006\240J\204\201\201\353I2\005\300\323\352\177\355>\236X0k*\3331\331\213\330\327\202\256\214\223\210[[s\366;~\200i\037\321\350+\006\203\021\335\327s\240\031Gf\247#RFE\"\317d\003\274\227\207\2749\032\322\201al\355\203\331\016\230\342|\202<\r\313S\032\267eS \221\254y|2\273\003\002\030D;b\220`\352\025yU\342-\021\311e\237=\260\031\374\324\234\004\232\177\276\351V\003\254\253\371E\204\265\\QP\255K\b\221_\312\210\224\031\263q\301X\360\344\261j4zf\033\225o\365C\t9b\216\034\036\243\302M\256H{a9\006U\214\307=\244\233\a\270\'VK\301i]\025.\330~\326\336\f\037\271/\2411\025\245\374\277\022\206\017\325\347\266\273w\230V\265\324I7/n;v\001d\230\2719\272\257\005\365\356\361\320\304\215\313y\323;\362\302uvM$el\016E\237]\357u\236L\006\177(\266\216\236\240.mo\266\024\305\275g\004\000+\223O\324\325O?L]\001\232\326\351\336\033A\375K]\254Lt\273P\2301\f\334\310\375\3070\\2\376\374\302\250X\307\253(\361\364\272\207\305\'\220\367d\020\337\350k\316\255\337\217\362~c\240\321V[K\3