cError}\\n              onLoadRecord={handleLoadRecord}\\n              onDeleteRecord={(rec) => void handleDeleteRecord(rec)}\\n              onClearAll={() => void handleClearAllRecords()}\\n            />\\n          )}\\n        </main>\\n      )}\\n\\n      {/* Minimal Quiet Footer (hidden in full-bleed 3D lab so 3D occupies 100vh cleanly) */}\\n      {activeTab !== \'LAB_3D\' && (\\n        <footer className=\\\"border-t border-slate-200 bg-white py-4 px-6 text-[13px] text-slate-500\\\">\\n          <div className=\\\"max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-2\\\">\\n            <span>\\n              EMRefract Lab \302\267 M\303\264 ph\341\273\217ng \304\221\341\273\213nh lu\341\272\255t Snell, ph\306\260\306\241ng tr\303\254nh Fresnel & s\303\263ng suy gi\341\272\243m \304\221i\341\273\207n m\303\264i\\n            </span>\\n            <span className=\\\"font-mono text-xs text-slate-400\\\">\\n              n\342\202\201 sin \316\270i = n\342\202\202 sin \316\270t \302\267 Z = Z\342\202\200 / n \302\267 \316\274r = 1\\n            </span>\\n          </div>\\n        </footer>\\n      )}\",\"StartLine\":605,\"TargetContent\":\"                <CharacteristicsPanel physics={physics} />\\n\\n                <FresnelChart\\n                  physics={physics}\\n                  polarization={polarization}\\n                  wavelengthVacuumNm={wavelengthVacuumNm}\\n                  material1Label={material1Label}\\n                  material2Label={material2Label}\\n                  onSelectAngle={(deg) => {\\n                    setActiveScenarioId(null);\\n                    setIncidentAngleDeg(deg);\\n                  }}\\n                />\\n              </div>\\n            </div>\\n          )}\\n\\n          {activeTab === \'IDENTIFIER\' && (\\n            <InverseIdentifierView\\n              currentPhysics={physics}\\n              currentPolarization={polarization}\\n              currentWavelengthNm={wavelengthVacuumNm}\\n              onApplyToSimulator={handleApplyIdentified}\\n            />\\n          )}\\n\\n          {activeTab === \'SEARCH\' && (\\n            <MaterialSearchView\\n              currentN1={n1}\\n              currentN2={n2}\\n              wavelengthVacuumNm={wavelengthVacuumNm}\\n              onApplyRefractiveIndex={handleApplySearchedN2}\\n            />\\n          )}\\n\\n          {activeTab === \'LOG\' && (\\n            <MeasurementLogView\\n              records={records}\\n              syncLoading={syncLoading}\\n              syncError={syncError}\\n              onLoadRecord={handleLoadRecord}\\n              onDeleteRecord={(rec) => void handleDeleteRecord(rec)}\\n              onClearAll={() => void handleClearAllRecords()}\\n            />\\n          )}\\n        </main>\\n      )}\\n\\n      {/* Minimal Quiet Footer (hidden in full-bleed 3D lab so 3D occupies 100vh cleanly) */}\\n      {activeTab !== \'LAB_3D\' && (\\n        <footer className=\\\"border-t border-slate-200 bg-white py-3.5 px-6 text-xs text-slate-500\\\">\\n          <div className=\\\"max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-2\\\">\\n            <span>\\n              EMRefract Lab \302\267 M\303\264 ph\341\273\217ng \304\221\341\273\213nh lu\341\272\255t Snell, ph\306\260\306\241ng tr\303\254nh Fresnel & s\303\263ng suy gi\341\272\243m \304\221i\341\273\207n m\303\264i\\n            </span>\\n            <span className=\\\"font-mono text-slate-400\\\">\\n              n\342\202\201 sin \316\270i = n\342\202\202 sin \316\270t \302\267 Z = Z\342\202\200 / n \302\267 \316\274r = 1\\n            </span>\\n          </div>\\n        </footer>\\n      )}\"}],\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Integrating AI tab and typography in App.tsx\",\"toolSummary\":\"Update App.tsx navigation and type scale\"}"
