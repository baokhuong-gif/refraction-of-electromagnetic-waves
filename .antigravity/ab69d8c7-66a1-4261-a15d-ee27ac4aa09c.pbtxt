      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Fix mobile header navigation clipping and prioritize WaveCanvas above ControlDeck on mobile screens\",\"EndLine\":295,\"Instruction\":\"Show desktop nav in header (hidden md:flex), add non-sticky mobile tab strip inside main (md:hidden), and order WaveCanvas first on mobile\",\"ReplacementContent\":\"          {/* Zone 2: Clean single-line text navigation links (desktop) */}\\n          <nav\\n            aria-label=\\\"\304\220i\341\273\201u h\306\260\341\273\233ng ch\303\255nh\\\"\\n            className=\\\"hidden md:flex items-center gap-7 text-sm font-medium\\\"\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              aria-current={activeTab === \'SIMULATOR\' ? \'page\' : undefined}\\n              onClick={() => setActiveTab(\'SIMULATOR\')}\\n              className={`py-1 border-b-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                activeTab === \'SIMULATOR\'\\n                  ? \'border-sky-600 text-slate-900\'\\n                  : \'border-transparent text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              M\303\264 ph\341\273\217ng s\303\263ng\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              aria-current={activeTab === \'IDENTIFIER\' ? \'page\' : undefined}\\n              onClick={() => setActiveTab(\'IDENTIFIER\')}\\n              className={`py-1 border-b-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                activeTab === \'IDENTIFIER\'\\n                  ? \'border-sky-600 text-slate-900\'\\n                  : \'border-transparent text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              Nh\341\272\255n d\341\272\241ng ng\306\260\341\273\243c\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              aria-current={activeTab === \'LOG\' ? \'page\' : undefined}\\n              onClick={() => setActiveTab(\'LOG\')}\\n              className={`py-1 border-b-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                activeTab === \'LOG\'\\n                  ? \'border-sky-600 text-slate-900\'\\n                  : \'border-transparent text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              B\341\272\243ng ph\303\251p \304\221o ({records.length})\\n            </button>\\n          </nav>\\n\\n          {/* Zone 3: 1 primary action */}\\n          <div className=\\\"flex items-center shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleRecordMeasurement}\\n              className=\\\"px-3.5 py-2 text-xs font-semibold text-white bg-sky-700 hover:bg-sky-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n            >\\n              Ghi nh\341\272\255n ph\303\251p \304\221o\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Subtle inline feedback strip when recording a measurement */}\\n      {justRecordedMsg && (\\n        <div\\n          role=\\\"status\\\"\\n          aria-live=\\\"polite\\\"\\n          className=\\\"bg-emerald-50 border-b border-emerald-200 text-emerald-900 text-xs px-6 py-2\\\"\\n        >\\n          <div className=\\\"max-w-[1440px] mx-auto flex items-center justify-between\\\">\\n            <span>\342\227\217 {justRecordedMsg}</span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setActiveTab(\'LOG\')}\\n              className=\\\"font-semibold underline hover:text-emerald-700 cursor-pointer\\\"\\n            >\\n              Xem b\341\272\243ng ph\303\251p \304\221o\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Main Workspace */}\\n      <main className=\\\"flex-1 max-w-[1440px] w-full mx-auto px-4 sm:px-6 py-4 sm:py-6\\\">\\n        {/* Non-sticky mobile navigation tabs (keeps sticky header strictly 1-row and <= 7% mobile viewport height) */}\\n        <nav\\n          aria-label=\\\"\304\220i\341\273\201u h\306\260\341\273\233ng di \304\221\341\273\231ng\\\"\\n          className=\\\"md:hidden grid grid-cols-3 gap-1 p-1 mb-4 bg-slate-200/70 rounded-lg\\\"\\n        >\\n          <button\\n            type=\\\"button\\\"\\n            aria-current={activeTab === \'SIMULATOR\' ? \'page\' : undefined}\\n            onClick={() => setActiveTab(\'SIMULATOR\')}\\n            className={`py-2 px-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n              activeTab === \'SIMULATOR\'\\n                ? \'bg-white text-slate-900 shadow-xs\'\\n                : \'text-slate-600\'\\n            }`}\\n          >\\n            M\303\264 ph\341\273\217ng\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            aria-current={activeTab === \'IDENTIFIER\' ? \'page\' : undefined}\\n            onClick={() => setActiveTab(\'IDENTIFIER\')}\\n            className={`py-2 px-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n              activeTab === \'IDENTIFIER\'\\n                ? \'bg-white text-slate-900 shadow-xs\'\\n                : \'text-slate-600\'\\n            }`}\\n          >\\n            Nh\341\272\255n d\341\272\241ng\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            aria-current={activeTab === \'LOG\' ? \'page\' : undefined}\\n            onClick={() => setActiveTab(\'LOG\')}\\n            className={`py-2 px-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n              activeTab === \'LOG\'\\n                ? \'bg-white text-slate-900 shadow-xs\'\\n                : \'text-slate-600\'\\n            }`}\\n          >\\n            Ph\303\251p \304\221o ({records.length})\\n          </button>\\n        </nav>\\n\\n        {activeTab === \'SIMULATOR\' && (\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-[336px_minmax(0,1fr)] gap-6 items-start\\\">\\n            <div className=\\\"order-2 lg:order-1\\\">\\n              <ControlDeck\\n                n1={n1}\\n                n2={n2}\\n                material1Id={material1Id}\\n                material2Id={material2Id}\\n                incidentAngleDeg={incidentAngleDeg}\\n                polarization={polarization}\\n                wavelengthVacuumNm={wavelengthVacuumNm}\\n                band={band}\\n                activeScenarioId={activeScenarioId}\\n                physics={physics}\\n                onSelectScenario={handleSelectScenario}\\n                onChangeMaterial1={(id, nextN) => {\\n                  setActiveScenarioId(null);\\n                  setMaterial1Id(id);\\n                  setN1(nextN);\\n                }}\\n                onChangeMaterial2={(id, nextN) => {\\n                  setActiveScenarioId(null);\\n                  setMaterial2Id(id);\\n                  setN2(nextN);\\n                }}\\n                onSwapMedia={handleSwapMedia}\\n                onChangeIncidentAngle={(deg) => {\\n                  setActiveScenarioId(null);\\n                  setIncidentAngleDeg(deg);\\n                }}\\n                onChangePolarization={(pol) => {\\n                  setActiveScenarioId(null);\\n                  setPolarization(pol);\\n                }}\\n                onChangeBand={handleChangeBand}\\n                onChangeWavelengthNm={(nm) => {\\n                  setActiveScenarioId(null);\\n                  setWavelengthVacuumNm(nm);\\n                }}\\n              />\\n            </div>\\n\\n            <div className=\\\"order-1 lg:order-2 space-y-5 min-w-0\\\">\",\"StartLine\":176,\"TargetContent\":\"          {/* Zone 2: Clean single-line text navigation links */}\\n          <nav\\n            aria-label=\\\"\304\2