    content: "  };\n\n  // Resize observer + animation loop mounted once\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    const container = containerRef.current;\n    if (!canvas || !container) return;\n\n    const resizeCanvas = () => {\n      const rect = container.getBoundingClientRect();\n      const dpr = Math.min(window.devicePixelRatio || 1, 2);\n      canvas.width = Math.max(300, Math.floor(rect.width * dpr));\n      canvas.height = Math.max(340, Math.floor(rect.height * dpr));\n      drawFrame();\n    };\n\n    resizeCanvas();\n    const observer = new ResizeObserver(resizeCanvas);\n    observer.observe(container);\n\n    const prefersReducedMotion =\n      typeof window !== \'undefined\' &&\n      window.matchMedia &&\n      window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n\n    let rafId = 0;\n    let lastTs = performance.now();\n\n    const tick = (now: number) => {\n      const dt = Math.min(0.05, (now - lastTs) / 1000);\n      lastTs = now;\n      if (isPlayingRef.current && !prefersReducedMotion) {\n        phaseRef.current = (phaseRef.current + dt * 4.2 * speedRef.current) % (Math.PI * 200);\n      }\n      drawFrame();\n      rafId = requestAnimationFrame(tick);\n    };\n\n    rafId = requestAnimationFrame(tick);\n\n    return () => {\n      cancelAnimationFrame(rafId);\n      observer.disconnect();\n    };\n  }, []);\n\n  // Re-draw immediately on prop changes when paused\n  useEffect(() => {\n    drawFrame();\n  }, [physics, polarization, wavelengthVacuumNm, material1Label, material2Label, layers]);\n\n  const updateAngleFromPointer = (clientX: number, clientY: number) => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const rect = canvas.getBoundingClientRect();\n    const x = clientX - rect.left;\n    const y = clientY - rect.top;\n    const cx = rect.width * 0.5;\n    const cy = rect.height * 0.5;\n\n    const dx = cx - x; // positive to the left of normal\n    const dy = cy - y; // positive above interface\n    if (dy < 2) {\n      onChangeIncidentAngle(89.0);\n      return;\n    }\n    const clampedDx = Math.max(0, dx);\n    const angle = radToDeg(Math.atan2(clampedDx, dy));\n    onChangeIncidentAngle(Math.round(clamp(angle, 0, 89.5) * 10) / 10);\n  };\n\n  const handlePointerDown = (e: React.PointerEvent<HTMLCanvasElement>) => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const rect = canvas.getBoundingClientRect();\n    const y = e.clientY - rect.top;\n    // Allow dragging anywhere in Medium 1 to aim the incident wave\n    if (y <= rect.height * 0.52) {\n      setIsDraggingSource(true);\n      e.currentTarget.setPointerCapture(e.pointerId);\n      updateAngleFromPointer(e.clientX, e.clientY);\n    }\n  };\n\n  const handlePointerMove = (e: React.PointerEvent<HTMLCanvasElement>) => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const rect = canvas.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    const cx = rect.width * 0.5;\n    const cy = rect.height * 0.5;\n\n    const normX = (x - cx) / (rect.width * 0.5);\n    const normZ = (y - cy) / (rect.height * 0.5);\n    const angleFromNormalDeg = radToDeg(Math.atan2(Math.abs(x - cx), Math.max(1, Math.abs(y - cy))));\n\n    setProbe({\n      active: true,\n      xPx: x,\n      yPx: y,\n      medium: y <= cy ? 1 : 2,\n      normX,\n      normZ,\n      angleFromNormalDeg,\n    });\n\n    if (isDraggingSource) {\n      updateAngleFromPointer(e.clientX, e.clientY);\n    }\n  };\n\n  const handlePointerUp = (e: React.PointerEvent<HTMLCanvasElement>) => {\n    if (isDraggingSource) {\n      setIsDraggingSource(false);\n      if (e.currentTarget.hasPointerCapture(e.pointerId)) {\n        e.currentTarget.releasePointerCapture(e.pointerId);\n      }\n    }\n  };\n\n  const handleStepFrame = () => {\n    setIsPlaying(false);\n    phaseRef.current += Math.PI / 4;\n    drawFrame();\n  };\n\n  const toggleLayer = (key: keyof WaveLayerToggles) => {\n    setLayers((prev) => ({ ...prev, [key]: !prev[key] }));\n  };\n\n  return (\n    <section\n      aria-label=\"S\303\242n kh\341\272\245u m\303\264 ph\341\273\217ng truy\341\273\201n s\303\263ng \304\221i\341\273\207n t\341\273\253\"\n      className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\"\n    >\n      {/* Compact Instrument Toolbar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 border-b border-slate-200 bg-slate-50/70\">\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => setIsPlaying((v) => !v)}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-800 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            {isPlaying ? \'T\341\272\241m d\341\273\253ng\' : \'Ph\303\241t s\303\263ng\'}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handleStepFrame}\n            aria-label=\"B\306\260\341\273\233c khung s\303\263ng k\341\272\277 ti\341\272\277p\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <StepForward className=\"w-3.5 h-3.5\" />\n            B\306\260\341\273\233c pha\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onResetSimulation}\n            aria-label=\"\304\220\341\272\267t l\341\272\241i tham s\341\273\221 m\303\264 ph\341\273\217ng\"\n            className=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-md bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            \304\220\341\272\267t l\341\272\241i\n          </button>\n\n          <div className=\"hidden sm:flex items-center gap-1.5 pl-2 border-l border-slate-200 text-xs text-slate-600\">\n            <label htmlFor=\"wave-speed-select\" className=\"whitespace-nowrap\">\n              T\341\273\221c \304\221\341\273\231:\n            </label>\n            <select\n              id=\"wave-speed-select\"\n              value={speedMultiplier}\n              onChange={(e) => setSpeedMultiplier(Number(e.target.value))}\n              className=\"bg-white border border-slate-200 rounded px-1.5 py-1 text-xs font-mono text-slate-800\"\n            >\n              <option value={0.5}>0.5\303\227</option>\n              <option value={1}>1.0\303\227</option>\n              <option value={1.8}>1.8\303\227</option>\n            </select>\n          </div>\n        </div>\n\n        {/* Layer Visibility Toggles */}\n        <div\n          role=\"group\"\n          aria-label=\"L\341\273\233p hi\341\273\203n th\341\273\213 m\303\264 ph\341\273\217ng\"\n          className=\"flex flex-wrap items-center gap-1 bg-slate-100 p-1 rounded-lg\"\n        >\n          {(\n            [\n              [\'wavefronts\', \'S\303\263ng ph\341\272\263ng\'],\n              [\'rays\', \'Tia s\303\263ng\'],\n              [\'eField\', \'Tr\306\260\341\273\235ng E\'],\n              [\'angles\', \'G\303\263c & Ph\303\241p tuy\341\272\277n\'],\n            ] as const\n          ).map(([key, label]) => (\n            <button\n              key={key}\n              type=\"button\"\n              aria-pressed={layers[key]}\n              onClick={() => toggleLayer(key)}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                layers[key]\n                  ? \'bg-white text-slate-900 shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              {label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main Canvas Stage */}\n      <div\n        ref={containerRef}\n        className=\"relative w-full h-[380px] sm:h-[430px] select-none bg-white\"\n        data-testid=\"em-wave-canvas-container\"\n        data-regime={physics.classification.code}\n      >\n        <canvas\n          ref={canvasRef}\n          data-testid=\"em-wave-canvas\"\n          onPointerDown={handlePointerDown}\n          onPointerMove={handlePointerMove}\n          onPointerUp={handlePointerUp}\n          onPointerLeave={() => {\n            setProbe((prev) => ({ ...prev, active: false }));\n          }}\n          className={`w-full h-full block ${\n            isDraggingSource ? \'cursor-grabbing\' : \'cursor-crosshair\'\n          }`}\n          aria-label=\"Bi\341\273\203u \304\221\341\273\223 tr\341\273\261c quan kh\303\272c x\341\272\241 v\303\240 ph\341\272\243n x\341\272\241 s\303\263ng \304\221i\341\273\207n t\341\273\253 qua m\341\272\267t ph\303\242n c\303\241ch hai m\303\264i tr\306\260\341\273\235ng\"\n        />\n\n        {/* Subtle Bottom Coordinate Probe & Interaction Hint */}\n        <div className=\"pointer-events-none absolute bottom-2.5 left-4 right-4 flex items-center justify-between text-[11px] font-mono text-slate-500\">\n          <span>K\303\251o ngu\341\273\223n ph\303\241t \341\273\237 m\303\264i tr\306\260\341\273\235ng 1 \304\221\341\273\203 thay \304\221\341\273\225i g\303\263c t\341\273\233i \316\270i tr\341\273\261c ti\341\272\277p</span>\n          {probe.active && (\n            <span className=\"hidden sm:inline bg-white/90 px-2 py-0.5 rounded border border-slate-200 tabular-nums text-slate-700\">\n              M\303\264i tr\306\260\341\273\235ng {probe.medium} \302\267 x={probe.normX.toFixed(2)} \302\267 z={probe.normZ.toFixed(2)} \302\267 \342\210\240N=\n              {probe.angleFromNormalDeg.toFixed(1)}\302\260\n            </span>\n          )}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nfunction drawRayArrow(\n  ctx: CanvasRenderingContext2D,\n  x1: number,\n  y1: number,\n  x2: number,\n  y2: number,\n  color: string,\n  lineWidth: number,\n  alpha: number\n) {\n  ctx.save();\n  ctx.strokeStyle = hexToRgba(color, alpha);\n  ctx.fillStyle = hexToRgba(color, alpha);\n  ctx.lineWidth = lineWidth;\n  ctx.lineCap = \'round\';\n\n  ctx.beginPath();\n  ctx.moveTo(x1, y1);\n  ctx.lineTo(x2, y2);\n  ctx.stroke();\n\n  // Midpoint directional arrow\n  const mx = x1 + (x2 - x1) * 0.56;\n  const my = y1 + (y2 - y1) * 0.56;\n  const angle = Math.atan2(y2 - y1, x2 - x1);\n  const headLen = 9;\n\n  ctx.beginPath();\n  ctx.moveTo(mx, my);\n  ctx.lineTo(\n    mx - headLen * Math.cos(angle - Math.PI / 6),\n    my - headLen * Math.sin(angle - Math.PI / 6)\n  );\n  ctx.lineTo(\n    mx - headLen * Math.cos(angle + Math.PI / 6),\n    my - headLen * Math.sin(angle + Math.PI / 6)\n  );\n  ctx.closePath();\n  ctx.fill();\n  ctx.restore();\n}\n\nfunction hexToRgba(hex: string, alpha: number): string {\n  const clean = hex.replace(\'#\', \'\');\n  const full =\n    clean.length === 3\n      ? clean\n          .split(\'\')\n          .map((c) => c + c)\n          .join(\'\')\n      : clean;\n  const num = parseInt(full, 16);\n  const r = (num >> 16) & 255;\n  const g = (num >> 8) & 255;\n  const b = num & 255;\n  return `rgba(${r}, ${g}, ${b}, ${clamp(alpha, 0, 1).toFixed(3)})`;\n}\n"
