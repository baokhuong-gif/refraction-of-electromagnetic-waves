              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Draw crisp sinusoidal wavefront crests & troughs"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const stepPx = 5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      for (let s = 0; s <= length; s += stepPx) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const distFromOrigin = reverseTravel ? -s : s;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const val = Math.cos(k * distFromOrigin - phase + phaseOffsetRad);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
