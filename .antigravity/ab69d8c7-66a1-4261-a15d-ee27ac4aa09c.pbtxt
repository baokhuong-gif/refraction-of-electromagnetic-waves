</div>\\n      )}\\n\\n      {/* Non-sticky mobile/tablet navigation tabs with horizontal scroll so labels never squish */}\\n      <div className=\\\"lg:hidden px-4 pt-3 bg-slate-50\\\">\\n        <nav\\n          aria-label=\\\"\304\220i\341\273\201u h\306\260\341\273\233ng di \304\221\341\273\231ng\\\"\\n          className=\\\"flex items-center gap-1 p-1 bg-slate-200/75 rounded-lg overflow-x-auto\\\"\\n        >\\n          {navItems.map((item) => (\\n            <button\\n              key={item.id}\\n              type=\\\"button\\\"\\n              aria-current={activeTab === item.id ? \'page\' : undefined}\\n              onClick={() => setActiveTab(item.id)}\\n              className={`py-2 px-3 text-[13px] font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                activeTab === item.id ? \'bg-white text-slate-950 font-semibold shadow-xs\' : \'text-slate-600\'\\n              }`}\\n            >\\n              {item.mobileLabel}\\n            </button>\\n          ))}\\n        </nav>\\n      </div>\\n\\n      {/* Full-bleed 3D Optical Lab Viewport */}\\n      {activeTab === \'LAB_3D\' ? (\",\"StartLine\":377,\"TargetContent\":\"  const handleApplySearchedN2 = (nextN2: number) => {\\n    setActiveScenarioId(null);\\n    setN2(nextN2);\\n    setMaterial2Id(\'custom\');\\n    setActiveTab(\'SIMULATOR\');\\n    showBanner(`\304\220\303\243 n\341\272\241p chi\341\272\277t su\341\272\245t n\342\202\202 = ${nextN2.toFixed(4)} t\341\273\253 Google Search v\303\240o m\303\264 ph\341\273\217ng.`, false);\\n  };\\n\\n  const navItems: Array<{ id: ActiveTab; desktopLabel: string; mobileLabel: string }> = [\\n    { id: \'SIMULATOR\', desktopLabel: \'M\303\264 ph\341\273\217ng 2D\', mobileLabel: \'2D\' },\\n    { id: \'LAB_3D\', desktopLabel: \'Ph\303\262ng lab 3D\', mobileLabel: \'3D\' },\\n    { id: \'IDENTIFIER\', desktopLabel: \'Nh\341\272\255n d\341\272\241ng ng\306\260\341\273\243c\', mobileLabel: \'Nh\341\272\255n d\3