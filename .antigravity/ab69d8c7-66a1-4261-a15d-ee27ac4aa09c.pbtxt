              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 3. Refracted (or evanescent) wavefront nodes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _color.setHex(p.isTotalInternalReflection ? 0xd97706 : 0x059669);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
