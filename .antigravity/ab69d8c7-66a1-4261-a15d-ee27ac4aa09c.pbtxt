      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add unit test for AnimatedLabSlider percentage mapping helper\",\"EndLine\":207,\"Instruction\":\"Add test verifying computeSliderPercent clamps and normalizes values accurately\",\"ReplacementContent\":\"  const tirMeta = buildPdfReportMetadata(tirRes, new Date(2026, 10, 25, 10, 15));\\n  assert.equal(tirMeta.refractedAngleText, \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (TIR)\');\\n});\\n\\ntest(\'Animated slider percentage calculation normalizes and clamps bounds accurately\', async () => {\\n  const { computeSliderPercent } = await import(\'../components/AnimatedLabSlider\');\\n  assert.equal(computeSliderPercent(45, 0, 90), 50);\\n  assert.equal(computeSliderPercent(1.0, 1.0, 3.8), 0);\\n  assert.equal(computeSliderPercent(3.8, 1.0, 3.8), 100);\\n  assert.equal(computeSliderPercent(5.0, 1.0, 3.8), 100);\\n  assert.equal(computeSliderPercent(-10, 0, 90), 0);\\n});\",\"StartLine\":203,\"TargetContent\":\"  const tirMeta = buildPdfReportMetadata(tirRes, new Date(2026, 10, 25, 10, 15));\\n  assert.equal(tirMeta.refractedAngleText, \'Ph\341\272\243n x\341\272\241 to\303\240n ph\341\272\247n (TIR)\');\\n});\",\"TargetFile\":\"/src/physics/emPhysics.test.ts\",\"toolAction\":\"Adding slider calculation unit test\",\"toolSummary\":\"Add slider unit test\"}"
      original_name: "replace_file_content"
    }
