  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useCallback, useEffect, useState } from \'react\';\nimport {\n  ArrowRight,\n  ExternalLink,\n  Globe,\n  History,\n  Loader2,\n  Search,\n  Sparkles,\n} from \'lucide-react\';\nimport { useAuth } from \'../contexts/AuthContext\';\nimport { formatWavelength } from \'../physics/emPhysics\';\n\ninterface GroundedSource {\n  title: string;\n  uri: string;\n}\n\ninterface SearchResultPayload {\n  answer: string;\n  suggestedN: number | null;\n  sources: GroundedSource[];\n  searchQueries: string[];\n}\n\ninterface SavedSearchLogItem {\n  id: number;\n  query: string;\n  summary: string;\n  suggestedN: number | null;\n  wavelengthNm: number | null;\n  sources: GroundedSource[];\n  createdAt: string;\n}\n\ninterface MaterialSearchViewProps {\n  currentN1: number;\n  currentN2: number;\n  wavelengthVacuumNm: number;\n  onApplyRefractiveIndex: (n2: number, labelHint?: string) => void;\n}\n\nconst EXAMPLE_QUERIES = [\n  \'Chi\341\272\277t su\341\272\245t k\303\255nh quang h\341\273\215c N-BK7 v\303\240 \304\221\341\273\231 t\303\241n s\341\272\257c \341\273\237 b\306\260\341\273\233c s\303\263ng 532 nm\',\n  \'H\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i v\303\240 chi\341\272\277t su\341\272\245t Silicon \304\221\306\241n tinh th\341\273\203 \341\273\237 b\304\203ng vi s\303\263ng 10 GHz\',\n  \'Chi\341\272\277t su\341\272\245t n\306\260\341\273\233c bi\341\273\203n theo \304\221\341\273\231 m\341\272\267n v\303\240 nhi\341\273\207t \304\221\341\273\231 trong v\303\271ng \303\241nh s\303\241ng kh\341\272\243 ki\341\272\277n\',\n  \'Chi\341\272\277t su\341\272\245t tinh th\341\273\203 Sapphire (Al2O3) v\303\240 \341\273\251ng d\341\273\245ng c\341\273\255a s\341\273\225 quang h\341\273\215c\',\n];\n\nexport const MaterialSearchView: React.FC<MaterialSearchViewProps> = ({\n  currentN1,\n  currentN2,\n  wavelengthVacuumNm,\n  onApplyRefractiveIndex,\n}) => {\n  const { user, getIdToken } = useAuth();\n  const [query, setQuery] = useState(EXAMPLE_QUERIES[0]);\n  const [loading, setLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [result, setResult] = useState<SearchResultPayload | null>(null);\n  const [history, setHistory] = useState<SavedSearchLogItem[]>([]);\n\n  const loadHistory = useCallback(async () => {\n    if (!user) {\n      setHistory([]);\n      return;\n    }\n    const token = await getIdToken();\n    if (!token) return;\n    try {\n      const res = await fetch(\'/api/search/history\', {\n        headers: { Authorization: `Bearer ${token}` },\n      });\n      if (!res.ok) return;\n      const data = (await res.json()) as { history?: SavedSearchLogItem[] };\n      if (Array.isArray(data.history)) {\n        setHistory(data.history);\n      }\n    } catch {\n      // Non-fatal history refresh failure\n    }\n  }, [user, getIdToken]);\n\n  useEffect(() => {\n    void loadHistory();\n  }, [loadHistory]);\n\n  const executeSearch = async (targetQuery: string) => {\n    const trimmed = targetQuery.trim();\n    if (trimmed.length < 2) {\n      setErrorMsg(\'Vui l\303\262ng nh\341\272\255p t\341\273\253 kh\303\263a v\341\272\255t li\341\273\207u ho\341\272\267c hi\341\273\207n t\306\260\341\273\243ng quang h\341\273\215c c\341\272\247n tra c\341\273\251u.\');\n      return;\n    }\n\n    setLoading(true);\n    setErrorMsg(null);\n    try {\n      const headers: Record<string, string> = {\n        \'Content-Type\': \'application/json\',\n      };\n      const token = await getIdToken();\n      if (token) {\n        headers.Authorization = `Bearer ${token}`;\n      }\n\n      const response = await fetch(\'/api/search/material\', {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({\n          query: trimmed,\n          wavelengthNm: wavelengthVacuumNm,\n          currentN1,\n          currentN2,\n        }),\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data?.error || \'Kh\303\264ng th\341\273\203 ho\303\240n t\341\272\245t tra c\341\273\251u d\341\273\257 li\341\273\207u l\303\272c n\303\240y.\');\n      }\n\n      setResult(data as SearchResultPayload);\n      if (user) {\n        void loadHistory();\n      }\n    } catch (err: unknown) {\n      setErrorMsg(\n        err instanceof Error ? err.message : \'\304\220\303\243 x\341\272\243y ra l\341\273\227i khi tra c\341\273\251u d\341\273\257 li\341\273\207u tr\341\273\261c tuy\341\272\277n.\'\n      );\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    void executeSearch(query);\n  };\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n      {/* Left: Search Form & Preset Research Queries */}\n      <section\n        aria-label=\"Tra c\341\273\251u d\341\273\257 li\341\273\207u v\341\272\255t li\341\273\207u \304\221i\341\273\207n m\303\264i qua Google Search\"\n        className=\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 space-y-5\"\n      >\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <Globe className=\"w-4 h-4 text-sky-700\" aria-hidden=\"true\" />\n            <h1 className=\"text-lg font-semibold text-slate-900\">\n              Tra c\341\273\251u v\341\272\255t li\341\273\207u & d\341\273\257 li\341\273\207u quang h\341\273\215c\n            </h1>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1.5 leading-relaxed\">\n            T\303\254m ki\341\272\277m th\303\264ng s\341\273\221 chi\341\272\277t su\341\272\245t theo b\306\260\341\273\233c s\303\263ng, h\341\272\261ng s\341\273\221 \304\221i\341\273\207n m\303\264i v\303\240 t\303\240i li\341\273\207u th\341\273\261c nghi\341\273\207m\n            m\341\273\233i nh\341\272\245t t\341\273\253 Google Search \304\221\341\273\203 n\341\272\241p tr\341\273\261c ti\341\272\277p v\303\240o b\341\273\231 m\303\264 ph\341\273\217ng.\n          </p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-3\">\n          <div>\n            <label htmlFor=\"material-search-input\" className=\"block text-xs font-medium text-slate-700 mb-1.5\">\n              C\303\242u h\341\273\217i ho\341\272\267c t\303\252n v\341\272\255t li\341\273\207u c\341\272\247n tra c\341\273\251u\n            </label>\n            <textarea\n              id=\"material-search-input\"\n              rows={3}\n              value={query}\n              onChange={(e) => setQuery(e.target.value)}\n              placeholder=\"V\303\255 d\341\273\245: Chi\341\272\277t su\341\272\245t th\341\272\241ch anh n\303\263ng ch\341\272\243y SiO2 \341\273\237 1550 nm...\"\n              className=\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none resize-none\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2\">\n            <span>B\341\273\221i c\341\272\243nh hi\341\273\207n t\341\272\241i:</span>\n            <span className=\"tabular-nums text-slate-700\">\n              \316\273\342\202\200={formatWavelength(wavelengthVacuumNm)} \302\267 n\342\202\201={currentN1.toFixed(3)} \302\267 n\342\202\202=\n              {currentN2.toFixed(3)}\n            </span>\n          </div>\n\n          {errorMsg && (\n            <div\n              role=\"alert\"\n              className=\"rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-800\"\n            >\n              {errorMsg}\n            </div>\n          )}\n\n          <button\n            type=\"submit\"\n            disabled={loading}\n            className=\"w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 text-sm font-semibold text-white bg-sky-700 hover:bg-sky-800 disabled:opacity-60 rounded-lg transition-colors cursor-pointer\"\n          >\n            {loading ? (\n              <>\n                <Loader2 className=\"w-4 h-4 animate-spin\" />\n                \304\220ang t\303\254m ki\341\272\277m ngu\341\273\223n x\303\241c th\341\273\261c...\n              </>\n            ) : (\n              <>\n                <Search className=\"w-4 h-4\" />\n                Tra c\341\273\251u Google Search\n              </>\n            )}\n          </button>\n        </form>\n\n        <div className=\"pt-4 border-t border-slate-200 space-y-2\">\n          <div className=\"text-xs font-semibold text-slate-800\">G\341\273\243i \303\275 tra c\341\273\251u nhanh</div>\n          <div className=\"space-y-1.5\">\n            {EXAMPLE_QUERIES.map((example) => (\n              <button\n                key={example}\n                type=\"button\"\n                disabled={loading}\n                onClick={() => {\n                  setQuery(example);\n                  void executeSearch(example);\n                }}\n                className=\"w-full text-left px-3 py-2 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-sky-50/70 hover:border-sky-300 text-xs text-slate-700 transition-colors cursor-pointer\"\n              >\n                {example}\n              </button>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Right: Grounded Answer, Extracted Refractive Index CTA, Sources & History */}\n      <section\n        aria-label=\"K\341\272\277t qu\341\272\243 tra c\341\273\251u v\303\240 ngu\341\273\223n tham kh\341\272\243o\"\n        className=\"lg:col-span-7 space-y-5\"\n      >\n        {!result ? (\n          <div className=\"bg-white border border-slate-200 rounded-xl p-8 text-center\">\n            <Sparkles className=\"w-7 h-7 text-sky-600 mx-auto mb-3\" aria-hidden=\"true\" />\n            <h2 className=\"text-sm font-semibold text-slate-900\">\n              S\341\272\265n s\303\240ng tra c\341\273\251u d\341\273\257 li\341\273\207u quang h\341\273\215c & \304\221i\341\273\207n m\303\264i tr\341\273\261c tuy\341\272\277n\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-1.5 max-w-md mx-auto leading-relaxed\">\n              Nh\341\272\255p t\303\252n v\341\272\255t li\341\273\207u, th\341\273\247y tinh quang h\341\273\215c, tinh th\341\273\203 ho\341\272\267c b\306\260\341\273\233c s\303\263ng c\341\273\245 th\341\273\203 \304\221\341\273\203 nh\341\272\255n th\303\264ng s\341\273\221\n              chi\341\272\277t su\341\272\245t m\341\273\233i nh\341\272\245t k\303\250m danh s\303\241ch ngu\341\273\223n web \304\221\341\273\221i ch\341\273\251ng.\n            </p>\n          </div>\n        ) : (\n          <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden\">\n            <div className=\"px-6 py-4 border-b border-slate-200 bg-slate-50/80 flex flex-wrap items-center justify-between gap-3\">\n              <div>\n                <h2 className=\"text-sm font-semibold text-slate-900\">\n                  K\341\272\277t qu\341\272\243 t\341\273\225ng h\341\273\243p t\341\273\253 Google Search\n                </h2>\n                {result.searchQueries.length > 0 && (\n                  <p className=\"text-[11px] font-mono text-slate-500 mt-0.5 truncate max-w-md\">\n                    Truy v\341\272\245n: {result.searchQueries.join(\' \302\267 \')}\n                  </p>\n                )}\n              </div>\n\n              {result.suggestedN !== null && (\n                <button\n                  type=\"button\"\n                  onClick={() => onApplyRefractiveIndex(result.suggestedN!, query)}\n                  className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap cursor-pointer\"\n                >\n                  \303\201p d\341\273\245ng n\342\202\202 = {result.suggestedN.toFixed(4)}\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n\n            <div className=\"p-6 space-y-5\">\n              <div className=\"text-sm text-slate-800 leading-relaxed whitespace-pre-line\">\n                {result.answer}\n              </div>\n\n              {result.sources.length > 0 && (\n                <div className=\"pt-4 border-t border-slate-200\">\n                  <h3 className=\"text-xs font-semibold text-slate-800 mb-2.5\">\n                    Ngu\341\273\223n tham kh\341\272\243o x\303\241c th\341\273\261c ({result.sources.length})\n                  </h3>\n                  <ul className=\"space-y-1.5\">\n                    {result.sources.map((src) => (\n                      <li key={src.uri}>\n                        <a\n                          href={src.uri}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"inline-flex items-center gap-1.5 text-xs text-sky-700 hover:text-sky-900 hover:underline break-all\"\n                        >\n                          <ExternalLink className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                          <span>{src.title}</span>\n                        </a>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* Saved Search History for Authenticated Users */}\n        {history.length > 0 && (\n          <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <History className=\"w-4 h-4 text-slate-500\" aria-hidden=\"true\" />\n              <h2 className=\"text-sm font-semibold text-slate-900\">\n                L\341\273\213ch s\341\273\255 tra c\341\273\251u \304\221\303\243 l\306\260u ({history.length})\n              </h2>\n            </div>\n            <div className=\"divide-y divide-slate-100\">\n              {history.slice(0, 6).map((item) => (\n                <div\n                  key={item.id}\n                  className=\"py-3 flex flex-wrap items-center justify-between gap-3\"\n                >\n                  <div className=\"min-w-0 flex-1\">\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setQuery(item.query);\n                        setResult({\n                          answer: item.summary,\n                          suggestedN: item.suggestedN,\n                          sources: item.sources,\n                          searchQueries: [],\n                        });\n                      }}\n                      className=\"text-left text-xs font-medium text-slate-900 hover:text-sky-700 truncate block w-full cursor-pointer\"\n                    >\n                      {item.query}\n                    </button>\n                    <p className=\"text-[11px] text-slate-500 truncate mt-0.5\">{item.summary}</p>\n                  </div>\n                  {item.suggestedN !== null && (\n                    <button\n                      type=\"button\"\n                      onClick={() => onApplyRefractiveIndex(item.suggestedN!, item.query)}\n                      className=\"px-2.5 py-1 text-[11px] font-mono font-medium rounded border border-slate-200 bg-slate-50 text-sky-800 hover:bg-sky-50 whitespace-nowrap cursor-pointer\"\n                    >\n                      N\341\272\241p n\342\202\202 = {item.suggestedN.toFixed(3)}\n                    </button>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
